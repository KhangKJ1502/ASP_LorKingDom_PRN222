@model BLL.DTOs.AccountDto

<div class="profile-overview-container">
    <style>
        .profile-overview-container {
            padding: 2rem;
        }

        .profile-section-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: #f97316;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .profile-form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .profile-form-group {
            display: flex;
            flex-direction: column;
        }

        .profile-form-group.full-width {
            grid-column: 1 / -1;
        }

        .profile-label {
            font-weight: 600;
            color: #374151;
            margin-bottom: 0.5rem;
            font-size: 0.875rem;
        }

        .profile-input {
            padding: 0.75rem 1rem;
            border: 2px solid #fed7aa;
            border-radius: 8px;
            font-size: 0.95rem;
            transition: all 0.2s;
            background-color: #fff;
        }

        .profile-input:focus {
            outline: none;
            border-color: #f97316;
            box-shadow: 0 0 0 3px rgba(249, 115, 22, 0.1);
        }

        .profile-input:disabled {
            background-color: #f9fafb;
            color: #9ca3af;
            cursor: not-allowed;
        }

        .profile-avatar-section {
            background: linear-gradient(135deg, #fff5f3 0%, #fff 100%);
            border: 2px dashed #fed7aa;
            border-radius: 12px;
            padding: 2rem;
            text-align: center;
            margin-bottom: 2rem;
        }

        .profile-avatar-preview {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid #f97316;
            margin: 0 auto 1rem;
            display: block;
            box-shadow: 0 4px 12px rgba(249, 115, 22, 0.2);
        }

        .profile-avatar-upload-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.625rem 1.25rem;
            background: linear-gradient(135deg, #f97316 0%, #fb923c 100%);
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 0.875rem;
        }

        .profile-avatar-upload-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(249, 115, 22, 0.3);
        }

        .profile-file-input {
            display: none;
        }

        .profile-file-hint {
            color: #6b7280;
            font-size: 0.75rem;
            margin-top: 0.5rem;
        }

        .profile-actions {
            display: flex;
            gap: 1rem;
            justify-content: flex-end;
            padding-top: 1.5rem;
            border-top: 2px solid #fed7aa;
        }

        .profile-btn {
            padding: 0.75rem 2rem;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            border: none;
            font-size: 0.95rem;
        }

        .profile-btn-primary {
            background: linear-gradient(135deg, #f97316 0%, #fb923c 100%);
            color: white;
        }

        .profile-btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(249, 115, 22, 0.3);
        }

        .profile-btn-secondary {
            background: white;
            color: #6b7280;
            border: 2px solid #e5e7eb;
        }

        .profile-btn-secondary:hover {
            background: #f9fafb;
            border-color: #d1d5db;
        }

        .profile-info-card {
            background: linear-gradient(135deg, #fff5f3 0%, #fff 100%);
            border: 2px solid #fed7aa;
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 2rem;
        }

        .profile-info-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
        }

        .profile-info-item {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .profile-info-label {
            font-size: 0.75rem;
            color: #6b7280;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .profile-info-value {
            font-size: 0.95rem;
            color: #111827;
            font-weight: 500;
        }

        .profile-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .profile-badge-active {
            background: #d1fae5;
            color: #065f46;
        }

        .profile-badge-inactive {
            background: #fee2e2;
            color: #991b1b;
        }

        @@media (max-width: 768px) {

            .profile-form-grid,
            .profile-info-grid {
                grid-template-columns: 1fr;
            }

            .profile-actions {
                flex-direction: column;
            }

            .profile-btn {
                width: 100%;
            }
        }
    </style>

    <h2 class="profile-section-title">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        Thông tin tài khoản
    </h2>

    <!-- Account Info Card -->
    <div class="profile-info-card">
        <div class="profile-info-grid">
            <div class="profile-info-item">
                <span class="profile-info-label">ID Tài khoản</span>
                <span class="profile-info-value">#@Model.Id</span>
            </div>
            <div class="profile-info-item">
                <span class="profile-info-label">Trạng thái</span>
                <span
                    class="profile-badge @(Model.Status == "Active" ? "profile-badge-active" : "profile-badge-inactive")">
                    @(Model.Status == "Active" ? "Đang hoạt động" : "Không hoạt động")
                </span>
            </div>
            <div class="profile-info-item">
                <span class="profile-info-label">Ngày tạo</span>
                <span class="profile-info-value">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            <div class="profile-info-item">
                <span class="profile-info-label">Vai trò</span>
                <span class="profile-info-value">Khách hàng</span>
            </div>
        </div>
    </div>

    <!-- Avatar Section -->
    <div class="profile-avatar-section">
        <img id="avatarPreview"
            src="@(string.IsNullOrEmpty(Model.Image) ? "/Assets/image/avatar/avatar-illustrated-02.png" : Model.Image)"
            alt="Avatar" class="profile-avatar-preview" />
        <label for="avatarInput" class="profile-avatar-upload-btn">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            Chọn ảnh đại diện
        </label>
        <input type="file" id="avatarInput" class="profile-file-input" accept="image/*" />
        <p class="profile-file-hint">JPG, PNG, GIF tối đa 5MB</p>
    </div>

    <!-- Profile Form -->
    <form id="profileForm">
        <div class="profile-form-grid">
            <div class="profile-form-group">
                <label class="profile-label" for="accountName">
                    Tên hiển thị <span class="text-red-500">*</span>
                </label>
                <input type="text" id="accountName" name="accountName" class="profile-input" value="@Model.AccountName"
                    required />
            </div>

            <div class="profile-form-group">
                <label class="profile-label" for="email">
                    Email
                </label>
                <input type="email" id="email" name="email" class="profile-input" value="@Model.Email" disabled />
                <small style="color: #6b7280; font-size: 0.75rem; margin-top: 0.25rem;">
                    Email không thể thay đổi
                </small>
            </div>

            <div class="profile-form-group">
                <label class="profile-label" for="phoneNumber">
                    Số điện thoại
                </label>
                <input type="tel" id="phoneNumber" name="phoneNumber" class="profile-input" value="@Model.PhoneNumber"
                    placeholder="Nhập số điện thoại" />
            </div>

            <div class="profile-form-group">
                <label class="profile-label">
                    Mật khẩu
                </label>
                <button type="button" class="profile-btn profile-btn-secondary" id="changePasswordBtn"
                    style="width: 100%; justify-content: center;">
                    <svg class="h-4 w-4 inline-block mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                    </svg>
                    Đổi mật khẩu
                </button>
            </div>
        </div>

        <div class="profile-actions">
            <button type="button" class="profile-btn profile-btn-secondary" id="resetBtn">
                <svg class="h-4 w-4 inline-block mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                Đặt lại
            </button>
            <button type="submit" class="profile-btn profile-btn-primary">
                <svg class="h-4 w-4 inline-block mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Lưu thay đổi
            </button>
        </div>
    </form>
</div>

<!-- Change Password Modal -->
<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel"
    aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="changePasswordModalLabel" style="color: #f97316; font-weight: 700;">
                    <svg class="h-5 w-5 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                    </svg>
                    Đổi mật khẩu
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="changePasswordForm">
                    <div class="mb-3">
                        <label for="currentPassword" class="form-label" style="font-weight: 600; color: #374151;">
                            Mật khẩu hiện tại <span class="text-danger">*</span>
                        </label>
                        <input type="password" class="form-control" id="currentPassword" name="currentPassword" required
                            style="border: 2px solid #fed7aa; border-radius: 8px;">
                    </div>
                    <div class="mb-3">
                        <label for="newPassword" class="form-label" style="font-weight: 600; color: #374151;">
                            Mật khẩu mới <span class="text-danger">*</span>
                        </label>
                        <input type="password" class="form-control" id="newPassword" name="newPassword" required
                            style="border: 2px solid #fed7aa; border-radius: 8px;">
                        <small class="text-muted">Mật khẩu phải có ít nhất 6 ký tự</small>
                    </div>
                    <div class="mb-3">
                        <label for="confirmPassword" class="form-label" style="font-weight: 600; color: #374151;">
                            Xác nhận mật khẩu mới <span class="text-danger">*</span>
                        </label>
                        <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required
                            style="border: 2px solid #fed7aa; border-radius: 8px;">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" id="submitChangePassword"
                    style="background: linear-gradient(135deg, #f97316 0%, #ea580c 100%); border: none;">
                    Đổi mật khẩu
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    // Initialize profile overview functionality
    window.initializeProfileOverview = function () {
        const profileForm = document.getElementById('profileForm');
        const resetBtn = document.getElementById('resetBtn');
        const avatarInput = document.getElementById('avatarInput');
        const avatarPreview = document.getElementById('avatarPreview');

        // Handle avatar preview
        if (avatarInput) {
            avatarInput.addEventListener('change', function (e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        avatarPreview.src = e.target.result;
                    };
                    reader.readAsDataURL(file);
                }
            });
        }

        // Handle reset button
        if (resetBtn) {
            resetBtn.addEventListener('click', function () {
                profileForm.reset();
                // Reset avatar preview to original
                const originalAvatar = '@(string.IsNullOrEmpty(Model.Image) ? "/Assets/image/avatar/avatar-illustrated-02.png" : Model.Image)';
                avatarPreview.src = originalAvatar;
            });
        }

        // Handle profile form submission
        if (profileForm) {
            profileForm.addEventListener('submit', function (e) {
                e.preventDefault();

                const formData = new FormData();
                formData.append('accountName', document.getElementById('accountName').value);
                formData.append('phoneNumber', document.getElementById('phoneNumber').value);

                if (avatarInput && avatarInput.files[0]) {
                    formData.append('avatar', avatarInput.files[0]);
                }

                // Get anti-forgery token
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                $.ajax({
                    url: '/Home/UpdateProfile',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    headers: {
                        'RequestVerificationToken': token
                    },
                    success: function (response) {
                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công!',
                                text: 'Cập nhật thông tin thành công!',
                                timer: 2000
                            }).then(() => {
                                // Reload profile overview
                                $.ajax({
                                    url: '/Home/ProfileOverview',
                                    type: 'GET',
                                    success: function (html) {
                                        $('#profile-content').html(html);
                                        if (typeof window.initializeProfileOverview === 'function') {
                                            window.initializeProfileOverview();
                                        }
                                        if (typeof window.handleChangePassword === 'function') {
                                            window.handleChangePassword();
                                        }
                                    }
                                });
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Lỗi',
                                text: response.message || 'Có lỗi xảy ra khi cập nhật.'
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Error updating profile:", error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi',
                            text: 'Đã xảy ra lỗi khi cập nhật thông tin.'
                        });
                    }
                });
            });
        }
    };

    // Handle change password
    window.handleChangePassword = function () {
        const changePasswordBtn = document.getElementById('changePasswordBtn');
        const submitChangePassword = document.getElementById('submitChangePassword');
        const changePasswordForm = document.getElementById('changePasswordForm');

        if (changePasswordBtn) {
            changePasswordBtn.addEventListener('click', function () {
            const modalElement = document.getElementById('changePasswordModal');
            // Lấy instance đã có hoặc tạo mới nếu chưa có
            let modal = bootstrap.Modal.getInstance(modalElement);
            if (!modal) {
                modal = new bootstrap.Modal(modalElement);
            }
            modal.show();
        });
    }

        if (submitChangePassword && changePasswordForm) {
            submitChangePassword.addEventListener('click', function () {
                const currentPassword = document.getElementById('currentPassword').value;
                const newPassword = document.getElementById('newPassword').value;
                const confirmPassword = document.getElementById('confirmPassword').value;

                if (!currentPassword || !newPassword || !confirmPassword) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Thiếu thông tin',
                        text: 'Vui lòng điền đầy đủ thông tin.'
                    });
                    return;
                }

                if (newPassword !== confirmPassword) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi',
                        text: 'Mật khẩu mới và xác nhận mật khẩu không khớp.'
                    });
                    return;
                }

                if (newPassword.length < 6) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi',
                        text: 'Mật khẩu phải có ít nhất 6 ký tự.'
                    });
                    return;
                }

                // Get anti-forgery token
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                $.ajax({
                    url: '@Url.Action("ChangePassword", "Home")',
                    type: 'POST',
                    data: {
                        currentPassword: currentPassword,
                        newPassword: newPassword,
                        confirmPassword: confirmPassword,
                        __RequestVerificationToken: token
                    },
                    success: function (response) {
                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công!',
                                text: 'Đổi mật khẩu thành công!',
                                timer: 2000
                            }).then(() => {
                                const modal = bootstrap.Modal.getInstance(document.getElementById('changePasswordModal'));
                                modal.hide();
                                changePasswordForm.reset();
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Lỗi',
                                text: response.message || 'Có lỗi xảy ra khi đổi mật khẩu.'
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Error changing password:", error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi',
                            text: 'Đã xảy ra lỗi khi đổi mật khẩu.'
                        });
                    }
                });
            });
        }
    };

    // Initialize on load
    $(document).ready(function () {
        initializeProfileOverview();
        handleChangePassword();
    });
</script>