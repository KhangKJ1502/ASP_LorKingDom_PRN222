@{
    ViewData["Title"] = "My Profile";
}

<div class="min-h-screen bg-gradient-to-br from-orange-50/30 to-white">
    <div class="container mx-auto px-4 py-8">
        <!-- Header -->
        <div class="flex items-center gap-4 mb-8">
            <a href="/">
                <button class="rounded-full hover:bg-orange-100 transition-colors p-2">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                </button>
            </a>
            <div>
                <h1 class="text-4xl font-bold text-gradient font-fredoka">My Profile</h1>
                <p class="text-muted-foreground">Manage your account and preferences</p>
            </div>
        </div>

        <div class="grid lg:grid-cols-4 gap-8">
            <!-- Profile Sidebar -->
            <div class="lg:col-span-1">
                <div class="sticky top-8 shadow-xl border-2 border-orange-100 rounded-xl bg-white">
                    <div class="p-6 text-center">
                        <div class="relative mb-6">
                            <div class="w-24 h-24 mx-auto border-4 border-orange-200 shadow-lg rounded-full bg-gradient-warm flex items-center justify-center text-white text-2xl font-bold">
                                JD
                            </div>
                            <button class="absolute -bottom-2 -right-2 rounded-full w-8 h-8 bg-white border-2 border-orange-200 hover:bg-orange-50 flex items-center justify-center">
                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                                </svg>
                            </button>
                        </div>

                        <h3 class="text-xl font-bold text-gray-800 mb-1">John Doe</h3>
                        <p class="text-gray-600 mb-4">Premium Member</p>

                        <div class="inline-flex items-center gap-1 bg-gradient-warm text-white px-3 py-1 rounded-full text-sm mb-6">
                            <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                            </svg>
                            VIP Customer
                        </div>

                        <div class="space-y-2 text-sm">
                            <div class="flex items-center justify-between">
                                <span class="text-gray-600">Total Orders</span>
                                <span class="font-semibold">47</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-gray-600">Total Spent</span>
                                <span class="font-semibold">$2,847</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-gray-600">Member Since</span>
                                <span class="font-semibold">2022</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="lg:col-span-3">
                <!-- Tabs -->
                <div class="grid grid-cols-5 bg-white border-2 border-orange-100 rounded-xl p-1 mb-6">
                    <button class="profile-tab active rounded-lg px-4 py-3 flex items-center justify-center gap-2 text-sm font-medium transition-all">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                        Overview
                    </button>

                    <button class="profile-tab rounded-lg px-4 py-3 flex items-center justify-center gap-2 text-sm font-medium transition-all">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                        </svg>
                        Orders
                    </button>

                    <button class="profile-tab rounded-lg px-4 py-3 flex items-center justify-center gap-2 text-sm font-medium transition-all">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                        </svg>
                        Wishlist
                    </button>

                    <!-- Address tab now redirects to new page -->
                    <button class="profile-tab rounded-lg px-4 py-3 flex items-center justify-center gap-2 text-sm font-medium transition-all hover:bg-orange-50"
                            data-tab="addresses">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                        <span>Addresses</span>
                    </button>


                    <button class="profile-tab rounded-lg px-4 py-3 flex items-center justify-center gap-2 text-sm font-medium transition-all">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                        Settings
                    </button>
                </div>

                <!-- Simple welcome text -->
                <div class="bg-white rounded-xl border-2 border-orange-100 shadow-sm p-8">
                    <h2 class="text-2xl font-bold text-orange-600 mb-4">Welcome back, John!</h2>
                    <p class="text-gray-600">Here you can manage your orders, wishlist, and account settings.</p>
                </div>
            </div>
        </div>
    </div>
    <script>
        (function() {
          const content = document.getElementById("profile-content");
          document.addEventListener("click", async (e) => {
            const btn = e.target.closest(".profile-tab");
            if (!btn) return;
            const tab = btn.getAttribute("data-tab");
            if (tab !== "addresses") return;

            // Active tab UI (màu cam #F97316 cho tab hiện hành)
            document.querySelectorAll(".profile-tab").forEach(x => x.classList.remove("active"));
            btn.classList.add("active"); // thêm CSS .active { background:#fff5ec; color:#f97316; ... }

            const res = await fetch("/addresses/partial", { method: "GET", credentials: "same-origin" });
            const html = await res.text();
            content.innerHTML = html;

            // Sau khi partial vào DOM, gọi list
            const evt = new Event('DOMContentLoaded');
            document.dispatchEvent(evt);
          });
        })();
    </script>

</div>

