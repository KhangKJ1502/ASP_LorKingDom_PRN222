    @section Scripts {
        <script src="~/js/profile.js" asp-append-version="true"></script>
        <script src="~/js/addresses.js" asp-append-version="true"></script>
    }
</div>

<script>
    // ===== GLOBAL FUNCTIONS FOR ORDER HISTORY =====
    // These must be defined in parent page because partial view scripts don't execute when loaded via innerHTML
    
    // Load order page (pagination)
    window.loadOrderPage = async function(page) {
        try {
            const content = document.getElementById("profile-content");
            
            // Show loading
            const loadingHtml = `
                <div class="bg-white rounded-xl border-2 border-orange-100 shadow-sm p-8 text-center">
                    <div class="spinner-border text-orange-500" role="status">
                        <span class="sr-only">Đang tải...</span>
                    </div>
                    <p class="mt-3 text-gray-600">Đang tải đơn hàng...</p>
                </div>
            `;
            content.innerHTML = loadingHtml;

            const res = await fetch(`/Home/Order?page=${page}`, {
                method: "GET",
                credentials: "same-origin"
            });
            const html = await res.text();
            content.innerHTML = html;

            // Initialize filters after content is loaded
            if (typeof window.initializeOrderFilters === 'function') {
                window.initializeOrderFilters();
            }

            // Scroll to top of content
            content.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } catch (error) {
            console.error("Error loading order page:", error);
            const content = document.getElementById("profile-content");
            content.innerHTML = `
                <div class="bg-white rounded-xl border-2 border-orange-100 shadow-sm p-8 text-center">
                    <p class="text-red-500">Không thể tải đơn hàng. Vui lòng thử lại sau.</p>
                </div>
            `;
        }
    };
    
    // Cancel order functionality
    window.cancelOrder = function(orderId) {
        Swal.fire({
            title: 'Xác nhận hủy đơn',
            text: 'Bạn có chắc chắn muốn hủy đơn hàng #' + orderId + ' không?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc2626',
            cancelButtonColor: '#6b7280',
            confirmButtonText: 'Hủy đơn',
            cancelButtonText: 'Không'
        }).then((result) => {
            if (result.isConfirmed) {
                // Show loading
                Swal.fire({
                    title: 'Đang xử lý...',
                    allowOutsideClick: false,
                    didOpen: () => Swal.showLoading()
                });

                // Get anti-forgery token
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                fetch('/Order/CancelOrder', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ orderId: orderId })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire({
                            title: 'Thành công!',
                            text: data.message || 'Hủy đơn hàng thành công!',
                            icon: 'success',
                            confirmButtonColor: '#10b981'
                        }).then(() => {
                            // Reload to orders tab
                            window.location.href = '/Home/Profile#orders';
                            window.location.reload();
                        });
                    } else {
                        Swal.fire({
                            title: 'Lỗi!',
                            text: data.message || 'Không thể hủy đơn hàng!',
                            icon: 'error',
                            confirmButtonColor: '#dc2626'
                        });
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    Swal.fire({
                        title: 'Lỗi!',
                        text: 'Có lỗi xảy ra khi hủy đơn hàng!',
                        icon: 'error',
                        confirmButtonColor: '#dc2626'
                    });
                });
            }
        });
    };

    // Return order functionality (placeholder)
    window.returnOrder = function(orderId) {
        Swal.fire({
            title: 'Thông báo',
            text: 'Tính năng hoàn trả đơn hàng #' + orderId + ' đang được phát triển.',
            icon: 'info',
            confirmButtonColor: '#10b981'
        });
    };

    // Initialize order filters after partial view loads
    window.initializeOrderFilters = function() {
        console.log('Initializing order filters...');
        
        const filterTabs = document.querySelectorAll('.filter-tab');
        console.log('Found filter tabs:', filterTabs.length);

        filterTabs.forEach(tab => {
            // Remove existing listeners to avoid duplicates
            const newTab = tab.cloneNode(true);
            tab.parentNode.replaceChild(newTab, tab);
        });

        // Add event listeners to fresh tabs
        document.querySelectorAll('.filter-tab').forEach(tab => {
            tab.addEventListener('click', function (e) {
                e.preventDefault();
                console.log('Tab clicked!');

                // Update active tab
                document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
                this.classList.add('active');

                // Get selected status
                const selectedStatus = this.getAttribute('data-status');
                console.log('Selected status:', selectedStatus);

                // Filter orders
                let visibleCount = 0;
                document.querySelectorAll('.order-card').forEach(card => {
                    const cardStatus = card.getAttribute('data-status');

                    if (selectedStatus === 'all') {
                        card.classList.remove('hidden');
                        visibleCount++;
                    } else {
                        if (cardStatus == selectedStatus) {
                            card.classList.remove('hidden');
                            visibleCount++;
                        } else {
                            card.classList.add('hidden');
                        }
                    }
                });

                console.log('Visible cards:', visibleCount);

                // Show/hide empty state message
                let emptyStateMsg = document.getElementById('filter-empty-state');
                if (visibleCount === 0) {
                    if (!emptyStateMsg) {
                        emptyStateMsg = document.createElement('div');
                        emptyStateMsg.id = 'filter-empty-state';
                        emptyStateMsg.className = 'empty-state';
                        emptyStateMsg.style.marginTop = '2rem';
                        
                        const statusNames = {
                            '1': 'Chờ xác nhận',
                            '2': 'Đã xác nhận',
                            '3': 'Đang vận chuyển',
                            '4': 'Đã giao',
                            '5': 'Đã hủy'
                        };
                        
                        const statusName = selectedStatus === 'all' ? '' : statusNames[selectedStatus] || '';
                        
                        emptyStateMsg.innerHTML = `
                            <div class="empty-icon">📦</div>
                            <h3>Không có đơn hàng</h3>
                            <p class="text-muted">Bạn chưa có đơn hàng nào ở trạng thái "${statusName}".</p>
                        `;
                        
                        document.getElementById('orderList').appendChild(emptyStateMsg);
                    }
                } else {
                    if (emptyStateMsg) {
                        emptyStateMsg.remove();
                    }
                }
            });
        });
    };

    // ===== PROFILE PAGE LOGIC =====
    (function () {
        const content = document.getElementById("profile-content");
        const tabs = document.querySelectorAll(".profile-tab");

        // Check URL hash to determine active tab
        function getActiveTabFromHash() {
            const hash = window.location.hash.substring(1); // Remove '#'
            return hash || 'overview';
        }

        // Set URL hash when tab changes
        function setTabHash(tabName) {
            window.history.replaceState(null, null, '#' + tabName);
        }

        // Load tab content
        async function loadTab(tabName) {
            // Update active state
            tabs.forEach(t => t.classList.remove("active"));
            const activeTab = document.querySelector(`[data-tab="${tabName}"]`);
            if (activeTab) {
                activeTab.classList.add("active");
            }

            // Set hash
            setTabHash(tabName);

            // Handle addresses tab (existing behavior)
            if (tabName === "addresses") {
                try {
                    const res = await fetch("/addresses/partial", {
                        method: "GET",
                        credentials: "same-origin"
                    });
                    const html = await res.text();
                    content.innerHTML = html;

                    // Trigger DOMContentLoaded for partial
                    const evt = new Event('DOMContentLoaded');
                    document.dispatchEvent(evt);
                } catch (error) {
                    console.error("Error loading addresses:", error);
                    content.innerHTML = `
                        <div class="bg-white rounded-xl border-2 border-orange-100 shadow-sm p-8">
                            <h2 class="text-2xl font-bold text-red-600 mb-4">Error</h2>
                            <p class="text-gray-600">Unable to load addresses. Please try again.</p>
                        </div>
                    `;
                }
                return;
            }

            // Handle orders tab - load from partial view
            if (tabName === "orders") {
                try {
                    const res = await fetch("/Home/Order", {
                        method: "GET",
                        credentials: "same-origin"
                    });
                    const html = await res.text();
                    content.innerHTML = html;

                    // Initialize order filters after content is loaded
                    if (typeof window.initializeOrderFilters === 'function') {
                        window.initializeOrderFilters();
                    }
                } catch (error) {
                    console.error("Error loading orders:", error);
                    content.innerHTML = `
                        <div class="bg-white rounded-xl border-2 border-orange-100 shadow-sm p-8">
                            <h2 class="text-2xl font-bold text-red-600 mb-4">Error</h2>
                            <p class="text-gray-600">Unable to load order history. Please try again.</p>
                        </div>
                    `;
                }
                return;
            }

            // Handle other tabs with predefined content
            if (tabContents[tabName]) {
                content.innerHTML = tabContents[tabName];
            }
        }

        // Tab content mapping
        const tabContents = {
            overview: `
                <div class="bg-white rounded-xl border-2 border-orange-100 shadow-sm p-8">
                    <h2 class="text-2xl font-bold text-orange-600 mb-4">Welcome back, John!</h2>
                    <p class="text-gray-600">Here you can manage your orders, wishlist, and account settings.</p>
                </div>
            `,
            wishlist: `
                <div class="bg-white rounded-xl border-2 border-orange-100 shadow-sm p-8">
                    <h2 class="text-2xl font-bold text-orange-600 mb-4">My Wishlist</h2>
                    <p class="text-gray-600">Your wishlist is currently empty. Start adding your favorite items!</p>
                </div>
            `,
            settings: `
                <div class="bg-white rounded-xl border-2 border-orange-100 shadow-sm p-8">
                    <h2 class="text-2xl font-bold text-orange-600 mb-4">Account Settings</h2>
                    <p class="text-gray-600">Manage your account preferences and security settings.</p>
                </div>
            `
        };

        // Handle tab clicks
        tabs.forEach(tab => {
            tab.addEventListener("click", async function (e) {
                e.preventDefault();
                const tabName = this.getAttribute("data-tab");
                await loadTab(tabName);
            });
        });

        // Load initial tab based on hash
        const initialTab = getActiveTabFromHash();
        loadTab(initialTab);
    })();
</script>



