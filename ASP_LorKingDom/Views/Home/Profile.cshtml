@model BLL.DTOs.AccountDto
@{
    ViewData["Title"] = "My Profile";
}
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<!-- Đặt gần cuối <body > -->

<style>
    .toast {
        pointer-events: auto;
        display: flex;
        align-items: center;
        gap: .75rem;
        min-width: 280px;
        max-width: 420px;
        padding: .875rem 1rem;
        border-radius: 12px;
        color: #fff;
        box-shadow: 0 10px 24px rgba(0, 0, 0, .18);
        opacity: 0;
        transform: translateY(-6px);
        transition: opacity .2s ease, transform .2s ease;
    }

    .toast.show {
        opacity: 1;
        transform: translateY(0);
    }

    .toast-error {
        background: #ef4444;
    }

    /* đỏ */
    .toast-success {
        background: #22c55e;
    }

    /* xanh */
    .toast-info {
        background: #3b82f6;
    }

    /* xanh dương */
    .toast-close {
        margin-left: auto;
        background: transparent;
        border: 0;
        color: #fff;
        opacity: .8;
    }

    .toast-close:hover {
        opacity: 1
    }
</style>

<!-- Anti-forgery token ẩn để JS gửi kèm khi POST -->
<input type="hidden" name="__RequestVerificationToken" value="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />

<div class="min-h-screen bg-gradient-to-br from-orange-50/30 to-white">
    <div class="container mx-auto px-4 py-8">
        <!-- Header -->
        <div class="flex items-center gap-4 mb-8">
            <a href="/">
                <button class="rounded-full hover:bg-orange-100 transition-colors p-2" title="Back">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                </button>
            </a>
            <div>
                <h1 class="text-4xl font-bold text-gradient font-fredoka">Hồ sơ</h1>
                <p class="text-muted-foreground">Quản lý tài khoản và tùy chọn theo cách của bạn</p>
            </div>
        </div>

        <div class="grid lg:grid-cols-4 gap-8">
            <!-- Profile Sidebar -->
            <div class="lg:col-span-1">
                <div class="sticky top-8 shadow-xl border-2 border-orange-100 rounded-xl bg-white">
                    <div class="p-6 text-center">
                        <div class="relative mb-6">
                            <img src="@(string.IsNullOrEmpty(Model.Image) ? "/Assets/image/avatar/avatar-illustrated-02.png" : Model.Image)"
                                alt="Avatar" id="sidebarAvatar"
                                class="w-24 h-24 mx-auto border-4 border-orange-200 shadow-lg rounded-full object-cover" />
                        </div>

                        <h3 class="text-xl font-bold text-gray-800 mb-1">@Model.AccountName</h3>
                        <p class="text-gray-600 mb-4">@Model.Email</p>

                        <div class="space-y-2 text-sm">
                            <div class="flex items-center justify-between">
                                <span class="text-gray-600">Trạng thái</span>
                                <span
                                    class="font-semibold @(Model.Status == "Active" ? "text-green-600" : "text-red-600")">
                                    @(Model.Status == "Active" ? "Hoạt động" : "Không hoạt động")
                                </span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-gray-600">Tham gia từ</span>
                                <span class="font-semibold">@Model.CreatedAt.ToString("MM/yyyy")</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="lg:col-span-3">
                <!-- Tabs -->
                <div class="grid grid-cols-5 bg-white border-2 border-orange-100 rounded-xl p-1 mb-6">
                    <button
                        class="profile-tab active rounded-lg px-4 py-3 flex items-center justify-center gap-2 text-sm font-medium transition-all"
                        data-tab="overview">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                        Thông tin
                    </button>
                    <button
                        class="profile-tab rounded-lg px-4 py-3 flex items-center justify-center gap-2 text-sm font-medium transition-all"
                        data-tab="orders">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                        </svg>
                        Đơn hàng
                    </button>
                    <button
                        class="profile-tab rounded-lg px-4 py-3 flex items-center justify-center gap-2 text-sm font-medium transition-all"
                        data-tab="addresses">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                        Địa chỉ
                    </button>
                    <button
                        class="profile-tab rounded-lg px-4 py-3 flex items-center justify-center gap-2 text-sm font-medium transition-all"
                        data-tab="wallets">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        Ví
                    </button>

                    <button
                        class="profile-tab rounded-lg px-4 py-3 flex items-center justify-center gap-2 text-sm font-medium transition-all"
                        data-tab="reviews">
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                        </svg>
                        Đánh giá
                    </button>
                </div>

                <!-- Tab Content: nội dung động sẽ được JS nạp vào đây -->
                <div id="profile-content" class="border-2 border-orange-100 rounded-xl bg-white">
                    <!-- Content will be loaded by JavaScript -->
                </div>
            </div>
        </div>
    </div>

    <!-- Address - Quynh-->
    <div class="modal fade" id="addrModal" tabindex="-1" aria-labelledby="addrModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 id="addrModalLabel" class="modal-title">Address</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div id="addrModalBody" class="modal-body">
                </div>
            </div>
        </div>
    </div>

    <!-- Review Popup Modal -->
    <div class="modal fade" id="reviewPopupModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-gradient-orange text-white border-0">
                    <h5 class="modal-title fw-bold">
                        <i class="fas fa-star me-2"></i> Đánh giá của bạn
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-0" id="reviewPopupContent">
                    <div class="text-center py-5">
                        <div class="spinner-border text-orange" role="status"></div>
                        <p class="mt-3 text-muted">Đang tải đánh giá...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_ReviewModal")

    @section Scripts {
        <script src="~/js/profile.js" asp-append-version="true"></script>
        <script src="~/js/addresses.js" asp-append-version="true"></script>
        <script src="~/js/reviews.js" asp-append-version="true"></script>
    }
</div>

<script>
    // ===== GLOBAL FUNCTIONS FOR ORDER HISTORY =====
    // These must be defined in parent page because partial view scripts don't execute when loaded via innerHTML

    // Initialize profile overview form
    window.initializeProfileOverview = function () {
        console.log('Initializing profile overview...');

        const avatarInput = $('#avatarInput');
        const avatarPreview = $('#avatarPreview');
        const profileForm = $('#profileForm');
        const resetBtn = $('#resetBtn');

        if (!profileForm.length) {
            console.log('Profile form not found');
            return;
        }

        // Get original values from form
        const originalValues = {
            accountName: $('#accountName').val() || '',
            phoneNumber: $('#phoneNumber').val() || '',
            avatar: $('#avatarPreview').attr('src') || '/Assets/image/avatar/avatar-illustrated-02.png'
        };

        console.log('Original values:', originalValues);

        let selectedFile = null;

        // Remove existing event handlers to avoid duplicates
        avatarInput.off('change');
        resetBtn.off('click');
        profileForm.off('submit');

        // Avatar preview
        avatarInput.on('change', function (e) {
            const file = e.target.files[0];
            if (file) {
                // Validate file type
                const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif'];
                if (!allowedTypes.includes(file.type)) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi',
                        text: 'Chỉ chấp nhận file ảnh (JPG, PNG, GIF)',
                        confirmButtonColor: '#dc2626'
                    });
                    avatarInput.val('');
                    return;
                }

                // Validate file size (5MB)
                if (file.size > 5 * 1024 * 1024) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi',
                        text: 'Kích thước ảnh không được vượt quá 5MB',
                        confirmButtonColor: '#dc2626'
                    });
                    avatarInput.val('');
                    return;
                }

                selectedFile = file;

                // Preview
                const reader = new FileReader();
                reader.onload = function (e) {
                    avatarPreview.attr('src', e.target.result);
                };
                reader.readAsDataURL(file);
            }
        });

        // Reset form
        resetBtn.on('click', function () {
            $('#accountName').val(originalValues.accountName);
            $('#phoneNumber').val(originalValues.phoneNumber);
            avatarPreview.attr('src', originalValues.avatar);
            avatarInput.val('');
            selectedFile = null;
        });

        // Submit form với jQuery AJAX giống Login
        profileForm.on('submit', function (e) {
            e.preventDefault();

            const accountName = $('#accountName').val().trim();
            const phoneNumber = $('#phoneNumber').val().trim();

            console.log('Submitting profile update:', { accountName, phoneNumber, hasFile: !!selectedFile });

            // Validation
            if (!accountName) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Thiếu thông tin',
                    text: 'Vui lòng nhập tên hiển thị',
                    confirmButtonColor: '#f97316'
                });
                return;
            }

            // Show loading
            Swal.fire({
                title: 'Đang cập nhật...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            // Create FormData
            const formData = new FormData();
            formData.append('accountName', accountName);
            formData.append('phoneNumber', phoneNumber);

            if (selectedFile) {
                formData.append('avatar', selectedFile);
            }

            $.ajax({
                url: '/Home/UpdateProfile',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (data) {
                    console.log('Response received:', data);

                    if (data.success) {
                        // Update original values
                        originalValues.accountName = accountName;
                        originalValues.phoneNumber = phoneNumber;

                        if (data.avatar) {
                            originalValues.avatar = data.avatar;
                            // Update avatar in preview
                            avatarPreview.attr('src', data.avatar);
                            // Update avatar in sidebar
                            $('#sidebarAvatar').attr('src', data.avatar);
                        }

                        // Update sidebar name
                        if (data.accountName) {
                            $('.lg\\:col-span-1 h3.text-xl.font-bold').text(data.accountName);
                        }

                        selectedFile = null;
                        avatarInput.val('');

                        Swal.fire({
                            icon: 'success',
                            title: 'Thành công',
                            text: data.message,
                            confirmButtonColor: '#10b981'
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi',
                            text: data.message,
                            confirmButtonColor: '#dc2626'
                        });
                    }
                },
                error: function (xhr, status, error) {
                    console.error('AJAX Error:', { xhr, status, error });
                    console.error('Response text:', xhr.responseText);

                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi',
                        text: 'Đã xảy ra lỗi khi cập nhật thông tin: ' + error,
                        confirmButtonColor: '#dc2626'
                    });
                }
            });
        });

        console.log('Profile overview initialized successfully');
    };

    // Handle change password
    window.handleChangePassword = function () {
        console.log('Setting up change password handler...');

        const changePasswordBtn = $('#changePasswordBtn');
        const changePasswordModal = new bootstrap.Modal(document.getElementById('changePasswordModal'));
        const submitChangePasswordBtn = $('#submitChangePassword');
        const changePasswordForm = $('#changePasswordForm');

        // Remove existing handlers
        changePasswordBtn.off('click');
        submitChangePasswordBtn.off('click');

        // Open modal
        changePasswordBtn.on('click', function () {
            changePasswordForm[0].reset();
            changePasswordModal.show();
        });

        // Submit change password
        submitChangePasswordBtn.on('click', function () {
            const currentPassword = $('#currentPassword').val().trim();
            const newPassword = $('#newPassword').val().trim();
            const confirmPassword = $('#confirmPassword').val().trim();

            // Validation
            if (!currentPassword || !newPassword || !confirmPassword) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Thiếu thông tin',
                    text: 'Vui lòng điền đầy đủ thông tin',
                    confirmButtonColor: '#f97316'
                });
                return;
            }

            if (newPassword.length < 8) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Mật khẩu không hợp lệ',
                    text: 'Mật khẩu mới phải có ít nhất 8 ký tự',
                    confirmButtonColor: '#f97316'
                });
                return;
            }

            if (newPassword !== confirmPassword) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Mật khẩu không khớp',
                    text: 'Mật khẩu mới và xác nhận mật khẩu không khớp',
                    confirmButtonColor: '#f97316'
                });
                return;
            }

            // Show loading
            Swal.fire({
                title: 'Đang xử lý...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            // AJAX submit
            $.ajax({
                url: '/Home/ChangePassword',
                type: 'POST',
                data: {
                    currentPassword: currentPassword,
                    newPassword: newPassword,
                    confirmPassword: confirmPassword
                },
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (data) {
                    if (data.success) {
                        changePasswordModal.hide();
                        changePasswordForm[0].reset();
                        Swal.fire({
                            icon: 'success',
                            title: 'Thành công',
                            text: data.message,
                            confirmButtonColor: '#10b981'
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi',
                            text: data.message,
                            confirmButtonColor: '#dc2626'
                        });
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error:', error);
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi',
                        text: 'Đã xảy ra lỗi khi đổi mật khẩu',
                        confirmButtonColor: '#dc2626'
                    });
                }
            });
        });

        console.log('Change password handler setup complete');
    };

    // Load order page (pagination)
    window.loadOrderPage = function (page) {
        const content = $('#profile-content');

        // Show loading
        const loadingHtml = `
            <div class="bg-white rounded-xl border-2 border-orange-100 shadow-sm p-8 text-center">
                <div class="spinner-border text-orange-500" role="status">
                    <span class="sr-only">Đang tải...</span>
                </div>
                <p class="mt-3 text-gray-600">Đang tải đơn hàng...</p>
            </div>
        `;
        content.html(loadingHtml);

        // Use jQuery AJAX 
        $.ajax({
            url: '@Url.Action("OrderHistory", "Order")',
            type: 'GET',
            data: { page: page },
            success: function (html) {
                content.html(html);

                // Initialize filters after content is loaded
                if (typeof window.initializeOrderFilters === 'function') {
                    window.initializeOrderFilters();
                }

                // Scroll to top of content
                content[0].scrollIntoView({ behavior: 'smooth', block: 'start' });
            },
            error: function (xhr, status, error) {
                console.error("Error loading order page:", error);
                content.html(`
                    <div class="bg-white rounded-xl border-2 border-orange-100 shadow-sm p-8 text-center">
                        <p class="text-red-500">Không thể tải đơn hàng. Vui lòng thử lại sau.</p>
                    </div>
                `);
            }
        });
    };

    // ===== Navigate to reviews tab with specific product =====
    window.navigateToReviewsTab = function (tabType = 'pending', productId = null) {
        console.log('Navigating to reviews tab:', tabType, 'productId:', productId);

        // Store in sessionStorage để sử dụng sau khi load
        if (productId) {
            sessionStorage.setItem('highlightProductId', productId);
        }
        sessionStorage.setItem('reviewsTabType', tabType);

        // Update active tab UI
        document.querySelectorAll('.profile-tab').forEach(t => t.classList.remove('active'));
        const reviewsTab = document.querySelector('[data-tab="reviews"]');
        if (reviewsTab) {
            reviewsTab.classList.add('active');
        }

        // Update URL hash
        window.history.replaceState(null, null, '#reviews');

        // Load reviews content
        loadReviewsContent();
    };

    window.openReviewPopup = async function (productId) {
        const modalEl = document.getElementById('reviewPopupModal');
        const content = document.getElementById('reviewPopupContent');
        const modal = new bootstrap.Modal(modalEl);

        // Show loading
        content.innerHTML = `
                <div class="text-center py-5">
                    <div class="spinner-border text-orange" role="status"></div>
                    <p class="mt-3 text-muted">Đang tải đánh giá...</p>
                </div>
            `;
        modal.show();

        try {
            const res = await fetch(`/Review/ViewReviewPopup?productId=${productId}`);
            if (!res.ok) throw new Error("Không thể tải");

            const html = await res.text();
            content.innerHTML = html;
        } catch (err) {
            content.innerHTML = `
                    <div class="text-center py-5 text-danger">
                        <i class="fas fa-exclamation-triangle fa-2x mb-3"></i>
                        <p>Không thể tải đánh giá. Vui lòng thử lại.</p>
                    </div>
                `;
        }
    };



    // Return order functionality (placeholder)
    window.returnOrder = function (orderId) {
        Swal.fire({
            title: 'Thông báo',
            text: 'Tính năng hoàn trả đơn hàng #' + orderId + ' đang được phát triển.',
            icon: 'info',
            confirmButtonColor: '#10b981'
        });
    };

    // Initialize order filters after partial view loads
    window.initializeOrderFilters = function () {
        console.log('Initializing order filters...');

        const filterTabs = document.querySelectorAll('.filter-tab');
        console.log('Found filter tabs:', filterTabs.length);

        filterTabs.forEach(tab => {
            // Remove existing listeners to avoid duplicates
            const newTab = tab.cloneNode(true);
            tab.parentNode.replaceChild(newTab, tab);
        });

        // Add event listeners to fresh tabs
        document.querySelectorAll('.filter-tab').forEach(tab => {
            tab.addEventListener('click', function (e) {
                e.preventDefault();
                console.log('Tab clicked!');

                // Update active tab
                document.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
                this.classList.add('active');

                // Get selected status
                const selectedStatus = this.getAttribute('data-status');
                console.log('Selected status:', selectedStatus);

                // Filter orders
                let visibleCount = 0;
                document.querySelectorAll('.order-card').forEach(card => {
                    const cardStatus = card.getAttribute('data-status');

                    if (selectedStatus === 'all') {
                        card.classList.remove('hidden');
                        visibleCount++;
                    } else {
                        if (cardStatus == selectedStatus) {
                            card.classList.remove('hidden');
                            visibleCount++;
                        } else {
                            card.classList.add('hidden');
                        }
                    }
                });

                console.log('Visible cards:', visibleCount);

                // Show/hide empty state message
                let emptyStateMsg = document.getElementById('filter-empty-state');
                if (visibleCount === 0) {
                    if (!emptyStateMsg) {
                        emptyStateMsg = document.createElement('div');
                        emptyStateMsg.id = 'filter-empty-state';
                        emptyStateMsg.className = 'empty-state';
                        emptyStateMsg.style.marginTop = '2rem';

                        const statusNames = {
                            '1': 'Chờ xác nhận',
                            '2': 'Đã xác nhận',
                            '3': 'Đang vận chuyển',
                            '4': 'Đã giao',
                            '5': 'Đã hủy'
                        };

                        const statusName = selectedStatus === 'all' ? '' : statusNames[selectedStatus] || '';

                        emptyStateMsg.innerHTML = `
                            <div class="empty-icon">📦</div>
                            <h3>Không có đơn hàng</h3>
                            <p class="text-muted">Bạn chưa có đơn hàng nào ở trạng thái "${statusName}".</p>
                        `;

                        document.getElementById('orderList').appendChild(emptyStateMsg);
                    }
                } else {
                    if (emptyStateMsg) {
                        emptyStateMsg.remove();
                    }
                }
            });
        });
    };

    // ===== TAB NAVIGATION =====
    // Tab navigation logic has been moved to /js/profile.js for better maintainability
    // All tab loading, AJAX calls, and script execution are handled there

    // ===== HELPER FUNCTIONS =====

    /**
     * Highlight review card by product ID
     * Called from profile.js after reviews tab is loaded
     */
    window.highlightReviewByProductId = function (productId) {
        console.log('Highlighting review for product:', productId);

        const reviewCard = document.querySelector(
            `.my-review-card[data-product-id="${productId}"], .pending-review-card[data-product-id="${productId}"]`
        );

        if (!reviewCard) {
            console.warn('Review card not found for product:', productId);
            return;
        }

        console.log('Found review card for product:', productId);

        // Apply highlight styles
        reviewCard.style.border = '3px solid #f97316';
        reviewCard.style.boxShadow = '0 0 30px rgba(249, 115, 22, 0.5)';
        reviewCard.style.backgroundColor = '#fff5ec';
        reviewCard.style.transition = 'all 0.3s ease';

        // Scroll to card
        setTimeout(() => {
            reviewCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 300);

        // Blink animation
        let blinkCount = 0;
        const blinkInterval = setInterval(() => {
            reviewCard.style.backgroundColor = blinkCount % 2 === 0 ? '#fff5ec' : '#ffffff';
            blinkCount++;

            if (blinkCount >= 6) {
                clearInterval(blinkInterval);
                // Remove highlight after animation
                setTimeout(() => {
                    reviewCard.style.border = '2px solid #fed7aa';
                    reviewCard.style.boxShadow = '';
                    reviewCard.style.backgroundColor = 'white';
                }, 500);
            }
        }, 300);
    };
</script>