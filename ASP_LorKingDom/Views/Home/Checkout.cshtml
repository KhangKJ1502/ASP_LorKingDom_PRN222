@{
    ViewData["Title"] = "Thanh toán";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/checkout.css" asp-append-version="true" />
}

<div class="checkout-page">
    <div class="container">
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="checkout-breadcrumb mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/Home/Cart">Giỏ hàng</a></li>
                <li class="breadcrumb-item active" aria-current="page">Thanh toán</li>
            </ol>
        </nav>

        <div class="row g-4">
            <!-- Cột trái: Thông tin thanh toán -->
            <div class="col-lg-7">
                <div class="checkout-card">
                    <form id="checkoutForm" method="post" class="needs-validation" novalidate>
                        @Html.AntiForgeryToken()

                        <!-- SECTION: Thông tin người nhận -->
                        <h4 class="checkout-card-title">
                            <i class="fas fa-user me-2"></i>Thông tin người nhận
                        </h4>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label for="fullName" class="form-label">Họ và tên *</label>
                                <input type="text" class="form-control" id="fullName" name="fullName"
                                    placeholder="Nhập họ tên của bạn (VD: Nguyễn Văn A)"
                                    value="@(ViewBag.FullName ?? "")" required />
                                <div class="invalid-feedback">Vui lòng nhập tên.</div>
                            </div>
                            <div class="col-md-6">
                                <label for="email" class="form-label">Email *</label>
                                <input type="email" class="form-control" id="email" name="email"
                                    placeholder="your@email.com" value="@(ViewBag.Email ?? "")" required />
                                <div class="invalid-feedback">Vui lòng nhập email hợp lệ.</div>
                            </div>
                            <div class="col-md-6">
                                <label for="phone" class="form-label">Số điện thoại *</label>
                                <input type="tel" class="form-control" id="phone" name="phone" placeholder="0123456789"
                                    value="@(ViewBag.Phone ?? "")" required />
                                <div class="invalid-feedback">Vui lòng nhập số điện thoại.</div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- SECTION: Địa chỉ giao hàng -->
                        <h4 class="checkout-card-title">
                            <i class="fas fa-map-marker-alt me-2"></i>Địa chỉ giao hàng
                        </h4>
                        <p class="text-muted small mb-3">Chọn địa chỉ đã lưu hoặc nhập địa chỉ mới.</p>

                        <!-- Saved Addresses Container (Dynamic) -->
                        <div id="savedAddressesContainer" class="d-flex flex-column gap-2 mb-3">
                            <!-- Địa chỉ sẽ được load bằng AJAX -->
                            <div class="text-center py-3">
                                <div class="spinner-border spinner-border-sm text-primary" role="status">
                                    <span class="visually-hidden">Đang tải...</span>
                                </div>
                                <small class="text-muted ms-2">Đang tải địa chỉ...</small>
                            </div>
                        </div>

                        <!-- New Address Form -->
                        <div id="new-address-form" style="display: none;">
                            <div class="row g-3">
                                <div class="col-12">
                                    <label for="streetInput" class="form-label">Địa chỉ *</label>
                                    <input type="text" class="form-control" id="streetInput" name="street"
                                        placeholder="Số nhà, tên đường" />
                                </div>
                                <div class="col-md-6">
                                    <label for="cityInput" class="form-label">Tỉnh/Thành phố *</label>
                                    <input type="text" class="form-control" id="cityInput" name="city"
                                        placeholder="VD: Hồ Chí Minh, Hà Nội, Đà Nẵng..." />
                                </div>
                                <div class="col-md-6">
                                    <label for="districtInput" class="form-label">Quận/Huyện *</label>
                                    <input type="text" class="form-control" id="districtInput" name="district"
                                        placeholder="VD: Quận 1, Quận Hải Châu..." />
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- SECTION: Phương thức vận chuyển -->
                        <h4 class="checkout-card-title">
                            <i class="fas fa-truck me-2"></i>Phương thức vận chuyển
                        </h4>
                        <div class="d-flex flex-column gap-2 mb-4">
                            <div class="shipping-method-option">
                                <input class="form-check-input" type="radio" name="shippingMethod" id="shipping1"
                                    value="standard" checked />
                                <label class="form-check-label" for="shipping1">
                                    <strong>Giao hàng tiêu chuẩn (3-5 ngày)</strong>
                                </label>
                                <span class="badge badge-primary ms-auto">20.000 đ</span>
                            </div>

                            <div class="shipping-method-option">
                                <input class="form-check-input" type="radio" name="shippingMethod" id="shipping2"
                                    value="express" />
                                <label class="form-check-label" for="shipping2">
                                    <strong>Giao hàng nhanh (1-2 ngày)</strong>
                                    <div class="address-section-small">
                                        Giao hàng nhanh tại các thành phố lớn
                                    </div>
                                </label>
                                <span class="badge badge-primary ms-auto">40.000 ₫</span>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- SECTION: Phương thức thanh toán -->
                        <h4 class="checkout-card-title">
                            <i class="fas fa-credit-card me-2"></i>Phương thức thanh toán
                        </h4>
                        <div class="d-flex flex-column gap-2 mb-4">
                            <div class="payment-method-option">
                                <input class="form-check-input" type="radio" name="paymentMethod" id="payment4"
                                    value="cod" checked />
                                <label class="form-check-label" for="payment4">
                                    <i class="fas fa-money-bill me-2"></i>
                                    <strong>Thanh toán khi nhận hàng (COD)</strong>
                                </label>
                            </div>
                        </div>

                        <!-- Checkout Button -->
                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            <i class="fas fa-lock me-2"></i>Hoàn tất đơn hàng
                        </button>
                    </form>
                </div>
            </div>

            <!-- Cột phải: Tóm tắt đơn hàng -->
            <div class="col-lg-5">
                <div class="checkout-card order-summary-card">
                    <h4 class="checkout-card-title d-flex justify-content-between align-items-center">
                        <span>Tóm tắt đơn hàng</span>
                        <span class="badge bg-secondary">3 sản phẩm</span>
                    </h4>

                    <!-- Danh sách sản phẩm với scroll -->
                    <div class="order-summary-items">
                        @{
                            var cartItems = (List<BLL.DTOs.CartItemDto>?)ViewBag.CartItems ?? new
                            List<BLL.DTOs.CartItemDto>();
                        }
                        @if (cartItems.Any())
                        {
                            @foreach (var item in cartItems)
                            {
                                <div class="summary-item">
                                    <img src="@(item.MainImageUrl ?? "https://via.placeholder.com/60")" alt="@item.ProductName"
                                        class="order-summary-img" />
                                    <div class="summary-item-info">
                                        <div class="summary-item-name">@item.ProductName</div>
                                        <div class="summary-item-qty">SL: @item.Quantity × @((item.PriceAtThatTime > 0 ?
                                                                                item.PriceAtThatTime : item.CurrentPrice).ToString("N0")) ₫</div>
                                    </div>
                                    <div class="summary-item-price">@((item.Quantity * (item.PriceAtThatTime > 0 ?
                                                                        item.PriceAtThatTime : item.CurrentPrice)).ToString("N0")) ₫</div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-info">Giỏ hàng trống</div>
                        }
                    </div>

                    <!-- Mã giảm giá -->
                    <div class="promo-section">
                        <label for="promoCode" class="form-label">Mã giảm giá</label>
                        <div class="input-group">
                            <input type="text" class="form-control promo-input" id="promoCode" name="promoCode"
                                placeholder="Chọn ưu đãi" readonly />
                            <button class="btn btn-outline-primary" type="button" id="openVoucherModal"
                                style=" padding: 0.75rem 1.35rem;">
                                <i class="fas fa-ticket-alt me-1"></i>Ưu đãi
                            </button>
                            <button class="btn btn-outline-danger" type="button" id="clearVoucherBtn"
                                style="display: none; padding: 0.75rem 1rem;">
                                <i class="fas fa-times"></i>Hủy
                            </button>
                        </div>
                        <small class="text-muted" id="appliedVoucherText"></small>
                    </div>

                    <!-- Tính toán giá -->
                    <ul class="list-group list-group-flush mt-4">
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Tạm tính (@(ViewBag.CartItems?.Count ?? 0) sản phẩm)</span>
                            <strong id="subtotalDisplay">@((ViewBag.Subtotal ?? 0M).ToString("N0")) ₫</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Vận chuyển</span>
                            <strong class="text-success" id="shippingDisplay">20.000 ₫</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span>Giảm giá</span>
                            <strong class="text-danger">-0 ₫</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between"
                            style="background-color: rgba(245, 160, 120, 0.1); font-size: 1.125rem;">
                            <span>Tổng cộng</span>
                            <strong class="text-primary" id="totalDisplay">@(((ViewBag.Subtotal ?? 0M) +
                                                                20000).ToString("N0")) ₫</strong>
                        </li>
                    </ul>

                    <!-- Info -->
                    <div class="alert alert-info mt-3" role="alert">
                        <i class="fas fa-info-circle me-2"></i>
                        <small>
                            Đơn hàng của bạn sẽ được xử lý ngay sau khi thanh toán thành công!
                        </small>
                    </div>

                    <!-- Continue Shopping -->
                    <div class="text-center mt-3">
                        <a href="/" class="text-primary fw-medium text-decoration-none">
                            <i class="fas fa-arrow-left me-2"></i>Tiếp tục mua sắm
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Ưu đãi -->
<div class="modal fade" id="voucherModal" tabindex="-1" aria-labelledby="voucherModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="voucherModalLabel">
                    <i class="fas fa-ticket-alt me-2 text-primary"></i>Chọn ưu đãi
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="voucherListContainer">
                    <!-- Voucher list will be loaded here -->
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Đang tải...</span>
                        </div>
                        <p class="mt-2 text-muted">Đang tải danh sách ưu đãi...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const addressRadios = $('input[name="addressSelection"]');
            const newAddressForm = $('#new-address-form');
            const newAddressInputs = newAddressForm.find('input, select');
            const shippingRadios = $('input[name="shippingMethod"]');

            // Giá vận chuyển theo phương thức
            const shippingCosts = {
                standard: 20000,
                express: 40000
            };

            // Subtotal từ backend
            const subtotal = parseFloat($('#subtotalDisplay').text().replace(/[^0-9]/g, '')) || 0;

            // Biến lưu trữ discount
            let currentDiscount = 0;
            let appliedVoucherCode = '';

            // Dữ liệu địa chỉ đã lưu từ server
            let savedAddressesData = {};

            // Load địa chỉ đã lưu từ server
            function loadSavedAddresses() {
                $.ajax({
                    url: '@Url.Action("GetUserAddresses", "Home")',
                    type: 'GET',
                    success: function (result) {
                        if (result.success && result.addresses && result.addresses.length > 0) {
                            renderAddresses(result.addresses);
                        } else {
                            // Không có địa chỉ đã lưu - chỉ hiển thị option thêm mới
                            renderNoAddresses();
                        }
                    },
                    error: function () {
                        console.error('Failed to load addresses');
                        renderNoAddresses();
                    }
                });
            }

            // Render danh sách địa chỉ
            function renderAddresses(addresses) {
                let html = '';

                // Render saved addresses
                addresses.forEach(function (addr, index) {
                    savedAddressesData['addr_' + addr.id] = {
                        street: addr.addressLine || '',
                        city: addr.city || '',
                        district: addr.ward || ''
                    };

                    const isChecked = addr.isDefault || index === 0;
                    const label = addr.isDefault ? 'Địa chỉ mặc định' : 'Địa chỉ ' + (index + 1);

                    html += `
                                    <div class="saved-address-option">
                                        <input class="form-check-input" type="radio" name="addressSelection" 
                                               id="addr_${addr.id}" value="addr_${addr.id}" ${isChecked ? 'checked' : ''} />
                                        <label class="form-check-label" for="addr_${addr.id}">
                                            <strong>${label}</strong>
                                            <div class="address-section-small">
                                                ${addr.fullAddress}
                                            </div>
                                        </label>
                                    </div>
                                `;
                });

                // Add "Thêm địa chỉ mới" option
                html += `
                                <div class="saved-address-option">
                                    <input class="form-check-input" type="radio" name="addressSelection" 
                                           id="addrNew" value="new" />
                                    <label class="form-check-label" for="addrNew">
                                        <i class="fas fa-plus me-2 text-primary"></i>
                                        <strong>Thêm địa chỉ mới</strong>
                                    </label>
                                </div>
                            `;

                $('#savedAddressesContainer').html(html);

                // Re-bind event handlers
                $('input[name="addressSelection"]').on('change', updateAddressForm);
                updateAddressForm(); // Initialize
            }            // Render when no addresses found
            function renderNoAddresses() {
                const html = `
                                    <div class="saved-address-option">
                                        <input class="form-check-input" type="radio" name="addressSelection" 
                                               id="addrNew" value="new" checked />
                                        <label class="form-check-label" for="addrNew">
                                            <i class="fas fa-plus me-2 text-primary"></i>
                                            <strong>Thêm địa chỉ mới</strong>
                                        </label>
                                    </div>
                                `;

                $('#savedAddressesContainer').html(html);

                // Show new address form immediately
                newAddressForm.show();
                newAddressInputs.prop('required', true);

                // Re-bind event handlers
                $('input[name="addressSelection"]').on('change', updateAddressForm);
            }

            // Update tổng tiền
            function updateTotal() {
                const shippingMethod = $('input[name="shippingMethod"]:checked').val();
                const shippingCost = shippingCosts[shippingMethod] || 0;
                const total = Math.max(subtotal + shippingCost - currentDiscount, 0);

                $('#shippingDisplay').text((shippingCost).toLocaleString('vi-VN') + ' ₫');
                $('#totalDisplay').text((total).toLocaleString('vi-VN') + ' ₫');
            }

            // Lắng nghe thay đổi phương thức vận chuyển
            shippingRadios.on('change', updateTotal);

            // Toggle form nhập địa chỉ mới
            function updateAddressForm() {
                const selected = $('input[name="addressSelection"]:checked').val();

                if (selected === 'new') {
                    // Chọn "Thêm địa chỉ mới" → hiển thị form nhập
                    newAddressForm.show();
                    newAddressInputs.prop('required', true);
                    // Clear values when switching to new address
                    $('#streetInput').val('');
                    $('#cityInput').val('');
                    $('#districtInput').val('');
                } else {
                    // Chọn địa chỉ đã lưu → ẩn form, bỏ required, fill data
                    newAddressForm.hide();
                    newAddressInputs.prop('required', false);

                    // Fill inputs with saved address data (even though hidden, they will be submitted)
                    const addr = savedAddressesData[selected];
                    if (addr) {
                        $('#streetInput').val(addr.street);
                        $('#cityInput').val(addr.city);
                        $('#districtInput').val(addr.district);
                        console.log('Filled address:', addr); // Debug
                    } else {
                        console.error('Address not found for:', selected); // Debug
                    }
                }
            }

            // Validation (Bootstrap style)
            $('.needs-validation').on('submit', function (event) {
                if (!this.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                $(this).addClass('was-validated');
            });

            // Initialize on page load
            loadSavedAddresses();
            updateTotal(); // Tính lại tổng tiền khi load trang

            // 🎯 Mở modal ưu đãi
            $('#openVoucherModal').on('click', function () {
                const voucherModal = new bootstrap.Modal(document.getElementById('voucherModal'));
                voucherModal.show();
                loadVouchers();
            });

            // Tải danh sách voucher
            function loadVouchers() {
                $('#voucherListContainer').html(`
                                        <div class="text-center py-4">
                                            <div class="spinner-border text-primary" role="status">
                                                <span class="visually-hidden">Đang tải...</span>
                                            </div>
                                            <p class="mt-2 text-muted">Đang tải danh sách ưu đãi...</p>
                                        </div>
                                    `);

                $.ajax({
                    url: '@Url.Action("GetActiveVouchers", "Voucher")',
                    type: 'GET',
                    data: { orderAmount: subtotal },
                    success: function (result) {
                        if (result.success && result.vouchers.length > 0) {
                            renderVouchers(result.vouchers);
                        } else {
                            $('#voucherListContainer').html(`
                                                    <div class="text-center py-5">
                                                        <i class="fas fa-ticket-alt fa-3x text-muted mb-3"></i>
                                                        <p class="text-muted">Không có ưu đãi nào khả dụng</p>
                                                    </div>
                                                `);
                        }
                    },
                    error: function () {
                        $('#voucherListContainer').html(`
                                                <div class="alert alert-danger">
                                                    <i class="fas fa-exclamation-circle me-2"></i>
                                                    Không thể tải danh sách ưu đãi. Vui lòng thử lại.
                                                </div>
                                            `);
                    }
                });
            }

            // Render danh sách voucher
            function renderVouchers(vouchers) {
                let html = '<div class="voucher-list">';

                vouchers.forEach(function (voucher) {
                    const isEligible = voucher.isEligible;
                    const isSelected = appliedVoucherCode === voucher.voucherCode;
                    const cardClass = isEligible ? (isSelected ? 'voucher-card selected' : 'voucher-card') : 'voucher-card disabled';

                    const voucherTypeName = voucher.voucherTypeName.toLowerCase();
                    const isPercentage = voucherTypeName.includes('percent') || voucherTypeName.includes('%');

                    let discountText = '';
                    if (isPercentage) {
                        discountText = `Giảm ${voucher.discountValue}%`;
                        if (voucher.maxDiscountAmount) {
                            discountText += `<br><small>Tối đa ${voucher.maxDiscountAmount.toLocaleString('vi-VN')} ₫</small>`;
                        }
                    } else {
                        discountText = `Giảm ${voucher.discountValue.toLocaleString('vi-VN')} ₫`;
                    }

                    const minOrderText = voucher.minOrderAmount
                        ? `Đơn tối thiểu ${voucher.minOrderAmount.toLocaleString('vi-VN')} ₫`
                        : 'Không giới hạn';

                    const endDate = new Date(voucher.endDate);
                    const endDateText = `HSD: ${endDate.toLocaleDateString('vi-VN')}`;

                    html += `
                                            <div class="${cardClass}" data-voucher-code="${voucher.voucherCode}" data-discount="${voucher.discountAmount}">                          
                                                <div class="voucher-card-right">
                                                    <div class="voucher-code-badge">${voucher.voucherCode}</div>
                                                    <div class="voucher-discount">
                                                        ${discountText}
                                                    </div>
                                                    <div class="voucher-details">
                                                        <div><i class="fas fa-shopping-cart me-1"></i>${minOrderText}</div>
                                                        <div><i class="far fa-clock me-1"></i>${endDateText}</div>
                                                    </div>
                                                    ${!isEligible ? `<div class="voucher-ineligible-reason"><i class="fas fa-info-circle me-1"></i>${voucher.ineligibleReason}</div>` : ''}                
                                                </div>
                                                <div class="voucher-card-left">
                                                    ${isEligible ? `
                                                        <button class="btn btn-sm btn-apply-voucher ${isSelected ? 'btn-success' : 'btn-primary'}"
                                                                data-voucher-code="${voucher.voucherCode}"
                                                                data-discount="${voucher.discountAmount}">
                                                            ${isSelected ? '<i class="fas fa-check me-1"></i>Đã áp dụng' : '<i class="fas fa-plus me-1"></i>Áp dụng'}
                                                        </button>
                                                    ` : ''}                              
                                                </div>
                                            </div>
                                        `;
                });

                html += '</div>';
                $('#voucherListContainer').html(html);

                // Xử lý sự kiện click áp dụng voucher
                $('.btn-apply-voucher').on('click', function () {
                    const voucherCode = $(this).data('voucher-code');
                    const discount = $(this).data('discount');
                    applyVoucher(voucherCode, discount);
                });
            }

            // Áp dụng voucher
            function applyVoucher(voucherCode, discount) {
                currentDiscount = discount;
                appliedVoucherCode = voucherCode;

                // Cập nhật UI
                $('#promoCode').val(voucherCode);
                $('#appliedVoucherText').html(`<i class="fas fa-check-circle text-success me-1"></i>Đã áp dụng voucher ${voucherCode}`);
                $('.list-group-item:contains("Giảm giá") strong').text('-' + currentDiscount.toLocaleString('vi-VN') + ' ₫');
                updateTotal();

                // Hiển thị nút hủy
                $('#clearVoucherBtn').show();

                // Cập nhật trạng thái các nút trong modal
                $('.btn-apply-voucher').removeClass('btn-success').addClass('btn-primary')
                    .html('<i class="fas fa-plus me-1"></i>Áp dụng');
                $('.voucher-card').removeClass('selected');

                $(`.btn-apply-voucher[data-voucher-code="${voucherCode}"]`)
                    .removeClass('btn-primary').addClass('btn-success')
                    .html('<i class="fas fa-check me-1"></i>Đã áp dụng');
                $(`.voucher-card[data-voucher-code="${voucherCode}"]`).addClass('selected');

                // Đóng modal và thông báo
                bootstrap.Modal.getInstance(document.getElementById('voucherModal')).hide();

                Swal.fire({
                    icon: 'success',
                    title: 'Thành công!',
                    html: `<p>Đã áp dụng voucher <strong>${voucherCode}</strong></p><p class="fw-bold text-success">Giảm giá: ${currentDiscount.toLocaleString('vi-VN')} ₫</p>`,
                    confirmButtonColor: '#e67e4b',
                    timer: 2000
                });
            }

            // Hủy ưu đãi
            $('#clearVoucherBtn').on('click', function (e) {
                e.preventDefault();

                currentDiscount = 0;
                appliedVoucherCode = '';

                // Cập nhật UI
                $('#promoCode').val('');
                $('#appliedVoucherText').html('');
                $('.list-group-item:contains("Giảm giá") strong').text('-0 ₫');
                updateTotal();

                // Ẩn nút hủy
                $('#clearVoucherBtn').hide();

                // Cập nhật trạng thái các nút trong modal
                $('.btn-apply-voucher').removeClass('btn-success').addClass('btn-primary')
                    .html('<i class="fas fa-plus me-1"></i>Áp dụng');
                $('.voucher-card').removeClass('selected');

                Swal.fire({
                    icon: 'info',
                    title: 'Đã hủy',
                    text: 'Ưu đãi đã được hủy',
                    confirmButtonColor: '#e67e4b',
                    timer: 1500
                });
            });

            // 🎯 Nút áp dụng mã khuyến mãi (giữ lại để backward compatible, nhưng đã thay bằng modal)
            // Đã được thay thế bằng modal, code này không còn được sử dụng

            // Submit form checkout bằng AJAX
            $('#checkoutForm').on('submit', function (e) {
                e.preventDefault();

                const form = $(this);
                if (!this.checkValidity()) {
                    form.addClass('was-validated');
                    return;
                }

                // Hiện loading
                Swal.fire({
                    title: 'Đang xử lý đơn hàng...',
                    didOpen: () => Swal.showLoading(),
                    allowOutsideClick: false,
                    showConfirmButton: false
                });

                // Lấy giá trị địa chỉ (quan trọng: lấy trực tiếp từ input, không dùng serialize)
                const streetValue = $('#streetInput').val() || '';
                const cityValue = $('#cityInput').val() || '';
                const districtValue = $('#districtInput').val() || '';

                // Debug: Log address values
                console.log('Address values:', {
                    street: streetValue,
                    city: cityValue,
                    district: districtValue
                });

                // Build form data object manually to ensure address fields are included
                const formDataObj = {
                    fullName: $('#fullName').val(),
                    email: $('#email').val(),
                    phone: $('#phone').val(),
                    street: streetValue,
                    city: cityValue,
                    district: districtValue,
                    shippingMethod: $('input[name="shippingMethod"]:checked').val(),
                    paymentMethod: $('input[name="paymentMethod"]:checked').val()
                };

                // Thêm voucher code nếu đã áp dụng
                if (appliedVoucherCode) {
                    formDataObj.promoCode = appliedVoucherCode;
                }

                console.log('Sending data:', formDataObj);

                $.ajax({
                    url: '/Order/Create',
                    type: 'POST',
                    data: formDataObj,
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (result) {
                        Swal.close();

                        if (result.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công!',
                                text: result.message,
                                confirmButtonColor: '#e67e4b',
                                allowOutsideClick: false
                            }).then(() => {
                                window.location.href = '/';
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Lỗi',
                                text: result.message,
                                confirmButtonColor: '#e67e4b'
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('Checkout AJAX error:', error);
                        Swal.close();
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi',
                            text: 'Không thể hoàn tất đơn hàng. Vui lòng thử lại.',
                            confirmButtonColor: '#e67e4b'
                        });
                    }
                });
            });
        });
    </script>
}