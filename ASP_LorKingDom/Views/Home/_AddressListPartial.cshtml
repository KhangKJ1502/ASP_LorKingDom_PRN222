@model List<BLL.DTOs.AddressDto>

<div id="addr-list-wrap">
	@if (!(Model?.Any() ?? false))
	{
		<div class="p-6 text-gray-500 border-2 border-dashed rounded-xl text-center">
			No address yet. Click “Add New Address”.
		</div>
	}
	else
	{
		foreach (var a in Model!)
		{
			<div class="p-4 rounded-xl bg-orange-50/50 border-2 border-orange-200 mb-4 shadow-sm">
				<div class="flex justify-between items-start mb-2">
					<div class="flex items-center gap-2">
						@if (a.IsDefault)
						{
							<span class="bg-gradient-warm text-white px-3 py-1 rounded-full text-sm">Default</span>
						}
						<span class="text-sm text-gray-500">#@a.Id</span>
					</div>

					<div class="flex items-center gap-2">
						@if (!a.IsDefault)
						{
							<button type="button" class="addr-btn-setdefault border px-2 py-1 rounded-lg hover:bg-orange-100 text-sm" data-id="@a.Id">
								Set default
							</button>
						}

						<!-- ✏️ Edit (btn-warning style) -->
						<button type="button"
								class="addr-btn-edit btn btn-sm btn-warning"
								data-id="@a.Id"
								title="Edit">
							<i class="fa-solid fa-pen-to-square"></i>
						</button>

						<!-- 🗑️ Delete (btn-danger style) -->
						<button type="button"
								class="addr-btn-delete btn btn-sm btn-danger"
								data-id="@a.Id"
								title="Delete">
							<i class="fa-solid fa-trash"></i>
						</button>
					</div>
				</div>

				<h4 class="font-semibold">Home Address</h4>
				<p class="text-gray-600">@a.AddressLine</p>
				<p class="text-gray-600">@a.City@(string.IsNullOrWhiteSpace(a.Ward) ? "" : $", {a.Ward}")</p>
			</div>
		}
	}

	<button type="button"
			class="addr-btn-add w-full border-2 border-orange-200 hover:bg-orange-50 bg-transparent py-3 rounded-xl transition-all font-medium text-orange-700">
		<i class="fa-solid fa-plus mr-2"></i> Add New Address
	</button>
</div>
