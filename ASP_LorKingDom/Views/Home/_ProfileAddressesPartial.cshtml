@{
    Layout = null;
}
<form id="__afForm" class="hidden">
    @Html.AntiForgeryToken()
</form>

<div class="border-2 border-orange-100 rounded-xl bg-white shadow-sm">
    <div class="p-6 flex items-center justify-between">
        <div>
            <h3 class="text-gradient text-xl font-bold">My Addresses</h3>
            <p class="text-gray-500 text-sm">Manage your shipping addresses</p>
        </div>
        <button data-action="open-add"
                class="px-4 py-2 rounded-xl bg-gradient-to-r from-orange-500 to-orange-400 text-white hover:opacity-90 transition">
            + Add Address
        </button>
    </div>

    <div id="addr-grid" class="p-6 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- items render bằng JS -->
    </div>
</div>

<!-- Modal Add/Edit -->
<div id="addr-modal" class="fixed inset-0 hidden/ modal flex items-center justify-center">
    <div class="absolute inset-0 bg-black/40" data-action="close-modal"></div>
    <div class="relative bg-white rounded-2xl p-6 w-[520px] shadow-xl">
        <h4 id="addr-modal-title" class="text-lg font-bold mb-4">Add Address</h4>
        <input type="hidden" id="addr-id" value="0" />
        <div class="space-y-3">
            <div>
                <label class="text-sm text-gray-600">Address Line</label>
                <input id="addr-line" class="w-full border rounded-lg px-3 py-2" />
            </div>
            <div>
                <label class="text-sm text-gray-600">City</label>
                <input id="addr-city" class="w-full border rounded-lg px-3 py-2" />
            </div>
            <div>
                <label class="text-sm text-gray-600">Ward (optional)</label>
                <input id="addr-ward" class="w-full border rounded-lg px-3 py-2" />
            </div>
            <label class="inline-flex items-center gap-2">
                <input id="addr-default" type="checkbox" class="h-4 w-4">
                <span>Set as default</span>
            </label>
        </div>
        <div class="mt-5 flex justify-end gap-2">
            <button class="px-4 py-2 rounded-lg border" data-action="close-modal">Cancel</button>
            <button class="px-4 py-2 rounded-lg bg-orange-500 text-white" data-action="save-addr">Save</button>
        </div>
    </div>
</div>

<!-- Modal Confirm Delete -->
<div id="addr-confirm" class="fixed inset-0 hidden/ modal flex items-center justify-center">
    <div class="absolute inset-0 bg-black/40" data-action="close-confirm"></div>
    <div class="relative bg-white rounded-2xl p-6 w-[420px] shadow-xl">
        <h4 class="text-lg font-bold mb-2">Delete address?</h4>
        <p class="text-gray-600 mb-4">This action cannot be undone.</p>
        <input type="hidden" id="addr-del-id" value="0" />
        <div class="mt-2 flex justify-end gap-2">
            <button class="px-4 py-2 rounded-lg border" data-action="close-confirm">Cancel</button>
            <button class="px-4 py-2 rounded-lg bg-red-600 text-white" data-action="confirm-delete">Delete</button>
        </div>
    </div>
</div>

<script>
    (() => {
      const api = {
        list: "/addresses/list",
        create: "/addresses/create",
        update: "/addresses/update",
        del: "/addresses/delete",
        setDefault: "/addresses/set-default"
      };

      const qs = (s, el = document) => el.querySelector(s);
      const af = () => {
        const f = qs("#__afForm");
        if (!f) return {};
        const token = f.querySelector('input[name="__RequestVerificationToken"]')?.value;
        return token ? { "RequestVerificationToken": token } : {};
      };

      async function fetchJson(url, options = {}) {
        const opt = Object.assign({ method: "GET" }, options);
        opt.headers = Object.assign(
          { "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8" },
          af(), opt.headers || {}
        );
        const res = await fetch(url, opt);
        if (!res.ok) throw new Error(await res.text());
        return res.json();
      }

      const show = el => el.classList.remove("hidden/");
      const hide = el => el.classList.add("hidden/");

      const grid = () => qs("#addr-grid");
      const modal = () => qs("#addr-modal");
      const confirmM = () => qs("#addr-confirm");

      function itemCard(a) {
        const badge = a.isDefault
          ? `<span class="text-xs bg-orange-100 text-orange-700 px-2 py-0.5 rounded-full">Default</span>`
          : `<button class="text-xs px-2 py-0.5 rounded-full border" data-action="make-default" data-id="${a.addressId}">Make default</button>`;
        return `
          <div class="border rounded-xl p-4 flex flex-col gap-3">
            <div class="flex items-start justify-between">
              <div class="font-semibold">${a.addressLine}</div>
              <div class="flex items-center gap-2">
                ${badge}
                <button class="p-2 rounded-lg hover:bg-orange-50" title="Edit" data-action="edit" data-id="${a.addressId}">✏️</button>
                <button class="p-2 rounded-lg hover:bg-red-50" title="Delete" data-action="delete" data-id="${a.addressId}">🗑️</button>
              </div>
            </div>
            <div class="text-sm text-gray-600">${a.ward ? a.ward + ", " : ""}${a.city}</div>
            <div class="text-xs text-gray-400">Added: ${new Date(a.createdAt).toLocaleString()}</div>
          </div>`;
      }

      async function loadList() {
        const data = await fetchJson(api.list);
        grid().innerHTML = data.map(itemCard).join("");
      }

      function openAdd() {
        qs("#addr-modal-title").textContent = "Add Address";
        qs("#addr-id").value = "0";
        qs("#addr-line").value = "";
        qs("#addr-city").value = "";
        qs("#addr-ward").value = "";
        qs("#addr-default").checked = false;
        show(modal());
      }

      async function openEdit(id) {
        const card = qs(`[data-action="edit"][data-id="${id}"]`).closest(".border");
        qs("#addr-modal-title").textContent = "Edit Address";
        qs("#addr-id").value = id;

        const line = card.querySelector(".font-semibold").textContent.trim();
        const cityWard = card.querySelector(".text-sm").textContent.trim();
        const parts = cityWard.split(",").map(s => s.trim());
        qs("#addr-line").value = line;
        if (parts.length === 2) { qs("#addr-ward").value = parts[0]; qs("#addr-city").value = parts[1]; }
        else { qs("#addr-ward").value = ""; qs("#addr-city").value = parts[0] || ""; }

        qs("#addr-default").checked = !!card.querySelector(".bg-orange-100");
        show(modal());
      }

      function closeModal() { hide(modal()); }
      function openConfirm(id) { qs("#addr-del-id").value = id; show(confirmM()); }
      function closeConfirm() { hide(confirmM()); }

      async function saveAddr() {
        const id = parseInt(qs("#addr-id").value || "0", 10);
        const payload = new URLSearchParams({
          id: id.toString(),
          addressLine: qs("#addr-line").value.trim(),
          city: qs("#addr-city").value.trim(),
          ward: qs("#addr-ward").value.trim(),
          isDefault: qs("#addr-default").checked ? "true" : "false"
        });

        if (!payload.get("addressLine") || !payload.get("city")) {
          alert("Address Line và City là bắt buộc.");
          return;
        }

        if (id === 0)
          await fetchJson(api.create, { method: "POST", body: payload });
        else
          await fetchJson(api.update, { method: "POST", body: payload });

        closeModal();
        await loadList();
      }

      async function doDelete() {
        const id = parseInt(qs("#addr-del-id").value || "0", 10);
        const payload = new URLSearchParams({ id: id.toString() });
        await fetchJson(api.del, { method: "POST", body: payload });
        closeConfirm();
        await loadList();
      }

      async function makeDefault(id) {
        const payload = new URLSearchParams({ id: id.toString() });
        await fetchJson(api.setDefault, { method: "POST", body: payload });
        await loadList();
      }

      document.addEventListener("click", (e) => {
        const btn = e.target.closest("[data-action]");
        if (!btn) return;
        const action = btn.getAttribute("data-action");

        if (action === "open-add") { e.preventDefault(); openAdd(); }
        else if (action === "close-modal") { e.preventDefault(); closeModal(); }
        else if (action === "save-addr") { e.preventDefault(); saveAddr(); }
        else if (action === "edit") { e.preventDefault(); openEdit(parseInt(btn.dataset.id, 10)); }
        else if (action === "delete") { e.preventDefault(); openConfirm(parseInt(btn.dataset.id, 10)); }
        else if (action === "close-confirm") { e.preventDefault(); closeConfirm(); }
        else if (action === "confirm-delete") { e.preventDefault(); doDelete(); }
        else if (action === "make-default") { e.preventDefault(); makeDefault(parseInt(btn.dataset.id, 10)); }
      });

      // Gọi load khi partial được render
      document.addEventListener("DOMContentLoaded", () => {
        if (grid()) loadList().catch(console.error);
      });
    })();
</script>

