@{
	ViewData["Title"] = "Liên Hệ - LorKingDom";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/contact.css" asp-append-version="true" />

<!-- Hero Section -->
<section class="hero-section">
	<div class="container">
		<div class="hero-grid">
			<div class="hero-content-contact">
				<h1 class="hero-title" style="color: black !important;">
					Chào mừng đến với <span class="text-gradient">LorKingDom</span>
				</h1>
				<p class="hero-subtitle">
					Nơi mỗi món đồ chơi là một câu chuyện, mỗi nụ cười là một kỷ niệm
				</p>
				<div class="hero-badges">
					<div class="badge"><p>🎯 Chất lượng cao</p></div>
					<div class="badge"><p>💚 An toàn cho bé</p></div>
					<div class="badge"><p>✨ Phát triển sáng tạo</p></div>
				</div>
			</div>

			<div class="hero-image-wrapper">
				<div class="hero-media">
					<img src="~/Assets/image/contact/happy-children-playing-with-colorful-educational-t.jpg"
						 alt="Happy children playing with colorful educational toys"
						 class="hero-img"
						 asp-append-version="true" />
				</div>
				<div class="hero-blob hero-blob-1"></div>
				<div class="hero-blob hero-blob-2"></div>
			</div>

		</div>
	</div>
</section>

<!-- Brand Story Section -->
<section class="brand-story-section">
	<div class="container">
		<div class="section-wrapper">
			<div class="section-header">
				<h2 class="section-title">Câu Chuyện Của Chúng Tôi</h2>
				<p class="section-subtitle">Hành trình mang niềm vui đến với mọi gia đình</p>
			</div>

			<div class="story-grid">
				<div class="story-content">
					<div class="story-card">
						<div class="story-icon"><span>🌟</span></div>
						<h3 class="story-card-title">Khởi Đầu (2015)</h3>
						<p class="story-card-text">
							LorKingDom được thành lập với niềm đam mê mang đến những món đồ chơi chất lượng cao, an toàn và giáo dục cho trẻ em Việt Nam.
						</p>
					</div>

					<div class="story-card">
						<div class="story-icon"><span>🚀</span></div>
						<h3 class="story-card-title">Phát Triển (2018–2020)</h3>
						<p class="story-card-text">
							Mở rộng hệ thống cửa hàng và nền tảng trực tuyến, mang đến trải nghiệm mua sắm tiện lợi.
						</p>
					</div>

					<div class="story-card">
						<div class="story-icon"><span>💝</span></div>
						<h3 class="story-card-title">Hôm Nay (2025)</h3>
						<p class="story-card-text">
							Đối tác tin cậy của hơn 100,000 gia đình, với 5,000+ sản phẩm từ các thương hiệu uy tín.
						</p>
					</div>
				</div>

				<div class="story-images">
					<div class="story-image-sticky">
						<div class="story-image">
							<img src="~/Assets/image/contact/children-laughing-and-playing-together-with-educat.jpg"
								 alt="Trẻ em vui chơi cùng nhau"
								 asp-append-version="true" />
						</div>
						<div class="story-image story-image-small">
							<img src="~/Assets/image/contact/colorful-educational-toys--building-blocks--puzzle.jpg"
								 alt="Đồ chơi giáo dục đa dạng"
								 asp-append-version="true" />
						</div>
					</div>
				</div>

			</div>
		</div>
	</div>
</section>

<!-- Mission & Values -->
<section class="brand-mission-section">
	<div class="container">
		<div class="section-wrapper">
			<div class="section-header">
				<h2 class="section-title">Sứ Mệnh & Giá Trị</h2>
				<p class="section-subtitle">Những điều chúng tôi tin tưởng và theo đuổi</p>
			</div>

			<div class="mission-highlight">
				<div class="mission-grid">
					<div class="mission-content">
						<h3 class="mission-title">Sứ Mệnh Của Chúng Tôi</h3>
						<p class="mission-text">
							Mang đến cho trẻ những món đồ chơi giúp phát triển thể chất, trí tuệ và cảm xúc.
						</p>
						<div class="mission-tags">
							<span class="mission-tag">Chất lượng hàng đầu</span>
							<span class="mission-tag">An toàn tuyệt đối</span>
							<span class="mission-tag">Giá trị giáo dục</span>
						</div>
					</div>
					<div class="mission-image">
						<img src="~/Assets/image/contact/happy-child-playing-with-wooden-educational-toys--.jpg"
							 alt="Trẻ em học tập qua chơi"
							 asp-append-version="true" />
					</div>
				</div>
			</div>

			<div class="values-grid">
				<div class="value-card">
					<div class="value-icon">🎨</div>
					<h4 class="value-title">Sáng Tạo</h4>
					<p class="value-text">Khuyến khích tư duy sáng tạo và trí tưởng tượng.</p>
				</div>
				<div class="value-card">
					<div class="value-icon">🛡️</div>
					<h4 class="value-title">An Toàn</h4>
					<p class="value-text">Đạt chuẩn an toàn quốc tế cho trẻ em.</p>
				</div>
				<div class="value-card">
					<div class="value-icon">📚</div>
					<h4 class="value-title">Giáo Dục</h4>
					<p class="value-text">Mỗi món đồ chơi đều có giá trị học tập.</p>
				</div>
				<div class="value-card">
					<div class="value-icon">💚</div>
					<h4 class="value-title">Trách Nhiệm</h4>
					<p class="value-text">Cam kết với môi trường và cộng đồng.</p>
				</div>
			</div>
		</div>
	</div>
</section>

<!-- Contact -->
<section class="contact-section">
	<div class="container">
		<div class="contact-grid">
			<div class="contact-info">
				<div class="contact-info-header">
					<h2 class="contact-title">Liên Hệ Với Chúng Tôi</h2>
					<p class="contact-subtitle">Chúng tôi luôn sẵn sàng hỗ trợ bạn.</p>
				</div>

				<div class="contact-info-list">
					<div class="contact-info-item">
						<div class="contact-info-icon">📍</div>
						<div class="contact-info-content">
							<h3 class="contact-info-title">Địa Chỉ</h3>
							<p class="contact-info-text">123 Nguyễn Huệ, Q.1, TP.HCM</p>
						</div>
					</div>

					<div class="contact-info-item">
						<div class="contact-info-icon">📞</div>
						<div class="contact-info-content">
							<h3 class="contact-info-title">Điện Thoại</h3>
							<p class="contact-info-text">Hotline: 1900 1234 – 0901 234 567</p>
						</div>
					</div>

					<div class="contact-info-item">
						<div class="contact-info-icon">✉️</div>
						<div class="contact-info-content">
							<h3 class="contact-info-title">Email</h3>
							<p class="contact-info-text">support@lorkingdom.vn</p>
						</div>
					</div>

					<div class="contact-info-item">
						<div class="contact-info-icon">⏰</div>
						<div class="contact-info-content">
							<h3 class="contact-info-title">Giờ Làm Việc</h3>
							<p class="contact-info-text">T2–T6: 8:00–20:00 | T7–CN: 9:00–21:00</p>
						</div>
					</div>
				</div>
			</div>

			<div class="contact-form-wrapper media-full">
				<img src="~/Assets/image/contact/colorful-toys-and-children-playing.jpg"
					 alt="Trẻ em học tập qua chơi" asp-append-version="true" />
			</div>
		</div>
	</div>
</section>

@section Scripts {
	<script src="~/js/contact.js" asp-append-version="true"></script>
}
