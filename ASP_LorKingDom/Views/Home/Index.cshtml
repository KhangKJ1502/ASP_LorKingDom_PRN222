<section class="products-section">
	<div class="container">
		<div class="section-header">
			<h2 class="section-title">Featured Products</h2>
			<p class="section-subtitle">Handpicked toys loved by children</p>
		</div>

		@if (Model != null && Model.Any())
		{
			@foreach (var row in Model.Chunk(4))
			{
				<div class="product-row d-grid" style="grid-template-columns: repeat(4, minmax(0,1fr)); gap:24px; margin-bottom:24px;">
					@foreach (var p in row)
					{
						<div class="product-card">
							<div class="product-image">
								<img src="@(string.IsNullOrWhiteSpace(p.MainImageUrl) ? Url.Content("~/images/placeholder.png") : p.MainImageUrl)"
									 alt="@p.ProductName" loading="lazy" />
								<button class="product-wishlist" aria-label="Add to wishlist" type="button">
									<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
										<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78
                                                 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
									</svg>
								</button>

								@* Badge nếu muốn hiển thị sản phẩm hot/new/sale *@
								@if (p.Price < 50)
								{
									<span class="product-badge badge-hot">Hot</span>
								}
								else if (p.Price > 200)
								{
									<span class="product-badge badge-sale">-30%</span>
								}
							</div>

							<div class="product-info">
								<h3 class="product-name" title="@p.ProductName">@p.ProductName</h3>

								@* ⭐⭐ Hiển thị sao đánh giá giả lập (4-5 sao ngẫu nhiên) *@
								<div class="product-rating">
									@{
										int stars = new Random().Next(4, 6); // 4 hoặc 5 sao
									}
									<div class="stars">
										@for (int i = 0; i < stars; i++)
										{
											<span>★</span>
										}
										@for (int i = stars; i < 5; i++)
										{
											<span>☆</span>
										}
									</div>
									<span>(@(new Random().Next(50, 500)))</span>
								</div>

								@* 💰 Hiển thị giá *@
								<div class="product-price">
									<span class="price-current">@p.Price.ToString("C")</span>
									@if (p.Price > 100)
									{
										<span class="price-original">@((p.Price * 1.2m).ToString("C"))</span>
									}
								</div>

								@* 🛒 Nút Add to Cart *@
								<form method="post" asp-action="AddToCart" asp-controller="Cart" asp-route-id="@p.Id">
									<button type="submit" class="btn btn-primary btn-block">
										Add to Cart
									</button>
								</form>
							</div>
						</div>
					}
				</div>
			}
		}
		else
		{
			<div class="alert alert-info">No products available.</div>
		}
	</div>
</section>


<!-- Newsletter Section -->
<section class="newsletter-section">
	<div class="container">
		<div class="newsletter-content">
			<div class="newsletter-icon">
				<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
					<polyline points="22,6 12,13 2,6"></polyline>
				</svg>
			</div>
			<div class="newsletter-text">
				<h2 class="newsletter-title">Subscribe to Our Newsletter</h2>
				<p class="newsletter-subtitle">Get the latest updates on new products and special offers</p>
			</div>
			<div class="newsletter-form">
				<input type="email" class="form-control" placeholder="Enter your email">
				<button class="btn btn-primary">Subscribe</button>
			</div>
		</div>
	</div>
</section>

@section Scripts {
	<script src="~/js/home.js"></script>
}
