</section>


<!-- Promotion Banner -->
<section class="promotion-section">
	<div class="container">
		<div class="promotion-banner">
			<div class="promotion-content">
				<span class="promotion-badge">SPECIAL OFFER</span>
				<h2 class="promotion-title">Summer Sale - Up to 50% OFF</h2>
				<p class="promotion-text">Limited time offer on selected toys</p>
				<button class="btn btn-light btn-lg">Shop Now</button>
			</div>
			<div class="promotion-image">
				<img src="~/images/promotion/summer-sale.jpg" alt="Summer Sale">
			</div>
		</div>
	</div>
</section>

