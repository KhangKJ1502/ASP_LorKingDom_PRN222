<!-- Hero Section -->
<section class="hero-section">
	<div class="hero-banner">
		<div class="hero-overlay"></div>
		<img src="~/images/hero/colorful-toys-and-children-playing.jpg" alt="Discover Amazing Toys World" class="hero-image active" id="heroImage1">
		<img src="~/images/hero/educational-toys-and-learning-games.jpg" alt="Smart Educational Toys" class="hero-image" id="heroImage2">
		<img src="~/images/hero/famous-toy-brands-display.jpg" alt="Trusted Global Brands" class="hero-image" id="heroImage3">

		<button class="hero-nav-btn hero-prev" onclick="prevSlide()">
			<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<polyline points="15 18 9 12 15 6"></polyline>
			</svg>
		</button>

		<button class="hero-nav-btn hero-next" onclick="nextSlide()">
			<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<polyline points="9 18 15 12 9 6"></polyline>
			</svg>
		</button>

		<div class="hero-dots">
			<button class="hero-dot active" onclick="goToSlide(0)"></button>
			<button class="hero-dot" onclick="goToSlide(1)"></button>
			<button class="hero-dot" onclick="goToSlide(2)"></button>
		</div>

		<div class="hero-decorations">
