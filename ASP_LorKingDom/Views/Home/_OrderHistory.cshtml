@model BLL.DTOs.PagedResult<BLL.DTOs.OrderDto>
@{
    Layout = null;
}

<style>
    .order-card {
        background: white;
        border: 2px solid #fed7aa;
        border-radius: 1rem;
        padding: 1.5rem;
        margin-bottom: 1rem;
        transition: all 0.3s ease;
        display: block;
    }

    .order-card.hidden {
        display: none !important;
    }

    .order-card:hover {
        border-color: #f97316;
        box-shadow: 0 10px 25px rgba(249, 115, 22, 0.1);
        transform: translateY(-2px);
    }

    .order-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 1rem;
        border-bottom: 2px solid #fff5ec;
        margin-bottom: 1rem;
    }

    .order-id {
        font-size: 1.125rem;
        font-weight: 700;
        color: #1f2937;
    }

    .order-date {
        font-size: 0.875rem;
        color: #6b7280;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        border-radius: 9999px;
        font-size: 0.875rem;
        font-weight: 600;
    }

    /* Pagination styles */
    .pagination-container {
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 2px solid #fff5ec;
    }

    .pagination {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .page-item .page-link {
        padding: 0.5rem 0.75rem;
        border: 2px solid #fed7aa;
        background: white;
        color: #f97316;
        border-radius: 0.5rem;
        text-decoration: none;
        transition: all 0.3s ease;
        font-weight: 600;
        cursor: pointer;
        min-width: 40px;
        text-align: center;
    }

    .page-item .page-link:hover {
        background: #fff5ec;
        border-color: #f97316;
    }

    .page-item.active .page-link {
        background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
        color: white;
        border-color: #f97316;
    }

    .page-item.disabled .page-link {
        opacity: 0.5;
        cursor: not-allowed;
        pointer-events: none;
    }
        border-radius: 9999px;
        font-size: 0.875rem;
        font-weight: 600;
    }

    .status-pending {
        background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
        color: white;
    }

    .status-confirmed {
        background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        color: white;
    }

    .status-shipped {
        background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
        color: white;
    }

    .status-delivered {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
    }

    .status-cancelled {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: white;
    }

    .order-items {
        margin: 1rem 0;
    }

    .order-items a:hover {
        text-decoration: underline;
        color: #ea580c;
    }

    .order-item {
        display: flex;
        gap: 1rem;
        padding: 0.75rem 0;
        border-bottom: 1px solid #f3f4f6;
    }

    .order-item:last-child {
        border-bottom: none;
    }

    .item-image {
        width: 60px;
        height: 60px;
        border-radius: 0.5rem;
        object-fit: cover;
        border: 2px solid #fed7aa;
    }

    .item-details {
        flex: 1;
    }

    .item-name {
        font-weight: 600;
        color: #1f2937;
        margin-bottom: 0.25rem;
    }

    .item-meta {
        font-size: 0.875rem;
        color: #6b7280;
    }

    .item-price {
        font-weight: 700;
        color: #f97316;
        text-align: right;
    }

    .order-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 1rem;
        border-top: 2px solid #fff5ec;
        margin-top: 1rem;
    }

    .order-total {
        font-size: 1.25rem;
        font-weight: 700;
        color: #f97316;
    }

    .btn-view-detail {
        background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
        color: white;
        padding: 0.625rem 1.5rem;
        border-radius: 0.5rem;
        border: none;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
    }

    .btn-view-detail:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(249, 115, 22, 0.3);
        color: white;
    }

    .btn-cancel {
        background: white;
        color: #dc2626;
        padding: 0.625rem 1.5rem;
        border-radius: 0.5rem;
        border: 2px solid #dc2626;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-cancel:hover {
        background: #dc2626;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(220, 38, 38, 0.3);
    }

    .btn-return {
        background: white;
        color: #10b981;
        padding: 0.625rem 1.5rem;
        border-radius: 0.5rem;
        border: 2px solid #10b981;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-return:hover {
        background: #10b981;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(16, 185, 129, 0.3);
    }

    .filter-tabs {
        display: flex;
        gap: 0.5rem;
        background: white;
        border: 2px solid #fed7aa;
        border-radius: 1rem;
        padding: 0.5rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    .filter-tab {
        padding: 0.625rem 1.25rem;
        border-radius: 0.75rem;
        border: none;
        background: transparent;
        color: #6b7280;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 0.875rem;
    }

    .filter-tab:hover {
        background: #fff5ec;
        color: #f97316;
    }

    .filter-tab.active {
        background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
        color: white;
        box-shadow: 0 4px 10px rgba(249, 115, 22, 0.3);
    }

    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        background: white;
        border: 2px solid #fed7aa;
        border-radius: 1rem;
    }

    .empty-icon {
        width: 120px;
        height: 120px;
        margin: 0 auto 1.5rem;
        opacity: 0.5;
    }

    .shipping-info {
        background: #fff5ec;
        padding: 1rem;
        border-radius: 0.75rem;
        margin-top: 1rem;
        font-size: 0.875rem;
    }

    .shipping-address {
        color: #6b7280;
        margin-top: 0.5rem;
    }

    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: currentColor;
    }

    .order-items a {
        color: #f97316;
        font-size: 0.875rem;
        text-decoration: none;
        font-weight: 600;
    }

    .order-items a:hover {
        text-decoration: underline;
        color: #ea580c;
    }
</style>

<div class="bg-white rounded-xl border-2 border-orange-100 shadow-sm p-6">
    <div class="flex justify-content-between align-items-center mb-4">
        <h2 class="text-2xl font-bold" style="color: #f97316;">Lịch sử đơn hàng</h2>
        <span class="text-sm text-gray-600">Tổng: <strong>@Model.Total đơn hàng</strong> | Trang @Model.Page/@Model.TotalPages</span>
    </div>

    <!-- Filter Tabs -->
    <div class="filter-tabs">
        <button class="filter-tab active" data-status="all">
            Tất cả
        </button>
        <button class="filter-tab" data-status="1">
            Chờ xác nhận
        </button>
        <button class="filter-tab" data-status="2">
            Đã xác nhận
        </button>
        <button class="filter-tab" data-status="3">
            Đang vận chuyển
        </button>
        <button class="filter-tab" data-status="4">
            Đã giao
        </button>
        <button class="filter-tab" data-status="5">
            Đã hủy
        </button>
    </div>

    <!-- Order List -->
    <div id="orderList">
        @if (Model.Items.Any())
        {
            @foreach (var order in Model.Items)
            {
                var statusClass = order.StatusId switch
                {
                    1 => "status-pending",
                    2 => "status-confirmed",
                    3 => "status-shipped",
                    4 => "status-delivered",
                    5 => "status-cancelled",
                    _ => "status-pending"
                };

                <div class="order-card" data-status="@order.StatusId">
                    <div class="order-header">
                        <div>
                            <div class="order-id">#@order.OrderId</div>
                            <div class="order-date">Đặt ngày @order.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                        <span class="status-badge @statusClass">
                            <span class="status-dot"></span>
                            @switch (@order.StatusName)
                            {
                                case "Pending":
                                    @:Chờ xác nhận
                                    break;
                                case "Confirmed":
                                    @:Đã xác nhận
                                    break;
                                case "Shipped":
                                    @: Đang vận chuyển
                                    break;
                                case "Delivered":
                                    @:Đã giao
                                    break;
                                case "Cancelled":
                                    @:Đã hủy
                                    break;
                                default:
                                    @:@order.StatusName
                                    break;
                            }
                        </span>
                    </div>

                    <div class="order-items">
                        @{
                            var firstItem = order.OrderDetails.FirstOrDefault();
                            if (firstItem != null)
                            {
                                <div class="order-item">
                                    <img src="@(firstItem.MainImageUrl ?? "https://via.placeholder.com/60")"
                                        alt="@firstItem.ProductName" class="item-image" />
                                    <div class="item-details">
                                        <div class="item-name">@firstItem.ProductName</div>
                                        <div class="item-meta">SL: @firstItem.Quantity × @firstItem.UnitPrice.ToString("N0") ₫</div>
                                    </div>
                                    <div class="item-price">@firstItem.Total.ToString("N0") ₫</div>
                                </div>
                            }
                        }
                        @if (order.OrderDetails.Count > 1)
                        {
                            <div style="text-align: center; margin-top: 0.75rem;">
                                <a href="/Home/OrderDetails?id=@order.OrderId"
                                    style="color: #f97316; font-size: 0.875rem; text-decoration: none; font-weight: 600;">
                                    Xem thêm @(order.OrderDetails.Count - 1) sản phẩm khác →
                                </a>
                            </div>
                        }
                    </div>

                    <div class="shipping-info">
                        <strong>Giao đến:</strong>
                        <div class="shipping-address">
                            @order.ShippingAddressLine, @order.ShippingWard, @order.ShippingCity
                        </div>
                    </div>

                    <div class="order-footer">
                        <div class="order-total">Tổng: @order.TotalAmount.ToString("N0") ₫</div>
                        <div style="display: flex; gap: 0.5rem;">
                            <a href="/Home/OrderDetails?id=@order.OrderId" class="btn-view-detail">
                                Xem chi tiết
                            </a>
                            @if (order.StatusId == 1 || order.StatusId == 2)
                            {
                                <button class="btn-cancel" onclick="cancelOrder(@order.OrderId)">
                                    Hủy đơn
                                </button>
                            }
                            @if (order.StatusId == 4)
                            {
                                <button class="btn-return" onclick="returnOrder(@order.OrderId)">
                                    Hoàn trả
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">📦</div>
                <h3>Chưa có đơn hàng nào</h3>
                <p class="text-muted">Bạn chưa có đơn hàng nào. Hãy bắt đầu mua sắm ngay!</p>
                <a href="/" class="btn-view-detail mt-3" style="display: inline-block;">
                    Khám phá sản phẩm
                </a>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="pagination-container" style="margin-top: 2rem;">
            <nav aria-label="Order history pagination">
                <ul class="pagination justify-content-center">
                    @if (Model.HasPrev)
                    {
                        <li class="page-item">
                            <a class="page-link" href="#" data-page="@(Model.Page - 1)" onclick="loadOrderPage(@(Model.Page - 1)); return false;">
                                <i class="fas fa-chevron-left"></i> Trước
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link"><i class="fas fa-chevron-left"></i> Trước</span>
                        </li>
                    }

                    @{
                        int startPage = Math.Max(1, Model.Page - 2);
                        int endPage = Math.Min(Model.TotalPages, Model.Page + 2);
                    }

                    @if (startPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="#" data-page="1" onclick="loadOrderPage(1); return false;">1</a>
                        </li>
                        @if (startPage > 2)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        }
                    }

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link" href="#" data-page="@i" onclick="loadOrderPage(@i); return false;">@i</a>
                        </li>
                    }

                    @if (endPage < Model.TotalPages)
                    {
                        @if (endPage < Model.TotalPages - 1)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">...</span>
                            </li>
                        }
                        <li class="page-item">
                            <a class="page-link" href="#" data-page="@Model.TotalPages" onclick="loadOrderPage(@Model.TotalPages); return false;">@Model.TotalPages</a>
                        </li>
                    }

                    @if (Model.HasNext)
                    {
                        <li class="page-item">
                            <a class="page-link" href="#" data-page="@(Model.Page + 1)" onclick="loadOrderPage(@(Model.Page + 1)); return false;">
                                Sau <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link">Sau <i class="fas fa-chevron-right"></i></span>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>