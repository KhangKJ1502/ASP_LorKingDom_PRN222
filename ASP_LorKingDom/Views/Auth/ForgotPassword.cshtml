@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

<div class="login-container">
    <div class="decorative-section">
        <div class="decorative-card">
            <div class="decorative-content">
                <div class="decorative-icon">🔑</div>
                <h2 class="decorative-title">Quên mật khẩu?</h2>
                <p class="decorative-text">
                    Nhập email đã đăng ký để nhận mật khẩu mới.
                </p>
            </div>
        </div>
    </div>
    <div class="login-form-section">
        <div class="form-wrapper">
            <div class="logo-section">
                <a href="/" class="logo-link">
                    <svg class="logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                        <path d="M2 17l10 5 10-5M2 12l10 5 10-5"></path>
                    </svg>
                    <span class="logo-text">ToyStore</span>
                </a>
            </div>

            <div class="welcome-section">
                <h1 class="welcome-title">Đặt lại mật khẩu 🔑</h1>
                <p class="welcome-subtitle">Nhập email để nhận hướng dẫn</p>
            </div>

            <form class="login-form" method="post" asp-controller="Auth" asp-action="ForgotPassword">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label for="email" class="form-label">Email</label>
                    <input type="email" id="email" name="email" class="form-input"
                           placeholder="ten@email.com" required />
                </div>

                <button type="submit" class="btn-primary">Gửi mật khẩu mới</button>
            </form>

            <p class="signup-link">
                <a asp-controller="Auth" asp-action="Login">Quay lại đăng nhập</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @if (TempData["Error"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi',
                    text: '@Html.Raw(TempData["Error"])',
                    confirmButtonText: 'Thử lại',
                    confirmButtonColor: '#f97316',
                    timer: 5000,
                });
            });
        </script>
    }
}