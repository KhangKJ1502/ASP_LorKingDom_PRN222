@{
    ViewData["Title"] = "Đăng ký";
    Layout = "_Layout";
}

@using BLL.DTOs
@model SignupRequestDto

@section Styles {
    <link rel="stylesheet" href="~/css/signup.css" asp-append-version="true" />
}

<div class="signup-container">
    <!-- Left side - Decorative -->
    <div class="decorative-section">
        <div class="decorative-content">
            <div class="decorative-icon">🎉</div>
            <h2 class="decorative-title">Tham gia cùng chúng tôi!</h2>
            <p class="decorative-text">
                Trở thành thành viên để nhận nhiều ưu đãi đặc biệt và
                trải nghiệm mua sắm tuyệt vời nhất!
            </p>
            <div class="decorative-features">
                <div class="feature-item">
                    <span class="feature-icon">💝</span>
                    <span>Giảm giá 20% cho đơn đầu tiên</span>
                </div>
                <div class="feature-item">
                    <span class="feature-icon">🎯</span>
                    <span>Tích điểm mỗi lần mua hàng</span>
                </div>
                <div class="feature-item">
                    <span class="feature-icon">🔔</span>
                    <span>Thông báo sản phẩm mới</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Right side - Form -->
    <div class="signup-form-section">
        <div class="form-wrapper">
            <!-- Logo -->
            <div class="logo-section">
                <a href="/" class="logo-link">
                    <svg class="logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                        <path d="M2 17l10 5 10-5M2 12l10 5 10-5"></path>
                    </svg>
                    <span class="logo-text">ToyStore</span>
                </a>
            </div>

            <!-- Welcome text -->
            <div class="welcome-section">
                <h1 class="welcome-title">Tạo tài khoản mới 🚀</h1>
                <p class="welcome-subtitle">Bắt đầu hành trình mua sắm thú vị của bạn</p>
            </div>

            <!-- Signup Form -->
            <form class="signup-form" id="signupForm">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-input" placeholder="ten@email.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password" class="form-label">Mật khẩu</label>
                    <input asp-for="Password" class="form-input" placeholder="••••••••" />
                    @* <p class="form-hint">Tối thiểu 8 ký tự, bao gồm chữ và số</p> *@
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu</label>
                    <input asp-for="ConfirmPassword" class="form-input" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="form-checkbox">
                    <label class="checkbox-label">
                        <input type="checkbox" name="AgreeTerms" id="AgreeTerms" value="true" />
                        <span>
                            Tôi đồng ý với
                            <a href="/terms">Điều khoản dịch vụ</a>
                            và
                            <a href="/privacy">Chính sách bảo mật</a>
                        </span>
                    </label>
                    <span asp-validation-for="AgreeTerms" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-primary">Đăng ký</button>
            </form>

            <!-- Divider -->
            @* <div class="divider"> *@
            @*     <span>Hoặc đăng ký với</span> *@
            @* </div> *@

            <!-- Social Signup -->
            @* <div class="social-buttons"> *@
            @*     <button type="button" class="btn-social" *@
            @*         onclick="window.location.href='@Url.Action("ExternalLogin", "Account", new { provider = "Google" })'"> *@
            @*         <svg class="social-icon" viewBox="0 0 24 24"> *@
            @*             <path fill="#4285F4" *@
            @*                 d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" /> *@
            @*             <path fill="#34A853" *@
            @*                 d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" /> *@
            @*             <path fill="#FBBC05" *@
            @*                 d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" /> *@
            @*             <path fill="#EA4335" *@
            @*                 d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" /> *@
            @*         </svg> *@
            @*         Google *@
            @*     </button> *@

            @*     <button type="button" class="btn-social" *@
            @*         onclick="window.location.href='@Url.Action("ExternalLogin", "Account", new { provider = "Facebook" })'"> *@
            @*         <svg class="social-icon" viewBox="0 0 24 24" fill="#1877F2"> *@
            @*             <path *@
            @*                 d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" /> *@
            @*         </svg> *@
            @*         Facebook *@
            @*     </button> *@
            @* </div> *@

            <!-- Login link -->
            <p class="login-link">
                Đã có tài khoản?
                <a asp-controller="Auth" asp-action="Login">Đăng nhập ngay</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $('#signupForm').on('submit', function (e) {
                e.preventDefault();

                const form = $(this);

                // Kiểm tra client-side validation trước
                if (!form.valid()) {
                    return;
                }

                // Kiểm tra checkbox AgreeTerms riêng
                const agreeTerms = $('input[name="AgreeTerms"]').is(':checked');
                if (!agreeTerms) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Thiếu thông tin',
                        text: 'Bạn phải đồng ý với Điều khoản dịch vụ và Chính sách bảo mật.',
                        confirmButtonColor: '#f97316'
                    });
                    return;
                }

                const submitBtn = form.find('button[type="submit"]');
                const originalText = submitBtn.html();

                // Hiển thị trạng thái đang xử lý
                submitBtn.prop('disabled', true);
                submitBtn.html('<span class="spinner-border me-2"></span>Đang xử lý...');

                $.ajax({
                    url: '@Url.Action("Signup", "Auth")',
                    type: 'POST',
                    data: form.serialize(),
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (data) {
                        if (data.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công',
                                text: data.message,
                                confirmButtonColor: '#28a745',
                                allowOutsideClick: false
                            }).then(() => {
                                window.location.href = data.redirectUrl;
                            });
                        } else {
                            // Hiển thị lỗi
                            let errorMessage = data.message;
                            if (Array.isArray(data.message)) {
                                errorMessage = data.message.join('\n');
                            }

                            Swal.fire({
                                icon: 'error',
                                title: 'Đăng ký thất bại',
                                text: errorMessage,
                                confirmButtonColor: '#f97316',
                                timer: 5000
                            });
                            submitBtn.prop('disabled', false);
                            submitBtn.html(originalText);
                        }
                    },
                    error: function (xhr, status, error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi',
                            text: 'Đã xảy ra lỗi khi đăng ký',
                            confirmButtonColor: '#f97316'
                        });
                        submitBtn.prop('disabled', false);
                        submitBtn.html(originalText);
                        console.error('Signup error:', error);
                    }
                });
            });
        });
    </script>

}