@{
    ViewData["Title"] = "Xác thực OTP - Quên mật khẩu";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/verify-otp.css" />
}

<div class="verify-container">
    <div class="verify-card shadow-lg">
        <div class="text-center mb-4">
            <div class="otp-badge mx-auto mb-3">
                <span>📧</span>
            </div>
            <h2 class="verify-title">Xác minh Email</h2>
            <p class="verify-subtitle">
                Chúng tôi đã gửi mã OTP đến <strong>@ViewBag.Email</strong>.<br />
                Vui lòng nhập mã bên dưới để tiếp tục.
            </p>
        </div>

        <!-- Form VERIFY -->
        <form id="verifyForgotPasswordOtpForm" class="otp-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="email" value="@ViewBag.Email" />
            <input type="hidden" name="otpCode" id="otpCode" />

            <div class="otp-input-group d-flex justify-content-between mb-4">
                <input type="text" maxlength="1" class="otp-input form-control text-center" autocomplete="one-time-code" required />
                <input type="text" maxlength="1" class="otp-input form-control text-center" required />
                <input type="text" maxlength="1" class="otp-input form-control text-center" required />
                <input type="text" maxlength="1" class="otp-input form-control text-center" required />
                <input type="text" maxlength="1" class="otp-input form-control text-center" required />
                <input type="text" maxlength="1" class="otp-input form-control text-center" required />
            </div>

            <button type="submit" class="btn btn-primary w-100 mb-3">
                <span class="spinner-border spinner-border-sm me-2 d-none" id="verifySpinner" role="status" aria-hidden="true"></span>
                <span id="verifyBtnText">Xác nhận</span>
            </button>
        </form>

        <!-- Form RESEND -->
        <form id="resendForgotPasswordOtpForm" class="text-center">
            @Html.AntiForgeryToken()
            <input type="hidden" name="email" value="@ViewBag.Email" />
            <button type="submit" id="resendBtn" class="btn btn-link p-0" disabled>
                Gửi lại mã sau <span id="countdown">30</span>s
            </button>
        </form>

        <div class="text-center mt-3">
            <a href="@Url.Action("Login", "Auth")" class="text-muted small">
                Quay lại đăng nhập
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // OTP Input Navigation
        const otpInputs = document.querySelectorAll('.otp-input');
        const otpCodeInput = document.getElementById('otpCode');

        const updateOtpCode = () => {
            otpCodeInput.value = Array.from(otpInputs).map(i => i.value).join('');
        };

        otpInputs.forEach((input, index) => {
            input.addEventListener('input', (e) => {
                if (e.target.value.length === 1 && index < otpInputs.length - 1) {
                    otpInputs[index + 1].focus();
                }
                updateOtpCode();
            });

            input.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && !input.value && index > 0) {
                    otpInputs[index - 1].focus();
                }
            });
        });

        // Countdown Timer
        const email = '@ViewBag.Email';
        const key = `otp_resend_forgot_until:${email}`;
        let until = parseInt(localStorage.getItem(key) || "0", 10);
        const now = Date.now();
        if (!until || now >= until) {
            until = now + 30_000;
            localStorage.setItem(key, String(until));
        }

        const resendBtn = document.getElementById('resendBtn');
        const countdownEl = document.getElementById('countdown');

        function tick() {
            const remain = Math.max(0, until - Date.now());
            const s = Math.ceil(remain / 1000);
            countdownEl.textContent = s;
            if (remain <= 0) {
                resendBtn.removeAttribute("disabled");
                resendBtn.textContent = "Gửi lại mã OTP";
                return;
            }
            requestAnimationFrame(tick);
        }
        tick();

        // Verify OTP Form
            $('#verifyForgotPasswordOtpForm').on('submit', function (e) {
            e.preventDefault();

            const form = $(this);
            const spinner = $('#verifySpinner');
            const btnText = $('#verifyBtnText');

            spinner.removeClass('d-none');
            btnText.text('Đang xác minh...');

            $.ajax({
                url: '@Url.Action("VerifyForgotPasswordOtp", "Auth")',
                type: 'POST',
                data: form.serialize(), // Gửi dữ liệu form
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (data) {
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Thành công',
                            text: data.message,
                            confirmButtonColor: '#28a745',
                            allowOutsideClick: false
                        }).then(() => {
                            window.location.href = data.redirectUrl;
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Xác minh thất bại',
                            text: data.message,
                            confirmButtonColor: '#f97316'
                        });
                    }
                },
                error: function (xhr) {
                    console.error(xhr);
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi',
                        text: 'Đã xảy ra lỗi khi xác minh OTP',
                        confirmButtonColor: '#f97316'
                    });
                },
                complete: function () {
                    spinner.addClass('d-none');
                    btnText.text('Xác nhận');
                }
            });
        });

        // Resend OTP Form
            $('#resendForgotPasswordOtpForm').on('submit', function (e) {
            e.preventDefault();

            const form = $(this);
            const resendBtn = $('#resendBtn'); // Nút gửi lại OTP của bạn
            resendBtn.prop('disabled', true);

            $.ajax({
                url: '@Url.Action("ResendForgotPasswordOtp", "Auth")',
                type: 'POST',
                data: form.serialize(),
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (data) {
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Thành công',
                            text: data.message,
                            confirmButtonColor: '#28a745',
                            timer: 1500,
                            showConfirmButton: false
                        });

                        // Reset countdown (giống logic cũ)
                        until = Date.now() + 30_000;
                        localStorage.setItem(key, String(until));
                        resendBtn.text("Gửi lại mã sau 30s");
                        resendBtn.attr("disabled", true);
                        tick();
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi',
                            text: data.message,
                            confirmButtonColor: '#f97316'
                        });
                        resendBtn.prop('disabled', false);
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi',
                        text: 'Đã xảy ra lỗi khi gửi lại OTP',
                        confirmButtonColor: '#f97316'
                    });
                    resendBtn.prop('disabled', false);
                }
            });
        });
    </script>
}