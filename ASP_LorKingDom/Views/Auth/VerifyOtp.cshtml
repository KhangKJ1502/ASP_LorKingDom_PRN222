@{
    ViewData["Title"] = "Xác thực OTP";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/verify-otp.css" />
}

<div class="verify-container">
    <div class="verify-card shadow-lg">
        <div class="text-center mb-4">
            <div class="otp-badge mx-auto mb-3">
                <span class="bi bi-shield-lock-fill">📧</span>
            </div>
            <h2 class="verify-title">Xác minh Email</h2>
            <p class="verify-subtitle">
                Chúng tôi đã gửi mã OTP đến <strong>@ViewBag.Email</strong>.<br />
                Vui lòng nhập mã bên dưới để hoàn tất đăng ký.
            </p>
        </div>

        <!-- TempData / ModelState -->
        <!-- Form VERIFY -->
        <form id="verifyOtpForm" class="otp-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="email" value="@ViewBag.Email" />
            <input type="hidden" name="otpCode" id="otpCode" />

            <div class="otp-input-group d-flex justify-content-between mb-4">
                <input type="text" maxlength="1" class="otp-input form-control text-center" name="Otp1"
                    autocomplete="one-time-code" required />
                <input type="text" maxlength="1" class="otp-input form-control text-center" name="Otp2" required />
                <input type="text" maxlength="1" class="otp-input form-control text-center" name="Otp3" required />
                <input type="text" maxlength="1" class="otp-input form-control text-center" name="Otp4" required />
                <input type="text" maxlength="1" class="otp-input form-control text-center" name="Otp5" required />
                <input type="text" maxlength="1" class="otp-input form-control text-center" name="Otp6" required />
            </div>

            <button type="submit" class="btn btn-primary w-100 mb-3">Xác nhận</button>
        </form>

        <!-- Form RESEND (tách riêng, POST + antiforgery) -->
        <form id="resendForm" class="text-center">
            @Html.AntiForgeryToken()
            <input type="hidden" name="email" value="@ViewBag.Email" />
            <button type="submit" id="resendBtn" class="btn btn-link p-0" disabled>
                Gửi lại mã sau <span id="countdown">30</span>s
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // OTP Input Navigation
        const otpInputs = document.querySelectorAll('.otp-input');
        otpInputs.forEach((input, index) => {
            input.addEventListener('input', (e) => {
                if (e.target.value.length === 1 && index < otpInputs.length - 1) {
                    otpInputs[index + 1].focus();
                }
            });

            input.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && e.target.value === '' && index > 0) {
                    otpInputs[index - 1].focus();
                }
            });
        });

        // Verify OTP Form
        document.getElementById('verifyOtpForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            const formData = new FormData(this);
            const otpCode = Array.from(document.querySelectorAll('.otp-input'))
                .map(input => input.value)
                .join('');

            formData.set('otpCode', otpCode);

            try {
                const response = await fetch('@Url.Action("VerifyOtp", "Auth")', {
                    method: 'POST',
                    body: formData
                });

                const data = await response.json();

                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công',
                        text: data.message,
                        confirmButtonColor: '#28a745',
                        allowOutsideClick: false
                    }).then(() => {
                        window.location.href = data.redirectUrl;
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Xác minh OTP thất bại',
                        text: data.message,
                        confirmButtonColor: '#f97316',
                        timer: 5000
                    });
                }
            } catch (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi',
                    text: 'Đã xảy ra lỗi khi xác minh OTP',
                    confirmButtonColor: '#f97316'
                });
            }
        });

        // Resend OTP Form
        document.getElementById('resendForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            const formData = new FormData(this);

            try {
                const response = await fetch('@Url.Action("ResendOtp", "Auth")', {
                    method: 'POST',
                    body: formData
                });

                const data = await response.json();

                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công',
                        text: data.message,
                        confirmButtonColor: '#28a745',
                        timer: 3000
                    });

                    // Reset countdown
                    let countdown = 30;
                    document.getElementById('resendBtn').disabled = true;
                    document.getElementById('countdown').textContent = countdown;

                    const interval = setInterval(() => {
                        countdown--;
                        document.getElementById('countdown').textContent = countdown;

                        if (countdown === 0) {
                            clearInterval(interval);
                            document.getElementById('resendBtn').disabled = false;
                            document.getElementById('countdown').textContent = '30';
                        }
                    }, 1000);
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi',
                        text: data.message,
                        confirmButtonColor: '#f97316',
                        timer: 5000
                    });
                }
            } catch (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi',
                    text: 'Đã xảy ra lỗi khi gửi lại OTP',
                    confirmButtonColor: '#f97316'
                });
            }
        });

        // Countdown timer on load
        document.addEventListener('DOMContentLoaded', function () {
            let countdown = 30;
            const resendBtn = document.getElementById('resendBtn');
            const countdownSpan = document.getElementById('countdown');

            resendBtn.disabled = true;

            const interval = setInterval(() => {
                countdown--;
                countdownSpan.textContent = countdown;

                if (countdown === 0) {
                    clearInterval(interval);
                    resendBtn.disabled = false;
                    countdownSpan.textContent = '30';
                }
            }, 1000);
        });
    </script>
}