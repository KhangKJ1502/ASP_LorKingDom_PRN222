@{
    Layout = "_AdminLayout";

    // Lấy đúng ID và tên từ Controller (đã chuẩn hoá = claim)
    var userId = (string)ViewBag.UserId!;
    var name = (string)ViewBag.Name!;
}

<link rel="stylesheet" href="~/css/chat-staff.css" asp-append-version="true" />
<!-- Badge thông báo -->
<div class="notification-badge" id="notificationBadge">
    <span id="unreadCount">0</span> tin nhắn mới
</div>

<div class="chat-page-header">
    <h2 class="chat-page-title">💬 Quản lý Chat</h2>
</div>

<div class="chat-container">
    <!-- LEFT -->
    <div class="chat-card">
        <div class="chat-card-header">
            <div class="chat-card-title">📥 Danh sách hội thoại</div>
            <div class="count-badge" id="totalConv">0</div>
        </div>

        <div class="search-box">
            <div class="input-wrapper">
                <span class="input-icon">🔍</span>
                <input id="q" type="text" placeholder="Tìm kiếm khách hàng..." />
            </div>
            <div class="input-wrapper">
                <span class="input-icon">🔽</span>
                <select id="f">
                    <option value="">Tất cả</option>
                    <option value="online">Đang online</option>
                    <option value="unread">Chưa đọc</option>
                </select>
            </div>
        </div>

        <div id="convList" class="conversation-list">
            <div class="empty-state">
                <div class="empty-icon">⏳</div>
                <p>Đang tải danh sách...</p>
            </div>
        </div>
    </div>

    <!-- RIGHT -->
    <div class="chat-card">
        <div class="chat-area-header">
            <div class="current-customer">
                <h3 id="chatTitle">Chưa chọn hội thoại</h3>
                <p id="chatStatus">Vui lòng chọn một hội thoại để bắt đầu</p>
            </div>
        </div>

        <div id="chatBody" class="messages-area">
            <div class="empty-state">
                <div class="empty-icon">💬</div>
                <h3>Chọn hội thoại để bắt đầu</h3>
                <p>Nhấn vào một khách hàng bên trái để xem tin nhắn</p>
            </div>
        </div>

        <div id="typing" class="typing-status"></div>

        <div class="message-input-box">
            <input id="txt" type="text" placeholder="Nhập tin nhắn của bạn..." autocomplete="off" />
            <button id="sendBtn" class="send-btn">📤 Gửi</button>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        // ===== Staff info lấy từ Razor (=> từ Claims => ID thật, vd "22")
        const STAFF_ID = "@userId";
        const STAFF_NAME = "@name";

        // Hub URL: KHÔNG lấy query string nữa
        const HUB = `/chatHub?userId=${encodeURIComponent(STAFF_ID)}&isStaff=true&name=${encodeURIComponent(STAFF_NAME)}`;

        // ===== State
        const conn = new signalR.HubConnectionBuilder()
            .withUrl(HUB)
            .withAutomaticReconnect({
                nextRetryDelayInMilliseconds: ctx =>
                    Math.min(1000 * (ctx.previousRetryCount + 1), 10000)
            })
            .build();

        conn.serverTimeoutInMilliseconds = 60000;
        conn.keepAliveIntervalInMilliseconds = 20000;

        const convMap = new Map();
        let currentConv = null;

        let isOnChatPage = true;
        let lastPageState = true;
        let unreadCount = 0;
        let pageStateTimeout = null;

        // ===== Utils
        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text ?? '';
            return div.innerHTML;
        }

        function getInitials(text) {
            const s = (text ?? '').trim();
            return s ? s.substring(0, 2).toUpperCase() : '??';
        }

        function formatTime(date) {
            const d = new Date(date);
            if (Number.isNaN(d.getTime())) return '';
            const hours = Math.floor((Date.now() - d.getTime()) / 36e5);
            return hours < 24
                ? d.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' })
                : d.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit' });
        }

        // ===== Render danh sách hội thoại
        function renderList() {
            const q = document.getElementById('q').value.trim().toLowerCase();
            const f = document.getElementById('f').value;
            const list = document.getElementById('convList');

            const items = [...convMap.values()]
                .filter(x => !q || (x.customerUserId ?? '').toLowerCase().includes(q))
                .filter(x => f === "" ? true : (f === "online" ? !!x.customerOnline : (x.unreadForStaff ?? 0) > 0))
                .sort((a,b) => new Date(b.lastAt||0) - new Date(a.lastAt||0));

            document.getElementById('totalConv').textContent = items.length;

            if (items.length === 0) {
                list.innerHTML = `
                    <div class="empty-state">
                        <div class="empty-icon">📭</div>
                        <p>Không có hội thoại nào</p>
                    </div>`;
                return;
            }

            list.innerHTML = items.map(x => `
                <div class="conversation-item ${currentConv === x.conversationId ? 'active' : ''}"
                     onclick="openConv('${x.conversationId}')">
                    <div class="customer-avatar">${getInitials(x.customerUserId)}</div>
                    <div class="customer-info">
                        <div class="customer-name">
                            ${escapeHtml(x.customerUserId)}
                            <span class="status-indicator ${x.customerOnline ? 'online' : 'offline'}">
                                <span class="status-dot"></span>
                                ${x.customerOnline ? 'Online' : 'Offline'}
                            </span>
                        </div>
                        <div class="message-preview">${escapeHtml(x.lastMessage || 'Chưa có tin nhắn')}</div>
                    </div>
                    <div class="conversation-meta">
                        <div class="message-time">${x.lastAt ? formatTime(x.lastAt) : ''}</div>
                        ${(x.unreadForStaff ?? 0) > 0
                            ? `<span class="unread-count">${x.unreadForStaff}</span>`
                            : ''}
                    </div>
                </div>
            `).join('');
        }

        // ===== Header khung chat bên phải
        function setDetailHeader(card) {
            const title = document.getElementById('chatTitle');
            const status = document.getElementById('chatStatus');

            if (card) {
                title.textContent = `Khách hàng: ${card.customerUserId}`;
                status.innerHTML = `
                    <span class="status-indicator ${card.customerOnline ? 'online' : 'offline'}">
                        <span class="status-dot"></span>
                        ${card.customerOnline ? 'Đang online' : 'Offline'}
                    </span>`;
            } else {
                title.textContent = 'Chưa chọn hội thoại';
                status.textContent = 'Vui lòng chọn một hội thoại để bắt đầu';
            }
        }

        // ===== Thêm 1 tin nhắn vào khung phải
        function addChatLine(senderId, text, when, shouldCache = true) {
            const msg = document.createElement('div');
            msg.className = 'chat-message ' + (senderId === STAFF_ID ? 'sent' : 'received');

            const content = document.createElement('div');
            content.className = 'message-content';
            content.textContent = text ?? '';

            const time = document.createElement('span');
            time.className = 'message-timestamp';
            time.textContent = new Date(when || Date.now()).toLocaleTimeString('vi-VN', {
                hour: '2-digit',
                minute: '2-digit'
            });

            content.appendChild(time);
            msg.appendChild(content);

            const body = document.getElementById('chatBody');
            body.appendChild(msg);
            body.scrollTop = body.scrollHeight;

            if (shouldCache && currentConv) {
                const key = `messages:${currentConv}`;
                const messages = JSON.parse(sessionStorage.getItem(key) || '[]');
                messages.push({
                    senderId,
                    text,
                    sentAt: when || new Date().toISOString()
                });
                sessionStorage.setItem(key, JSON.stringify(messages));
            }
        }

        // ===== Mở 1 cuộc hội thoại
        async function openConv(convId) {
            console.log("🔓 Opening conversation:", convId);
            currentConv = convId;
            setDetailHeader(convMap.get(convId));
            document.getElementById('chatBody').innerHTML = '';

            try {
                const key = `messages:${convId}`;
                const cached = JSON.parse(sessionStorage.getItem(key) || '[]');

                if (cached.length > 0) {
                    console.log("Loading", cached.length, "messages from cache");
                    cached.forEach(m => addChatLine(m.senderId, m.text, m.sentAt, false));
                } else {
                    console.log("Fetching messages from server...");
                    const msgs = await conn.invoke("GetMessages", convId);
                    console.log("Received", msgs.length, "messages");
                    msgs.forEach(m => addChatLine(m.senderId, m.text, m.sentAt, false));
                    sessionStorage.setItem(key, JSON.stringify(msgs));
                }
            } catch (err) {
                console.error("Error loading messages:", err);
            }

            try {
                console.log("Joining conversation group...");
                await conn.invoke("OpenConversation", convId);
                console.log("Successfully joined conversation");
            } catch (err) {
                console.error("Error opening conversation:", err);
            }

            renderList();
        }

        // ===== Update trạng thái đang xem trang
        function updatePageState(state) {
            if (state === lastPageState) return;
            lastPageState = state;
            clearTimeout(pageStateTimeout);
            pageStateTimeout = setTimeout(() => {
                if (conn && conn.state === signalR.HubConnectionState.Connected) {
                    conn.invoke("UpdatePageState", state)
                        .catch(err => console.error('UpdatePageState error:', err));
                }
            }, 400);
        }

        // ===== Badge thông báo
        function showNotificationBadge(count = 1) {
            if (!isOnChatPage) {
                unreadCount += count;
                const badge = document.getElementById('notificationBadge');
                const countEl = document.getElementById('unreadCount');
                countEl.textContent = String(unreadCount);
                badge.style.display = 'block';
            }
        }

        function hideNotificationBadge() {
            const badge = document.getElementById('notificationBadge');
            const countEl = document.getElementById('unreadCount');
            badge.style.display = 'none';
            unreadCount = 0;
            countEl.textContent = '0';
        }

        // ===== SignalR events
        
        // Nhận danh sách conversations khi staff connect
        conn.on("conversationList", (list) => {
            console.log("📋 Received conversationList:", list);
            list.forEach(conv => {
                convMap.set(conv.conversationId, conv);
            });
            renderList();
        });
        
        conn.on("receive", (m) => {
            console.log("📨 Received message:", m);
            console.log("Current conversation:", currentConv);
            console.log("Match:", m.conversationId === currentConv);

            if (!isOnChatPage) showNotificationBadge(1);

            if (m.conversationId === currentConv) {
                console.log("✅ Adding message to current conversation");
                addChatLine(m.senderId, m.text, m.sentAt);
            } else {
                console.log("⚠️ Message for different conversation");
                const card = convMap.get(m.conversationId);
                if (card) {
                    card.lastMessage = m.text;
                    card.lastAt = m.sentAt;
                    card.unreadForStaff = (card.unreadForStaff ?? 0) + 1;
                    convMap.set(m.conversationId, card);
                    renderList();
                } else {
                    console.log("❌ No card found for conversation:", m.conversationId);
                }
            }
        });

        conn.on("conversationUpdated", (card) => {
            convMap.set(card.conversationId, card);

            if (!isOnChatPage && (card.unreadForStaff ?? 0) > 0) {
                showNotificationBadge(1);
            }

            if (currentConv === card.conversationId) {
                setDetailHeader(card);
            }

            renderList();
        });

        conn.on("presenceChanged", (uid, online) => {
            for (const v of convMap.values()) {
                if (v.customerUserId === uid) {
                    v.customerOnline = online;
                }
            }
            if (currentConv && convMap.has(currentConv)) {
                setDetailHeader(convMap.get(currentConv));
            }
            renderList();
        });

        // ===== DOM events
        document.getElementById('q').addEventListener('input', renderList);
        document.getElementById('f').addEventListener('change', renderList);

        document.getElementById('sendBtn').addEventListener('click', async () => {
            if (!currentConv) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Chưa chọn hội thoại',
                    text: '⚠️ Vui lòng chọn một hội thoại trước khi gửi tin nhắn',
                    confirmButtonColor: '#667eea'
                });
                return;
            }
            const el = document.getElementById('txt');
            const v = el.value.trim();
            if (!v) return;
            el.value = "";
            try {
                console.log("📤 Sending message:", { convId: currentConv, from: STAFF_ID, text: v });
                await conn.invoke("SendMessage", currentConv, STAFF_ID, v);
                console.log("✅ Message sent successfully");
            } catch (err) {
                console.error('❌ SendMessage error:', err);
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi gửi tin nhắn',
                    text: 'Không thể gửi tin nhắn. Vui lòng thử lại.',
                    confirmButtonColor: '#667eea'
                });
            }
        });

        document.getElementById('txt').addEventListener('keydown', (e) => {
            if (e.key === "Enter" && !e.shiftKey) {
                e.preventDefault();
                document.getElementById('sendBtn').click();
            }
        });

        // ⚠ FIX QUAN TRỌNG: badge click KHÔNG redirect kèm query string nữa
        document.getElementById('notificationBadge').addEventListener('click', () => {
            hideNotificationBadge();
            // chỉ reload lại /Chat/Staff thôi
            window.location.href = `/Chat/Staff`;
        });

        // focus/blur để biết agent còn coi tab không
        window.addEventListener('blur', () => {
            isOnChatPage = false;
            updatePageState(false);
        });
        window.addEventListener('focus', () => {
            isOnChatPage = true;
            updatePageState(true);
            hideNotificationBadge();
        });
        document.addEventListener('visibilitychange', () => {
            const now = !document.hidden;
            isOnChatPage = now;
            updatePageState(now);
            if (now) hideNotificationBadge();
        });

        // ===== Khởi động kết nối
        async function start() {
            try {
                console.log("🔌 Connecting to SignalR hub...");
                await conn.start();
                console.log("✅ Connected! Staff ID:", STAFF_ID);
                updatePageState(true);

                // load danh sách hội thoại cho staff hiện tại
                console.log("Loading conversations for staff:", STAFF_ID);
                const res = await fetch(`/api/chat-dashboard/conversations?staffId=${encodeURIComponent(STAFF_ID)}`);
                const data = await res.json();
                console.log("Loaded", data.length, "conversations");

                data.forEach(x => convMap.set(x.conversationId, {
                    conversationId: x.conversationId,
                    customerUserId: x.customerUserId,
                    staffUserId: x.staffUserId,
                    lastMessage: x.lastMessage,
                    lastAt: x.lastAt,
                    unreadForStaff: x.unreadForStaff,
                    customerOnline: x.customerOnline
                }));

                console.log("ConvMap size:", convMap.size);
                renderList();
            } catch (err) {
                console.error('Connection error:', err);
                // optional retry
                setTimeout(start, 5000);
            }
        }

        conn.onreconnecting = (error) => {
            console.warn('Reconnecting...', error);
        };

        conn.onreconnected = () => {
            console.log('Reconnected');
            updatePageState(isOnChatPage);
        };

        // run
        start().catch(console.error);

        // expose openConv cho onclick inline
        window.openConv = openConv;
    </script>
}
