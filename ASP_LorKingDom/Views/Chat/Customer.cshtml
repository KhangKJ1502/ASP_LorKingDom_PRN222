@{
    // 1. Lấy info khách
    var userId = (string)ViewBag.UserId
                 ?? User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                 ?? ("guest_" + Guid.NewGuid().ToString("N").Substring(0, 8));

    var name = (string)ViewBag.Name
               ?? User?.Identity?.Name
               ?? "Khách hàng";
}
<link rel="stylesheet" href="~/css/chat-customer.css">
<div id="chatWidget">
    <!-- Floating Button -->
    <button class="chat-widget-button" id="chatToggleBtn" type="button">
        <svg class="chat-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
        <svg class="close-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
        <span class="notification-dot" id="notificationDot"></span>
    </button>

    <!-- Chat Box -->
    <div class="chat-widget-box" id="chatBox">
        <!-- Header -->
        <div class="chat-widget-header">
            <div class="header-content">
                <div class="agent-avatar">
                    <span>🎧</span>
                </div>

                <div class="agent-info">
                    <h4>Hỗ trợ khách hàng</h4>

                    <p class="agent-status" id="agentStatus">
                        <span class="status-dot"></span>
                        <span class="status-text">Đang kiểm tra...</span>
                    </p>
                </div>
            </div>

            <button class="minimize-btn" id="minimizeBtn" type="button">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
            </button>
        </div>

        <!-- Messages -->
        <div class="chat-widget-messages" id="chatMessages">
            <div class="welcome-message">
                <div class="welcome-icon">👋</div>
                <h3>Xin chào!</h3>
                <p>Chúng tôi có thể giúp gì cho bạn?</p>
            </div>
        </div>

        <!-- Typing Indicator -->
        <div class="typing-indicator" id="typingIndicator">
            <div class="typing-dots">
                <span></span>
                <span></span>
                <span></span>
            </div>
            <span class="typing-text">Nhân viên đang nhập...</span>
        </div>

        <!-- Input -->
        <div class="chat-widget-input">
            <input type="text" id="messageInput" placeholder="Nhập tin nhắn..." autocomplete="off" />
            <button class="send-button" id="sendButton" type="button">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="22" y1="2" x2="11" y2="13"></line>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
            </button>
        </div>

        <!-- Footer -->
        <div class="chat-widget-footer">
            <span>Powered by ToyLand Support</span>
        </div>
    </div>
</div>


<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
(function () {

    // ===== Razor -> JS =====
    const USER_ID = "@userId";
    const DISPLAY_NAME = "@name";
    const HUB = `/chatHub?userId=${encodeURIComponent(USER_ID)}&isStaff=false&name=${encodeURIComponent(DISPLAY_NAME)}`;

    // state
    let conn = null;
    let convId = null;
    let typingTimer = null;
    let isBoxOpen = false;

    // dom
    const toggleBtn = document.getElementById('chatToggleBtn');
    const chatBox = document.getElementById('chatBox');
    const minimizeBtn = document.getElementById('minimizeBtn');
    const messageInput = document.getElementById('messageInput');
    const sendButton = document.getElementById('sendButton');
    const chatMessages = document.getElementById('chatMessages');
    const typingIndicator = document.getElementById('typingIndicator');
    const agentStatus = document.getElementById('agentStatus');
    const notificationDot = document.getElementById('notificationDot');

    // cookie helpers
    function getCookie(name) {
        const m = document.cookie.match(new RegExp('(?:^|; )' + name.replace(/([$?*|{}\]\\^])/g, '\\$1') + '=([^;]*)'));
        return m ? decodeURIComponent(m[1]) : null;
    }

    function setCookie(name, value, minutes) {
        const d = new Date();
        d.setTime(d.getTime() + (minutes * 60 * 1000));
        document.cookie = `${name}=${encodeURIComponent(value)};expires=${d.toUTCString()};path=/;SameSite=Lax`;
    }

    function getAssignedStaff() {
        const staffId = getCookie("staffId");
        const staffName = getCookie("staffName") || "Nhân viên hỗ trợ";
        return { staffId, staffName };
    }

    // UI helpers
    function toggleChatBox() {
        isBoxOpen = !isBoxOpen;
        chatBox.classList.toggle('show', isBoxOpen);
        toggleBtn.classList.toggle('active', isBoxOpen);

        if (isBoxOpen) {
            messageInput.focus();
            notificationDot.classList.remove('show');
        }
    }
    toggleBtn.addEventListener('click', toggleChatBox);
    minimizeBtn.addEventListener('click', toggleChatBox);

    function formatTime(date) {
        return new Date(date || Date.now()).toLocaleTimeString('vi-VN', {
            hour: '2-digit',
            minute: '2-digit'
        });
    }

    function addMessage(senderId, text, when) {
        const welcome = chatMessages.querySelector('.welcome-message');
        if (welcome) welcome.remove();

        const wrap = document.createElement('div');
        wrap.className = `chat-message ${senderId === USER_ID ? 'sent' : 'received'}`;

        const bubble = document.createElement('div');
        bubble.className = 'chat-bubble';
        bubble.textContent = text ?? '';

        const time = document.createElement('span');
        time.className = 'message-time';
        time.textContent = formatTime(when);

        bubble.appendChild(time);
        wrap.appendChild(bubble);
        chatMessages.appendChild(wrap);

        chatMessages.scrollTop = chatMessages.scrollHeight;

        if (!isBoxOpen && senderId !== USER_ID) {
            notificationDot.classList.add('show');
        }
    }

    function setAgentStatus(online) {
        if (online) {
            agentStatus.classList.add('online');
            agentStatus.querySelector('.status-text').textContent = 'Đang online';
        } else {
            agentStatus.classList.remove('online');
            agentStatus.querySelector('.status-text').textContent = 'Offline';
        }
    }

    function showTyping(isTyping) {
        typingIndicator.classList.toggle('show', isTyping);
        if (isTyping) {
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }
    }

    // chat actions
    async function sendMessage() {
        const text = messageInput.value.trim();
        if (!text || !convId) return;

        messageInput.value = '';
        try {
            await conn.invoke("SendMessage", convId, USER_ID, text);
        } catch (err) {
            console.error("SendMessage error:", err);
        }
    }

    function handleTyping() {
        if (!convId) return;

        conn.invoke("Typing", convId, USER_ID, true).catch(() => {});
        clearTimeout(typingTimer);
        typingTimer = setTimeout(() => {
            conn.invoke("Typing", convId, USER_ID, false).catch(() => {});
        }, 1000);
    }

    sendButton.addEventListener('click', sendMessage);
    messageInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            sendMessage();
        } else {
            handleTyping();
        }
    });

    // SignalR
    async function initSignalR() {
        conn = new signalR.HubConnectionBuilder()
            .withUrl(HUB)
            .withAutomaticReconnect()
            .build();

        conn.on("receive", (m) => {
            if (m.conversationId === convId) {
                addMessage(m.senderId, m.text, m.sentAt);
            }
        });

        conn.on("typing", (from, isTyping) => {
            if (from !== USER_ID) {
                showTyping(isTyping);
            }
        });

        conn.on("presenceChanged", (uid, online) => {
            const { staffId } = getAssignedStaff();
            if (uid && staffId && uid === staffId) {
                setAgentStatus(online);
            }
        });

        conn.on("conversationUpdated", (conv) => {
            console.log("conversationUpdated", conv);
        });

        await conn.start();
        console.log("SignalR connected");
    }

    async function startConversation() {
        const { staffId } = getAssignedStaff();

        try {
            if (staffId) {
                console.log("📌 Found staffId in cookie:", staffId);
                try {
                    // Thử dùng staff từ cookie
                    convId = await conn.invoke("StartChatWithStaff", USER_ID, staffId);
                    console.log("✅ StartChatWithStaff ->", convId);
                    setAgentStatus(true);
                } catch (err) {
                    console.warn("⚠️ StartChatWithStaff failed, falling back to auto-assign:", err);
                    // Nếu staff không còn available, fallback auto-assign
                    convId = await conn.invoke("StartChatAsCustomer", USER_ID);
                    console.log("✅ StartChatAsCustomer (fallback) ->", convId);
                }
            } else {
                console.log("📌 No staffId cookie, using auto-assign");
                // Auto-assign
                convId = await conn.invoke("StartChatAsCustomer", USER_ID);
                console.log("✅ StartChatAsCustomer ->", convId);
            }
        } catch (err) {
            console.error("❌ startConversation failed:", err);
            agentStatus.querySelector('.status-text').textContent = 'Lỗi kết nối';
        }
    }

    async function init() {
        await initSignalR();
        await startConversation();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }

})();
</script>
