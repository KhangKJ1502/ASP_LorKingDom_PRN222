@model BLL.DTOs.ReviewBlogDto

<div class="comment-item">
    <div class="comment-header">
        <div>
            <span class="comment-author">@Model?.AuthorName</span>
        </div>
        <div>
            <span class="comment-date">@Model?.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
            @if (User.Identity?.IsAuthenticated == true)
            {
                var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                if (userId != null && int.TryParse(userId, out int accountId) && accountId == Model?.AccountId)
                {
                    <form method="post" asp-action="DeletePublicReview" asp-controller="BlogReview"
                        asp-route-reviewId="@Model?.ReviewBlogId" style="display:inline;"
                        onsubmit="return confirm('Bạn có chắc muốn xoá bình luận này?')">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger" title="Xoá bình luận"
                            style="padding: 0.25rem 0.5rem; font-size: 0.75rem;">
                            <i class="fas fa-trash"></i>
                        </button>
                    </form>
                }
            }
        </div>
    </div>

    <div class="comment-content">@Model?.Comment</div>

    <div class="comment-actions">
        <form method="post" asp-action="ReactToReview" asp-controller="BlogReview"
            asp-route-reviewId="@Model?.ReviewBlogId" style="display:inline;" onsubmit="return handleReaction(event)">
            @Html.AntiForgeryToken()
            <input type="hidden" name="reactionType" value="like" />
            <button type="submit" class="reaction-btn @(Model?.CurrentUserReactionType == true ? "active" : "")"
                title="Thích">
                <i class="fas fa-thumbs-up"></i>
                <span class="reaction-count">@Model?.LikeCount</span>
            </button>
        </form>

        <form method="post" asp-action="ReactToReview" asp-controller="BlogReview"
            asp-route-reviewId="@Model?.ReviewBlogId" style="display:inline;" onsubmit="return handleReaction(event)">
            @Html.AntiForgeryToken()
            <input type="hidden" name="reactionType" value="dislike" />
            <button type="submit" class="reaction-btn @(Model?.CurrentUserReactionType == false ? "active" : "")"
                title="Không thích">
                <i class="fas fa-thumbs-down"></i>
                <span class="reaction-count">@Model?.DislikeCount</span>
            </button>
        </form>
    </div>

    @if (Model?.Replies?.Any() == true)
    {
        <div class="replies-section">
            <div style="font-weight: 600; margin-bottom: 0.8rem; font-size: 0.9rem;">Phản hồi từ quản lý:</div>
            @foreach (var reply in Model.Replies)
            {
                <div class="reply-item">
                    <div class="reply-header">
                        <span class="reply-author">@reply.AuthorName</span>
                        @if (reply.IsAdmin)
                        {
                            <span class="reply-admin-badge">Admin</span>
                        }
                        <span class="reply-date">@reply.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <div class="reply-content">@reply.Content</div>
                </div>
            }
        </div>
    }
</div>