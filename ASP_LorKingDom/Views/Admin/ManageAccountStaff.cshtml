@using System.Linq
@using System.Text.Json
@using Microsoft.AspNetCore.Html
@using BLL.DTOs
@model BLL.DTOs.PagedResult<BLL.DTOs.AccountDto>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản Lý Nhân Viên";
    var query = (string?)ViewBag.Query ?? "";
    var edit = ViewBag.EditStaff as BLL.DTOs.AccountDto;
    var roles = ViewBag.Roles as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    
    // ✅ Fixed: Dùng Page/Total thay vì CurrentPage/TotalItems
    var currentPage = Model?.Page ?? 1;
    var pageSize = Model?.PageSize ?? 10;
    var totalRows = Model?.Total ?? 0;
    var totalPages = Model?.TotalPages ?? 1;
    if (totalPages < 1) totalPages = 1;
}

<!-- Giữ nguyên phần CSS -->
<style>
    .search-box .form-control {
        border: 1px solid #000 !important;
        box-shadow: none !important
    }
    .search-box .btn {
        border: 1px solid #000 !important;
        border-left: none !important
    }
    .deleted-row {
        opacity: .6;
        background: #f8f9fa
    }
    .modal-header-gradient {
        background: linear-gradient(135deg,#667eea 0%,#764ba2 100%);
        color: #fff;
        border-radius: 16px 16px 0 0;
        padding: 1.25rem;
        border: none
    }
    .avatar-preview {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        border: 3px solid #667eea;
        box-shadow: 0 4px 12px rgba(0,0,0,.1);
        object-fit: cover
    }
    .avatar-placeholder, .avatar-placeholder-small {
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-weight: 700;
        background: linear-gradient(135deg,#667eea 0%,#764ba2 100%);
        box-shadow: 0 4px 12px rgba(0,0,0,.1)
    }
    .avatar-placeholder {
        width: 100px;
        height: 100px;
        font-size: 2.5rem;
        border: 3px solid #667eea
    }
    .staff-avatar {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #e9ecef
    }
    .avatar-placeholder-small {
        width: 45px;
        height: 45px;
        font-size: 1rem;
        border: 2px solid #e9ecef
    }
    .info-box {
        background: #e7f3ff;
        border-left: 4px solid #667eea;
        padding: .5rem .75rem;
        border-radius: 6px;
        margin-top: .5rem
    }
    .toast-top-right {
        top: 120px !important;
        right: 24px !important;
        left: auto !important;
        bottom: auto !important
    }
</style>

<div class="container-fluid px-5">
    <h1 class="mt-4">Quản Lý Nhân Viên</h1>

    <div class="card mb-4 mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div><i class="fa-solid fa-user-tie me-1"></i> Danh Sách Nhân Viên</div>
            <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#addStaffModal" onclick="openAddModal()">
                <i class="fa-solid fa-plus me-1"></i> Thêm Nhân Viên
            </button>
        </div>
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-md-8">
                    <form method="get" asp-action="Search" asp-controller="AccountStaff" id="searchForm">
                        <div class="input-group search-box">
                            <input type="text" name="q" value="@query" class="form-control" placeholder="Tìm theo tên, email, số điện thoại...">
                            <input type="hidden" name="pageSize" value="@(Model?.PageSize ?? 10)" />
                            <button class="btn btn-outline-secondary" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
                            @if (!string.IsNullOrWhiteSpace(query))
                            {
                                <a href="@Url.Action(action: "Index", controller: "AccountStaff", new { pageSize = Model?.PageSize ?? 10 })" class="btn btn-outline-danger" title="Xóa tìm kiếm">
                                    <i class="fa-solid fa-times"></i>
                                </a>
                            }
                        </div>
                    </form>
                </div>
                <div class="col-md-4">
                    <div class="d-flex align-items-center justify-content-end">
                        <label class="me-2 mb-0">Hiển thị:</label>
                        <select class="form-select form-select-sm" style="width: auto;" id="pageSizeSelector" onchange="changePageSize(this.value)">
                            @{
                                var currentPageSize = Model?.PageSize ?? 10;
                            }
                            <option value="5" selected="@(currentPageSize == 5)">5</option>
                            <option value="10" selected="@(currentPageSize == 10)">10</option>
                            <option value="20" selected="@(currentPageSize == 20)">20</option>
                            <option value="50" selected="@(currentPageSize == 50)">50</option>
                            <option value="100" selected="@(currentPageSize == 100)">100</option>
                        </select>
                        <span class="ms-2 text-muted">mục/trang</span>
                    </div>
                </div>
            </div>

            @if (TempData["Error"] is string e)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fa-solid fa-circle-exclamation me-2"></i>@e
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Success"] is string s)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i>@s
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Table list trực tiếp -->
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th style="white-space:nowrap">ID</th>
                            <th style="white-space:nowrap">Hành Động</th>
                            <th>Avatar</th>
                            <th>Tên nhân viên</th>
                            <th>Email</th>
                            <th>Số điện thoại</th>
                            <th>Role</th>
                            <th style="white-space:nowrap">Trạng Thái</th>
                            <th style="white-space:nowrap">Ngày Tạo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Items != null && Model.Items.Any())
                        {
                            foreach (var staff in Model.Items)
                            {
                                var roleName = "";
                                if (staff.RoleId.HasValue)
                                {
                                    var r = roles.FirstOrDefault(x => (int)x.RoleId == staff.RoleId.Value);
                                    roleName = r != null ? (string)r.RoleName : "";
                                }
                                <tr data-staff-id="@staff.Id" class="@(staff.IsDeleted ? "deleted-row" : "")">
                                    <td>@staff.Id</td>
                                    <td style="white-space:nowrap">
                                        <button class="btn btn-sm btn-warning"
                                                title="Cập nhật"
                                                data-bs-toggle="modal" data-bs-target="#editStaffModal"
                                                onclick="openEditModal(this)"
                                                data-id="@staff.Id"
                                                data-name="@staff.AccountName"
                                                data-email="@staff.Email"
                                                data-phone="@staff.PhoneNumber"
                                                data-roleid="@(staff.RoleId?.ToString() ?? "")"
                                                data-image="@staff.Image"
                                                data-status="@staff.Status"
                                                data-isdeleted="@staff.IsDeleted.ToString().ToLower()"
                                                data-created="@staff.CreatedAt.ToString("s")"
                                                data-updated="@(staff.UpdatedAt?.ToString("s") ?? "")">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </button>

                                        @if (!staff.IsDeleted)
                                        {
                                            <form method="post" asp-action="DeleteStaff" asp-controller="AccountStaff" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@staff.Id" />
                                                <input type="hidden" name="q" value="@query" />
                                                <input type="hidden" name="pageSize" value="@pageSize" />
                                                <button class="btn btn-sm btn-danger" title="Xoá" type="submit" onclick="return confirm('Bạn có chắc chắn muốn xoá nhân viên này?')">
                                                    <i class="fa-solid fa-trash-can"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form method="post" asp-action="RestoreStaff" asp-controller="AccountStaff" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@staff.Id" />
                                                <input type="hidden" name="q" value="@query" />
                                                <input type="hidden" name="pageSize" value="@pageSize" />
                                                <button class="btn btn-sm btn-success" title="Khôi phục" type="submit">
                                                    <i class="fa-solid fa-undo"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(staff.Image))
                                        {
                                            <img src="@staff.Image" alt="Avatar" class="staff-avatar"
                                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-flex';" />
                                            <div class="avatar-placeholder-small" style="display:none;">@(staff.AccountName?.Substring(0, 1).ToUpper() ?? "S")</div>
                                        }
                                        else
                                        {
                                            <div class="avatar-placeholder-small">@(staff.AccountName?.Substring(0, 1).ToUpper() ?? "S")</div>
                                        }
                                    </td>
                                    <td>@staff.AccountName</td>
                                    <td>@staff.Email</td>
                                    <td>@(staff.PhoneNumber ?? "—")</td>
                                    <td>@(string.IsNullOrWhiteSpace(roleName) ? "—" : roleName)</td>
                                    <td>
                                        @if (staff.IsDeleted)
                                        {
                                            <span class="badge bg-secondary">Đã vô hiệu</span>
                                        }
                                        else
                                        {
                                            var badge = staff.Status == "Active" ? "success" :
                                            staff.Status == "Inactive" ? "warning" : "secondary";
                                            var label = staff.Status == "Active" ? "Hoạt Động" :
                                            staff.Status == "Inactive" ? "Ngưng Hoạt Động" : "Không Xác Định";
                                            <span class="badge bg-@badge">@label</span>
                                        }
                                    </td>
                                    <td>@staff.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="9" class="text-center text-muted">Không có dữ liệu.</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            @* PAGINATION *@
            @if (totalPages > 1)
            {
                Func<int, IHtmlContent> PageItem = (int p) =>
                {
                    var active = p == currentPage ? "active" : "";
                    var action = string.IsNullOrWhiteSpace(query) ? "Index" : "Search";
                    var url = string.IsNullOrWhiteSpace(query)
                        ? Url.Action(action, "AccountStaff", new { page = p, pageSize = pageSize })
                        : Url.Action(action, "AccountStaff", new { q = query, page = p, pageSize = pageSize });
                    return new HtmlString($@"
                        <li class=""page-item {active}"">
                        <a class=""page-link"" href=""{url}"">{p}</a>
                        </li>
                        ");
                };

                Func<string, IHtmlContent> DisabledDots = (string text) =>
                {
                    return new HtmlString($@"
                        <li class=""page-item disabled"">
                        <span class=""page-link"">{text}</span>
                        </li>
                        ");
                };

                var prevDisabled = currentPage <= 1;
                var nextDisabled = currentPage >= totalPages;
                var prevPage = prevDisabled ? 1 : currentPage - 1;
                var nextPage = nextDisabled ? totalPages : currentPage + 1;

                var action = string.IsNullOrWhiteSpace(query) ? "Index" : "Search";
                var prevUrl = prevDisabled
                    ? "#"
                    : string.IsNullOrWhiteSpace(query)
                        ? Url.Action(action, "AccountStaff", new { page = prevPage, pageSize = pageSize })
                        : Url.Action(action, "AccountStaff", new { q = query, page = prevPage, pageSize = pageSize });

                var nextUrl = nextDisabled
                    ? "#"
                    : string.IsNullOrWhiteSpace(query)
                        ? Url.Action(action, "AccountStaff", new { page = nextPage, pageSize = pageSize })
                        : Url.Action(action, "AccountStaff", new { q = query, page = nextPage, pageSize = pageSize });

                <nav>
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(prevDisabled ? "disabled" : "")">
                            <a class="page-link" href="@prevUrl" aria-disabled="@(prevDisabled ? "true" : "false")">«</a>
                        </li>

                        @{
                            var windowSize = 1;
                            var startPage = currentPage - windowSize;
                            var endPage = currentPage + windowSize;
                            if (startPage < 1) startPage = 1;
                            if (endPage > totalPages) endPage = totalPages;

                            @PageItem(1);

                            if (startPage > 2)
                            {
                                @DisabledDots("...");
                            }

                            for (int p = startPage; p <= endPage; p++)
                            {
                                if (p != 1 && p != totalPages)
                                {
                                    @PageItem(p);
                                }
                            }

                            if (endPage < totalPages - 1)
                            {
                                @DisabledDots("...");
                            }

                            if (totalPages > 1)
                            {
                                @PageItem(totalPages);
                            }
                        }

                        <li class="page-item @(nextDisabled ? "disabled" : "")">
                            <a class="page-link" href="@nextUrl" aria-disabled="@(nextDisabled ? "true" : "false")">»</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>
<div class="modal fade" id="addStaffModal" tabindex="-1" aria-labelledby="addStaffLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header modal-header-gradient">
                <h5 id="addStaffLabel" class="modal-title"><i class="fa-solid fa-user-plus me-2"></i>Thêm Nhân Viên Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" id="addStaffForm" enctype="multipart/form-data" action="@Url.Action("CreateStaff","AccountStaff")">
                @Html.AntiForgeryToken()
                <div class="modal-body bg-light-subtle p-4">
                    <input type="hidden" name="q" value="@query" />

                    <div class="mb-3">
                        <label class="form-label"><i class="fa-solid fa-image me-1"></i>Ảnh nhân viên</label>
                        <div class="d-flex align-items-center gap-3">
                            <div>
                                <div id="add_avatarPlaceholder" class="avatar-placeholder">S</div>
                                <img id="add_avatarPreview" class="avatar-preview d-none" />
                            </div>
                            <div class="flex-grow-1">
                                <input class="form-control" type="file" id="add_avatarFile" name="AvatarFile" accept="image/png,image/jpeg,image/jpg,image/webp,image/gif" />
                                <small class="form-text">Hỗ trợ JPG/PNG/WebP/GIF. Tối đa <strong>2MB</strong>.</small>
                                <input type="hidden" name="ExistingImage" id="add_existingImage" />
                                <input type="hidden" name="RemoveImage" id="add_removeImage" value="false" />
                            </div>
                        </div>
                        <div class="d-flex gap-2 mt-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('add_avatarFile').click()"><i class="fa-solid fa-upload me-1"></i>Chọn ảnh</button>
                            <button type="button" class="btn btn-outline-danger btn-sm" onclick="clearAvatar('add')"><i class="fa-solid fa-trash-can me-1"></i>Xoá ảnh</button>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-lg-6">
                            <label class="form-label"><i class="fa-solid fa-user me-1"></i>Tên nhân viên <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="AccountName" id="add_accountName" placeholder="Nhập tên nhân viên" required />
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label"><i class="fa-solid fa-phone me-1"></i>Số điện thoại</label>
                            <input type="text" class="form-control" name="PhoneNumber" id="add_phoneNumber" placeholder="Nhập số điện thoại" />
                        </div>

                        <div class="col-lg-12">
                            <label class="form-label"><i class="fa-solid fa-id-badge me-1"></i>Vai trò <span class="text-danger">*</span></label>
                            <select class="form-select" name="RoleId" id="add_roleId" required>
                                <option value="">-- Chọn vai trò --</option>
                                @foreach (var r in roles)
                                {
                                    <option value="@((int)r.RoleId)">@r.RoleName</option>
                                }
                            </select>
                            <small class="form-text"><i class="fa-solid fa-info-circle me-1"></i>Bắt buộc chọn đúng Role cho nhân viên.</small>
                        </div>

                        <div class="col-lg-12">
                            <label class="form-label"><i class="fa-solid fa-envelope me-1"></i>Email <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" name="Email" id="add_email" placeholder="Nhập email nhân viên" required />
                        </div>

                        <div class="col-lg-12">
                            <label class="form-label"><i class="fa-solid fa-lock me-1"></i>Mật khẩu <span class="text-danger">*</span></label>
                            <input type="password" class="form-control" name="Password" id="add_password" placeholder="Nhập mật khẩu" required />
                        </div>
                        <div class="col-lg-12">
                            <label class="form-label"><i class="fa-solid fa-lock me-1"></i>Xác nhận mật khẩu <span class="text-danger">*</span></label>
                            <input type="password" class="form-control" name="ConfirmPassword" id="add_confirmPassword" placeholder="Nhập lại mật khẩu" required />
                        </div>

                        <div class="col-lg-12">
                            <label class="form-label"><i class="fa-solid fa-toggle-on me-1"></i>Trạng thái <span class="text-danger">*</span></label>
                            <input type="hidden" name="Status" id="add_status" value="Active" />
                            <input type="hidden" name="IsDeleted" id="add_isDeleted" value="false" />
                            <div class="btn-group d-flex" role="group">
                                <input type="radio" class="btn-check" name="add_statusRadio" id="add_statusActive" value="Active" checked onchange="setStatus('add','Active')" autocomplete="off">
                                <label class="btn btn-outline-success" for="add_statusActive"><i class="fa-solid fa-circle-check me-1"></i>Hoạt động</label>
                                <input type="radio" class="btn-check" name="add_statusRadio" id="add_statusInactive" value="Inactive" onchange="setStatus('add','Inactive')" autocomplete="off">
                                <label class="btn btn-outline-danger" for="add_statusInactive"><i class="fa-solid fa-ban me-1"></i>Vô hiệu</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><i class="fa-solid fa-xmark me-1"></i>Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-1"></i>Lưu</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- EDIT MODAL -->
<div class="modal fade" id="editStaffModal" tabindex="-1" aria-labelledby="editStaffLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header modal-header-gradient">
                <h5 id="editStaffLabel" class="modal-title"><i class="fa-solid fa-user-pen me-2"></i>Cập nhật Thông Tin Nhân Viên</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" id="editStaffForm" enctype="multipart/form-data" action="@Url.Action("UpdateStaff","AccountStaff")">
                @Html.AntiForgeryToken()
                <div class="modal-body bg-light-subtle p-4">
                    <input type="hidden" name="Id" id="edit_id" value="0" />
                    <input type="hidden" name="q" value="@query" />
                    <input type="hidden" name="pageSize" value="@pageSize" />
                    <input type="hidden" name="ExistingImage" id="edit_existingImage" />
                    <input type="hidden" name="RemoveImage" id="edit_removeImage" value="false" />

                    <div class="mb-3">
                        <label class="form-label"><i class="fa-solid fa-image me-1"></i>Ảnh nhân viên</label>
                        <div class="d-flex align-items-center gap-3">
                            <div>
                                <div id="edit_avatarPlaceholder" class="avatar-placeholder d-none">S</div>
                                <img id="edit_avatarPreview" class="avatar-preview d-none" />
                            </div>
                            <div class="flex-grow-1">
                                <input class="form-control" type="file" id="edit_avatarFile" name="AvatarFile" accept="image/png,image/jpeg,image/jpg,image/webp,image/gif" />
                                <small class="form-text">Hỗ trợ JPG/PNG/WebP/GIF. Tối đa <strong>2MB</strong>.</small>
                                <input type="hidden" name="ExistingImage" id="edit_existingImage" />
                                <input type="hidden" name="RemoveImage" id="edit_removeImage" value="false" />
                            </div>
                        </div>
                        <div class="d-flex gap-2 mt-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('edit_avatarFile').click()"><i class="fa-solid fa-upload me-1"></i>Chọn ảnh</button>
                            <button type="button" class="btn btn-outline-danger btn-sm" onclick="clearAvatar('edit')"><i class="fa-solid fa-trash-can me-1"></i>Xoá ảnh</button>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-lg-6">
                            <label class="form-label"><i class="fa-solid fa-user me-1"></i>Tên nhân viên <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="AccountName" id="edit_accountName" required />
                        </div>
                        <div class="col-lg-6">
                            <label class="form-label"><i class="fa-solid fa-phone me-1"></i>Số điện thoại</label>
                            <input type="text" class="form-control" name="PhoneNumber" id="edit_phoneNumber" />
                        </div>

                        <div class="col-lg-12">
                            <label class="form-label"><i class="fa-solid fa-id-badge me-1"></i>Vai trò <span class="text-danger">*</span></label>
                            <select class="form-select" name="RoleId" id="edit_roleId" required>
                                <option value="">-- Chọn vai trò --</option>
                                @foreach (var r in roles)
                                {
                                    <option value="@((int)r.RoleId)">@r.RoleName</option>
                                }
                            </select>
                        </div>

                        <div class="col-lg-12">
                            <label class="form-label"><i class="fa-solid fa-envelope me-1"></i>Email <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" id="edit_email" readonly />
                            <input type="hidden" name="Email" id="edit_email_hidden" />
                            <small class="form-text"><i class="fa-solid fa-lock me-1"></i>Email không thể thay đổi sau khi tạo</small>
                        </div>

                        <div class="col-lg-12">
                            <label class="form-label"><i class="fa-solid fa-key me-1"></i>Mật khẩu mới <span class="text-muted">(để trống nếu không đổi)</span></label>
                            <input type="password" class="form-control" name="NewPassword" id="edit_newPassword" placeholder="Nhập mật khẩu mới (nếu muốn đổi)" />
                            <small class="form-text text-muted">Tối thiểu 6 ký tự. Bỏ trống nếu không muốn thay đổi mật khẩu.</small>
                        </div>
                        <div class="col-lg-12">
                            <label class="form-label"><i class="fa-solid fa-key me-1"></i>Xác nhận mật khẩu mới</label>
                            <input type="password" class="form-control" name="ConfirmNewPassword" id="edit_confirmNewPassword" placeholder="Nhập lại mật khẩu mới" />
                        </div>

                        <div class="col-lg-12">
                            <label class="form-label"><i class="fa-solid fa-toggle-on me-1"></i>Trạng thái <span class="text-danger">*</span></label>
                            <input type="hidden" name="Status" id="edit_status" value="Active" />
                            <input type="hidden" name="IsDeleted" id="edit_isDeleted" value="false" />
                            <div class="btn-group d-flex" role="group">
                                <input type="radio" class="btn-check" name="edit_statusRadio" id="edit_statusActive" value="Active" onchange="setStatus('edit','Active')" autocomplete="off">
                                <label class="btn btn-outline-success" for="edit_statusActive"><i class="fa-solid fa-circle-check me-1"></i>Hoạt động</label>
                                <input type="radio" class="btn-check" name="edit_statusRadio" id="edit_statusInactive" value="Inactive" onchange="setStatus('edit','Inactive')" autocomplete="off">
                                <label class="btn btn-outline-danger" for="edit_statusInactive"><i class="fa-solid fa-ban me-1"></i>Vô hiệu</label>
                            </div>

                            <div class="info-box small text-muted mt-3">
                                <i class="fa-regular fa-clock me-1"></i>
                                <strong>Ngày tạo:</strong> <span id="edit_createdAt">—</span>
                                <span class="ms-3"><i class="fa-solid fa-rotate me-1"></i><strong>Cập nhật:</strong> <span id="edit_updatedAt">—</span></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><i class="fa-solid fa-xmark me-1"></i>Đóng</button>
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-1"></i>Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />

@section Scripts {
    <script>
        // ===== Status Helper =====
        function setStatus(scope, value) {
            document.getElementById(scope + '_status').value = value;
        }

        // ===== Avatar Preview =====
        function bindAvatarPreview(scope) {
          const file = document.getElementById(scope + '_avatarFile');
          if(!file) return;
          file.addEventListener('change', function(){
            const f = this.files?.[0];
            if(!f) return;
            const img = document.getElementById(scope + '_avatarPreview');
            const ph  = document.getElementById(scope + '_avatarPlaceholder');
            const allowed = ['image/png','image/jpeg','image/jpg','image/webp','image/gif'];
            if(!allowed.includes(f.type.toLowerCase())){ showToast('Chỉ hỗ trợ PNG/JPG/WebP/GIF!', true); file.value=''; return; }
            if(f.size > 2*1024*1024){ showToast('Kích thước ảnh tối đa 2MB.', true); file.value=''; return; }
            const reader = new FileReader();
            reader.onload = (ev)=>{
              if(img){ img.src = ev.target.result; img.classList.remove('d-none'); }
              if(ph) ph.classList.add('d-none');
              const rm = document.getElementById(scope + '_removeImage'); if(rm) rm.value='false';
            };
            reader.readAsDataURL(f);
          });
        }

        // ===== Modals =====
        function openAddModal(){
          const f = document.getElementById('addStaffForm'); if(f) f.reset();
          document.getElementById('add_statusActive').checked = true;
          setStatus('add', 'Active');
          clearAvatar('add');

          const ph = document.getElementById('add_avatarPlaceholder');
          if(ph){ ph.textContent='S'; ph.classList.remove('d-none'); }

          const img = document.getElementById('add_avatarPreview');
          if(img){ img.src=''; img.classList.add('d-none'); }
        }

        function clearAvatar(scope){
          const img = document.getElementById(scope + '_avatarPreview');
          const ph  = document.getElementById(scope + '_avatarPlaceholder');
          const file= document.getElementById(scope + '_avatarFile');
          if(img) img.classList.add('d-none');
          if(ph) ph.classList.remove('d-none');
          if(file) file.value = '';
        }

        function openEditModal(btn){
          const data = {
            id: btn.getAttribute('data-id'),
            name: btn.getAttribute('data-name'),
            email: btn.getAttribute('data-email'),
            phone: btn.getAttribute('data-phone'),
            roleid: btn.getAttribute('data-roleid'),
            image: btn.getAttribute('data-image'),
            status: btn.getAttribute('data-status'),
            isdeleted: btn.getAttribute('data-isdeleted') === 'true',
            created: btn.getAttribute('data-created'),
            updated: btn.getAttribute('data-updated')
          };
          fillEditModal(data);
        }

        function fillEditModal(data){
          document.getElementById('edit_id').value = data.id || '';
          document.getElementById('edit_accountName').value = data.name || '';
          document.getElementById('edit_email').value = data.email || '';
          document.getElementById('edit_email_hidden').value = data.email || '';
          document.getElementById('edit_phoneNumber').value = data.phone || '';
          document.getElementById('edit_roleId').value = data.roleid || '';
          
          // Status radio buttons
          const statusActive = document.getElementById('edit_statusActive');
          const statusInactive = document.getElementById('edit_statusInactive');
          if (data.isdeleted) {
            if (statusInactive) statusInactive.checked = true;
            document.getElementById('edit_status').value = 'Inactive';
            document.getElementById('edit_isDeleted').value = 'true';
          } else {
            const status = data.status || 'Active';
            document.getElementById('edit_status').value = status;
            if (status === 'Active' && statusActive) {
              statusActive.checked = true;
            } else if (statusInactive) {
              statusInactive.checked = true;
            }
            document.getElementById('edit_isDeleted').value = 'false';
          }

          // Clear password fields
          const newPw = document.getElementById('edit_newPassword');
          const confirmPw = document.getElementById('edit_confirmNewPassword');
          if (newPw) newPw.value = '';
          if (confirmPw) confirmPw.value = '';
          
          // Display dates
          const createdAtEl = document.getElementById('edit_createdAt');
          const updatedAtEl = document.getElementById('edit_updatedAt');
          if (createdAtEl) createdAtEl.textContent = data.created ? new Date(data.created).toLocaleString() : '—';
          if (updatedAtEl) updatedAtEl.textContent = data.updated ? new Date(data.updated).toLocaleString() : '—';

          const img = document.getElementById('edit_avatarPreview');
          const ph  = document.getElementById('edit_avatarPlaceholder');
          const ex  = document.getElementById('edit_existingImage');
          const rm  = document.getElementById('edit_removeImage');
          const file= document.getElementById('edit_avatarFile');
          if(file) file.value = '';
          if(rm) rm.value = 'false';

          if(data.image){
            if(img){ img.src = data.image; img.classList.remove('d-none'); }
            if(ph) ph.classList.add('d-none');
            if(ex) ex.value = data.image;
          }else{
            if(img){ img.src=''; img.classList.add('d-none'); }
            if(ph){
              ph.classList.remove('d-none');
              const fc = (data.name || '').trim().charAt(0).toUpperCase() || 'S';
              ph.textContent = fc;
            }
            if(ex) ex.value = '';
          }
        }

        // ===== Page Size Selector =====
        function changePageSize(newPageSize) {
          const query = '@Html.Raw(query ?? "")';
          
          if (query) {
            // Nếu có query, redirect về Search action
            window.location.href = '@Url.Action("Search", "AccountStaff")' + '?q=' + encodeURIComponent(query) + '&page=1&pageSize=' + newPageSize;
          } else {
            // Nếu không có query, redirect về Index action
            window.location.href = '@Url.Action("Index", "AccountStaff")' + '?page=1&pageSize=' + newPageSize;
          }
        }

        // ===== Toast Helper =====
        function showToast(msg, isError){
          alert(msg);
        }

        // ===== DOM Ready =====
        document.addEventListener('DOMContentLoaded', function(){
          bindAvatarPreview('add');
          bindAvatarPreview('edit');

          const addForm = document.getElementById('addStaffForm');
          if(addForm){
            addForm.addEventListener('submit', function(e){
              const roleId = document.getElementById('add_roleId').value;
              const pw  = document.getElementById('add_password').value || '';
              const cpw = document.getElementById('add_confirmPassword').value || '';
              if(!roleId){ e.preventDefault(); showToast('Vui lòng chọn vai trò (Role)!', true); return false; }
              if(pw !== cpw){ e.preventDefault(); showToast('Mật khẩu xác nhận không khớp!', true); return false; }
              if(pw.length < 6){ e.preventDefault(); showToast('Mật khẩu phải có ít nhất 6 ký tự!', true); return false; }
            });
          }

          const editForm = document.getElementById('editStaffForm');
          if(editForm){
            editForm.addEventListener('submit', function(e){
              const roleId = document.getElementById('edit_roleId').value;
              if(!roleId){ e.preventDefault(); showToast('Vui lòng chọn vai trò (Role)!', true); return false; }
              const newPw = document.getElementById('edit_newPassword').value || '';
              const confirmPw = document.getElementById('edit_confirmNewPassword').value || '';
              if(newPw || confirmPw){
                if(newPw !== confirmPw){ e.preventDefault(); showToast('Xác nhận mật khẩu mới không khớp!', true); return false; }
                if(newPw.length < 6){ e.preventDefault(); showToast('Mật khẩu mới phải có ít nhất 6 ký tự!', true); return false; }
              }
            });
          }

          // Tự mở modal nếu server yêu cầu
          const showAddModal = '@((ViewBag.ShowAddModal == true) ? "true" : "false")';
          const hasEditData = '@((edit != null) ? "true" : "false")';
          
          if(showAddModal === 'true'){
            console.log('Opening Add Modal with error data');
            try{
              const addDataStr = '@Html.Raw(JsonSerializer.Serialize(ViewBag.AddStaffModel ?? new BLL.DTOs.AccountDto()))';
              const addData = addDataStr ? JSON.parse(addDataStr) : {};
              
              if(addData.AccountName || addData.Email){
                document.getElementById('add_accountName').value = addData.AccountName || addData.accountName || '';
                document.getElementById('add_phoneNumber').value = addData.PhoneNumber || addData.phoneNumber || '';
                document.getElementById('add_roleId').value = addData.RoleId || addData.roleId || '';
                document.getElementById('add_email').value = addData.Email || addData.email || '';
                console.log('Restored add form data:', addData);
              }
              
              new bootstrap.Modal(document.getElementById('addStaffModal')).show();
            }catch(e){ 
              console.error('Error loading add modal:', e); 
            }
          }
          else if(hasEditData === 'true'){
            console.log('Opening Edit Modal');
            try{
              const raw='@Html.Raw(JsonSerializer.Serialize(edit ?? new BLL.DTOs.AccountDto()))';
              const dto = raw ? JSON.parse(raw) : {};
              fillEditModal({
                id: dto.id || dto.Id || 0,
                name: dto.accountName || dto.AccountName || '',
                phone: dto.phoneNumber || dto.PhoneNumber || '',
                roleid: (dto.roleId ?? dto.RoleId) ? String(dto.roleId ?? dto.RoleId) : '',
                email: dto.email || dto.Email || '',
                image: dto.image || dto.Image || '',
                status: dto.status || dto.Status || '',
                isdeleted: (dto.isDeleted ?? dto.IsDeleted) ? true : false,
                created: dto.createdAt || dto.CreatedAt || '',
                updated: dto.updatedAt || dto.UpdatedAt || ''
              });
              new bootstrap.Modal(document.getElementById('editStaffModal')).show();
            }catch(e){ console.error('Error loading edit modal:', e); }
          }

          const hasError='@((ViewBag.ShowErrorModal == true) ? "true" : "false")';
          if(hasError==='true'){
            const msg = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ErrorMessage ?? ""));
            if (msg) showToast(msg, true);
          }

        });
    </script>
}