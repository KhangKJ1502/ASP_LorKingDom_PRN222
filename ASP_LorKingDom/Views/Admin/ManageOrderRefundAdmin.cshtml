@using BLL.DTOs
@model PagedResult<BLL.DTOs.OrderRefundDto>

@{
    ViewData["Title"] = "Quản lý hoàn tiền / hoàn trả - ToyLand Admin";
    Layout = "_AdminLayout";

    var q = (string?)ViewBag.Query ?? "";
    var statusFilter = (string?)ViewBag.StatusFilter ?? "";
    var dateFromFilter = (string?)ViewBag.DateFromFilter ?? "";
    var dateToFilter = (string?)ViewBag.DateToFilter ?? "";

    var currentPage = (int?)ViewBag.CurrentPage ?? 1;
    var pageSize = (int?)ViewBag.PageSize ?? 10;
    var totalRecords = (int?)ViewBag.TotalRecords ?? 0;
    var totalPages = (int?)ViewBag.TotalPages ?? 1;
}

<link rel="stylesheet" href="~/css/admin-order-refund.css" asp-append-version="true" />

<div class="container-fluid px-5">
    <h1 class="mt-4">Quản Lý Hoàn Tiền / Hoàn Trả</h1>

    <!-- Success Toast -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="toast-container position-fixed p-3" style="top: 20px; right: 20px; z-index: 2080;">
            <div class="toast align-items-center text-bg-success border-0 show" role="alert">
                <div class="d-flex">
                    <div class="toast-body fs-5 fw-semibold">
                        <i class="fa-solid fa-circle-check me-2"></i>
                        @TempData["SuccessMessage"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        </div>
    }

    <!-- Error Toast -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="toast-container position-fixed p-3" style="top: 20px; right: 20px; z-index: 2080;">
            <div class="toast align-items-center text-bg-danger border-0 show" role="alert">
                <div class="d-flex">
                    <div class="toast-body fs-5 fw-semibold">
                        <i class="fa-solid fa-circle-exclamation me-2"></i>
                        @TempData["ErrorMessage"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        </div>
    }

    <div class="card mb-4 mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <i class="fa-solid fa-rotate-left me-2"></i>Danh Sách Yêu Cầu Hoàn Tiền
            </div>
            <span class="badge bg-primary rounded-pill">@totalRecords yêu cầu</span>
        </div>

        <div class="card-body">
            <!-- Bộ lọc / tìm kiếm -->
            <form class="mb-4" method="get" asp-action="Search" asp-controller="OrderRefundAdmin">
                <div class="row g-2 mb-3">
                    <div class="col-md-3">
                        <input type="text" name="keyword" value="@q" class="form-control"
                               placeholder="Tìm theo RefundID, OrderID, tên người yêu cầu...">
                    </div>

                    <div class="col-md-2">
                        <select name="status" class="form-control">
                            <option value="">Tất cả trạng thái</option>
                            <option value="Requested" selected="@(statusFilter == "Requested")">Yêu cầu hoàn tiền</option>
                            <option value="Approved" selected="@(statusFilter == "Approved")">Đã duyệt</option>
                            <option value="Rejected" selected="@(statusFilter == "Rejected")">Từ chối</option>
                            <option value="Processing" selected="@(statusFilter == "Processing")">Đang xử lý</option>
                            <option value="Refunded" selected="@(statusFilter == "Refunded")">Đã hoàn tiền</option>
                            <option value="Cancelled" selected="@(statusFilter == "Cancelled")">Đã hủy</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <input type="date" name="dateFrom" value="@dateFromFilter" class="form-control">
                    </div>
                    <div class="col-md-2">
                        <input type="date" name="dateTo" value="@dateToFilter" class="form-control">
                    </div>

                    <div class="col-md-2">
                        <button class="btn btn-primary w-100" type="submit">
                            <i class="fa-solid fa-magnifying-glass"></i> Tìm kiếm
                        </button>
                    </div>
                    
                    <div class="col-md-1">
                        <button class="btn btn-outline-secondary w-100" type="button" 
                                onclick="window.location.href='@Url.Action("Index", "OrderRefundAdmin")'">
                            <i class="fa-solid fa-times"></i> Xóa
                        </button>
                    </div>
                </div>
                <input type="hidden" name="pageSize" value="@pageSize" />
            </form>

            <!-- Page Size Selector -->
            <div class="mb-3 d-flex justify-content-between align-items-center">
                <div>
                    <label for="pageSizeSelect" class="form-label mb-0 me-2">Hiển thị:</label>
                    <select id="pageSizeSelect" class="form-select form-select-sm d-inline-block" style="width: auto;" onchange="changePageSize(this.value)">
                        <option value="5" selected="@(pageSize == 5)">5</option>
                        <option value="10" selected="@(pageSize == 10)">10</option>
                        <option value="20" selected="@(pageSize == 20)">20</option>
                        <option value="50" selected="@(pageSize == 50)">50</option>
                        <option value="100" selected="@(pageSize == 100)">100</option>
                    </select>
                    <span class="ms-2 text-muted">yêu cầu mỗi trang</span>
                </div>
                <div class="text-muted">
                    Trang @currentPage / @totalPages (Tổng @totalRecords yêu cầu)
                </div>
            </div>

            <!-- Bảng refund -->
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th style="width:100px; text-align:center;">RefundID</th>
                            <th>Đơn hàng</th>
                            <th>Người yêu cầu</th>
                            <th>Người duyệt</th>
                            <th style="width:120px;">Trạng thái</th>
                            <th style="width:130px;">Phương thức</th>
                            <th style="width:160px;">Thời gian tạo</th>
                            <th style="width:160px;">Duyệt lúc</th>
                            <th style="width:160px; text-align:center;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.Items?.Any() == true)
                        {
                            foreach (var refund in Model.Items)
                            {
                                var refundClass = refund.RefundStatus switch
                                {
                                    "Requested" => "refund-requested",
                                    "Approved" => "refund-approved",
                                    "Rejected" => "refund-rejected",
                                    "Refunded" => "refund-refunded",
                                    "Processing" => "refund-processing",
                                    "Cancelled" => "refund-cancelled",
                                    _ => "refund-unknown"
                                };

                                <tr>
                                    <td style="text-align:center;">
                                        <a href="javascript:void(0)"
                                           class="refund-id"
                                           onclick="viewRefundDetail(@refund.RefundId)">
                                            #@refund.RefundId.ToString().PadLeft(6, '0')
                                        </a>
                                    </td>

                                    <td>
                                        <div class="fw-semibold text-dark">
                                            @(refund.OrderCode ?? $"Order #{refund.OrderId}")
                                        </div>
                                        <div class="text-muted small">
                                            ID: @refund.OrderId
                                        </div>
                                    </td>

                                    <td>
                                        <p class="customer-name mb-0">
                                            @(refund.RequestedByName ?? $"Account #{refund.RequestedBy}")
                                        </p>
                                        <div class="account-hint">
                                            ID: @refund.RequestedBy
                                        </div>
                                    </td>

                                    <td>
                                        @if (refund.ApprovedBy != null)
                                        {
                                            <p class="customer-name mb-0">
                                                @(refund.ApprovedByName ?? $"Staff #{refund.ApprovedBy}")
                                            </p>
                                            <div class="account-hint">
                                                Đã duyệt
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>

                                    <td>
                                        <span class="refund-badge @refundClass">
                                            @refund.RefundStatusDisplay
                                        </span>
                                    </td>

                                    <td>
                                        <div class="text-dark fw-semibold">@refund.RefundMode</div>
                                        @if (refund.WalletTransactionId != null)
                                        {
                                            <div class="text-muted small">
                                                Txn: @refund.WalletTransactionId
                                            </div>
                                        }
                                    </td>

                                    <td>
                                        <div class="text-dark fw-semibold">
                                            @refund.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                        <div class="text-muted small">
                                            Tạo yêu cầu
                                        </div>
                                    </td>

                                    <td>
                                        @if (refund.ApprovedAt.HasValue)
                                        {
                                            <div class="text-dark fw-semibold">
                                                @refund.ApprovedAt.Value.ToString("dd/MM/yyyy HH:mm")
                                            </div>
                                            <div class="text-muted small">
                                                Duyệt yêu cầu
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>

                                    <td style="text-align:center;">
                                        @if (refund.RefundStatus == "Requested")
                                        {
                                            <button type="button" class="btn btn-sm btn-success me-1"
                                                    onclick="updateRefundStatus(@refund.RefundId, 'Approved')"
                                                    title="Duyệt yêu cầu">
                                                <i class="fas fa-check-circle"></i> Duyệt
                                            </button>

                                            <button type="button" class="btn btn-sm btn-danger"
                                                    onclick="updateRefundStatus(@refund.RefundId, 'Rejected')"
                                                    title="Từ chối">
                                                <i class="fas fa-times-circle"></i> Từ chối
                                            </button>
                                        }
                                        else if (refund.RefundStatus == "Approved")
                                        {
                                            <button type="button" class="btn btn-sm btn-primary"
                                                    onclick="confirmRefundToWallet(@refund.RefundId, '@refund.RefundMode')"
                                                    title="Xác nhận hoàn tiền vào ví">
                                                <i class="fas fa-money-bill-wave"></i> Hoàn tiền
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-secondary"
                                                    onclick="viewRefundDetail(@refund.RefundId)"
                                                    title="Xem chi tiết">
                                                <i class="fas fa-eye"></i> Chi tiết
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">
                                    <i class="fas fa-inbox me-2"></i>Không có yêu cầu hoàn tiền nào.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (totalPages > 1)
            {
                var hasFilter = !string.IsNullOrWhiteSpace(q) || !string.IsNullOrWhiteSpace(statusFilter) || !string.IsNullOrWhiteSpace(dateFromFilter) || !string.IsNullOrWhiteSpace(dateToFilter);
                var actionName = hasFilter ? "Search" : "Index";
                
                <nav class="mt-4" aria-label="Refund pagination">
                    <ul class="pagination justify-content-center">
                        <!-- Previous Button -->
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            @if (hasFilter)
                            {
                                <a class="page-link"
                                   href="@Url.Action("Search", new { keyword = q, status = statusFilter, dateFrom = dateFromFilter, dateTo = dateToFilter, page = currentPage - 1, pageSize })">
                                    « Trước
                                </a>
                            }
                            else
                            {
                                <a class="page-link"
                                   href="@Url.Action("Index", new { page = currentPage - 1, pageSize })">
                                    « Trước
                                </a>
                            }
                        </li>

                        @{
                            int startPage = Math.Max(1, currentPage - 2);
                            int endPage = Math.Min(totalPages, currentPage + 2);

                            if (startPage > 1)
                            {
                                if (hasFilter)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Search", new { keyword = q, status = statusFilter, dateFrom = dateFromFilter, dateTo = dateToFilter, page = 1, pageSize })">1</a>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", new { page = 1, pageSize })">1</a>
                                    </li>
                                }
                                if (startPage > 2)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                            }

                            for (int i = startPage; i <= endPage; i++)
                            {
                                if (hasFilter)
                                {
                                    <li class="page-item @(i == currentPage ? "active" : "")">
                                        <a class="page-link"
                                           href="@Url.Action("Search", new { keyword = q, status = statusFilter, dateFrom = dateFromFilter, dateTo = dateToFilter, page = i, pageSize })">
                                            @i
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item @(i == currentPage ? "active" : "")">
                                        <a class="page-link"
                                           href="@Url.Action("Index", new { page = i, pageSize })">
                                            @i
                                        </a>
                                    </li>
                                }
                            }

                            if (endPage < totalPages)
                            {
                                if (endPage < totalPages - 1)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                                if (hasFilter)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Search", new { keyword = q, status = statusFilter, dateFrom = dateFromFilter, dateTo = dateToFilter, page = totalPages, pageSize })">@totalPages</a>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", new { page = totalPages, pageSize })">@totalPages</a>
                                    </li>
                                }
                            }
                        }

                        <!-- Next Button -->
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            @if (hasFilter)
                            {
                                <a class="page-link"
                                   href="@Url.Action("Search", new { keyword = q, status = statusFilter, dateFrom = dateFromFilter, dateTo = dateToFilter, page = currentPage + 1, pageSize })">
                                    Sau »
                                </a>
                            }
                            else
                            {
                                <a class="page-link"
                                   href="@Url.Action("Index", new { page = currentPage + 1, pageSize })">
                                    Sau »
                                </a>
                            }
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

<!-- SweetAlert2 CSS & JS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<!-- Modal Chi tiết Refund -->
<div class="modal fade" id="refundDetailModal" tabindex="-1" aria-labelledby="refundDetailLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="refundDetailLabel">
                    <i class="fa-solid fa-rotate-left me-2"></i>Chi tiết hoàn tiền
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body" id="refundDetailContent">
                <div class="modal-spinner" id="modalSpinner">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Đang tải...</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-hide toasts after 5 seconds
        document.addEventListener('DOMContentLoaded', function() {
            const toasts = document.querySelectorAll('.toast');
            toasts.forEach(toast => {
                setTimeout(() => {
                    toast.classList.remove('show');
                }, 5000);
            });
        });

        async function viewRefundDetail(refundId) {
            const id = parseInt(refundId, 10);
            if (isNaN(id) || id <= 0) {
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi!',
                    text: 'ID hoàn tiền không hợp lệ',
                    confirmButtonColor: '#667eea'
                });
                return;
            }

            const modalEl = document.getElementById('refundDetailModal');
            const modal = new bootstrap.Modal(modalEl);
            const spinner = document.getElementById('modalSpinner');
            const content = document.getElementById('refundDetailContent');

            // Show modal with spinner
            spinner.classList.remove('hide');
            content.innerHTML = '<div class="modal-spinner" id="modalSpinner"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Đang tải...</span></div></div>';
            modal.show();

            try {
                const response = await fetch(`/OrderRefundAdmin/GetRefundDetail/${refundId}`, {
                    method: 'GET',
                    headers: {
                        'Accept': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                if (!response.ok) {
                    const errorData = await response.json();
                    throw new Error(errorData.message || `HTTP ${response.status}`);
                }

                const r = await response.json();

                // Format dates
                const createdAtFmt = formatDate(r.createdAt);
                const approvedAtFmt = r.approvedAt ? formatDate(r.approvedAt) : 'Chưa duyệt';
                const processedAtFmt = r.processedAt ? formatDate(r.processedAt) : 'Chưa xử lý';

                // Build timeline steps
                let stepsHtml = '';
                if (r.steps && r.steps.length > 0) {
                    stepsHtml = r.steps.map(step => `
                        <div class="detail-row">
                            <span class="detail-label">${escapeHtml(step.label)}</span>
                            <span class="detail-value">${formatDate(step.at)}</span>
                        </div>
                    `).join('');
                } else {
                    stepsHtml = '<div class="text-muted small">Chưa có hoạt động xử lý nào.</div>';
                }

                // Build HTML content
                const htmlContent = `
                    <div class="row g-3">
                        <div class="col-md-12">
                            <div class="refund-detail-section">
                                <h6><i class="fas fa-info-circle me-2"></i>Thông tin hoàn tiền</h6>
                                <div class="detail-row">
                                    <span class="detail-label">Refund ID:</span>
                                    <span class="detail-value">#${r.refundId.toString().padStart(6,'0')}</span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Đơn hàng:</span>
                                    <span class="detail-value">${escapeHtml(r.orderCode || ("Order #" + r.orderId))}</span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Trạng thái:</span>
                                    <span class="detail-value">${escapeHtml(r.refundStatusDisplay || r.refundStatus)}</span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Phương thức hoàn:</span>
                                    <span class="detail-value">${escapeHtml(r.refundMode || '-')}</span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Ví giao dịch:</span>
                                    <span class="detail-value">${r.walletTransactionId || '-'}</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="refund-detail-section">
                                <h6><i class="fas fa-user me-2"></i>Người liên quan</h6>
                                <div class="detail-row">
                                    <span class="detail-label">Người yêu cầu:</span>
                                    <span class="detail-value">${escapeHtml(r.requestedByName || 'Không rõ')}</span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Người duyệt:</span>
                                    <span class="detail-value">${escapeHtml(r.approvedByName || '-')}</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="refund-detail-section">
                                <h6><i class="fas fa-clock me-2"></i>Thời gian xử lý</h6>
                                <div class="detail-row">
                                    <span class="detail-label">Tạo yêu cầu:</span>
                                    <span class="detail-value">${createdAtFmt}</span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Duyệt lúc:</span>
                                    <span class="detail-value">${approvedAtFmt}</span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Hoàn tất xử lý:</span>
                                    <span class="detail-value">${processedAtFmt}</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="refund-detail-section">
                                <h6><i class="fas fa-comments me-2"></i>Lý do yêu cầu</h6>
                                <div class="detail-row">
                                    <span class="detail-value" style="margin-left:auto; text-align:left; max-width:100%;">
                                        ${escapeHtml(r.reason || 'Không cung cấp lý do')}
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="refund-detail-section">
                                <h6><i class="fas fa-stream me-2"></i>Timeline xử lý</h6>
                                ${stepsHtml}
                            </div>
                        </div>

                        <div class="col-md-12">
                            <div class="total-section">
                                <div class="total-row">
                                    <span>Số tiền đơn hàng:</span>
                                    <span>${formatCurrency(r.totalAmount || 0)}đ</span>
                                </div>
                                <div class="total-row grand">
                                    <span>Số tiền hoàn:</span>
                                    <span>${formatCurrency(r.refundAmount || 0)}đ</span>
                                </div>
                            </div>
                        </div>
                    </div>
                `;

                content.innerHTML = htmlContent;

            } catch (error) {
                content.innerHTML = `<div class="alert alert-danger"><i class="fas fa-exclamation-circle me-2"></i>Lỗi tải dữ liệu: ${escapeHtml(error.message)}</div>`;
                console.error('Error loading refund detail:', error);
            }
        }

        function changePageSize(newPageSize) {
            const hasFilter = '@q' || '@statusFilter' || '@dateFromFilter' || '@dateToFilter';
            if (hasFilter) {
                window.location.href = '@Url.Action("Search", "OrderRefundAdmin")' +
                    '?keyword=@q' +
                    '&status=@statusFilter' +
                    '&dateFrom=@dateFromFilter' +
                    '&dateTo=@dateToFilter' +
                    '&page=1' +
                    '&pageSize=' + newPageSize;
            } else {
                window.location.href = '@Url.Action("Index", "OrderRefundAdmin")' +
                    '?page=1' +
                    '&pageSize=' + newPageSize;
            }
        }

        async function updateRefundStatus(refundId, newStatus) {
            if (!refundId || refundId <= 0 || !newStatus) {
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi!',
                    text: 'Dữ liệu không hợp lệ',
                    confirmButtonColor: '#667eea'
                });
                return;
            }

            // Confirm message
            let confirmMsg = '';
            let confirmTitle = '';
            let confirmIcon = 'question';
            
            switch(newStatus) {
                case 'Approved':
                    confirmTitle = 'Duyệt yêu cầu hoàn tiền?';
                    confirmMsg = 'Bạn có chắc muốn DUYỆT yêu cầu hoàn tiền này?';
                    confirmIcon = 'question';
                    break;
                case 'Rejected':
                    confirmTitle = 'Từ chối yêu cầu?';
                    confirmMsg = 'Bạn có chắc muốn TỪ CHỐI yêu cầu hoàn tiền này?';
                    confirmIcon = 'warning';
                    break;
                case 'Refunded':
                    confirmTitle = 'Xác nhận hoàn tiền?';
                    confirmMsg = 'Xác nhận đã HOÀN TIỀN cho khách hàng?';
                    confirmIcon = 'success';
                    break;
                case 'Cancelled':
                    confirmTitle = 'Hủy yêu cầu?';
                    confirmMsg = 'Bạn có chắc muốn HỦY yêu cầu hoàn tiền này?';
                    confirmIcon = 'warning';
                    break;
                default:
                    confirmTitle = 'Xác nhận?';
                    confirmMsg = 'Bạn có chắc muốn thực hiện hành động này?';
                    confirmIcon = 'question';
            }

            const result = await Swal.fire({
                icon: confirmIcon,
                title: confirmTitle,
                text: confirmMsg,
                showCancelButton: true,
                confirmButtonColor: '#667eea',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Xác nhận',
                cancelButtonText: 'Hủy bỏ',
                reverseButtons: true
            });

            if (!result.isConfirmed) {
                return;
            }

            submitRefundStatus(refundId, newStatus);
        }


        // Hàm xác nhận hoàn tiền vào ví
        async function confirmRefundToWallet(refundId, refundMode, refundAmount = null) {
            try {
                // 1) Nếu chưa có refundAmount thì gọi API lấy chi tiết
                if (refundAmount == null) {
                    // Mở loading - KHÔNG await
                    Swal.fire({
                        title: 'Đang tải số tiền hoàn...',
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });

                    // Dựng URL đúng với [HttpGet("GetRefundDetail/{id}")]
                    // Url.Action trả về "/OrderRefundAdmin/GetRefundDetail"
                    const baseDetailUrl = '@Url.Action("GetRefundDetail", "OrderRefundAdmin")';
                    const detailUrl = `${baseDetailUrl}/${encodeURIComponent(refundId)}`;

                    const res = await fetch(detailUrl, {
                        method: 'GET',
                        headers: {
                            'Accept': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    // Đọc text trước để phòng trường hợp server trả HTML (redirect/401/404)
                    const text = await res.text();
                    let payload = null;
                    try { payload = JSON.parse(text); } catch { payload = null; }

                    if (!res.ok) {
                        const msg = (payload && payload.message) || `HTTP ${res.status}`;
                        throw new Error(msg);
                    }
                    if (!payload) {
                        throw new Error('Phản hồi không phải JSON hợp lệ');
                    }

                    refundAmount = Number(payload.refundAmount) || 0;
                    Swal.close();
                }

                // 2) Hiển thị confirm theo RefundMode
                const amountFormatted = new Intl.NumberFormat('vi-VN').format(refundAmount);
                let confirmMessage = '';
                let confirmIcon = 'question';

                if (refundMode === 'Wallet') {
                    confirmMessage =
                        `Xác nhận hoàn <strong style="color:#f97316;">${amountFormatted}đ</strong> vào ví LorKingDom của khách hàng?<br><br>` +
                        `<div style="background:#d1fae5;padding:12px;border-radius:8px;margin-top:10px;">` +
                        `<span style="color:#059669;font-weight:600;">✓ Tiền sẽ tự động được cộng vào số dư ví</span>` +
                        `</div>`;
                } else if (refundMode === 'BankTransfer') {
                    confirmMessage =
                        `Xác nhận bạn đã chuyển khoản <strong style="color:#f97316;">${amountFormatted}đ</strong> cho khách hàng?<br><br>` +
                        `<div style="background:#fee2e2;padding:12px;border-radius:8px;margin-top:10px;">` +
                        `<span style="color:#dc2626;font-weight:600;">⚠ Hãy đảm bảo bạn đã thực hiện chuyển khoản ngân hàng</span>` +
                        `</div>`;
                    confirmIcon = 'warning';
                } else {
                    confirmMessage =
                        `Xác nhận đã hoàn <strong style="color:#f97316;">${amountFormatted}đ</strong> cho khách hàng bằng phương thức <strong>${refundMode}</strong>?`;
                }

                const result = await Swal.fire({
                    icon: confirmIcon,
                    title: 'Xác nhận hoàn tiền',
                    html: confirmMessage,
                    showCancelButton: true,
                    confirmButtonColor: '#10b981',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: '<i class="fas fa-check me-2"></i>Xác nhận hoàn tiền',
                    cancelButtonText: 'Hủy bỏ',
                    reverseButtons: true,
                    width: '500px'
                });

                if (result.isConfirmed) {
                    submitRefundStatus(refundId, 'Refunded');
                }
            } catch (err) {
                Swal.close();
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi',
                    text: `Không lấy được thông tin hoàn tiền: ${(err && err.message) || 'Không xác định'}`
                });
                console.error('confirmRefundToWallet error:', err);
            }
        }


        // Hàm submit form 
        function submitRefundStatus(refundId, newStatus) {
            // Create and submit form
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/OrderRefundAdmin/UpdateStatus';

            // Add refundId
            const refundIdInput = document.createElement('input');
            refundIdInput.type = 'hidden';
            refundIdInput.name = 'refundId';
            refundIdInput.value = refundId;
            form.appendChild(refundIdInput);

            // Add newStatus
            const statusInput = document.createElement('input');
            statusInput.type = 'hidden';
            statusInput.name = 'newStatus';
            statusInput.value = newStatus;
            form.appendChild(statusInput);

            // Add anti-forgery token
            const tokenInput = document.createElement('input');
            tokenInput.type = 'hidden';
            tokenInput.name = '__RequestVerificationToken';
            tokenInput.value = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)?.[1] || '';
            form.appendChild(tokenInput);

            document.body.appendChild(form);
            form.submit();
        }


        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function formatCurrency(value) {
            if (typeof value !== 'number' || value < 0) return '0';
            return value.toLocaleString('vi-VN');
        }

        function formatDate(dateStr) {
            if (!dateStr) return '-';
            try {
                const date = new Date(dateStr);
                const day = String(date.getDate()).padStart(2, '0');
                const month = String(date.getMonth() + 1).padStart(2, '0');
                const year = date.getFullYear();
                const hours = String(date.getHours()).padStart(2, '0');
                const minutes = String(date.getMinutes()).padStart(2, '0');
                return `${day}/${month}/${year} ${hours}:${minutes}`;
            } catch (e) {
                return dateStr;
            }
        }
    </script>
}