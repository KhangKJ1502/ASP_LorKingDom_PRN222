@using System.Linq
@using Microsoft.AspNetCore.Html
@using BLL.DTOs
@model BLL.DTOs.PagedResult<BLL.DTOs.AccountDto>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản Lý Khách Hàng";
    var query = (string?)ViewBag.Query ?? "";
    var edit = ViewBag.EditCustomer as BLL.DTOs.AccountDto;
    
    var currentPage = Model?.Page ?? 1;
    var pageSize = Model?.PageSize ?? 10;
    var totalRows = Model?.Total ?? 0;
    var totalPages = Model?.TotalPages ?? 1;
    if (totalPages < 1) totalPages = 1;
}

<link rel="stylesheet" href="~/css/admin-customer.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container-fluid px-5">
    <h1 class="mt-4">Quản Lý Khách Hàng</h1>

    <div class="card mb-4 mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div><i class="fa-solid fa-users me-1"></i> Danh Sách Khách Hàng</div>
        </div>

        <div class="card-body">
            <div class="row mb-4">
                <div class="col-md-8">
                    <form method="get" asp-action="Search" asp-controller="AccountCustomer" id="searchForm">
                        <div class="input-group search-box">
                            <input type="text" name="q" value="@query" class="form-control" placeholder="Tìm theo tên, email, số điện thoại...">
                            <input type="hidden" name="pageSize" value="@(Model?.PageSize ?? 10)" />
                            <button class="btn btn-outline-secondary" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
                            @if (!string.IsNullOrWhiteSpace(query))
                            {
                                <a href="@Url.Action("Index", "AccountCustomer", new { pageSize = Model?.PageSize ?? 10 })" class="btn btn-outline-danger" title="Xóa tìm kiếm">
                                    <i class="fa-solid fa-times"></i>
                                </a>
                            }
                        </div>
                    </form>
                </div>
                <div class="col-md-4">
                    <div class="d-flex align-items-center justify-content-end">
                        <label class="me-2 mb-0">Hiển thị:</label>
                        <select class="form-select form-select-sm" style="width: auto;" id="pageSizeSelector" onchange="changePageSize(this.value)">
                            @{
                                var currentPageSize = Model?.PageSize ?? 10;
                            }
                            <option value="5" selected="@(currentPageSize == 5)">5</option>
                            <option value="10" selected="@(currentPageSize == 10)">10</option>
                            <option value="20" selected="@(currentPageSize == 20)">20</option>
                            <option value="50" selected="@(currentPageSize == 50)">50</option>
                            <option value="100" selected="@(currentPageSize == 100)">100</option>
                        </select>
                        <span class="ms-2 text-muted">mục/trang</span>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th style="white-space:nowrap">ID</th>
                            <th style="white-space:nowrap">Hành Động</th>
                            <th>Avatar</th>
                            <th>Tên khách hàng</th>
                            <th>Email</th>
                            <th>Số điện thoại</th>
                            <th>Đăng nhập</th>
                            <th style="white-space:nowrap">Trạng Thái</th>
                            <th style="white-space:nowrap">Ngày Tạo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Items != null && Model.Items.Any())
                        {
                            foreach (var customer in Model.Items)
                            {
                                <tr class="@(customer.IsDeleted ? "deleted-row" : "")">
                                    <td>@customer.Id</td>
                                    <td style="white-space:nowrap">
                                        <a class="btn btn-sm btn-warning" title="Cập nhật"
                                           asp-action="Edit" asp-controller="AccountCustomer"
                                           asp-route-id="@customer.Id" asp-route-q="@query" asp-route-pageSize="@pageSize">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>
                                        
                                        @if (!customer.IsDeleted)
                                        {
                                            <form method="post" asp-action="BlockAccount" asp-controller="AccountCustomer" 
                                                  style="display:inline;" onsubmit="return confirmBlockCustomer(event);">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@customer.Id" />
                                                <input type="hidden" name="q" value="@query" />
                                                <input type="hidden" name="pageSize" value="@pageSize" />
                                                <button type="submit" class="btn btn-sm btn-danger" title="Vô hiệu hóa">
                                                    <i class="fa-solid fa-ban"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form method="post" asp-action="UnblockAccount" asp-controller="AccountCustomer" 
                                                  style="display:inline;" onsubmit="return confirmUnblockCustomer(event);">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@customer.Id" />
                                                <input type="hidden" name="q" value="@query" />
                                                <input type="hidden" name="pageSize" value="@pageSize" />
                                                <button type="submit" class="btn btn-sm btn-success" title="Khôi phục">
                                                    <i class="fa-solid fa-rotate-left"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(customer.Image))
                                        {
                                            <img src="@customer.Image" alt="Avatar" class="customer-avatar" />
                                        }
                                        else
                                        {
                                            <div class="avatar-placeholder-small">
                                                @(customer.AccountName?.Substring(0, 1).ToUpper() ?? "U")
                                            </div>
                                        }
                                    </td>
                                    <td>@customer.AccountName</td>
                                    <td>@customer.Email</td>
                                    <td>@(customer.PhoneNumber ?? "—")</td>
                                    <td>
                                        @if (customer.Provider == "Google")
                                        {
                                            <span class="badge bg-danger">
                                                <i class="fa-brands fa-google me-1"></i>Google
                                            </span>
                                        }
                                        else if (customer.Provider == "Facebook")
                                        {
                                            <span class="badge bg-info">
                                                <i class="fa-brands fa-facebook me-1"></i>Facebook
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="fa-solid fa-user me-1"></i>Local
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (customer.IsDeleted)
                                        {
                                            <span class="badge bg-secondary">Đã vô hiệu</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-@(customer.Status == "Active" ? "success" : "warning")">
                                                @(customer.Status == "Active" ? "Hoạt động" : "Không hoạt động")
                                            </span>
                                        }
                                    </td>
                                    <td>@customer.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted">Không có dữ liệu.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* PAGINATION *@
            @if (totalPages > 1)
            {
                Func<int, IHtmlContent> PageItem = (int p) =>
                {
                    var active = p == currentPage ? "active" : "";
                    var action = string.IsNullOrWhiteSpace(query) ? "Index" : "Search";
                    var url = string.IsNullOrWhiteSpace(query)
                        ? Url.Action(action, "AccountCustomer", new { page = p, pageSize = pageSize })
                        : Url.Action(action, "AccountCustomer", new { q = query, page = p, pageSize = pageSize });
                    return new HtmlString($@"
                        <li class=""page-item {active}"">
                        <a class=""page-link"" href=""{url}"">{p}</a>
                        </li>
                        ");
                };

                Func<string, IHtmlContent> DisabledDots = (string text) =>
                {
                    return new HtmlString($@"
                        <li class=""page-item disabled"">
                        <span class=""page-link"">{text}</span>
                        </li>
                        ");
                };

                var prevDisabled = currentPage <= 1;
                var nextDisabled = currentPage >= totalPages;
                var prevPage = prevDisabled ? 1 : currentPage - 1;
                var nextPage = nextDisabled ? totalPages : currentPage + 1;

                var action = string.IsNullOrWhiteSpace(query) ? "Index" : "Search";
                var prevUrl = prevDisabled
                    ? "#"
                    : string.IsNullOrWhiteSpace(query)
                        ? Url.Action(action, "AccountCustomer", new { page = prevPage, pageSize = pageSize })
                        : Url.Action(action, "AccountCustomer", new { q = query, page = prevPage, pageSize = pageSize });

                var nextUrl = nextDisabled
                    ? "#"
                    : string.IsNullOrWhiteSpace(query)
                        ? Url.Action(action, "AccountCustomer", new { page = nextPage, pageSize = pageSize })
                        : Url.Action(action, "AccountCustomer", new { q = query, page = nextPage, pageSize = pageSize });

                <nav>
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(prevDisabled ? "disabled" : "")">
                            <a class="page-link" href="@prevUrl" aria-disabled="@(prevDisabled ? "true" : "false")">«</a>
                        </li>

                        @{
                            var windowSize = 1;
                            var startPage = currentPage - windowSize;
                            var endPage = currentPage + windowSize;
                            if (startPage < 1) startPage = 1;
                            if (endPage > totalPages) endPage = totalPages;

                            @PageItem(1);

                            if (startPage > 2)
                            {
                                @DisabledDots("...");
                            }

                            for (int p = startPage; p <= endPage; p++)
                            {
                                if (p != 1 && p != totalPages)
                                {
                                    @PageItem(p);
                                }
                            }

                            if (endPage < totalPages - 1)
                            {
                                @DisabledDots("...");
                            }

                            if (totalPages > 1)
                            {
                                @PageItem(totalPages);
                            }
                        }

                        <li class="page-item @(nextDisabled ? "disabled" : "")">
                            <a class="page-link" href="@nextUrl" aria-disabled="@(nextDisabled ? "true" : "false")">»</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

<!-- Modal Edit Customer -->
<div class="modal fade" id="customerModal" tabindex="-1" aria-labelledby="customerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="customerModalLabel" class="modal-title text-white">
                    <i class="fa-solid fa-user-pen me-2"></i>
                    Cập nhật thông tin khách hàng
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form method="post" asp-action="SaveCustomer" asp-controller="AccountCustomer" id="customerForm">
                @Html.AntiForgeryToken()
                <div class="modal-body" style="background: #f8fafc;">
                    <input type="hidden" name="Id" id="customerId" value="@(edit?.Id ?? 0)" />
                    <input type="hidden" name="q" value="@query" />
                    <input type="hidden" name="pageSize" value="@pageSize" />

                    <div class="row g-3">
                        <!-- Avatar Preview -->
                        @if (edit != null)
                        {
                            <div class="col-12 text-center mb-3">
                                @if (!string.IsNullOrEmpty(edit.Image))
                                {
                                    <img src="@edit.Image" alt="Avatar" class="avatar-preview" style="width: 120px; height: 120px; border-radius: 50%; object-fit: cover; border: 4px solid #667eea; box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);" />
                                }
                                else
                                {
                                    <div class="avatar-placeholder" style="width: 120px; height: 120px; border-radius: 50%; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; display: inline-flex; align-items: center; justify-content: center; font-size: 3rem; font-weight: bold; box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);">
                                        @(edit.AccountName?.Substring(0, 1).ToUpper() ?? "U")
                                    </div>
                                }
                            </div>
                        }

                        <div class="col-lg-6">
                            <label class="form-label fw-bold">
                                <i class="fa-solid fa-user me-1 text-primary"></i>
                                Tên khách hàng <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control form-control-lg" name="AccountName" id="accountName"
                                   value="@(edit?.AccountName ?? "")" placeholder="Nhập tên khách hàng" required />
                        </div>

                        <div class="col-lg-6">
                            <label class="form-label fw-bold">
                                <i class="fa-solid fa-phone me-1 text-primary"></i>
                                Số điện thoại
                            </label>
                            <input type="text" class="form-control form-control-lg" name="PhoneNumber" id="phoneNumber"
                                   value="@(edit?.PhoneNumber ?? "")" placeholder="Nhập số điện thoại" />
                        </div>

                        <!-- Divider -->
                        <div class="col-12">
                            <hr class="my-2">
                            <h6 class="text-primary mb-3">
                                <i class="fa-solid fa-info-circle me-2"></i>
                                Thông tin hệ thống
                            </h6>
                        </div>

                        <div class="col-lg-6">
                            <label class="form-label fw-bold">
                                <i class="fa-solid fa-envelope me-1 text-primary"></i>
                                Email
                            </label>
                            <input type="email" class="form-control" value="@(edit?.Email ?? "")" disabled style="background-color: #f1f5f9; cursor: not-allowed;" />
                            <small class="text-muted d-block mt-1">
                                <i class="fa-solid fa-lock me-1"></i>Email không thể thay đổi
                            </small>
                        </div>

                        <div class="col-lg-6">
                            <label class="form-label fw-bold">
                                <i class="fa-solid fa-right-to-bracket me-1 text-primary"></i>
                                Phương thức đăng nhập
                            </label>
                            @{
                                var providerBadge = edit?.Provider switch
                                {
                                    "Google" => "<span class='badge bg-danger fs-6'><i class='fa-brands fa-google me-1'></i>Google</span>",
                                    "Facebook" => "<span class='badge bg-info fs-6'><i class='fa-brands fa-facebook me-1'></i>Facebook</span>",
                                    _ => "<span class='badge bg-secondary fs-6'><i class='fa-solid fa-user me-1'></i>Local</span>"
                                };
                            }
                            <div class="form-control" style="background-color: #f1f5f9; cursor: not-allowed; border: none; padding: 0.5rem;">
                                @Html.Raw(providerBadge)
                            </div>
                        </div>

                        <!-- Divider -->
                        <div class="col-12">
                            <hr class="my-2">
                        </div>

                        <div class="col-lg-12">
                            <label class="form-label fw-bold">
                                <i class="fa-solid fa-toggle-on me-1 text-primary"></i>
                                Trạng thái tài khoản <span class="text-danger">*</span>
                            </label>
                            <input type="hidden" name="Status" id="status" value="@(edit?.Status ?? "Hoạt Động")" />
                            <input type="hidden" name="IsDeleted" id="isDeleted" value="@((edit?.IsDeleted ?? false).ToString().ToLower())" />
                            <div class="btn-group d-flex" role="group">
                                <input type="radio" class="btn-check" name="statusRadio" id="statusActive" value="Active"
                                       checked="@((edit?.IsDeleted ?? false) ? null : "checked")"
                                       onchange="updateStatus(false)" autocomplete="off">
                                <label class="btn btn-outline-success" for="statusActive">
                                    <i class="fa-solid fa-circle-check me-1"></i>Hoạt động
                                </label>

                                <input type="radio" class="btn-check" name="statusRadio" id="statusInactive" value="Inactive"
                                       checked="@((edit?.IsDeleted ?? false) ? "checked" : null)"
                                       onchange="updateStatus(true)" autocomplete="off">
                                <label class="btn btn-outline-danger" for="statusInactive">
                                    <i class="fa-solid fa-ban me-1"></i>Vô hiệu hóa
                                </label>
                            </div>
                            <small class="text-muted d-block mt-2">
                                <i class="fa-solid fa-info-circle me-1"></i>
                                Tài khoản bị vô hiệu sẽ không thể đăng nhập vào hệ thống
                            </small>
                        </div>

                        @if (edit != null)
                        {
                            <div class="col-12">
                                <hr class="my-2">
                                <div style="background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%); border-radius: 12px; padding: 16px; border-left: 4px solid #667eea;">
                                    <div class="text-muted small">
                                        <i class="fa-regular fa-clock me-2 text-primary"></i>
                                        <strong>Ngày tạo:</strong> @(edit.CreatedAt.ToString("dd/MM/yyyy HH:mm"))
                                        @if (edit.UpdatedAt != null)
                                        {
                                            <span class="ms-3">
                                                <i class="fa-solid fa-rotate me-2 text-primary"></i>
                                                <strong>Cập nhật:</strong> @edit.UpdatedAt?.ToString("dd/MM/yyyy HH:mm")
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="modal-footer" style="background: #f8fafc;">
                    <button type="button" class="btn btn-outline-secondary btn-lg" data-bs-dismiss="modal">
                        <i class="fa-solid fa-xmark me-2"></i>
                        Hủy
                    </button>
                    <button type="submit" class="btn btn-lg" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none;">
                        <i class="fa-solid fa-save me-2"></i>
                        Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>



<!-- Font Awesome 6 -->
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
      crossorigin="anonymous" referrerpolicy="no-referrer" />

@section Scripts {
    <script>
        function updateStatus(isDeleted) {
            document.getElementById('status').value = isDeleted ? 'Inactive' : 'Active';
            document.getElementById('isDeleted').value = isDeleted.toString();
        }

        function changePageSize(newPageSize) {
          const query = '@Html.Raw(query ?? "")';
          
          if (query) {
            window.location.href = '@Url.Action("Search", "AccountCustomer")' + '?q=' + encodeURIComponent(query) + '&page=1&pageSize=' + newPageSize;
          } else {
            window.location.href = '@Url.Action("Index", "AccountCustomer")' + '?page=1&pageSize=' + newPageSize;
          }
        }
        
        // Clean up empty fields before submit
        document.getElementById('customerForm')?.addEventListener('submit', function(e) {
            const phoneInput = document.getElementById('phoneNumber');
            if (phoneInput && !phoneInput.value.trim()) {
                phoneInput.removeAttribute('name'); // Don't send empty phone
            }
        });
        
        // Toast Helper
        function showToast(msg, isError) {
            Swal.fire({
                icon: isError ? 'error' : 'success',
                title: isError ? 'Lỗi!' : 'Thành công!',
                text: msg,
                confirmButtonColor: '#667eea',
                timer: 3000,
                timerProgressBar: true
            });
        }
        
        // Confirm Block Customer
        async function confirmBlockCustomer(event) {
            event.preventDefault();
            
            const result = await Swal.fire({
                icon: 'warning',
                title: 'Vô hiệu hóa khách hàng?',
                html: '<p class="mb-0">Khách hàng sẽ không thể đăng nhập vào hệ thống.</p><p class="text-muted mb-0 mt-2" style="font-size: 0.9em;">⚠️ Hành động này có thể ảnh hưởng đến các đơn hàng đang xử lý.</p>',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="fa-solid fa-ban me-1"></i> Vô hiệu hóa',
                cancelButtonText: '<i class="fa-solid fa-xmark me-1"></i> Hủy',
                reverseButtons: true,
                showClass: {
                    popup: 'animate__animated animate__fadeInDown animate__faster'
                },
                hideClass: {
                    popup: 'animate__animated animate__fadeOutUp animate__faster'
                }
            });

            if (result.isConfirmed) {
                // Show loading
                Swal.fire({
                    title: 'Đang xử lý...',
                    html: 'Vui lòng đợi trong giây lát',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
                event.target.submit();
            }
            return false;
        }
        
        // Confirm Unblock Customer
        async function confirmUnblockCustomer(event) {
            event.preventDefault();
            
            const result = await Swal.fire({
                icon: 'question',
                title: 'Khôi phục khách hàng?',
                html: '<p class="mb-0">Khách hàng sẽ có thể đăng nhập trở lại.</p><p class="text-success mb-0 mt-2" style="font-size: 0.9em;">✓ Tài khoản sẽ được kích hoạt ngay lập tức.</p>',
                showCancelButton: true,
                confirmButtonColor: '#22c55e',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="fa-solid fa-check-circle me-1"></i> Khôi phục',
                cancelButtonText: '<i class="fa-solid fa-xmark me-1"></i> Hủy',
                reverseButtons: true,
                showClass: {
                    popup: 'animate__animated animate__fadeInDown animate__faster'
                },
                hideClass: {
                    popup: 'animate__animated animate__fadeOutUp animate__faster'
                }
            });

            if (result.isConfirmed) {
                // Show loading
                Swal.fire({
                    title: 'Đang xử lý...',
                    html: 'Vui lòng đợi trong giây lát',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
                event.target.submit();
            }
            return false;
        }

        document.addEventListener('DOMContentLoaded', function () {
            // Hiển thị thông báo Success/Error từ TempData
            const errorMsg = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Error"]?.ToString() ?? ""));
            const successMsg = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Success"]?.ToString() ?? ""));
            
            if (errorMsg) {
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi!',
                    text: errorMsg,
                    confirmButtonColor: '#ef4444',
                    timer: 4000,
                    timerProgressBar: true,
                    showClass: {
                        popup: 'animate__animated animate__fadeInDown'
                    },
                    hideClass: {
                        popup: 'animate__animated animate__fadeOutUp'
                    }
                });
            }
            
            if (successMsg) {
                Swal.fire({
                    icon: 'success',
                    title: 'Thành công!',
                    text: successMsg,
                    confirmButtonColor: '#22c55e',
                    timer: 3000,
                    timerProgressBar: true,
                    showClass: {
                        popup: 'animate__animated animate__fadeInDown'
                    },
                    hideClass: {
                        popup: 'animate__animated animate__fadeOutUp'
                    }
                });
            }

            // Show error message if any
            const hasError = '@((ViewBag.ShowErrorModal == true) ? "true" : "false")';
            if (hasError === 'true') {
                const msg = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ErrorMessage ?? ""));
                if (msg) showToast(msg, true);
            }

            // Hiển thị modal nếu cần
            const needShow = '@((edit != null || (ViewBag.ShowErrorModal == true)) ? "true" : "false")';
            if (needShow === "true") {
                const modalEl = document.getElementById('customerModal');
                if (modalEl) new bootstrap.Modal(modalEl).show();
            }
            
            // Add animation to form inputs
            document.querySelectorAll('.form-control, .form-control-lg').forEach(input => {
                input.addEventListener('focus', function() {
                    this.style.transform = 'translateY(-2px)';
                    this.style.transition = 'all 0.3s ease';
                });
                input.addEventListener('blur', function() {
                    this.style.transform = 'translateY(0)';
                });
            });
        });
    </script>
}