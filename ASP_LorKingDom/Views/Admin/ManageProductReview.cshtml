@model List<BLL.DTOs.ReviewProductDto>
@{
    ViewData["Title"] = "Quản lý đánh giá sản phẩm - ToyLand Admin";
    Layout = "_AdminLayout";
    var q = (string?)ViewBag.Query ?? "";
    var productFilter = (string?)ViewBag.ProductFilter ?? "";
    var deleteStatusFilter = (string?)ViewBag.DeleteStatusFilter ?? "";
    var replyStatusFilter = (string?)ViewBag.ReplyStatusFilter ?? "";
    var currentPage = (int?)ViewBag.CurrentPage ?? 1;
    var totalPages = (int?)ViewBag.TotalPages ?? 1;
    var showDeleted = (bool?)ViewBag.ShowDeleted ?? false;
}

<style>
    .deleted-row {
        opacity: 0.6;
        background: #f8f9fa;
    }

    #reviewDetailModal .modal-content {
        border: none;
        border-radius: 16px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
    }

    #reviewDetailModal .modal-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 16px 16px 0 0;
        padding: 1.5rem;
        border: none;
    }

    #reviewDetailModal .modal-title {
        font-weight: 600;
        font-size: 1.25rem;
    }

    #reviewDetailModal .modal-body {
        padding: 2rem;
        background-color: #f8f9fa;
    }

    .review-content {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        max-height: 3em;
        font-size: 0.95rem;
    }

    .author-badge {
        display: inline-block;
        background: #e7f3ff;
        color: #0066cc;
        padding: 0.35rem 0.75rem;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .reaction-stats {
        display: flex;
        gap: 1rem;
        font-size: 0.9rem;
        color: #6b7280;
    }

        .reaction-stats i {
            color: #667eea;
            margin-right: 0.3rem;
        }

    .date-text {
        font-size: 0.9rem;
        color: #6b7280;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.4rem 0.75rem;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .product-title-ellipsis {
        max-width: 200px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        display: inline-block;
        color: #333;
    }

    .rating-stars {
        color: #f4c150;
    }

    .nav-tabs .nav-link {
        border-radius: 8px;
        margin-right: 5px;
    }

        .nav-tabs .nav-link.active {
            background-color: #667eea;
            color: white;
        }

    /* Nút refresh loading state */
    .btn-refresh[aria-busy="true"] {
        pointer-events: none;
        opacity: .8;
    }
</style>

<div class="container-fluid px-5">
    <h1 class="mt-4">Quản Lý Đánh Giá Sản Phẩm</h1>

    <div class="card mb-4 mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div><i class="fa-solid fa-star me-2"></i>Danh Sách Đánh Giá</div>

            <!-- Nút Refresh ở header: RESET toàn bộ filter + search và load mặc định -->
            <div class="d-flex align-items-center gap-2">
                <button id="btnRefreshHeader" type="button" class="btn btn-outline-secondary btn-sm btn-refresh" title="Đặt lại bộ lọc và làm mới dữ liệu">
                    <i class="fa-solid fa-rotate-right me-1"></i> Refresh
                </button>
            </div>
        </div>

        <div class="card-body">
            <!-- Tabs -->
            <ul class="nav nav-tabs mb-4">
                <li class="nav-item">
                    <a class="nav-link @(showDeleted ? "" : "active")" href="@Url.Action("ManageProductReview", new { q = "", product = "", deleteStatus = "", replyStatus = "", page = 1, showDeleted = false })">
                        Đánh Giá Hoạt Động
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(showDeleted ? "active" : "")" href="@Url.Action("ManageProductReview", new { q = "", product = "", deleteStatus = "deleted", replyStatus = "", page = 1, showDeleted = true })">
                        Thùng Rác
                    </a>
                </li>
            </ul>

            <!-- Tìm kiếm và Lọc -->
            <form id="filterForm" class="mb-4" method="get" asp-action="ManageProductReview" asp-controller="ReviewProduct">
                <input type="hidden" name="showDeleted" value="@showDeleted.ToString().ToLower()" />
                <div class="row g-2 align-items-stretch">
                    <div class="col-md-3">
                        <input type="text" name="q" value="@q" class="form-control"
                               placeholder="Tìm theo người đánh giá, sản phẩm hoặc nội dung...">
                    </div>
                    <div class="col-md-2">
                        <select name="product" class="form-control">
                            <option value="">Tất cả sản phẩm</option>
                            @foreach (var product in ViewBag.Products)
                            {
                                <option value="@product.Id" selected="@(productFilter == product.Id.ToString())">@product.ProductName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select name="deleteStatus" class="form-control">
                            <option value="">Tất cả trạng thái</option>
                            <option value="undeleted" selected="@(deleteStatusFilter == "undeleted")">Chưa xóa</option>
                            <option value="deleted" selected="@(deleteStatusFilter == "deleted")">Đã xóa</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select name="replyStatus" class="form-control">
                            <option value="">Tất cả phản hồi</option>
                            <option value="replied" selected="@(replyStatusFilter == "replied")">Đã hồi</option>
                            <option value="unreplied" selected="@(replyStatusFilter == "unreplied")">Chưa hồi</option>
                        </select>
                    </div>
                    <div class="col-md-3 d-flex">
                        <button class="btn btn-primary flex-fill" type="submit">
                            <i class="fa-solid fa-magnifying-glass"></i> Tìm kiếm
                        </button>
                    </div>
                </div>
            </form>

            <!-- Bảng Dữ Liệu -->
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 40px;"><input type="checkbox" id="selectAll" class="form-check-input"></th>
                            <th>Nội dung đánh giá</th>
                            <th style="width: 150px;">Người đánh giá</th>
                            <th style="width: 180px;">Sản phẩm</th>
                            <th style="width: 120px;">Điểm</th>
                            <th style="width: 120px;">Tương tác</th>
                            <th style="width: 100px;">Phản hồi</th>
                            <th style="width: 80px;">Trạng thái</th>
                            <th style="width: 130px;">Ngày đánh giá</th>
                            <th style="width: 130px; text-align: center;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.Any() == true)
                        {
                            @foreach (var review in Model)
                            {
                                <tr class="@(review.IsDeleted ? "deleted-row" : "")" data-review-id="@review.ReviewProductId">
                                    <td><input type="checkbox" class="form-check-input row-checkbox"></td>
                                    <td><p class="review-content mb-0">@review.Comment</p></td>
                                    <td><span class="author-badge">@review.AuthorName</span></td>
                                    <td><span class="product-title-ellipsis" title="@review.ProductName">@review.ProductName</span></td>
                                    <td>
                                        <span class="rating-stars">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= review.Rating)
                                                {
                                                    <i class="fas fa-star"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-star"></i>
                                                }
                                            }
                                        </span>
                                    </td>
                                    <td>
                                        <span class="me-2"><i class="fas fa-thumbs-up"></i> @review.LikeCount</span>
                                        <span><i class="fas fa-thumbs-down"></i> @review.DislikeCount</span>
                                    </td>
                                    <td>
                                        @if (review.Replies?.Any() == true)
                                        {
                                            <span class="badge bg-success"><i class="fas fa-check"></i> @review.Replies.Count</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark"><i class="fas fa-clock"></i> Chưa</span>
                                        }
                                    </td>
                                    <td>
                                        @if (review.IsDeleted)
                                        {
                                            <span class="badge bg-danger"><i class="fas fa-trash"></i> Đã xóa</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary"><i class="fas fa-check"></i> Bình thường</span>
                                        }
                                    </td>
                                    <td>@review.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td style="text-align: center;">
                                        <button type="button" class="btn btn-sm btn-info" onclick="viewReviewDetail(@review.ReviewProductId)" title="Xem">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-primary" onclick="editReview(@review.ReviewProductId)" title="Sửa">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        @if (review.IsDeleted)
                                        {
                                            <button type="button" class="btn btn-sm btn-success" onclick="restoreReview(@review.ReviewProductId)" title="Khôi phục">
                                                <i class="fas fa-undo"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-danger" onclick="deleteReview(@review.ReviewProductId)" title="Xóa">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="10" style="text-align: center; color: #999;">@(showDeleted ? "Thùng rác trống." : "Không có đánh giá nào.")</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <nav class="mt-4" aria-label="Product review pagination">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           href="@Url.Action("ManageProductReview", "ReviewProduct", new { q, product = productFilter, deleteStatus = deleteStatusFilter, replyStatus = replyStatusFilter, page = currentPage - 1, showDeleted })">
                            <i class="fas fa-chevron-left me-1"></i>Trước
                        </a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link"
                               href="@Url.Action("ManageProductReview", "ReviewProduct", new { q, product = productFilter, deleteStatus = deleteStatusFilter, replyStatus = replyStatusFilter, page = i, showDeleted })">
                                @i
                            </a>
                        </li>
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link"
                           href="@Url.Action("ManageProductReview", "ReviewProduct", new { q, product = productFilter, deleteStatus = deleteStatusFilter, replyStatus = replyStatusFilter, page = currentPage + 1, showDeleted })">
                            Sau <i class="fas fa-chevron-right ms-1"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>

    <!-- Modal Chi Tiết Đánh Giá -->
    <div class="modal fade" id="reviewDetailModal" tabindex="-1" aria-labelledby="reviewDetailLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="reviewDetailLabel">Chi tiết đánh giá</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="reviewDetailContent"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Chỉnh Sửa Đánh Giá -->
    <div class="modal fade" id="editReviewModal" tabindex="-1" aria-labelledby="editReviewLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editReviewLabel"><i class="fas fa-edit me-2"></i>Chỉnh sửa đánh giá</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="editReviewForm" method="post">
                        <input type="hidden" name="ReviewProductId" id="editReviewId" />
                        <div class="mb-3">
                            <label class="form-label">Xác minh mua hàng</label>
                            <select name="IsVerifiedPurchase" class="form-control">
                                <option value="true">Đã xác minh</option>
                                <option value="false">Chưa xác minh</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Trạng thái</label>
                            <select name="IsDeleted" class="form-control">
                                <option value="false">Bình thường</option>
                                <option value="true">Đã xóa</option>
                            </select>
                        </div>
                        <button type="button" class="btn btn-primary" onclick="submitEditReview()">Lưu</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // =========================
        // Helper: Busy state
        // =========================
        function setBusy(el, busy) {
            if (!el) return;
            el.setAttribute('aria-busy', busy ? 'true' : 'false');
            el.querySelector('i')?.classList.toggle('fa-spin', !!busy);
        }

        // =========================
        // Refresh về MẶC ĐỊNH (reset filter + search + tab)
        // =========================
        function resetFiltersUIToDefault() {
            const form = document.getElementById('filterForm');
            if (!form) return;

            // Reset các input về mặc định
            const q = form.querySelector('[name="q"]');
            const product = form.querySelector('[name="product"]');
            const deleteStatus = form.querySelector('[name="deleteStatus"]');
            const replyStatus = form.querySelector('[name="replyStatus"]');
            const showDeleted = form.querySelector('[name="showDeleted"]');

            if (q) q.value = '';
            if (product) product.value = '';
            if (deleteStatus) deleteStatus.value = '';
            if (replyStatus) replyStatus.value = '';
            if (showDeleted) showDeleted.value = 'false';
        }

        function refreshToDefault(triggerEl = null) {
            if (triggerEl) setBusy(triggerEl, true);

            // Reset UI ngay lập tức để thấy hiệu ứng
            resetFiltersUIToDefault();

            // Điều hướng về URL mặc định: trang 1, showDeleted=false, các filter rỗng
            const basePath = '@Url.Action("ManageProductReview", "ReviewProduct")'; // ví dụ: /ReviewProduct/ManageProductReview
            const url = new URL(basePath, window.location.origin);
            url.searchParams.set('page', '1');
            url.searchParams.set('showDeleted', 'false');
            url.searchParams.set('q', '');
            url.searchParams.set('product', '');
            url.searchParams.set('deleteStatus', '');
            url.searchParams.set('replyStatus', '');
            window.location.assign(url.toString());
        }

        // =========================
        // Bind: chỉ nút header (Reset all)
        // =========================
        document.getElementById('btnRefreshHeader')?.addEventListener('click', function () {
            refreshToDefault(this);
        });

        // =========================
        // Select All
        // =========================
        document.getElementById('selectAll')?.addEventListener('change', function () {
            document.querySelectorAll('.row-checkbox').forEach(cb => cb.checked = this.checked);
        });

        // =========================
        // View Review Detail
        // =========================
        async function viewReviewDetail(reviewId) {
            try {
                const response = await fetch(`/ReviewProduct/Details/${reviewId}`, { credentials: 'include' });
                if (!response.ok) throw new Error(`Không thể tải chi tiết đánh giá: ${response.status}`);

                const review = await response.json();
                const token = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content')
                    || document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                if (!token) throw new Error('Không tìm thấy token bảo mật. Vui lòng tải lại trang.');

                let repliesHtml = '';
                if (review.replies && review.replies.length > 0) {
                    repliesHtml = `
                            <div class="replies-list">
                                ${review.replies.map(r => `
                                    <div style="background:white;padding:0.75rem;margin-bottom:0.5rem;border-left:3px solid #667eea;border-radius:4px;opacity:0;animation:fadeIn 0.4s forwards;">
                                        <p class="mb-1"><strong>${r.authorName}</strong></p>
                                        <p class="mb-1">${r.content}</p>
                                        <small class="text-muted">${r.createdAt}</small>
                                    </div>
                                `).join('')}
                            </div>`;
                } else {
                    repliesHtml = '<div class="alert alert-info mb-3">Chưa có phản hồi nào</div>';
                }

                let imagesHtml = '';
                if (review.imageUrls && review.imageUrls.length > 0) {
                    imagesHtml = review.imageUrls.map(url => `
                            <img src="${url}" alt="Review Image"
                                 style="max-width:100px;height:auto;margin-right:8px;border-radius:6px;box-shadow:0 2px 8px rgba(0,0,0,0.1);cursor:pointer;"
                                 onclick="window.open(this.src, '_blank')">`).join('');
                } else {
                    imagesHtml = '<p class="text-muted fst-italic">Không có hình ảnh</p>';
                }

                const content = `
                        <div class="row g-3">
                            <div class="col-md-12">
                                <p class="mb-1"><strong>Sản phẩm:</strong></p>
                                <a href="/Product/Detail/${review.productId}" target="_blank" class="text-decoration-none text-primary fw-medium">
                                    ${review.productName}
                                </a>
                            </div>

                            <div class="col-md-12">
                                <p class="mb-1"><strong>Nội dung:</strong></p>
                                <div style="background:#fff;padding:1rem;border:1px solid #e0e0e0;border-radius:8px;font-size:0.95rem;line-height:1.5;">
                                    ${review.content || '<em class="text-muted">Không có nội dung</em>'}
                                </div>
                            </div>

                            <div class="col-md-6"><p><strong>Người đánh giá:</strong> <span class="fw-medium">${review.authorName}</span></p></div>
                            <div class="col-md-6"><p><strong>Email:</strong> <span class="text-muted">${review.authorEmail || 'N/A'}</span></p></div>

                            <div class="col-md-6">
                                <p><strong>Điểm:</strong>
                                    <span class="text-warning fw-bold">${review.rating}</span>
                                    ${'<i class="fas fa-star text-warning"></i>'.repeat(review.rating)}
                                    ${'<i class="far fa-star text-muted"></i>'.repeat(5 - review.rating)}
                                </p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Tương tác:</strong>
                                    <span class="text-success"><i class="fas fa-thumbs-up"></i> ${review.likeCount}</span> |
                                    <span class="text-danger"><i class="fas fa-thumbs-down"></i> ${review.dislikeCount}</span>
                                </p>
                            </div>

                            <div class="col-md-6">
                                <p><strong>Xác minh:</strong>
                                    <span class="badge ${review.isVerifiedPurchase ? 'bg-success' : 'bg-secondary'}">
                                        ${review.isVerifiedPurchase ? 'Đã xác minh' : 'Chưa xác minh'}
                                    </span>
                                </p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Trạng thái:</strong>
                                    <span class="badge ${review.isDeleted ? 'bg-danger' : 'bg-secondary'}">
                                        ${review.isDeleted ? 'Đã xóa' : 'Bình thường'}
                                    </span>
                                </p>
                            </div>

                            <div class="col-md-12"><p><strong>Ngày đánh giá:</strong> <span class="text-muted">${review.createdAt}</span></p></div>

                            <div class="col-md-12">
                                <p class="mb-1"><strong>Hình ảnh:</strong></p>
                                <div class="d-flex flex-wrap gap-2">${imagesHtml}</div>
                            </div>

                            <div class="col-md-12">
                                <h6 class="mb-3 mt-2"><strong>Phản hồi từ quản trị viên:</strong></h6>
                                <div class="replies-container mb-3">${repliesHtml}</div>

                                <form id="replyForm" style="margin-top:1rem;">
                                    <input type="hidden" name="__RequestVerificationToken" value="${token}" />
                                    <div class="mb-2">
                                        <textarea name="replyContent" class="form-control" rows="2" placeholder="Nhập nội dung phản hồi..." style="resize:none;font-size:0.9rem;"></textarea>
                                    </div>
                                    <button type="button" class="btn btn-primary btn-sm" onclick="submitReply(${review.reviewId})">
                                        <i class="fas fa-paper-plane me-1"></i> Gửi phản hồi
                                    </button>
                                </form>
                            </div>
                        </div>
                    `;

                const modalBody = document.getElementById('reviewDetailContent');
                modalBody.innerHTML = content;

                setTimeout(() => {
                    modalBody.querySelectorAll('.replies-list > div').forEach((el, i) => {
                        el.style.animationDelay = `${i * 0.1}s`;
                        el.style.opacity = '1';
                    });
                }, 100);

                const modal = new bootstrap.Modal(document.getElementById('reviewDetailModal'), { backdrop: 'static', keyboard: false });
                modal.show();

            } catch (error) {
                console.error('Lỗi viewReviewDetail:', error);
                Swal.fire({ icon: 'error', title: 'Lỗi', text: error.message || 'Không thể tải chi tiết đánh giá', confirmButtonText: 'Đóng' });
            }
        }

        // =========================
        // Edit / Submit Edit
        // =========================
        async function editReview(reviewId) {
            try {
                const response = await fetch(`/ReviewProduct/Details/${reviewId}`);
                if (!response.ok) throw new Error('Không thể tải chi tiết đánh giá');

                const review = await response.json();
                document.getElementById('editReviewId').value = reviewId;
                document.querySelector('#editReviewForm select[name="IsVerifiedPurchase"]').value = review.isVerifiedPurchase ? 'true' : 'false';
                document.querySelector('#editReviewForm select[name="IsDeleted"]').value = review.isDeleted ? 'true' : 'false';

                const modal = new bootstrap.Modal(document.getElementById('editReviewModal'));
                modal.show();
            } catch (error) {
                Swal.fire('Lỗi', error.message, 'error');
            }
        }

        async function submitEditReview() {
            const form = document.getElementById('editReviewForm');
            const formData = new FormData(form);
            const reviewId = document.getElementById('editReviewId').value;

            try {
                const response = await fetch(`/ReviewProduct/Edit/${reviewId}`, { method: 'POST', body: formData });

                if (response.ok) {
                    Swal.fire({ icon: 'success', title: 'Thành công', text: 'Đã cập nhật đánh giá', timer: 1200, showConfirmButton: false })
                        .then(() => {
                            // Giữ nguyên filter hiện tại sau khi chỉnh sửa
                            const url = new URL(window.location.href);
                            window.location.assign(url.toString());
                        });
                } else {
                    const error = await response.json();
                    throw new Error(error.error || 'Lỗi server');
                }
            } catch (error) {
                Swal.fire('Lỗi', error.message, 'error');
            }
        }

        // =========================
        // Delete / Restore
        // =========================
        async function deleteReview(reviewId) {
            const result = await Swal.fire({
                title: 'Xác nhận xóa',
                text: 'Đánh giá sẽ được chuyển vào thùng rác. Bạn có chắc chắn muốn tiếp tục?',
                icon: 'warning', showCancelButton: true,
                confirmButtonColor: '#d33', cancelButtonColor: '#6c757d',
                confirmButtonText: 'Có, chuyển vào thùng rác', cancelButtonText: 'Hủy'
            });

            if (result.isConfirmed) {
                try {
                    const formData = new FormData();
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    if (token) formData.append('__RequestVerificationToken', token);

                    const response = await fetch(`/ReviewProduct/Delete/${reviewId}`, { method: 'POST', body: formData });

                    if (response.ok) {
                        Swal.fire({ icon: 'success', title: 'Thành công', text: 'Đánh giá đã được chuyển vào thùng rác', timer: 1200, showConfirmButton: false })
                            .then(() => { window.location.assign(new URL(window.location.href).toString()); });
                    } else {
                        const error = await response.json();
                        throw new Error(error.error || 'Lỗi server');
                    }
                } catch (error) {
                    Swal.fire('Lỗi', 'Không thể chuyển đánh giá vào thùng rác', 'error');
                }
            }
        }

        async function restoreReview(reviewId) {
            const result = await Swal.fire({
                title: 'Xác nhận khôi phục', text: 'Bạn có chắc chắn muốn khôi phục đánh giá này?',
                icon: 'question', showCancelButton: true,
                confirmButtonColor: '#28a745', cancelButtonColor: '#6c757d',
                confirmButtonText: 'Có, khôi phục', cancelButtonText: 'Hủy'
            });

            if (result.isConfirmed) {
                try {
                    const formData = new FormData();
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    if (token) formData.append('__RequestVerificationToken', token);

                    const response = await fetch(`/ReviewProduct/Restore/${reviewId}`, { method: 'POST', body: formData });

                    if (response.ok) {
                        Swal.fire({ icon: 'success', title: 'Thành công', text: 'Đánh giá đã được khôi phục', timer: 1200, showConfirmButton: false })
                            .then(() => { window.location.assign(new URL(window.location.href).toString()); });
                    } else {
                        const error = await response.json();
                        throw new Error(error.error || 'Lỗi server');
                    }
                } catch (error) {
                    Swal.fire('Lỗi', 'Không thể khôi phục đánh giá', 'error');
                }
            }
        }

        // =========================
        // Reply
        // =========================
        async function submitReply(reviewId) {
            const textarea = document.querySelector('#replyForm textarea[name="replyContent"]');
            const content = textarea?.value.trim();
            if (!content) { Swal.fire('Cảnh báo', 'Vui lòng nhập phản hồi', 'warning'); return; }

            const formData = new FormData(document.getElementById('replyForm'));

            try {
                const response = await fetch(`/ReviewProduct/Reply/${reviewId}`, { method: 'POST', body: formData, credentials: 'include' });
                const text = await response.text();
                let data; try { data = JSON.parse(text); } catch { }

                if (response.ok && data?.success) {
                    const adminName = "@User.FindFirst("AccountName")?.Value" || "@User.Identity?.Name" || "Quản trị viên";
                    const now = new Date();
                    const createdAt = now.toLocaleDateString('vi-VN') + ' ' + now.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });

                    const newReplyHtml = `
                            <div style="background:white;padding:0.75rem;margin-bottom:0.5rem;border-left:3px solid #667eea;border-radius:4px;animation:fadeIn 0.3s;">
                                <p class="mb-1"><strong>${adminName}</strong></p>
                                <p class="mb-1">${content}</p>
                                <small class="text-muted">${createdAt}</small>
                            </div>`;

                    const repliesContainer = document.querySelector('#reviewDetailContent .replies-container')
                        || document.querySelector('#reviewDetailContent > div > div:last-child > div:last-child');

                    let repliesList = repliesContainer.querySelector('.replies-list');
                    if (!repliesList) {
                        const noReplyAlert = repliesContainer.querySelector('.alert'); if (noReplyAlert) noReplyAlert.remove();
                        repliesList = document.createElement('div'); repliesList.className = 'replies-list'; repliesContainer.appendChild(repliesList);
                    }
                    repliesList.insertAdjacentHTML('beforeend', newReplyHtml);

                    const row = document.querySelector(`tr[data-review-id="${reviewId}"]`);
                    if (row) {
                        const replyBadge = row.querySelector('td:nth-child(7) .badge');
                        const currentCount = parseInt(replyBadge?.textContent.match(/\d+/)?.[0] || '0');
                        replyBadge.innerHTML = `<i class="fas fa-check"></i> ${currentCount + 1}`;
                        replyBadge.className = 'badge bg-success';
                    }

                    textarea.value = '';
                    Swal.fire({ icon: 'success', title: 'Thành công!', text: 'Phản hồi đã được gửi', timer: 1500, showConfirmButton: false, toast: true, position: 'top-end' });

                } else {
                    throw new Error(data?.error || 'Không thể gửi phản hồi');
                }
            } catch (error) {
                Swal.fire('Lỗi', error.message, 'error');
            }
        }
    </script>
}
