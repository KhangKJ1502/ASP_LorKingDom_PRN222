@model BLL.DTOs.PagedResult<BLL.DTOs.SuperCategoryDto>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản Lí Danh Mục Tổng";
    var q = (string?)ViewBag.Query ?? "";

    int page = ViewBag.Page is int vp ? vp : (Model?.Page ?? 1);
    int pageSize = ViewBag.PageSize is int vps ? vps : (Model?.PageSize ?? 20);
    int total = ViewBag.Total is int vt ? vt : (Model?.Total ?? 0);
    int totalPages = (int)Math.Ceiling(total / (double)Math.Max(1, pageSize));
    Func<int, string> PageUrl = p => Url.Action("Manage", "SuperCategory", new { q, page = p, pageSize })!;
}
<link rel="stylesheet" href="~/css/MSuperCategory.css" asp-append-version="true" />
<div class="container-fluid px-5">
    <h1 class="mt-4">Quản Lí Danh Mục Tổng</h1>

    <form class="mt-4" asp-action="AddSuperCategory" asp-controller="SuperCategory" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="q" value="@q" />
        <input type="hidden" name="pageSize" value="@pageSize" />
        <input type="hidden" name="id" value="0" />

        <label class="form-label">Tên Nhóm Danh Mục Tổng</label>
        <input type="text" name="name"
               value="@(ViewBag.LastName ?? "")"
               class="form-control d-inline-block w-auto" required />
        <button class="btn btn-primary ms-2" type="submit">Thêm Nhóm Danh Mục Tổng</button>
    </form>


    <div class="card mb-4 mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div><i class="fa-solid fa-table me-1"></i> Danh Sách Danh Mục Tổng</div>
        </div>

        <div class="card-body">
            <!-- Tìm kiếm -->
            <form class="mb-4" method="get" asp-action="Manage" asp-controller="SuperCategory">
                <div class="input-group search-box">
                    <input type="text" name="q" value="@q" class="form-control" placeholder="Tìm kiếm danh mục...">
                    <button class="btn btn-outline-secondary" type="submit">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                </div>
            </form>


            @if (TempData["Error"] is string e)
            {
                <div class="alert alert-danger">@e</div>
            }
            @if (TempData["Success"] is string s)
            {
                <div class="alert alert-success">@s</div>
            }

            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th style="white-space:nowrap">ID</th>
                            <th style="white-space:nowrap">Hành Động</th>
                            <th>Danh mục tổng</th>
                            <th style="white-space:nowrap">Trạng Thái</th>
                            <th style="white-space:nowrap">Ngày Tạo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.Items != null && Model.Items.Any())
                        {
                            @foreach (var x in Model.Items)
                            {
                                <tr class="@(x.IsDeleted ? "deleted-row" : "")">
                                    <td>@x.Id</td>

                                    <td style="white-space:nowrap">
                                        <!-- Nút Edit mở modal -->
                                        <a class="btn btn-sm btn-warning ms-1" title="Cập nhật"
                                           asp-action="Edit" asp-controller="SuperCategory"
                                           asp-route-id="@x.Id" asp-route-q="@q">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>
                                    </td>


                                    <td>@x.Name</td>

                                    <td>
                                        @if (x.IsDeleted)
                                        {
                                            <span class="badge bg-secondary">Không còn hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Hoạt Động</span>
                                        }
                                    </td>

                                    <td>@(x.CreatedAt?.ToString("dd/MM/yyyy HH:mm"))</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted">Không có dữ liệu.</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (totalPages > 1)
                {
                    <nav class="mt-3">
                        <ul class="pagination justify-content-center pagination-pill">
                            <li class="page-item @(page <= 1 ? "disabled" : "")">
                                <a class="page-link" href="@PageUrl(page - 1)">«</a>
                            </li>
                            @for (int p = 1; p <= totalPages; p++)
                            {
                                bool isCurrent = p == page;
                                <li class="page-item @(isCurrent ? "active" : "")">
                                    <a class="page-link" href="@PageUrl(p)">@p</a>
                                </li>
                            }
                            <li class="page-item @(page >= totalPages ? "disabled" : "")">
                                <a class="page-link" href="@PageUrl(page + 1)">»</a>
                            </li>
                        </ul>
                    </nav>
                }

            </div>
        </div>
    </div>
</div>
<!-- Modal Edit SuperCategory -->
<div class="modal fade @(ViewBag.EditSuperCategory != null ? "show d-block" : "")"
     id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="@(ViewBag.EditSuperCategory == null)">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="editModalLabel" class="modal-title">Cập nhật Danh Mục Tổng</h5>
                <a href="@Url.Action("Manage", "SuperCategory")" class="btn-close"></a>
            </div>

            <form method="post" asp-action="UpdateSuperCategory" asp-controller="SuperCategory">
                @Html.AntiForgeryToken()
                <input type="hidden" name="q" value="@q" />
                <input type="hidden" name="pageSize" value="@pageSize" />

                <div class="modal-body">
                    @{
                        var edit = ViewBag.EditSuperCategory as BLL.DTOs.SuperCategoryDto;
                    }
                    <input type="hidden" name="id" value="@(edit?.Id ?? 0)" />

                    <div class="mb-3">
                        <label class="form-label">Tên Nhóm Danh Mục Tổng</label>
                        <input type="text" class="form-control" name="name" value="@(edit?.Name ?? "")" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Trạng thái</label>
                        <select class="form-select" name="isDeleted" required>
                            <option value="false" selected="@(edit?.IsDeleted == false)">Hoạt động (0)</option>
                            <option value="true" selected="@(edit?.IsDeleted == true)">Không hoạt động (1)</option>
                        </select>
                        <div class="form-text">
                            Chọn “Không hoạt động” tương đương đặt IsDeleted = 1.
                        </div>
                    </div>

                    <div class="mb-2 text-muted small">
                        <i class="fa-regular fa-clock me-1"></i>
                        Ngày tạo: @(edit?.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                    </div>
                </div>

                <div class="modal-footer">
                    <a href="@Url.Action("Manage", "SuperCategory", new { q, page, pageSize })"
                       class="btn btn-outline-secondary">Hủy</a>
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>
@* modal báo lỗi *@

<div class="toast-container position-fixed p-3 toast-top-right" style="z-index:2080;">
    <div id="liveToast" class="toast align-items-center text-bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body fs-5 fw-semibold">
                <i class="fa-solid fa-circle-exclamation me-2"></i>
                @ViewBag.ErrorMessage
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Đóng"></button>
        </div>
    </div>
</div>




@section Scripts {
    <script>
        // Hiển thị toast 5s khi có lỗi
        document.addEventListener('DOMContentLoaded', function () {
            const hasError = '@(ViewBag.ShowErrorModal == true ? "true" : "false")';
            if (hasError === "true") {
                const toastEl = document.getElementById('liveToast');
                if (toastEl) {
                    const toast = new bootstrap.Toast(toastEl, { delay: 5000 }); // 5 giây
                    toast.show();
                }
            }
        });
    </script>

    @* Khóa nền khi có modal Edit hoặc khi muốn che nền *@
    @if (ViewBag.EditSuperCategory != null || ViewBag.ShowErrorModal == true)
    {
        <script>
            document.body.classList.add('modal-open');
            document.body.style.overflow = 'hidden';
        </script>
    }
}


@section Styles {
    <!-- Font Awesome 6 -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          crossorigin="anonymous" referrerpolicy="no-referrer" />

    <style>
        .deleted-row {
            opacity: 0.6;
            background: #f8f9fa;
        }
    </style>
}

