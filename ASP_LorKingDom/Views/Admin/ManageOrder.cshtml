@model BLL.DTOs.PagedResult<BLL.DTOs.OrderDto>
@{
    ViewData["Title"] = "Quản lý đơn hàng - ToyLand Admin";
    Layout = "_AdminLayout";

    var q = (string?)ViewBag.Query ?? "";
    var statusFilter = (int?)ViewBag.StatusFilter;
    var dateFromFilter = (string?)ViewBag.DateFromFilter ?? "";
    var dateToFilter = (string?)ViewBag.DateToFilter ?? "";
    var currentPage = (int?)ViewBag.CurrentPage ?? 1;
    var totalPages = Model.TotalPages;
}

<style>
    /* Status Colors */
    .status-pending {
        background-color: #fff3cd;
        color: #856404;
    }

    .status-confirmed {
        background-color: #d1ecf1;
        color: #0c5460;
    }

    .status-shipping {
        background-color: #cfe2ff;
        color: #084298;
    }

    .status-delivered {
        background-color: #d4edda;
        color: #155724;
    }

    .status-cancelled {
        background-color: #f8d7da;
        color: #721c24;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.4rem 0.75rem;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .refund-pending {
        background-color: #fff3cd;
        color: #856404;
    }

    .refund-none {
        background-color: #e2e3e5;
        color: #383d41;
    }

    .refund-approved {
        background-color: #d4edda;
        color: #155724;
    }

    .refund-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.4rem 0.75rem;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .order-id {
        font-weight: 600;
        color: #667eea;
        cursor: pointer;
    }

    .customer-name {
        font-weight: 500;
        margin: 0;
    }

    .price-text {
        font-weight: 600;
        color: #28a745;
    }

    .date-text {
        font-size: 0.9rem;
        color: #6b7280;
    }

    .cursor-pointer {
        cursor: pointer;
    }

    #orderModal .modal-content {
        border: none;
        border-radius: 16px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
    }

    #orderModal .modal-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 16px 16px 0 0;
        padding: 1.5rem;
        border: none;
    }

    #orderModal .modal-title {
        font-weight: 600;
        font-size: 1.25rem;
    }

    #orderModal .btn-close {
        filter: brightness(0) invert(1);
        opacity: 0.8;
    }

    #orderModal .modal-body {
        padding: 2rem;
        background-color: #f8f9fa;
    }

    .order-detail-section {
        background-color: white;
        padding: 1rem;
        border-radius: 8px;
        /* margin-bottom: 1rem; */
        border: 1px solid #e9ecef;
    }

    .order-detail-section h6 {
        font-weight: 600;
        margin-bottom: 1rem;
        color: #1f2937;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 0.5rem 0;
        border-bottom: 1px solid #e9ecef;
    }

    .detail-row:last-child {
        border-bottom: none;
    }

    .detail-label {
        font-weight: 500;
        color: #6b7280;
        font-size: 0.9rem;
    }

    .detail-value {
        color: #1f2937;
        font-weight: 500;
    }

    .order-items-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .order-items-list li {
        padding: 0.75rem 0;
        border-bottom: 1px solid #e9ecef;
        font-size: 0.9rem;
    }

    .order-items-list li:last-child {
        border-bottom: none;
    }

    .total-section {
        background-color: #f8f9fa;
        padding: 1rem;
        border-radius: 8px;
        /* margin-top: 0.5rem; */
    }

    .total-row {
        display: flex;
        justify-content: space-between;
        padding: 0.5rem 0;
        font-weight: 600;
        color: #1f2937;
    }

    .total-row.grand {
        font-size: 1.25rem;
        color: #667eea;
        border-top: 2px solid #e9ecef;
        padding-top: 0.75rem;
    }
</style>

<div class="container-fluid px-5">
    <h1 class="mt-4">Quản Lý Đơn Hàng</h1>

    <div class="card mb-4 mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div><i class="fa-solid fa-boxes-stacked me-2"></i>Danh Sách Đơn Hàng</div>
            <span class="badge bg-primary rounded-pill">@Model.Total đơn</span>
        </div>

        <div class="card-body">
            <!-- Tìm kiếm và Lọc -->
            <form class="mb-4" method="get" asp-action="Manage" asp-controller="Order">
                <div class="row g-2 mb-3">
                    <div class="col-md-3">
                        <input type="text" name="q" value="@q" class="form-control border"
                            placeholder="Tìm theo ID, tên khách hàng...">
                    </div>
                    <div class="col-md-2">
                        <select name="status" class="form-control">
                            <option value="">Tất cả trạng thái</option>
                            <option value="1" selected="@(statusFilter == 1)">Chờ xác nhận</option>
                            <option value="2" selected="@(statusFilter == 2)">Đã xác nhận</option>
                            <option value="3" selected="@(statusFilter == 3)">Đang vận chuyển</option>
                            <option value="4" selected="@(statusFilter == 4)">Đã giao</option>
                            <option value="5" selected="@(statusFilter == 5)">Đã hủy</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <input type="date" name="dateFrom" value="@dateFromFilter" class="form-control border">
                    </div>
                    <div class="col-md-2">
                        <input type="date" name="dateTo" value="@dateToFilter" class="form-control border">
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-primary w-100" type="submit">
                            <i class="fa-solid fa-magnifying-glass"></i> Tìm kiếm
                        </button>
                    </div>
                </div>
            </form>

            <!-- Table -->
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 80px; text-align: center;">Mã đơn</th>
                            <th style="width: 130px; text-align: center;">Hành động</th>
                            <th>Khách hàng</th>
                            <th style="width: 120px;">Số điện thoại</th>
                            <th style="width: 100px; text-align: right;">Tổng tiền</th>
                            <th style="width: 120px;">Trạng thái</th>
                            <th style="width: 100px;">Hoàn tiền</th>
                            <th style="width: 100px;">Ngày đặt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items?.Any() == true)
                        {
                            @foreach (var order in Model.Items)
                            {
                                <tr>
                                    <td style="text-align: center;">
                                        <span class="order-id cursor-pointer" onclick="viewOrderDetail(@order.OrderId)">#@order.OrderId.ToString().PadLeft(6, '0')</span>
                                    </td>
                                    <td style="text-align: center;">
                                        <button type="button" class="btn btn-sm btn-info"
                                                onclick="viewOrderDetail(@order.OrderId)" title="Xem">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </td>
                                    <td>
                                        <h6 class="customer-name">@order.ShippingName</h6>
                                        <small class="text-muted">@order.ShippingCity</small>
                                    </td>
                                    <td><span class="date-text">@order.ShippingPhone</span></td>
                                    <td style="text-align: right;" class="price-text">
                                        @order.TotalAmount.ToString("N0")đ
                                    </td>
                                    <td>
                                        @{
                                            var statusClass = order.StatusId switch
                                            {
                                                1 => "status-pending",
                                                2 => "status-confirmed",
                                                3 => "status-shipping",
                                                4 => "status-delivered",
                                                5 => "status-cancelled",
                                                _ => "status-pending"
                                            };

                                            var statusIcon = order.StatusId switch
                                            {
                                                1 => "fas fa-clock",
                                                2 => "fas fa-check-circle",
                                                3 => "fas fa-truck",
                                                4 => "fas fa-box",
                                                5 => "fas fa-times-circle",
                                                _ => "fas fa-circle"
                                            };
                                        }
                                        
                                        <select class="form-select form-select-sm status-badge @statusClass" 
                                                onchange="updateOrderStatus(@order.OrderId, this.value)"
                                                style="width: auto; display: inline-block; font-weight: 600;">
                                            <option value="1" selected="@(order.StatusId == 1)">Chờ xác nhận</option>
                                            <option value="2" selected="@(order.StatusId == 2)">Đã xác nhận</option>
                                            <option value="3" selected="@(order.StatusId == 3)">Đang vận chuyển</option>
                                            <option value="4" selected="@(order.StatusId == 4)">Đã giao</option>
                                            <option value="5" selected="@(order.StatusId == 5)">Đã hủy</option>
                                        </select>
                                    </td>
                                    <td>
                                        @{
                                            var refundClass = (order.RefundStatus?.ToLower()) switch
                                            {
                                                "pending" => "refund-pending",
                                                "none" => "refund-none",
                                                "approved" => "refund-approved",
                                                _ => "refund-none"
                                            };
                                        }
                                        <span class="refund-badge @refundClass">
                                            @(order.RefundStatus ?? "None")
                                        </span>
                                    </td>
                                    <td><span class="date-text">@order.OrderDate.ToString("dd/MM/yyyy")</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">Không có đơn hàng nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <nav class="mt-4" aria-label="Order pagination">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                            href="@Url.Action("Manage", "Order", new { q, status = statusFilter, dateFrom = dateFromFilter, dateTo = dateToFilter, page = currentPage - 1 })">
                            <i class="fas fa-chevron-left me-1"></i>Trước
                        </a>
                    </li>

                    @{
                        var startPage = Math.Max(1, currentPage - 2);
                        var endPage = Math.Min(totalPages, currentPage + 2);
                    }

                    @if (startPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Manage", "Order", new { q, status = statusFilter, dateFrom = dateFromFilter, dateTo = dateToFilter, page = 1 })">1</a>
                        </li>
                        @if (startPage > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                    }

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link"
                                href="@Url.Action("Manage", "Order", new { q, status = statusFilter, dateFrom = dateFromFilter, dateTo = dateToFilter, page = i })">
                                @i
                            </a>
                        </li>
                    }

                    @if (endPage < totalPages)
                    {
                        @if (endPage < totalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Manage", "Order", new { q, status = statusFilter, dateFrom = dateFromFilter, dateTo = dateToFilter, page = totalPages })">@totalPages</a>
                        </li>
                    }

                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link"
                            href="@Url.Action("Manage", "Order", new { q, status = statusFilter, dateFrom = dateFromFilter, dateTo = dateToFilter, page = currentPage + 1 })">
                            Sau <i class="fas fa-chevron-right ms-1"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>

<!-- Modal View Detail -->
<div class="modal fade" id="orderDetailModal" tabindex="-1" aria-labelledby="orderDetailLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" id="orderModal">
            <div class="modal-header">
                <h5 class="modal-title" id="orderDetailLabel">
                    <i class="fa-solid fa-boxes-stacked me-2"></i>Chi tiết đơn hàng
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="orderDetailContent">
                <!-- Content sẽ được load bằng JS -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- Toast lỗi -->
<div class="toast-container position-fixed p-3 toast-top-right" style="z-index: 2080;">
    <div id="liveToast" class="toast align-items-center text-bg-danger border-0" role="alert" aria-live="assertive"
        aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body fs-5 fw-semibold">
                <i class="fa-solid fa-circle-exclamation me-2"></i>
                @ViewBag.ErrorMessage
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        dayjs.locale('vi');

        // View Order Detail - Load from server
        function viewOrderDetail(orderId) {
            // Show loading
            Swal.fire({
                title: 'Đang tải...',
                didOpen: () => Swal.showLoading(),
                allowOutsideClick: false,
                showConfirmButton: false
            });

            $.ajax({
                url: '/Order/GetOrderDetail',
                type: 'GET',
                data: { id: orderId },
                success: function(result) {
                    Swal.close();
                    
                    if (!result.success || !result.order) {
                        Swal.fire('Lỗi', result.message || 'Không tìm thấy đơn hàng', 'error');
                        return;
                    }

                    const order = result.order;
                    const orderDateFormatted = dayjs(order.orderDate).format('DD/MM/YYYY HH:mm');

                    const statusClass = order.statusId === 1 ? 'status-pending' :
                        order.statusId === 2 ? 'status-confirmed' :
                        order.statusId === 3 ? 'status-shipping' :
                        order.statusId === 4 ? 'status-delivered' :
                        order.statusId === 5 ? 'status-cancelled' : 'status-pending';

                    const refundClass = (order.refundStatus?.toLowerCase() || 'none') === 'pending' ? 'refund-pending' :
                        order.refundStatus?.toLowerCase() === 'approved' ? 'refund-approved' : 'refund-none';

                    const itemsHtml = (order.orderDetails || []).map(item => `
                        <li>
                            <div style="display: flex; justify-content: space-between;">
                                <span>${item.productName}</span>
                                <span>${item.quantity} x ${item.unitPrice.toLocaleString('vi-VN')}đ = ${item.total.toLocaleString('vi-VN')}đ</span>
                            </div>
                        </li>
                    `).join('');

                    const subtotal = (order.orderDetails || []).reduce((sum, item) => sum + item.total, 0);

                    const content = `
                        <div class="row g-3">
                            <div class="col-md-12">
                                <div class="order-detail-section">
                                    <h6><i class="fas fa-info-circle me-2"></i>Thông tin chung</h6>
                                    <div class="detail-row">
                                        <span class="detail-label">Mã đơn hàng:</span>
                                        <span class="detail-value">#${order.orderId.toString().padStart(6, '0')}</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="detail-label">Trạng thái:</span>
                                        <span class="status-badge ${statusClass}">
                                            <i class="fas fa-check-circle"></i> ${order.statusName}
                                        </span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="detail-label">Hoàn tiền:</span>
                                        <span class="refund-badge ${refundClass}">${order.refundStatus || 'None'}</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="detail-label">Ngày đặt:</span>
                                        <span class="detail-value">${orderDateFormatted}</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="detail-label">Khách hàng:</span>
                                        <span class="detail-value">${order.accountName || 'N/A'}</span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="order-detail-section">
                                    <h6><i class="fas fa-map-marker-alt me-2"></i>Thông tin giao hàng</h6>
                                    <div class="detail-row">
                                        <span class="detail-label">Người nhận:</span>
                                        <span class="detail-value">${order.shippingName}</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="detail-label">Số điện thoại:</span>
                                        <span class="detail-value">${order.shippingPhone}</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="detail-label">Địa chỉ:</span>
                                        <span class="detail-value">${order.shippingAddressLine}</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="detail-label">Phường/Xã:</span>
                                        <span class="detail-value">${order.shippingWard}</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="detail-label">Tỉnh/Thành phố:</span>
                                        <span class="detail-value">${order.shippingCity}</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="detail-label">Phương thức vận chuyển:</span>
                                        <span class="detail-value">${order.shippingMethod === 'express' ? 'Giao nhanh' : 'Giao tiêu chuẩn'}</span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="order-detail-section">
                                    <h6><i class="fas fa-box me-2"></i>Chi tiết sản phẩm</h6>
                                    <ul class="order-items-list">
                                        ${itemsHtml || '<li class="text-muted">Chưa có sản phẩm</li>'}
                                    </ul>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="total-section">
                                    <div class="total-row">
                                        <span>Tạm tính:</span>
                                        <span>${subtotal.toLocaleString('vi-VN')}đ</span>
                                    </div>
                                    <div class="total-row">
                                        <span>Phí vận chuyển:</span>
                                        <span>${order.shippingFee.toLocaleString('vi-VN')}đ</span>
                                    </div>
                                    ${order.discountAmount > 0 ? `
                                    <div class="total-row">
                                        <span>Giảm giá ${order.voucherCode ? '(' + order.voucherCode + ')' : ''}:</span>
                                        <span class="text-danger">-${order.discountAmount.toLocaleString('vi-VN')}đ</span>
                                    </div>
                                    ` : ''}
                                    <div class="total-row grand">
                                        <span>Tổng cộng:</span>
                                        <span>${order.totalAmount.toLocaleString('vi-VN')}đ</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                    document.getElementById('orderDetailContent').innerHTML = content;
                    const modal = new bootstrap.Modal(document.getElementById('orderDetailModal'));
                    modal.show();
                },
                error: function() {
                    Swal.close();
                    Swal.fire('Lỗi', 'Không thể tải thông tin đơn hàng', 'error');
                }
            });
        }

        // Update Order Status
        function updateOrderStatus(orderId, newStatusId) {
            Swal.fire({
                title: 'Xác nhận cập nhật?',
                text: 'Bạn có chắc chắn muốn thay đổi trạng thái đơn hàng này?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Cập nhật',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Show loading
                    Swal.fire({
                        title: 'Đang xử lý...',
                        didOpen: () => Swal.showLoading(),
                        allowOutsideClick: false,
                        showConfirmButton: false
                    });

                    $.ajax({
                        url: '/Order/UpdateStatus',
                        type: 'POST',
                        data: { orderId: orderId, statusId: newStatusId },
                        success: function(result) {
                            Swal.close();
                            
                            if (result.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Thành công!',
                                    text: result.message,
                                    confirmButtonColor: '#3085d6'
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Lỗi', result.message, 'error');
                                location.reload(); // Reload to reset select
                            }
                        },
                        error: function() {
                            Swal.close();
                            Swal.fire('Lỗi', 'Không thể cập nhật trạng thái', 'error');
                            location.reload(); // Reload to reset select
                        }
                    });
                } else {
                    // Reset select to original value
                    location.reload();
                }
            });
        }
    </script>
}
