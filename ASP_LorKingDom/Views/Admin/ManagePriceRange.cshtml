@model IEnumerable<BLL.DTOs.PriceRangeDto>
@{
	Layout = "_AdminLayout";
	ViewData["Title"] = "Quản Lý Khoảng Giá";
	var q = (string?)ViewBag.Query ?? "";
}
<link rel="stylesheet" href="~/css/MPriceRange.css" asp-append-version="true" />
<div class="container-fluid px-5">
	<h1 class="mt-4">Quản Lý Khoảng Giá</h1>

	<form class="mt-4" asp-action="AddPriceRange" asp-controller="PriceRange" method="post">
		@Html.AntiForgeryToken()
		<input type="hidden" name="q" value="@q" />
		<input type="hidden" name="id" value="0" />
		<div class="row g-2 align-items-end">
			<div class="col-auto">
				<label class="form-label">Giá tối thiểu</label>
				<input type="number" name="priceRangeMin" step="1" min="0" class="form-control d-inline-block" required />
			</div>
			<div class="col-auto">
				<label class="form-label">Giá tối đa</label>
				<input type="number" name="priceRangeMax" step="1" min="0" class="form-control d-inline-block" required />
			</div>
			<div class="col-auto">
				<label class="form-label d-block">&nbsp;</label>
				<button class="btn btn-primary" type="submit">Thêm Khoảng Giá</button>
			</div>
		</div>
	</form>


	<div class="card mb-4 mt-4">
		<div class="card-header d-flex justify-content-between align-items-center">
			<div><i class="fa-solid fa-table me-1"></i> Danh Sách Khoảng Giá</div>
		</div>

		<div class="card-body">
			<!-- Tìm kiếm -->
			<form class="mb-4" method="get" asp-action="Manage" asp-controller="PriceRange">
				<div class="input-group search-box">
					<input type="text" name="q" value="@q" class="form-control" placeholder="Tìm theo số Min/Max...">
					<button class="btn btn-outline-secondary" type="submit">
						<i class="fa-solid fa-magnifying-glass"></i>
					</button>
				</div>
			</form>

			@if (TempData["Error"] is string e)
			{
				<div class="alert alert-danger">@e</div>
			}
			@if (TempData["Success"] is string s)
			{
				<div class="alert alert-success">@s</div>
			}

			<div class="table-responsive">
				<table class="table table-bordered table-striped table-hover">
					<thead class="table-dark">
						<tr>
							<th style="white-space:nowrap">ID</th>
							<th style="white-space:nowrap">Hành Động</th>
							<th>Khoảng Giá</th>
							<th style="white-space:nowrap">Trạng Thái</th>
							<th style="white-space:nowrap">Ngày Tạo</th>
						</tr>
					</thead>
					<tbody>
						@if (Model.Any())
						{
							foreach (var x in Model)
							{
								<tr class="@(x.IsDeleted ? "deleted-row" : "")">
									<td>@x.Id</td>

									<td style="white-space:nowrap">
										<a class="btn btn-sm btn-warning ms-1" title="Cập nhật"
										   asp-action="Edit" asp-controller="PriceRange"
										   asp-route-id="@x.Id" asp-route-q="@q">
											<i class="fa-solid fa-pen-to-square"></i>
										</a>
									</td>

									<td>@($"{x.PriceRangeMin:N0} - {x.PriceRangeMax:N0}")</td>

									<td>
										@if (x.IsDeleted)
										{
											<span class="badge bg-secondary">Không hoạt động</span>
										}
										else
										{
											<span class="badge bg-success">Hoạt động</span>
										}
									</td>

									<td>@(x.CreatedAt?.ToString("dd/MM/yyyy HH:mm"))</td>
								</tr>
							}
						}
						else
						{
							<tr>
								<td colspan="5" class="text-center text-muted">Không có dữ liệu.</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>

<!-- Modal Edit -->
<div class="modal fade @(ViewBag.EditPriceRange != null ? "show d-block" : "")"
	 id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="@(ViewBag.EditPriceRange == null)">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header">
				<h5 id="editModalLabel" class="modal-title">Cập nhật Khoảng Giá</h5>
				<a href="@Url.Action("Manage", "PriceRange")" class="btn-close"></a>
			</div>

			<form method="post" asp-action="UpdatePriceRange" asp-controller="PriceRange">
				@Html.AntiForgeryToken()
				<input type="hidden" name="q" value="@q" />
				<div class="modal-body">
					@{
						var edit = ViewBag.EditPriceRange as BLL.DTOs.PriceRangeDto;
					}
					<input type="hidden" name="id" value="@(edit?.Id ?? 0)" />

					<div class="row g-2">
						<div class="col">
							<label class="form-label">Giá tối thiểu</label>
							<input type="number" step="1" min="0"
								   class="form-control"
								   name="priceRangeMin"
								   value="@(edit?.PriceRangeMin.ToString("0"))" required />
						</div>
						<div class="col">
							<label class="form-label">Giá tối đa</label>
							<input type="number" step="1" min="0"
								   class="form-control"
								   name="priceRangeMax"
								   value="@(edit?.PriceRangeMax.ToString("0"))" required />
						</div>
					</div>

					<div class="mt-3">
						<label class="form-label">Trạng thái</label>
						<select class="form-select" name="isDeleted" required>
							<option value="false" selected="@(edit?.IsDeleted == false)">Hoạt động (0)</option>
							<option value="true" selected="@(edit?.IsDeleted == true)">Không hoạt động (1)</option>
						</select>
						<div class="form-text">IsDeleted = 1 nghĩa là không hoạt động.</div>
					</div>

					<div class="mb-2 mt-3 text-muted small">
						<i class="fa-regular fa-clock me-1"></i>
						Ngày tạo: @(edit?.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")
					</div>
				</div>

				<div class="modal-footer">
					<a href="@Url.Action("Manage", "PriceRange", new { q })" class="btn btn-outline-secondary">Hủy</a>
					<button type="submit" class="btn btn-primary">Lưu thay đổi</button>
				</div>
			</form>
		</div>
	</div>
</div>

<div class="toast-container position-fixed p-3 toast-top-right" style="z-index:2080;">
	<div id="liveToast" class="toast align-items-center text-bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true">
		<div class="d-flex">
			<div class="toast-body fs-5 fw-semibold">
				<i class="fa-solid fa-circle-exclamation me-2"></i>
				@ViewBag.ErrorMessage
			</div>
			<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Đóng"></button>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		// Hiển thị toast 5s khi có lỗi
		document.addEventListener('DOMContentLoaded', function () {
			const hasError = '@(ViewBag.ShowErrorModal == true ? "true" : "false")';
			if (hasError === "true") {
				const toastEl = document.getElementById('liveToast');
				if (toastEl) {
					const toast = new bootstrap.Toast(toastEl, { delay: 5000 });
					toast.show();
				}
			}
		});
	</script>

	@if (ViewBag.EditPriceRange != null || ViewBag.ShowErrorModal == true)
	{
		<script>
			document.body.classList.add('modal-open');
			document.body.style.overflow = 'hidden';
		</script>
	}
}

@section Styles {
	<link rel="stylesheet"
		  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
		  crossorigin="anonymous" referrerpolicy="no-referrer" />
}
