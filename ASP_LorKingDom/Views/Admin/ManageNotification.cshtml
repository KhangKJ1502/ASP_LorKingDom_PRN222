@using Microsoft.AspNetCore.Html
@model BLL.DTOs.PagedResult<BLL.DTOs.NotificationDto>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản Lý Thông Báo Hệ Thống";

    var f = ViewBag.Filter as BLL.DTOs.NotificationFilterDto;
    var edit = ViewBag.EditNotification as BLL.DTOs.NotificationDto;

    var roles = ViewBag.Roles as IEnumerable<DAL.Models.Role>;
}

<style>
    .search-box .form-control {
        border: 1px solid #000 !important;
        box-shadow: none !important;
    }

    .search-box .btn {
        border: 1px solid #000 !important;
        border-left: none !important;
    }

    .toast-top-right {
        top: 120px !important;
        right: 24px !important;
    }

    #liveToast.toast {
        min-width: 520px;
        padding: 1rem 1.25rem;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0,0,0,.18);
    }

    #liveToast .toast-body {
        font-size: 1.1rem;
        font-weight: 600;
    }

    .deleted-row {
        opacity: .6;
        background: #f8f9fa;
    }

    #notificationModal .modal-content {
        border: none;
        border-radius: 16px;
        box-shadow: 0 10px 40px rgba(0,0,0,.15);
    }

    #notificationModal .modal-header {
        background: linear-gradient(135deg,#667eea 0%,#764ba2 100%);
        color: #fff;
        border-radius: 16px 16px 0 0;
        padding: 1.5rem;
        border: none;
    }

    #notificationModal .modal-title {
        font-weight: 600;
        font-size: 1.25rem;
    }

    #notificationModal .btn-close {
        filter: brightness(0) invert(1);
        opacity: .8;
    }

        #notificationModal .btn-close:hover {
            opacity: 1;
        }

    #notificationModal .modal-body {
        padding: 2rem;
        background-color: #f8f9fa;
    }

    #notificationModal .form-label {
        font-weight: 500;
        color: #495057;
        margin-bottom: .5rem;
        font-size: .9rem;
    }

    #notificationModal .form-control,
    #notificationModal .form-select {
        border: 2px solid #e9ecef;
        border-radius: 8px;
        padding: .65rem .875rem;
        transition: .3s ease;
        background-color: #fff;
    }

        #notificationModal .form-control:focus,
        #notificationModal .form-select:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 .2rem rgba(102,126,234,.15);
        }

    #notificationModal textarea.form-control {
        min-height: 100px;
        resize: vertical;
    }

    #notificationModal .modal-footer {
        border-top: 1px solid #e9ecef;
        padding: 1.25rem 2rem;
        background-color: #fff;
        border-radius: 0 0 16px 16px;
    }

    #notificationModal .btn {
        padding: .625rem 1.5rem;
        border-radius: 8px;
        font-weight: 500;
        transition: .3s ease;
    }

    #notificationModal .btn-primary {
        background: linear-gradient(135deg,#667eea 0%,#764ba2 100%);
        border: none;
    }

        #notificationModal .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(102,126,234,.4);
        }

    #notificationModal .btn-outline-secondary {
        border: 2px solid #6c757d;
        color: #6c757d;
    }

        #notificationModal .btn-outline-secondary:hover {
            background-color: #6c757d;
            color: #fff;
        }

    .field-animate {
        animation: slideIn .3s ease;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(-4px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="container-fluid px-5">
    <h1 class="mt-4">Quản Lý Thông Báo</h1>

    <div class="card mb-4 mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div><i class="fa-solid fa-bell me-1"></i> Danh Sách Thông Báo</div>

            <button class="btn btn-primary"
                    type="button"
                    data-bs-toggle="modal"
                    data-bs-target="#notificationModal"
                    onclick="openAddModal()">
                <i class="fa-solid fa-plus me-1"></i> Thêm Thông Báo
            </button>
        </div>

        <div class="card-body">

            <div class="row mb-4">
                <div class="col-md-8">
                    <form method="get" asp-action="Search" asp-controller="Notification" id="searchForm">
                        <div class="input-group search-box">
                            <input type="text" name="Keyword" value="@(f?.Keyword ?? "")" class="form-control" placeholder="Tìm theo tiêu đề/nội dung...">
                            <input type="hidden" name="PageSize" value="@(Model?.PageSize ?? 10)" />
                            <button class="btn btn-outline-secondary" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
                            @if (!string.IsNullOrWhiteSpace(f?.Keyword))
                            {
                                <a href="@Url.Action("Index", "Notification", new { pageSize = Model?.PageSize ?? 10 })" class="btn btn-outline-danger" title="Xóa tìm kiếm">
                                    <i class="fa-solid fa-times"></i>
                                </a>
                            }
                        </div>
                    </form>
                </div>
                <div class="col-md-4">
                    <div class="d-flex align-items-center justify-content-end">
                        <label class="me-2 mb-0">Hiển thị:</label>
                        <select class="form-select form-select-sm" style="width: auto;" id="pageSizeSelector" onchange="changePageSize(this.value)">
                            @{
                                var currentPageSize = Model?.PageSize ?? 10;
                            }
                            <option value="5" selected="@(currentPageSize == 5)">5</option>
                            <option value="10" selected="@(currentPageSize == 10)">10</option>
                            <option value="20" selected="@(currentPageSize == 20)">20</option>
                            <option value="50" selected="@(currentPageSize == 50)">50</option>
                            <option value="100" selected="@(currentPageSize == 100)">100</option>
                        </select>
                        <span class="ms-2 text-muted">mục/trang</span>
                    </div>
                </div>
            </div>

            @if (TempData["Error"] is string e)
            {
                <div class="alert alert-danger">@e</div>
            }
            @if (TempData["Success"] is string s)
            {
                <div class="alert alert-success">@s</div>
            }
            @if (TempData["toast"] is string t)
            {
                <div class="alert alert-info">@t</div>
            }

            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th style="white-space:nowrap">Hành Động</th>
                            <th>Tiêu Đề</th>
                            <th>Loại</th>
                            <th>Target</th>
                            <th>Thời Gian Gửi</th>
                            <th>Trạng Thái</th>
                            <th>Ngày Tạo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.Items != null && Model.Items.Any())
                        {
                            foreach (var n in Model.Items)
                            {
                                <tr class="@(n.IsCanceled ? "deleted-row" : "")">
                                    <td>@n.NotificationId</td>

                                    <td style="white-space:nowrap">
                                        @if (!n.IsSent && !n.IsCanceled)
                                        {
                                            <a class="btn btn-sm btn-warning"
                                               asp-action="Edit"
                                               asp-controller="Notification"
                                               asp-route-id="@n.NotificationId">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </a>

                                            <form method="post"
                                                  asp-action="SendNow"
                                                  asp-controller="Notification"
                                                  style="display:inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@n.NotificationId" />
                                                <button type="submit"
                                                        class="btn btn-sm btn-success"
                                                        onclick="return confirm('Gửi ngay thông báo này?')">
                                                    <i class="fa-solid fa-paper-plane"></i>
                                                </button>
                                            </form>

                                            <form method="post"
                                                  asp-action="Cancel"
                                                  asp-controller="Notification"
                                                  style="display:inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@n.NotificationId" />
                                                <button type="submit"
                                                        class="btn btn-sm btn-secondary"
                                                        onclick="return confirm('Hủy thông báo này?')">
                                                    <i class="fa-solid fa-ban"></i>
                                                </button>
                                            </form>
                                        }

                                        <form method="post"
                                              asp-action="SoftDelete"
                                              asp-controller="Notification"
                                              style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@n.NotificationId" />
                                            <button type="submit"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="return confirm('Xóa thông báo này?')">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>

                                    <td>@n.Title</td>

                                    <td>@n.Type</td>

                                    <td>
                                        @n.TargetType
                                        @if (n.TargetUserId.HasValue)
                                        {
                                            <span class="text-muted ms-1">(User @n.TargetUserId)</span>
                                        }
                                        else if (n.TargetRoleId.HasValue)
                                        {
                                            <span class="text-muted ms-1">(@(n.TargetRoleName ?? $"Role {n.TargetRoleId}"))</span>
                                        }
                                    </td>

                                    <td>
                                        @n.ScheduledAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        @if (n.ExpireAt.HasValue)
                                        {
                                            <span> - @n.ExpireAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                        }
                                    </td>

                                    <td>
                                        @if (n.IsCanceled)
                                        {
                                            <span class="badge bg-secondary">Đã hủy</span>
                                        }
                                        else if (n.IsSent)
                                        {
                                            <span class="badge bg-success">Đã gửi</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Chờ gửi</span>
                                        }
                                    </td>

                                    <td>@n.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted">Không có dữ liệu.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @{
                // ====== CUSTOM PAGINATION START ======
                var totalPages = 1;
                var currentPage = 1;
                var pageSize = 20;
                var keyword = f?.Keyword ?? "";

                if (Model != null)
                {
                    pageSize = Model.PageSize;
                    currentPage = Model.Page;
                    totalPages = (int)Math.Ceiling((double)Model.Total / Model.PageSize);
                    if (totalPages < 1) totalPages = 1;
                }

                // helper render 1 trang (li>a)
                Func<int, IHtmlContent> renderPageItem = (int pageNum) =>
                {
                    var liClass = pageNum == currentPage ? "page-item active" : "page-item";
                    var action = string.IsNullOrWhiteSpace(keyword) ? "Index" : "Search";
                    var url = string.IsNullOrWhiteSpace(keyword)
                        ? Url.Action(action, "Notification", new { page = pageNum, pageSize = pageSize })
                        : Url.Action(action, "Notification", new { Keyword = keyword, page = pageNum, pageSize = pageSize });

                    return new HtmlString($@"
                        <li class=""{liClass}"">
                        <a class=""page-link"" href=""{url}"">{pageNum}</a>
                        </li>
                        ");
                };

                // helper render item disabled (ví dụ ... )
                Func<string, IHtmlContent> renderDisabledItem = (string text) =>
                {
                    return new HtmlString($@"
                        <li class=""page-item disabled"">
                        <span class=""page-link"">{text}</span>
                        </li>
                        ");
                };
            }

            @if (totalPages > 1)
            {
                <nav>
                    <ul class="pagination justify-content-center">

                        @* Previous *@
                        @{
                            var prevDisabled = currentPage <= 1;
                            var prevPage = currentPage > 1 ? currentPage - 1 : 1;
                            var action = string.IsNullOrWhiteSpace(keyword) ? "Index" : "Search";
                            var prevUrl = prevDisabled
                            ? "#"
                            : string.IsNullOrWhiteSpace(keyword)
                                ? Url.Action(action, "Notification", new { page = prevPage, pageSize = pageSize })
                                : Url.Action(action, "Notification", new { Keyword = keyword, page = prevPage, pageSize = pageSize });
                        }
                        <li class="page-item @(prevDisabled ? "disabled" : "")">
                            <a class="page-link"
                               href="@prevUrl"
                               tabindex="-1"
                               aria-disabled="@(prevDisabled ? "true" : "false")">«</a>
                        </li>

                        @* Pages with window + ... *@
                        @{
                            // Ví dụ windowSize = 1 => currentPage-1, currentPage, currentPage+1
                            var windowSize = 1;
                            var startPage = currentPage - windowSize;
                            var endPage = currentPage + windowSize;

                            if (startPage < 1) startPage = 1;
                            if (endPage > totalPages) endPage = totalPages;

                            // luôn hiện trang 1
                            @renderPageItem(1)
                            ;

                            // nếu block giữa không dính sát trang 1 => in "..."
                            if (startPage > 2)
                            {
                                @renderDisabledItem("...")
                                ;
                            }

                            // render các trang giữa (trừ 1 và totalPages để không bị lặp)
                            for (int p = startPage; p <= endPage; p++)
                            {
                                if (p != 1 && p != totalPages)
                                {
                                    @renderPageItem(p)
                                    ;
                                }
                            }

                            // nếu block giữa không dính sát trang cuối => in "..."
                            if (endPage < totalPages - 1)
                            {
                                @renderDisabledItem("...")
                                ;
                            }

                            // luôn hiện trang cuối (nếu >1)
                            if (totalPages > 1)
                            {
                                @renderPageItem(totalPages)
                                ;
                            }
                        }

                        @* Next *@
                        @{
                            var nextDisabled = currentPage >= totalPages;
                            var nextPage = currentPage < totalPages ? currentPage + 1 : totalPages;
                            var nextAction = string.IsNullOrWhiteSpace(keyword) ? "Index" : "Search";
                            var nextUrl = nextDisabled
                            ? "#"
                            : string.IsNullOrWhiteSpace(keyword)
                                ? Url.Action(nextAction, "Notification", new { page = nextPage, pageSize = pageSize })
                                : Url.Action(nextAction, "Notification", new { Keyword = keyword, page = nextPage, pageSize = pageSize });
                        }
                        <li class="page-item @(nextDisabled ? "disabled" : "")">
                            <a class="page-link"
                               href="@nextUrl"
                               aria-disabled="@(nextDisabled ? "true" : "false")">»</a>
                        </li>

                    </ul>
                </nav>
            }
            @* ====== CUSTOM PAGINATION END ====== *@

        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade"
     id="notificationModal"
     tabindex="-1"
     aria-labelledby="notificationModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 id="notificationModalLabel" class="modal-title">
                    <i class="fa-solid fa-bell me-2"></i>
                    @(edit != null ? "Cập nhật thông báo" : "Thêm thông báo mới")
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"
                        onclick="closeModal()"></button>
            </div>

            <form method="post"
                  asp-action="SaveNotification"
                  asp-controller="Notification"
                  id="notificationForm">
                @Html.AntiForgeryToken()

                <div class="modal-body">
                    <input type="hidden" name="NotificationId" id="notificationId" value="@(edit?.NotificationId ?? 0)" />
                    <input type="hidden" name="CreatedBy" id="createdBy" value="0" />

                    <div class="row g-3">

                        <div class="col-lg-6">
                            <label class="form-label">
                                <i class="fa-solid fa-heading me-1"></i>
                                Tiêu đề <span class="text-danger">*</span>
                            </label>
                            <input type="text"
                                   class="form-control"
                                   name="Title"
                                   id="title"
                                   value="@(edit?.Title ?? "")"
                                   placeholder="Nhập tiêu đề thông báo"
                                   required
                                   maxlength="200" />
                        </div>

                        <div class="col-lg-6">
                            <label class="form-label">
                                <i class="fa-solid fa-tag me-1"></i>
                                Loại <span class="text-danger">*</span>
                            </label>
                            <select class="form-select"
                                    name="Type"
                                    id="type"
                                    required>
                                <option value="info">ℹ️ Info</option>
                                <option value="warning">⚠️ Warning</option>
                                <option value="error">❌ Error</option>
                                <option value="promo">🎉 Promo</option>
                                <option value="system">⚙️ System</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label">
                                <i class="fa-solid fa-message me-1"></i>
                                Nội dung <span class="text-danger">*</span>
                            </label>
                            <textarea class="form-control"
                                      name="Message"
                                      id="message"
                                      rows="3"
                                      placeholder="Nhập nội dung thông báo..."
                                      required
                                      maxlength="1000">@(
                                          edit?.Message ?? ""
                                      )</textarea>
                        </div>

                        <div class="col-lg-4">
                            <label class="form-label">
                                <i class="fa-solid fa-bullseye me-1"></i>
                                Đối tượng <span class="text-danger">*</span>
                            </label>
                            <select class="form-select"
                                    name="TargetType"
                                    id="targetType"
                                    onchange="toggleTargetFields()"
                                    required>
                                <option value="All">👥 Tất cả</option>
                                <option value="Role">🎭 Theo vai trò</option>
                                <option value="User">👤 Người dùng cụ thể</option>
                                <option value="Condition">🔍 Theo điều kiện</option>
                            </select>
                        </div>

                        <div class="col-lg-4 field-animate"
                             id="targetRoleField"
                             style="display:none">
                            <label class="form-label">
                                <i class="fa-solid fa-user-tag me-1"></i>
                                Vai trò
                            </label>
                            <select class="form-select"
                                    name="TargetRoleId"
                                    id="targetRoleId">
                                <option value="">-- Chọn vai trò --</option>
                                @if (roles != null)
                                {
                                    foreach (var r in roles)
                                    {
                                        var rid = r.RoleId;
                                        if (edit?.TargetRoleId == rid)
                                        {
                                            <option value="@rid" selected="selected">@r.RoleName</option>
                                        }
                                        else
                                        {
                                            <option value="@rid">@r.RoleName</option>
                                        }
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-lg-4 field-animate"
                             id="targetUserField"
                             style="display:none">
                            <label class="form-label">
                                <i class="fa-solid fa-user me-1"></i>
                                ID Người dùng
                            </label>
                            <input type="number"
                                   class="form-control"
                                   name="TargetUserId"
                                   id="targetUserId"
                                   value="@(edit?.TargetUserId?.ToString() ?? "")"
                                   placeholder="Nhập ID người dùng"
                                   min="1" />
                        </div>

                        <div class="col-lg-6">
                            <label class="form-label">
                                <i class="fa-solid fa-clock me-1"></i>
                                Thời gian hiển thị <span class="text-danger">*</span>
                            </label>
                            <input type="datetime-local"
                                   class="form-control"
                                   name="ScheduledAt"
                                   id="scheduledAt"
                                   value="@(edit != null
                                                                               ? edit.ScheduledAt.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")
                                                                               : DateTime.Now.ToString("yyyy-MM-ddTHH:mm"))"
                                   required />
                        </div>

                        <div class="col-lg-6">
                            <label class="form-label">
                                <i class="fa-solid fa-calendar-xmark me-1"></i>
                                Thời gian hết hạn
                            </label>
                            <input type="datetime-local"
                                   class="form-control"
                                   name="ExpireAt"
                                   id="expireAt"
                                   value="@(edit?.ExpireAt?.ToLocalTime().ToString("yyyy-MM-ddTHH:mm") ?? "")" />
                        </div>

                        <div class="col-12 field-animate"
                             id="conditionField"
                             style="display:none">
                            <label class="form-label">
                                <i class="fa-solid fa-filter me-1"></i>
                                Điều kiện (JSON, optional)
                            </label>
                            <input type="text"
                                   class="form-control"
                                   name="ConditionJson"
                                   id="conditionJson"
                                   value="@(edit?.ConditionJson ?? "")"
                                   placeholder='VD: {"minSpent":1000000}' />
                        </div>

                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal"
                            onclick="closeModal()">
                        <i class="fa-solid fa-xmark me-1"></i>Hủy
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-floppy-disk me-1"></i>
                        @(edit != null ? "Lưu thay đổi" : "Thêm mới")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Toast lỗi -->
<div class="toast-container position-fixed p-3 toast-top-right">
    <div id="liveToast"
         class="toast align-items-center text-bg-danger border-0"
         role="alert">
        <div class="d-flex">
            <div class="toast-body fs-5 fw-semibold">
                <i class="fa-solid fa-circle-exclamation me-2"></i>
                @ViewBag.ErrorMessage
            </div>
            <button type="button"
                    class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer" />

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const hasError = '@(ViewBag.ShowErrorModal == true ? "true" : "false")';
            if (hasError === "true") {
                const toastEl = document.getElementById('liveToast');
                if (toastEl) new bootstrap.Toast(toastEl, { delay: 5000 }).show();
            }

            const needShow = '@((edit != null || (ViewBag.ShowErrorModal == true)) ? "true" : "false")';
            if (needShow === "true") {
                const modalEl = document.getElementById('notificationModal');
                if (modalEl) new bootstrap.Modal(modalEl).show();
            }

            // map type server -> UI
            const typeSel = document.getElementById('type');
            if (typeSel) {
                const serverType = '@(edit?.Type?.ToLowerInvariant() ?? "info")';
                const typeMapping = {
                    'general': 'info',
                    'promotion': 'promo',
                    'system': 'system',
                    'order': 'info',
                    'info': 'info',
                    'warning': 'warning',
                    'error': 'error',
                    'promo': 'promo'
                };
                typeSel.value = typeMapping[serverType] || 'info';
            }

            // map TargetType server -> UI
            const targetSel = document.getElementById('targetType');
            if (targetSel) {
                const serverTarget = '@(edit?.TargetType ?? "All")';
                const targetMapping = {
                    'ByRole': 'Role',
                    'SingleUser': 'User',
                    'ByCondition': 'Condition',
                    'All': 'All'
                };
                targetSel.value = targetMapping[serverTarget] || 'All';
            }

            toggleTargetFields();
        });

        function openAddModal() {
            const form = document.getElementById('notificationForm');
            if (form) form.reset();

            document.getElementById('notificationId').value = '0';
            document.getElementById('createdBy').value = '0';
            document.getElementById('scheduledAt').value = '@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")';
            document.getElementById('notificationModalLabel').innerHTML =
                '<i class="fa-solid fa-bell me-2"></i>Thêm thông báo mới';

            const typeSel = document.getElementById('type');
            if (typeSel) typeSel.value = 'info';

            const targetSel = document.getElementById('targetType');
            if (targetSel) targetSel.value = 'All';

            const roleSel = document.getElementById('targetRoleId');
            if (roleSel) roleSel.value = '';

            const userInput = document.getElementById('targetUserId');
            if (userInput) userInput.value = '';

            const condInput = document.getElementById('conditionJson');
            if (condInput) condInput.value = '';

            toggleTargetFields();
        }

        function closeModal() {
            const keyword = '@Html.Raw(f?.Keyword ?? "")';
            const pageSize = @(f?.PageSize ?? 10);
            
            if (keyword) {
                window.location.href = '@Url.Action("Search", "Notification")' + '?Keyword=' + encodeURIComponent(keyword) + '&PageSize=' + pageSize;
            } else {
                window.location.href = '@Url.Action("Index", "Notification")' + '?PageSize=' + pageSize;
            }
        }

        function changePageSize(newPageSize) {
            const keyword = '@Html.Raw(f?.Keyword ?? "")';
            
            if (keyword) {
                window.location.href = '@Url.Action("Search", "Notification")' + '?Keyword=' + encodeURIComponent(keyword) + '&page=1&PageSize=' + newPageSize;
            } else {
                window.location.href = '@Url.Action("Index", "Notification")' + '?page=1&PageSize=' + newPageSize;
            }
        }

        function toggleTargetFields() {
            const type = document.getElementById('targetType').value;
            const roleField = document.getElementById('targetRoleField');
            const userField = document.getElementById('targetUserField');
            const condField = document.getElementById('conditionField');

            const roleSelect = document.getElementById('targetRoleId');
            const userInput = document.getElementById('targetUserId');

            // hide all first
            if (roleField) roleField.style.display = 'none';
            if (userField) userField.style.display = 'none';
            if (condField) condField.style.display = 'none';

            if (roleSelect) roleSelect.required = false;
            if (userInput) userInput.required = false;

            // show per mode
            if (type === 'Role') {
                if (roleField) roleField.style.display = 'block';
                if (roleSelect) roleSelect.required = true;
            } else if (type === 'User') {
                if (userField) userField.style.display = 'block';
                if (userInput) userInput.required = true;
            } else if (type === 'Condition') {
                if (condField) condField.style.display = 'block';
            }
        }
    </script>
}
