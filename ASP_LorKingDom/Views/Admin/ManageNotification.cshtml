@using Microsoft.AspNetCore.Html
@model BLL.DTOs.PagedResult<BLL.DTOs.NotificationDto>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản Lý Thông Báo Hệ Thống";

    var f = ViewBag.Filter as BLL.DTOs.NotificationFilterDto;
    var edit = ViewBag.EditNotification as BLL.DTOs.NotificationDto;

    var roles = ViewBag.Roles as IEnumerable<DAL.Models.Role>;
}

<link rel="stylesheet" href="~/css/admin-notification.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container-fluid px-5">
    <h1 class="mt-4">Quản Lý Thông Báo</h1>

    <div class="card mb-4 mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div><i class="fa-solid fa-bell me-1"></i> Danh Sách Thông Báo</div>

            <button class="btn btn-primary"
                    type="button"
                    data-bs-toggle="modal"
                    data-bs-target="#notificationModal"
                    onclick="openAddModal()">
                <i class="fa-solid fa-plus me-1"></i> Thêm Thông Báo
            </button>
        </div>

        <div class="card-body">

            <div class="row mb-4">
                <div class="col-md-8">
                    <form method="get" asp-action="Search" asp-controller="Notification" id="searchForm">
                        <div class="input-group search-box">
                            <input type="text" name="Keyword" value="@(f?.Keyword ?? "")" class="form-control" placeholder="Tìm theo tiêu đề/nội dung...">
                            <input type="hidden" name="PageSize" value="@(Model?.PageSize ?? 10)" />
                            <button class="btn btn-outline-secondary" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
                            @if (!string.IsNullOrWhiteSpace(f?.Keyword))
                            {
                                <a href="@Url.Action("Index", "Notification", new { pageSize = Model?.PageSize ?? 10 })" class="btn btn-outline-danger" title="Xóa tìm kiếm">
                                    <i class="fa-solid fa-times"></i>
                                </a>
                            }
                        </div>
                    </form>
                </div>
                <div class="col-md-4">
                    <div class="d-flex align-items-center justify-content-end">
                        <label class="me-2 mb-0">Hiển thị:</label>
                        <select class="form-select form-select-sm" style="width: auto;" id="pageSizeSelector" onchange="changePageSize(this.value)">
                            @{
                                var currentPageSize = Model?.PageSize ?? 10;
                            }
                            <option value="5" selected="@(currentPageSize == 5)">5</option>
                            <option value="10" selected="@(currentPageSize == 10)">10</option>
                            <option value="20" selected="@(currentPageSize == 20)">20</option>
                            <option value="50" selected="@(currentPageSize == 50)">50</option>
                            <option value="100" selected="@(currentPageSize == 100)">100</option>
                        </select>
                        <span class="ms-2 text-muted">mục/trang</span>
                    </div>
                </div>
            </div>

            @if (TempData["Error"] is string e)
            {
                <div class="alert alert-danger">@e</div>
            }
            @if (TempData["Success"] is string s)
            {
                <div class="alert alert-success">@s</div>
            }
            @if (TempData["toast"] is string t)
            {
                <div class="alert alert-info">@t</div>
            }

            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th style="white-space:nowrap">Hành Động</th>
                            <th>Tiêu Đề</th>
                            <th>Loại</th>
                            <th>Target</th>
                            <th>Thời Gian Gửi</th>
                            <th>Trạng Thái</th>
                            <th>Ngày Tạo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.Items != null && Model.Items.Any())
                        {
                            foreach (var n in Model.Items)
                            {
                                <tr class="@(n.IsCanceled ? "deleted-row" : "")">
                                    <td>@n.NotificationId</td>

                                    <td style="white-space:nowrap">
                                        @if (!n.IsSent && !n.IsCanceled)
                                        {
                                            <!-- Chỉnh sửa -->
                                            <a class="btn btn-sm btn-warning"
                                               asp-action="Edit"
                                               asp-controller="Notification"
                                               asp-route-id="@n.NotificationId"
                                               title="Chỉnh sửa">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </a>

                                            <!-- Gửi ngay -->
                                            <form method="post"
                                                  asp-action="SendNow"
                                                  asp-controller="Notification"
                                                  style="display:inline"
                                                  onsubmit="return confirmSendNow(event)">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@n.NotificationId" />
                                                <button type="submit"
                                                        class="btn btn-sm btn-success"
                                                        title="Gửi ngay">
                                                    <i class="fa-solid fa-paper-plane"></i>
                                                </button>
                                            </form>

                                            <!-- Hủy -->
                                            <form method="post"
                                                  asp-action="Cancel"
                                                  asp-controller="Notification"
                                                  style="display:inline"
                                                  onsubmit="return confirmCancel(event)">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@n.NotificationId" />
                                                <button type="submit"
                                                        class="btn btn-sm btn-secondary"
                                                        title="Hủy thông báo">
                                                    <i class="fa-solid fa-ban"></i>
                                                </button>
                                            </form>

                                            <!-- Xóa (chỉ cho thông báo chưa gửi) -->
                                            <form method="post"
                                                  asp-action="Delete"
                                                  asp-controller="Notification"
                                                  style="display:inline"
                                                  onsubmit="return confirmDelete(event)">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@n.NotificationId" />
                                                <button type="submit"
                                                        class="btn btn-sm btn-danger"
                                                        title="Xóa thông báo">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <!-- Chỉ hiển thị thông tin cho thông báo đã gửi/đã hủy -->
                                            <span class="text-muted">
                                                @if (n.IsSent)
                                                {
                                                    <i class="fa-solid fa-check-circle text-success" title="Đã gửi"></i>
                                                }
                                                else if (n.IsCanceled)
                                                {
                                                    <i class="fa-solid fa-ban text-secondary" title="Đã hủy"></i>
                                                }
                                            </span>
                                        }
                                    </td>

                                    <td>@n.Title</td>

                                    <td>@n.Type</td>

                                    <td>
                                        @n.TargetType
                                        @if (n.TargetUserId.HasValue)
                                        {
                                            <span class="text-muted ms-1">(User @n.TargetUserId)</span>
                                        }
                                        else if (n.TargetRoleId.HasValue)
                                        {
                                            <span class="text-muted ms-1">(@(n.TargetRoleName ?? $"Role {n.TargetRoleId}"))</span>
                                        }
                                    </td>

                                    <td>
                                        @n.ScheduledAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        @if (n.ExpireAt.HasValue)
                                        {
                                            <span> - @n.ExpireAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                        }
                                    </td>

                                    <td>
                                        @if (n.IsCanceled)
                                        {
                                            <span class="badge bg-secondary">Đã hủy</span>
                                        }
                                        else if (n.IsSent)
                                        {
                                            <span class="badge bg-success">Đã gửi</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Chờ gửi</span>
                                        }
                                    </td>

                                    <td>@n.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted">Không có dữ liệu.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @{
                // ====== CUSTOM PAGINATION START ======
                var totalPages = 1;
                var currentPage = 1;
                var pageSize = 20;
                var keyword = f?.Keyword ?? "";

                if (Model != null)
                {
                    pageSize = Model.PageSize;
                    currentPage = Model.Page;
                    totalPages = (int)Math.Ceiling((double)Model.Total / Model.PageSize);
                    if (totalPages < 1) totalPages = 1;
                }

                // helper render 1 trang (li>a)
                Func<int, IHtmlContent> renderPageItem = (int pageNum) =>
                {
                    var liClass = pageNum == currentPage ? "page-item active" : "page-item";
                    var action = string.IsNullOrWhiteSpace(keyword) ? "Index" : "Search";
                    var url = string.IsNullOrWhiteSpace(keyword)
                        ? Url.Action(action, "Notification", new { page = pageNum, pageSize = pageSize })
                        : Url.Action(action, "Notification", new { Keyword = keyword, page = pageNum, pageSize = pageSize });

                    return new HtmlString($@"
                        <li class=""{liClass}"">
                        <a class=""page-link"" href=""{url}"">{pageNum}</a>
                        </li>
                        ");
                };

                // helper render item disabled (ví dụ ... )
                Func<string, IHtmlContent> renderDisabledItem = (string text) =>
                {
                    return new HtmlString($@"
                        <li class=""page-item disabled"">
                        <span class=""page-link"">{text}</span>
                        </li>
                        ");
                };
            }

            @if (totalPages > 1)
            {
                <nav>
                    <ul class="pagination justify-content-center">

                        @* Previous *@
                        @{
                            var prevDisabled = currentPage <= 1;
                            var prevPage = currentPage > 1 ? currentPage - 1 : 1;
                            var action = string.IsNullOrWhiteSpace(keyword) ? "Index" : "Search";
                            var prevUrl = prevDisabled
                            ? "#"
                            : string.IsNullOrWhiteSpace(keyword)
                                ? Url.Action(action, "Notification", new { page = prevPage, pageSize = pageSize })
                                : Url.Action(action, "Notification", new { Keyword = keyword, page = prevPage, pageSize = pageSize });
                        }
                        <li class="page-item @(prevDisabled ? "disabled" : "")">
                            <a class="page-link"
                               href="@prevUrl"
                               tabindex="-1"
                               aria-disabled="@(prevDisabled ? "true" : "false")">«</a>
                        </li>

                        @* Pages with window + ... *@
                        @{
                            // Ví dụ windowSize = 1 => currentPage-1, currentPage, currentPage+1
                            var windowSize = 1;
                            var startPage = currentPage - windowSize;
                            var endPage = currentPage + windowSize;

                            if (startPage < 1) startPage = 1;
                            if (endPage > totalPages) endPage = totalPages;

                            // luôn hiện trang 1
                            @renderPageItem(1)
                            ;

                            // nếu block giữa không dính sát trang 1 => in "..."
                            if (startPage > 2)
                            {
                                @renderDisabledItem("...")
                                ;
                            }

                            // render các trang giữa (trừ 1 và totalPages để không bị lặp)
                            for (int p = startPage; p <= endPage; p++)
                            {
                                if (p != 1 && p != totalPages)
                                {
                                    @renderPageItem(p)
                                    ;
                                }
                            }

                            // nếu block giữa không dính sát trang cuối => in "..."
                            if (endPage < totalPages - 1)
                            {
                                @renderDisabledItem("...")
                                ;
                            }

                            // luôn hiện trang cuối (nếu >1)
                            if (totalPages > 1)
                            {
                                @renderPageItem(totalPages)
                                ;
                            }
                        }

                        @* Next *@
                        @{
                            var nextDisabled = currentPage >= totalPages;
                            var nextPage = currentPage < totalPages ? currentPage + 1 : totalPages;
                            var nextAction = string.IsNullOrWhiteSpace(keyword) ? "Index" : "Search";
                            var nextUrl = nextDisabled
                            ? "#"
                            : string.IsNullOrWhiteSpace(keyword)
                                ? Url.Action(nextAction, "Notification", new { page = nextPage, pageSize = pageSize })
                                : Url.Action(nextAction, "Notification", new { Keyword = keyword, page = nextPage, pageSize = pageSize });
                        }
                        <li class="page-item @(nextDisabled ? "disabled" : "")">
                            <a class="page-link"
                               href="@nextUrl"
                               aria-disabled="@(nextDisabled ? "true" : "false")">»</a>
                        </li>

                    </ul>
                </nav>
            }
            @* ====== CUSTOM PAGINATION END ====== *@

        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade"
     id="notificationModal"
     tabindex="-1"
     aria-labelledby="notificationModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 id="notificationModalLabel" class="modal-title">
                    <i class="fa-solid fa-bell me-2"></i>
                    @(edit != null ? "Cập nhật thông báo" : "Thêm thông báo mới")
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"
                        onclick="closeModal()"></button>
            </div>

            <form method="post"
                  asp-action="@(edit != null ? "UpdateNotification" : "CreateNotification")"
                  asp-controller="Notification"
                  id="notificationForm">
                @Html.AntiForgeryToken()

                <div class="modal-body">
                    <input type="hidden" name="NotificationId" id="notificationId" value="@(edit?.NotificationId ?? 0)" />
                    <input type="hidden" name="CreatedBy" id="createdBy" value="0" />
                    <input type="hidden" name="ConditionJson" id="conditionJson" value="@(edit?.ConditionJson ?? "")" />

                    <div class="row g-3">

                        <!-- Tiêu đề -->
                        <div class="col-12">
                            <label class="form-label fw-bold">
                                <i class="fa-solid fa-heading me-1 text-primary"></i>
                                Tiêu đề thông báo <span class="text-danger">*</span>
                            </label>
                            <input type="text"
                                   class="form-control form-control-lg"
                                   name="Title"
                                   id="title"
                                   value="@(edit?.Title ?? "")"
                                   placeholder="VD: Chương trình khuyến mãi 11/11"
                                   required
                                   maxlength="200" />
                        </div>

                        <!-- Loại và Icon -->
                        <div class="col-lg-6">
                            <label class="form-label fw-bold">
                                <i class="fa-solid fa-tag me-1 text-primary"></i>
                                Loại thông báo <span class="text-danger">*</span>
                            </label>
                            <select class="form-select form-select-lg"
                                    name="Type"
                                    id="type"
                                    required>
                                <option value="info">ℹ️ Thông tin - Tin tức chung</option>
                                <option value="promo">🎉 Khuyến mãi - Ưu đãi đặc biệt</option>
                                <option value="warning">⚠️ Cảnh báo - Thông báo quan trọng</option>
                                <option value="system">⚙️ Hệ thống - Bảo trì, cập nhật</option>
                                <option value="error">❌ Lỗi - Sự cố cần xử lý</option>
                            </select>
                        </div>

                        <!-- Đối tượng -->
                        <div class="col-lg-6">
                            <label class="form-label fw-bold">
                                <i class="fa-solid fa-bullseye me-1 text-primary"></i>
                                Gửi đến <span class="text-danger">*</span>
                            </label>
                            <select class="form-select form-select-lg"
                                    name="TargetType"
                                    id="targetType"
                                    onchange="toggleTargetFields()"
                                    required>
                                <option value="All">👥 Tất cả người dùng</option>
                                <option value="Role">🎭 Nhóm người dùng (Vai trò)</option>
                                <option value="User">👤 Một người dùng cụ thể</option>
                            </select>
                        </div>

                        <!-- Target Role Field -->
                        <div class="col-12 field-animate"
                             id="targetRoleField"
                             style="display:none">
                            <label class="form-label">
                                <i class="fa-solid fa-user-tag me-1"></i>
                                Chọn nhóm người dùng
                            </label>
                            <select class="form-select"
                                    name="TargetRoleId"
                                    id="targetRoleId">
                                <option value="">-- Chọn vai trò --</option>
                                @if (roles != null)
                                {
                                    foreach (var r in roles)
                                    {
                                        var rid = r.RoleId;
                                        if (edit?.TargetRoleId == rid)
                                        {
                                            <option value="@rid" selected="selected">@r.RoleName</option>
                                        }
                                        else
                                        {
                                            <option value="@rid">@r.RoleName</option>
                                        }
                                    }
                                }
                            </select>
                        </div>

                        <!-- Target User Field -->
                        <div class="col-12 field-animate"
                             id="targetUserField"
                             style="display:none">
                            <label class="form-label">
                                <i class="fa-solid fa-user me-1"></i>
                                ID người dùng
                            </label>
                            <input type="number"
                                   class="form-control"
                                   name="TargetUserId"
                                   id="targetUserId"
                                   value="@(edit?.TargetUserId?.ToString() ?? "")"
                                   placeholder="Nhập ID người dùng (VD: 123)"
                                   min="1" />
                            <small class="text-muted">💡 Xem ID trong danh sách quản lý khách hàng</small>
                        </div>

                        <!-- Nội dung -->
                        <div class="col-12">
                            <label class="form-label fw-bold">
                                <i class="fa-solid fa-message me-1 text-primary"></i>
                                Nội dung chi tiết <span class="text-danger">*</span>
                            </label>
                            <textarea class="form-control"
                                      name="Message"
                                      id="message"
                                      rows="4"
                                      placeholder="VD: Giảm giá 50% toàn bộ sản phẩm đồ chơi trong dịp lễ. Áp dụng từ 11/11 đến 15/11. Không áp dụng cùng khuyến mãi khác."
                                      required
                                      maxlength="1000">@(edit?.Message ?? "")</textarea>
                            <div class="d-flex justify-content-between mt-1">
                                <small class="text-muted">📝 Tối đa 1000 ký tự</small>
                                <small class="text-muted" id="charCount">0/1000</small>
                            </div>
                        </div>

                        <!-- Divider -->
                        <div class="col-12">
                            <hr class="my-2">
                            <h6 class="text-primary mb-3">
                                <i class="fa-solid fa-clock me-2"></i>
                                Lên lịch hiển thị
                            </h6>
                        </div>

                        <!-- Quick Time Buttons -->
                        <div class="col-12">
                            <label class="form-label fw-bold">
                                ⚡ Chọn nhanh thời gian
                            </label>
                            <div class="btn-group w-100" role="group">
                                <button type="button" class="btn btn-outline-primary" onclick="setScheduleTime('now')">
                                    <i class="fa-solid fa-bolt me-1"></i>Ngay bây giờ
                                </button>
                                <button type="button" class="btn btn-outline-primary" onclick="setScheduleTime('1hour')">
                                    <i class="fa-solid fa-clock me-1"></i>Sau 1 giờ
                                </button>
                                <button type="button" class="btn btn-outline-primary" onclick="setScheduleTime('tomorrow')">
                                    <i class="fa-solid fa-calendar-day me-1"></i>Ngày mai 9h
                                </button>
                                <button type="button" class="btn btn-outline-primary" onclick="setScheduleTime('nextweek')">
                                    <i class="fa-solid fa-calendar-week me-1"></i>Tuần sau
                                </button>
                            </div>
                        </div>

                        <!-- Manual Time Input -->
                        <div class="col-lg-6">
                            <label class="form-label">
                                <i class="fa-solid fa-calendar-plus me-1"></i>
                                Hoặc chọn thời gian tùy chỉnh <span class="text-danger">*</span>
                            </label>
                            <input type="datetime-local"
                                   class="form-control"
                                   name="ScheduledAt"
                                   id="scheduledAt"
                                   value="@(edit != null ? edit.ScheduledAt.ToLocalTime().ToString("yyyy-MM-ddTHH:mm") : DateTime.Now.ToString("yyyy-MM-ddTHH:mm"))"
                                   required />
                            <small class="text-muted">📅 Thông báo sẽ hiển thị từ thời điểm này</small>
                        </div>

                        <!-- Expire Time -->
                        <div class="col-lg-6">
                            <label class="form-label">
                                <i class="fa-solid fa-calendar-xmark me-1"></i>
                                Hết hạn (Tùy chọn)
                            </label>
                            <input type="datetime-local"
                                   class="form-control"
                                   name="ExpireAt"
                                   id="expireAt"
                                   value="@(edit?.ExpireAt?.ToLocalTime().ToString("yyyy-MM-ddTHH:mm") ?? "")" />
                            <small class="text-muted">⏰ Để trống = không giới hạn</small>
                        </div>

                        <!-- Help Text -->
                        <div class="col-12">
                            <div class="alert alert-info mb-0">
                                <i class="fa-solid fa-lightbulb me-2"></i>
                                <strong>Mẹo:</strong> Nếu chọn "Ngay bây giờ" và muốn gửi ngay, nhấn nút "Gửi ngay" ở danh sách sau khi lưu.
                            </div>
                        </div>

                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal"
                            onclick="closeModal()">
                        <i class="fa-solid fa-xmark me-1"></i>Hủy
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-floppy-disk me-1"></i>
                        @(edit != null ? "Lưu thay đổi" : "Thêm mới")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Toast lỗi -->
<div class="toast-container position-fixed p-3 toast-top-right">
    <div id="liveToast"
         class="toast align-items-center text-bg-danger border-0"
         role="alert">
        <div class="d-flex">
            <div class="toast-body fs-5 fw-semibold">
                <i class="fa-solid fa-circle-exclamation me-2"></i>
                @ViewBag.ErrorMessage
            </div>
            <button type="button"
                    class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer" />

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const hasError = '@(ViewBag.ShowErrorModal == true ? "true" : "false")';
            if (hasError === "true") {
                const toastEl = document.getElementById('liveToast');
                if (toastEl) new bootstrap.Toast(toastEl, { delay: 5000 }).show();
            }

            const isEdit = '@(edit != null ? "true" : "false")';
            const needShow = '@((edit != null || (ViewBag.ShowErrorModal == true)) ? "true" : "false")';
            
            // Nếu đang edit, cập nhật form action
            if (isEdit === "true") {
                const form = document.getElementById('notificationForm');
                if (form) {
                    form.action = '@Url.Action("UpdateNotification", "Notification")';
                }
                
                document.getElementById('notificationModalLabel').innerHTML =
                    '<i class="fa-solid fa-bell me-2"></i>Cập nhật thông báo';
            }
            
            if (needShow === "true") {
                const modalEl = document.getElementById('notificationModal');
                if (modalEl) new bootstrap.Modal(modalEl).show();
            }

            // map type server -> UI
            const typeSel = document.getElementById('type');
            if (typeSel) {
                const serverType = '@(edit?.Type?.ToLowerInvariant() ?? "info")';
                const typeMapping = {
                    'general': 'info',
                    'promotion': 'promo',
                    'system': 'system',
                    'order': 'info',
                    'info': 'info',
                    'warning': 'warning',
                    'error': 'error',
                    'promo': 'promo'
                };
                typeSel.value = typeMapping[serverType] || 'info';
            }

            // map TargetType server -> UI
            const targetSel = document.getElementById('targetType');
            if (targetSel) {
                const serverTarget = '@(edit?.TargetType ?? "All")';
                const targetMapping = {
                    'ByRole': 'Role',
                    'SingleUser': 'User',
                    'ByCondition': 'Condition',
                    'All': 'All'
                };
                targetSel.value = targetMapping[serverTarget] || 'All';
            }

            toggleTargetFields();
        });

        function openAddModal() {
            const form = document.getElementById('notificationForm');
            if (form) {
                form.reset();
                // Đổi action về CreateNotification
                form.action = '@Url.Action("CreateNotification", "Notification")';
            }

            document.getElementById('notificationId').value = '0';
            document.getElementById('createdBy').value = '0';
            document.getElementById('conditionJson').value = '';
            
            // Set default time to now
            const now = new Date();
            const formatDateTime = (date) => {
                const year = date.getFullYear();
                const month = String(date.getMonth() + 1).padStart(2, '0');
                const day = String(date.getDate()).padStart(2, '0');
                const hours = String(date.getHours()).padStart(2, '0');
                const minutes = String(date.getMinutes()).padStart(2, '0');
                return `${year}-${month}-${day}T${hours}:${minutes}`;
            };
            
            document.getElementById('scheduledAt').value = formatDateTime(now);
            document.getElementById('notificationModalLabel').innerHTML =
                '<i class="fa-solid fa-bell me-2"></i>Thêm thông báo mới';

            const typeSel = document.getElementById('type');
            if (typeSel) typeSel.value = 'info';

            const targetSel = document.getElementById('targetType');
            if (targetSel) targetSel.value = 'All';

            const roleSel = document.getElementById('targetRoleId');
            if (roleSel) roleSel.value = '';

            const userInput = document.getElementById('targetUserId');
            if (userInput) userInput.value = '';

            const expireInput = document.getElementById('expireAt');
            if (expireInput) expireInput.value = '';

            // Update character count
            const charCount = document.getElementById('charCount');
            if (charCount) charCount.textContent = '0/1000';

            toggleTargetFields();
        }

        function closeModal() {
            const keyword = '@Html.Raw(f?.Keyword ?? "")';
            const pageSize = @(f?.PageSize ?? 10);
            
            if (keyword) {
                window.location.href = '@Url.Action("Search", "Notification")' + '?Keyword=' + encodeURIComponent(keyword) + '&PageSize=' + pageSize;
            } else {
                window.location.href = '@Url.Action("Index", "Notification")' + '?PageSize=' + pageSize;
            }
        }

        function changePageSize(newPageSize) {
            const keyword = '@Html.Raw(f?.Keyword ?? "")';
            
            if (keyword) {
                window.location.href = '@Url.Action("Search", "Notification")' + '?Keyword=' + encodeURIComponent(keyword) + '&page=1&PageSize=' + newPageSize;
            } else {
                window.location.href = '@Url.Action("Index", "Notification")' + '?page=1&PageSize=' + newPageSize;
            }
        }

        function toggleTargetFields() {
            const type = document.getElementById('targetType').value;
            const roleField = document.getElementById('targetRoleField');
            const userField = document.getElementById('targetUserField');

            const roleSelect = document.getElementById('targetRoleId');
            const userInput = document.getElementById('targetUserId');

            // hide all first
            if (roleField) roleField.style.display = 'none';
            if (userField) userField.style.display = 'none';

            if (roleSelect) roleSelect.required = false;
            if (userInput) userInput.required = false;

            // show per mode
            if (type === 'Role') {
                if (roleField) roleField.style.display = 'block';
                if (roleSelect) roleSelect.required = true;
            } else if (type === 'User') {
                if (userField) userField.style.display = 'block';
                if (userInput) userInput.required = true;
            }
        }

        // Character counter for message
        document.addEventListener('DOMContentLoaded', function() {
            const messageField = document.getElementById('message');
            const charCount = document.getElementById('charCount');
            
            if (messageField && charCount) {
                function updateCharCount() {
                    const length = messageField.value.length;
                    charCount.textContent = `${length}/1000`;
                    if (length > 900) {
                        charCount.classList.add('text-danger');
                        charCount.classList.remove('text-muted');
                    } else {
                        charCount.classList.add('text-muted');
                        charCount.classList.remove('text-danger');
                    }
                }
                
                messageField.addEventListener('input', updateCharCount);
                updateCharCount(); // Initial count
            }
        });

        // Quick schedule time buttons
        function setScheduleTime(preset) {
            const scheduledInput = document.getElementById('scheduledAt');
            const expireInput = document.getElementById('expireAt');
            let scheduleDate = new Date();
            let expireDate = null;

            switch(preset) {
                case 'now':
                    // Ngay bây giờ
                    break;
                
                case '1hour':
                    // Sau 1 giờ
                    scheduleDate.setHours(scheduleDate.getHours() + 1);
                    expireDate = new Date(scheduleDate);
                    expireDate.setDate(expireDate.getDate() + 7); // Hết hạn sau 7 ngày
                    break;
                
                case 'tomorrow':
                    // Ngày mai 9h sáng
                    scheduleDate.setDate(scheduleDate.getDate() + 1);
                    scheduleDate.setHours(9, 0, 0, 0);
                    expireDate = new Date(scheduleDate);
                    expireDate.setDate(expireDate.getDate() + 7);
                    break;
                
                case 'nextweek':
                    // Tuần sau cùng giờ
                    scheduleDate.setDate(scheduleDate.getDate() + 7);
                    expireDate = new Date(scheduleDate);
                    expireDate.setDate(expireDate.getDate() + 30); // Hết hạn sau 30 ngày
                    break;
            }

            // Format to datetime-local format (YYYY-MM-DDTHH:mm)
            const formatDateTime = (date) => {
                const year = date.getFullYear();
                const month = String(date.getMonth() + 1).padStart(2, '0');
                const day = String(date.getDate()).padStart(2, '0');
                const hours = String(date.getHours()).padStart(2, '0');
                const minutes = String(date.getMinutes()).padStart(2, '0');
                return `${year}-${month}-${day}T${hours}:${minutes}`;
            };

            scheduledInput.value = formatDateTime(scheduleDate);
            if (expireDate) {
                expireInput.value = formatDateTime(expireDate);
            }

            // Highlight the input briefly to show it changed
            scheduledInput.classList.add('border-success', 'border-2');
            setTimeout(() => {
                scheduledInput.classList.remove('border-success', 'border-2');
            }, 1000);
        }

        // SweetAlert2 confirmation functions
        async function confirmSendNow(event) {
            event.preventDefault();
            const result = await Swal.fire({
                icon: 'question',
                title: 'Gửi thông báo?',
                text: 'Bạn có chắc muốn gửi ngay thông báo này?',
                showCancelButton: true,
                confirmButtonColor: '#667eea',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Gửi ngay',
                cancelButtonText: 'Hủy',
                reverseButtons: true
            });
            if (result.isConfirmed) {
                event.target.submit();
            }
            return false;
        }

        async function confirmCancel(event) {
            event.preventDefault();
            const result = await Swal.fire({
                icon: 'warning',
                title: 'Hủy thông báo?',
                text: 'Bạn có chắc muốn hủy thông báo này?',
                showCancelButton: true,
                confirmButtonColor: '#667eea',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Hủy thông báo',
                cancelButtonText: 'Quay lại',
                reverseButtons: true
            });
            if (result.isConfirmed) {
                event.target.submit();
            }
            return false;
        }

        async function confirmDelete(event) {
            event.preventDefault();
            const result = await Swal.fire({
                icon: 'warning',
                title: 'Xóa thông báo?',
                text: 'Bạn có chắc muốn xóa thông báo này?',
                showCancelButton: true,
                confirmButtonColor: '#667eea',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Xóa',
                cancelButtonText: 'Hủy',
                reverseButtons: true
            });
            if (result.isConfirmed) {
                event.target.submit();
            }
            return false;
        }
    </script>
}
