@using Microsoft.AspNetCore.Html
@model BLL.DTOs.PagedResult<BLL.DTOs.PromotionDto>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản Lý Khuyến Mãi";

    var keyword = (string?)ViewBag.Keyword ?? "";
    var edit = ViewBag.EditPromotion as BLL.DTOs.PromotionDto;

    var currentPage = Model?.Page ?? 1;
    var pageSize = Model?.PageSize ?? 10;
    var totalRows = Model?.Total ?? 0;
    var totalPages = (int)Math.Ceiling(
        totalRows == 0 ? 1.0 :
        (double)totalRows / (pageSize == 0 ? 1 : pageSize)
    );
    if (totalPages < 1) totalPages = 1;
}

<link rel="stylesheet" href="~/css/admin-promotion-manage.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container-fluid px-5">
    <h1 class="mt-4">Quản Lý Khuyến Mãi</h1>

    <div class="card mb-4 mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div><i class="fa-solid fa-tags me-1"></i> Danh Sách Khuyến Mãi</div>
            <button class="btn btn-primary"
                    type="button"
                    data-bs-toggle="modal"
                    data-bs-target="#addPromotionModal">
                <i class="fa-solid fa-plus me-1"></i> Thêm Khuyến Mãi
            </button>
        </div>

        <div class="card-body">
            <div class="row mb-4">
                <div class="col-md-8">
                    <form method="get" asp-action="Search" asp-controller="Promotion" id="searchForm">
                        <div class="input-group search-box">
                            <input type="text" name="keyword" value="@keyword" class="form-control" placeholder="Tìm theo mã/mô tả...">
                            <input type="hidden" name="pageSize" value="@(Model?.PageSize ?? 10)" />
                            <button class="btn btn-outline-secondary" type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
                            @if (!string.IsNullOrWhiteSpace(keyword))
                            {
                                <a href="@Url.Action("Index", "Promotion", new { pageSize = Model?.PageSize ?? 10 })" class="btn btn-outline-danger" title="Xóa tìm kiếm">
                                    <i class="fa-solid fa-times"></i>
                                </a>
                            }
                        </div>
                    </form>
                </div>
                <div class="col-md-4">
                    <div class="d-flex align-items-center justify-content-end">
                        <label class="me-2 mb-0">Hiển thị:</label>
                        <select class="form-select form-select-sm" style="width: auto;" id="pageSizeSelector" onchange="changePageSize(this.value)">
                            @{
                                var currentPageSize = Model?.PageSize ?? 10;
                            }
                            <option value="5" selected="@(currentPageSize == 5)">5</option>
                            <option value="10" selected="@(currentPageSize == 10)">10</option>
                            <option value="20" selected="@(currentPageSize == 20)">20</option>
                            <option value="50" selected="@(currentPageSize == 50)">50</option>
                            <option value="100" selected="@(currentPageSize == 100)">100</option>
                        </select>
                        <span class="ms-2 text-muted">mục/trang</span>
                    </div>
                </div>
            </div>

            <!-- Success Toast -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="toast-container position-fixed p-3" style="top: 20px; right: 20px; z-index: 2080;">
                    <div class="toast align-items-center text-bg-success border-0 show" role="alert">
                        <div class="d-flex">
                            <div class="toast-body fs-5 fw-semibold">
                                <i class="fa-solid fa-circle-check me-2"></i>
                                @TempData["SuccessMessage"]
                            </div>
                            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                        </div>
                    </div>
                </div>
            }

            <!-- Error Toast -->
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="toast-container position-fixed p-3" style="top: 20px; right: 20px; z-index: 2080;">
                    <div class="toast align-items-center text-bg-danger border-0 show" role="alert">
                        <div class="d-flex">
                            <div class="toast-body fs-5 fw-semibold">
                                <i class="fa-solid fa-circle-exclamation me-2"></i>
                                @TempData["ErrorMessage"]
                            </div>
                            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                        </div>
                    </div>
                </div>
            }

            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th style="white-space:nowrap">ID</th>
                            <th style="white-space:nowrap">Hành Động</th>
                            <th>Mã KM</th>
                            <th>Giảm (%)</th>
                            <th>Thời gian</th>
                            <th style="white-space:nowrap">Trạng Thái</th>
                            <th style="white-space:nowrap">Ngày Tạo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.Items != null && Model.Items.Any())
                        {
                            foreach (var x in Model.Items)
                            {
                                <tr class="@(x.IsDeleted ? "deleted-row" : "")">
                                    <td>@x.PromotionId</td>
                                    <td style="white-space:nowrap">

                                        <a class="btn btn-sm btn-warning"
                                           title="Cập nhật"
                                           asp-action="Edit"
                                           asp-controller="Promotion"
                                           asp-route-id="@x.PromotionId"
                                           asp-route-keyword="@keyword"
                                           asp-route-page="@currentPage"
                                           asp-route-pageSize="@pageSize">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>

                                        <a class="btn btn-sm btn-info ms-1"
                                           title="Quản lý sản phẩm"
                                           asp-action="ManageProducts"
                                           asp-controller="Promotion"
                                           asp-route-promotionId="@x.PromotionId">
                                            <i class="fa-solid fa-boxes-stacked"></i>
                                        </a>

                                        <form method="post"
                                              asp-action="Delete"
                                              asp-controller="Promotion"
                                              style="display:inline"
                                              onsubmit="return confirmDeletePromotion(event)">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@x.PromotionId" />
                                            <input type="hidden" name="keyword" value="@keyword" />
                                            <input type="hidden" name="page" value="@currentPage" />
                                            <input type="hidden" name="pageSize" value="@pageSize" />
                                            <button type="submit"
                                                    class="btn btn-sm btn-danger">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>

                                    </td>
                                    <td>@x.PromotionCode</td>
                                    <td>@(x.DiscountPercent?.ToString("0.##") ?? "—")</td>
                                    <td>
                                        @x.StartDate.ToString("dd/MM/yyyy HH:mm")
                                        —
                                        @x.EndDate.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>
                                            <span class="badge bg-@(x.Status == "Active" ? "success" : "warning")">
                                                @(x.Status == "Active" ? "Đang hoạt động" : "Ngừng hoạt động")
                                            </span>
                                    </td>

                                    <td>@x.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted">Không có dữ liệu.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* PAGINATION: « 1 … 5 6 7 … 20 » *@
            @if (totalPages > 1)
            {
                Func<int, IHtmlContent> PageItem = (int p) =>
                {
                    var active = p == currentPage ? "active" : "";
                    var url = Url.Action("Manage", "Promotion",
                            new { keyword = keyword, page = p, pageSize = pageSize });
                    return new HtmlString($@"
                        <li class=""page-item {active}"">
                        <a class=""page-link"" href=""{url}"">{p}</a>
                        </li>
                        ");
                };

                Func<string, IHtmlContent> DisabledDots = (string text) =>
                {
                    return new HtmlString($@"
                        <li class=""page-item disabled"">
                        <span class=""page-link"">{text}</span>
                        </li>
                        ");
                };

                var prevDisabled = currentPage <= 1;
                var nextDisabled = currentPage >= totalPages;
                var prevPage = prevDisabled ? 1 : currentPage - 1;
                var nextPage = nextDisabled ? totalPages : currentPage + 1;

                var prevUrl = prevDisabled
                ? "#"
                : Url.Action("Manage", "Promotion",
                new { keyword = keyword, page = prevPage, pageSize = pageSize });

                var nextUrl = nextDisabled
                ? "#"
                : Url.Action("Manage", "Promotion",
                new { keyword = keyword, page = nextPage, pageSize = pageSize });

                <nav>
                    <ul class="pagination justify-content-center">

                        <li class="page-item @(prevDisabled ? "disabled" : "")">
                            <a class="page-link" href="@prevUrl" aria-disabled="@(prevDisabled ? "true" : "false")">«</a>
                        </li>

                        @{
                            // windowSize = số trang hai bên currentPage
                            var windowSize = 1;
                            var startPage = currentPage - windowSize;
                            var endPage = currentPage + windowSize;
                            if (startPage < 1) startPage = 1;
                            if (endPage > totalPages) endPage = totalPages;

                            // Trang đầu
                            @PageItem(1)
                            ;

                            // "..." nếu block đầu bị gap
                            if (startPage > 2)
                            {
                                @DisabledDots("...")
                                ;
                            }

                            // các trang giữa
                            for (int p = startPage; p <= endPage; p++)
                            {
                                if (p != 1 && p != totalPages)
                                {
                                    @PageItem(p)
                                    ;
                                }
                            }

                            // "..." nếu block cuối bị gap
                            if (endPage < totalPages - 1)
                            {
                                @DisabledDots("...")
                                ;
                            }

                            // Trang cuối
                            if (totalPages > 1)
                            {
                                @PageItem(totalPages)
                                ;
                            }
                        }

                        <li class="page-item @(nextDisabled ? "disabled" : "")">
                            <a class="page-link" href="@nextUrl" aria-disabled="@(nextDisabled ? "true" : "false")">»</a>
                        </li>

                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

<!-- Modal Add -->
<div class="modal fade"
     id="addPromotionModal"
     tabindex="-1"
     aria-labelledby="addPromotionModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="addPromotionModalLabel" class="modal-title">
                    <i class="fa-solid fa-plus-circle me-2"></i>
                    Thêm khuyến mãi mới
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <form method="post"
                  asp-action="CreatePromotion"
                  asp-controller="Promotion"
                  id="addPromotionForm">
                @Html.AntiForgeryToken()

                <div class="modal-body">
                    <input type="hidden" name="PromotionId" value="0" />
                    <input type="hidden" name="keyword" value="@keyword" />
                    <input type="hidden" name="page" value="@currentPage" />
                    <input type="hidden" name="pageSize" value="@pageSize" />

                    <div class="row g-3">
                        <!-- Mã khuyến mãi -->
                        <div class="col-12">
                            <label class="form-label fw-bold">
                                <i class="fa-solid fa-barcode me-1 text-primary"></i>
                                Mã khuyến mãi <span class="text-danger">*</span>
                            </label>
                            <input type="text"
                                   class="form-control form-control-lg"
                                   name="PromotionCode"
                                   id="addPromotionCode"
                                   placeholder="VD: SUMMER2024, SALE50, NEWYEAR2025..."
                                   required
                                   maxlength="50" />
                            <small class="text-muted">💡 Mã phải duy nhất và dễ nhớ cho khách hàng</small>
                        </div>

                        <!-- Discount và Status -->
                        <div class="col-lg-6">
                            <label class="form-label fw-bold">
                                <i class="fa-solid fa-percent me-1 text-primary"></i>
                                Phần trăm giảm giá <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <input type="number"
                                       step="0.01"
                                       min="0"
                                       max="100"
                                       class="form-control form-control-lg"
                                       name="DiscountPercent"
                                       id="addDiscountPercent"
                                       placeholder="0"
                                       required />
                                <span class="input-group-text bg-primary text-white fw-bold">%</span>
                            </div>
                            <div class="mt-2">
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="button" class="btn btn-outline-secondary" onclick="setDiscount(10, 'add')">10%</button>
                                    <button type="button" class="btn btn-outline-secondary" onclick="setDiscount(20, 'add')">20%</button>
                                    <button type="button" class="btn btn-outline-secondary" onclick="setDiscount(30, 'add')">30%</button>
                                    <button type="button" class="btn btn-outline-secondary" onclick="setDiscount(50, 'add')">50%</button>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <label class="form-label fw-bold">
                                <i class="fa-solid fa-toggle-on me-1 text-primary"></i>
                                Trạng thái <span class="text-danger">*</span>
                            </label>

                            <input type="hidden"
                                   name="Status"
                                   id="addStatus"
                                   value="Active" />

                            <div class="btn-group d-flex" role="group">
                                <input type="radio"
                                       class="btn-check"
                                       name="addStatusRadio"
                                       id="addStatusActive"
                                       value="Active"
                                       checked
                                       onchange="updateStatus(this.value, 'add')"
                                       autocomplete="off">
                                <label class="btn btn-outline-success" for="addStatusActive">
                                    <i class="fa-solid fa-circle-check me-1"></i>Đang hoạt động
                                </label>

                                <input type="radio"
                                       class="btn-check"
                                       name="addStatusRadio"
                                       id="addStatusInactive"
                                       value="Inactive"
                                       onchange="updateStatus(this.value, 'add')"
                                       autocomplete="off">
                                <label class="btn btn-outline-danger" for="addStatusInactive">
                                    <i class="fa-solid fa-circle-xmark me-1"></i>Ngừng hoạt động
                                </label>
                            </div>
                            <small class="text-muted d-block mt-2">📍 Khuyến mãi chỉ áp dụng khi đang hoạt động</small>
                        </div>

                        <!-- Divider -->
                        <div class="col-12">
                            <hr class="my-2">
                            <h6 class="text-primary mb-3">
                                <i class="fa-solid fa-calendar-days me-2"></i>
                                Thời gian áp dụng
                            </h6>
                        </div>

                        <!-- Quick Duration Buttons -->
                        <div class="col-12">
                            <label class="form-label fw-bold">
                                ⚡ Chọn nhanh thời gian khuyến mãi
                            </label>
                            <div class="btn-group w-100" role="group">
                                <button type="button" class="btn btn-outline-primary" onclick="setPromotionDuration('today', 'add')">
                                    <i class="fa-solid fa-bolt me-1"></i>Hôm nay
                                </button>
                                <button type="button" class="btn btn-outline-primary" onclick="setPromotionDuration('weekend', 'add')">
                                    <i class="fa-solid fa-calendar-week me-1"></i>Cuối tuần
                                </button>
                                <button type="button" class="btn btn-outline-primary" onclick="setPromotionDuration('week', 'add')">
                                    <i class="fa-solid fa-calendar me-1"></i>1 tuần
                                </button>
                                <button type="button" class="btn btn-outline-primary" onclick="setPromotionDuration('month', 'add')">
                                    <i class="fa-solid fa-calendar-plus me-1"></i>1 tháng
                                </button>
                            </div>
                        </div>

                        <!-- Start Date -->
                        <div class="col-lg-6">
                            <label class="form-label">
                                <i class="fa-solid fa-calendar-check me-1"></i>
                                Hoặc chọn ngày bắt đầu <span class="text-danger">*</span>
                            </label>
                            <input type="datetime-local"
                                   class="form-control"
                                   name="StartDate"
                                   id="addStartDate"
                                   required />
                            <small class="text-muted">📅 Khuyến mãi có hiệu lực từ thời điểm này</small>
                        </div>

                        <!-- End Date -->
                        <div class="col-lg-6">
                            <label class="form-label">
                                <i class="fa-solid fa-calendar-xmark me-1"></i>
                                Ngày kết thúc <span class="text-danger">*</span>
                            </label>
                            <input type="datetime-local"
                                   class="form-control"
                                   name="EndDate"
                                   id="addEndDate"
                                   required />
                            <small class="text-muted">⏰ Khuyến mãi hết hạn sau thời điểm này</small>
                        </div>

                        <!-- Mô tả -->
                        <div class="col-12">
                            <label class="form-label fw-bold">
                                <i class="fa-solid fa-align-left me-1 text-primary"></i>
                                Mô tả chi tiết
                            </label>
                            <textarea class="form-control"
                                      name="Description"
                                      id="addDescription"
                                      rows="3"
                                      placeholder="VD: Giảm giá đặc biệt nhân dịp khai trương. Áp dụng cho tất cả sản phẩm đồ chơi trẻ em. Không áp dụng đồng thời với khuyến mãi khác."
                                      maxlength="500"></textarea>
                            <div class="d-flex justify-content-between mt-1">
                                <small class="text-muted">📝 Tối đa 500 ký tự</small>
                                <small class="text-muted" id="addDescCharCount">0/500</small>
                            </div>
                        </div>

                        <!-- Help Box -->
                        <div class="col-12">
                            <div class="alert alert-info mb-0">
                                <i class="fa-solid fa-lightbulb me-2"></i>
                                <strong>Mẹo:</strong> Sau khi tạo khuyến mãi, nhấn nút <i class="fa-solid fa-boxes-stacked"></i> để gán sản phẩm áp dụng.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">
                        <i class="fa-solid fa-xmark me-1"></i>
                        Hủy
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-plus me-1"></i>
                        Thêm mới
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Edit -->
<div class="modal fade"
     id="editPromotionModal"
     tabindex="-1"
     aria-labelledby="editPromotionModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="editPromotionModalLabel" class="modal-title">
                    <i class="fa-solid fa-edit me-2"></i>
                    Cập nhật khuyến mãi
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <form method="post"
                  asp-action="UpdatePromotion"
                  asp-controller="Promotion"
                  id="editPromotionForm">
                @Html.AntiForgeryToken()

                <div class="modal-body">
                    <input type="hidden" name="PromotionId" id="editPromotionId" value="@(edit?.PromotionId ?? 0)" />
                    <input type="hidden" name="keyword" value="@keyword" />
                    <input type="hidden" name="page" value="@currentPage" />
                    <input type="hidden" name="pageSize" value="@pageSize" />

                    <div class="row g-3">
                        <!-- Mã khuyến mãi -->
                        <div class="col-12">
                            <label class="form-label fw-bold">
                                <i class="fa-solid fa-barcode me-1 text-primary"></i>
                                Mã khuyến mãi <span class="text-danger">*</span>
                            </label>
                            <input type="text"
                                   class="form-control form-control-lg"
                                   name="PromotionCode"
                                   id="editPromotionCode"
                                   value="@(edit?.PromotionCode ?? "")"
                                   placeholder="VD: SUMMER2024, SALE50, NEWYEAR2025..."
                                   required
                                   maxlength="50" />
                            <small class="text-muted">💡 Mã phải duy nhất và dễ nhớ cho khách hàng</small>
                        </div>

                        <!-- Discount và Status -->
                        <div class="col-lg-6">
                            <label class="form-label fw-bold">
                                <i class="fa-solid fa-percent me-1 text-primary"></i>
                                Phần trăm giảm giá <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <input type="number"
                                       step="0.01"
                                       min="0"
                                       max="100"
                                       class="form-control form-control-lg"
                                       name="DiscountPercent"
                                       id="editDiscountPercent"
                                       value="@(edit?.DiscountPercent?.ToString("0.##") ?? "")"
                                       placeholder="0"
                                       required />
                                <span class="input-group-text bg-primary text-white fw-bold">%</span>
                            </div>
                            <div class="mt-2">
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="button" class="btn btn-outline-secondary" onclick="setDiscount(10, 'edit')">10%</button>
                                    <button type="button" class="btn btn-outline-secondary" onclick="setDiscount(20, 'edit')">20%</button>
                                    <button type="button" class="btn btn-outline-secondary" onclick="setDiscount(30, 'edit')">30%</button>
                                    <button type="button" class="btn btn-outline-secondary" onclick="setDiscount(50, 'edit')">50%</button>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <label class="form-label fw-bold">
                                <i class="fa-solid fa-toggle-on me-1 text-primary"></i>
                                Trạng thái <span class="text-danger">*</span>
                            </label>

                            <input type="hidden"
                                   name="Status"
                                   id="editStatus"
                                   value="@(edit?.Status ?? "Active")" />

                            <div class="btn-group d-flex" role="group">
                                <input type="radio"
                                       class="btn-check"
                                       name="editStatusRadio"
                                       id="editStatusActive"
                                       value="Active"
                                       @(((edit?.Status ?? "Active") == "Active") ? "checked" : "")
                                       onchange="updateStatus(this.value, 'edit')"
                                       autocomplete="off">
                                <label class="btn btn-outline-success" for="editStatusActive">
                                    <i class="fa-solid fa-circle-check me-1"></i>Đang hoạt động
                                </label>

                                <input type="radio"
                                       class="btn-check"
                                       name="editStatusRadio"
                                       id="editStatusInactive"
                                       value="Inactive"
                                       @((edit?.Status == "Inactive") ? "checked" : "")
                                       onchange="updateStatus(this.value, 'edit')"
                                       autocomplete="off">
                                <label class="btn btn-outline-danger" for="editStatusInactive">
                                    <i class="fa-solid fa-circle-xmark me-1"></i>Ngừng hoạt động
                                </label>
                            </div>
                            <small class="text-muted d-block mt-2">📍 Khuyến mãi chỉ áp dụng khi đang hoạt động</small>
                        </div>

                        <!-- Divider -->
                        <div class="col-12">
                            <hr class="my-2">
                            <h6 class="text-primary mb-3">
                                <i class="fa-solid fa-calendar-days me-2"></i>
                                Thời gian áp dụng
                            </h6>
                        </div>

                        <!-- Quick Duration Buttons -->
                        <div class="col-12">
                            <label class="form-label fw-bold">
                                ⚡ Chọn nhanh thời gian khuyến mãi
                            </label>
                            <div class="btn-group w-100" role="group">
                                <button type="button" class="btn btn-outline-primary" onclick="setPromotionDuration('today', 'edit')">
                                    <i class="fa-solid fa-bolt me-1"></i>Hôm nay
                                </button>
                                <button type="button" class="btn btn-outline-primary" onclick="setPromotionDuration('weekend', 'edit')">
                                    <i class="fa-solid fa-calendar-week me-1"></i>Cuối tuần
                                </button>
                                <button type="button" class="btn btn-outline-primary" onclick="setPromotionDuration('week', 'edit')">
                                    <i class="fa-solid fa-calendar me-1"></i>1 tuần
                                </button>
                                <button type="button" class="btn btn-outline-primary" onclick="setPromotionDuration('month', 'edit')">
                                    <i class="fa-solid fa-calendar-plus me-1"></i>1 tháng
                                </button>
                            </div>
                        </div>

                        <!-- Start Date -->
                        <div class="col-lg-6">
                            <label class="form-label">
                                <i class="fa-solid fa-calendar-check me-1"></i>
                                Hoặc chọn ngày bắt đầu <span class="text-danger">*</span>
                            </label>
                            <input type="datetime-local"
                                   class="form-control"
                                   name="StartDate"
                                   id="editStartDate"
                                   value="@(edit != null ? edit.StartDate.ToString("yyyy-MM-ddTHH:mm") : "")"
                                   required />
                            <small class="text-muted">📅 Khuyến mãi có hiệu lực từ thời điểm này</small>
                        </div>

                        <!-- End Date -->
                        <div class="col-lg-6">
                            <label class="form-label">
                                <i class="fa-solid fa-calendar-xmark me-1"></i>
                                Ngày kết thúc <span class="text-danger">*</span>
                            </label>
                            <input type="datetime-local"
                                   class="form-control"
                                   name="EndDate"
                                   id="editEndDate"
                                   value="@(edit != null ? edit.EndDate.ToString("yyyy-MM-ddTHH:mm") : "")"
                                   required />
                            <small class="text-muted">⏰ Khuyến mãi hết hạn sau thời điểm này</small>
                        </div>

                        <!-- Mô tả -->
                        <div class="col-12">
                            <label class="form-label fw-bold">
                                <i class="fa-solid fa-align-left me-1 text-primary"></i>
                                Mô tả chi tiết
                            </label>
                            <textarea class="form-control"
                                      name="Description"
                                      id="editDescription"
                                      rows="3"
                                      placeholder="VD: Giảm giá đặc biệt nhân dịp khai trương. Áp dụng cho tất cả sản phẩm đồ chơi trẻ em. Không áp dụng đồng thời với khuyến mãi khác."
                                      maxlength="500">@(edit?.Description ?? "")</textarea>
                            <div class="d-flex justify-content-between mt-1">
                                <small class="text-muted">📝 Tối đa 500 ký tự</small>
                                <small class="text-muted" id="editDescCharCount">0/500</small>
                            </div>
                        </div>

                        @if (edit != null)
                        {
                            <div class="col-12">
                                <hr class="my-2">
                                <div class="info-box">
                                    <div class="text-muted small">
                                        <i class="fa-regular fa-clock me-1"></i>
                                        <strong>Ngày tạo:</strong> @edit.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                        @if (edit.UpdatedAt != null)
                                        {
                                            <span class="ms-3">
                                                <i class="fa-solid fa-rotate me-1"></i>
                                                <strong>Cập nhật:</strong> @edit.UpdatedAt?.ToString("dd/MM/yyyy HH:mm")
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Help Box -->
                        <div class="col-12">
                            <div class="alert alert-info mb-0">
                                <i class="fa-solid fa-lightbulb me-2"></i>
                                <strong>Mẹo:</strong> Sau khi cập nhật, nhấn nút <i class="fa-solid fa-boxes-stacked"></i> để quản lý sản phẩm áp dụng.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">
                        <i class="fa-solid fa-xmark me-1"></i>
                        Hủy
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-save me-1"></i>
                        Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Toast lỗi -->
<div class="toast-container position-fixed p-3 toast-top-right" style="z-index:2080;">
    <div id="liveToast"
         class="toast align-items-center text-bg-danger border-0"
         role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body fs-5 fw-semibold">
                <i class="fa-solid fa-circle-exclamation me-2"></i>
                @ViewBag.ErrorMessage
            </div>
            <button type="button"
                    class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast"
                    aria-label="Đóng"></button>
        </div>
    </div>
</div>

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer" />

@section Scripts {
    <script>
        // Auto-hide toasts after 5 seconds
        document.addEventListener('DOMContentLoaded', function() {
            const toasts = document.querySelectorAll('.toast');
            toasts.forEach(toast => {
                setTimeout(() => {
                    toast.classList.remove('show');
                }, 5000);
            });

            // Chỉ mở modal EDIT khi có data edit
            const needShowEdit = '@(edit != null ? "true" : "false")';
            if (needShowEdit === "true") {
                const modalEl = document.getElementById('editPromotionModal');
                if (modalEl) new bootstrap.Modal(modalEl).show();
            }
            
            // Initialize character counters
            initCharCounter('addDescription', 'addDescCharCount');
            initCharCounter('editDescription', 'editDescCharCount');
        });

        function updateStatus(value, formType) {
            const statusField = formType === 'add' ? 'addStatus' : 'editStatus';
            document.getElementById(statusField).value = value;
        }
        
        function initCharCounter(textareaId, counterId) {
            const descField = document.getElementById(textareaId);
            const charCount = document.getElementById(counterId);
            
            if (descField && charCount) {
                function updateCharCount() {
                    const length = descField.value.length;
                    charCount.textContent = `${length}/500`;
                    if (length > 450) {
                        charCount.classList.add('text-danger');
                        charCount.classList.remove('text-muted');
                    } else {
                        charCount.classList.add('text-muted');
                        charCount.classList.remove('text-danger');
                    }
                }
                
                descField.addEventListener('input', updateCharCount);
                updateCharCount(); // Initial count
            }
        }



        function changePageSize(newPageSize) {
          const keyword = '@Html.Raw(keyword ?? "")';
          
          if (keyword) {
            window.location.href = '@Url.Action("Search", "Promotion")' + '?keyword=' + encodeURIComponent(keyword) + '&page=1&pageSize=' + newPageSize;
          } else {
            window.location.href = '@Url.Action("Index", "Promotion")' + '?page=1&pageSize=' + newPageSize;
          }
        }

        async function confirmDeletePromotion(event) {
            event.preventDefault();
            
            const result = await Swal.fire({
                icon: 'warning',
                title: 'Xóa  khuyến mãi?',
                text: 'Bạn có chắc chắn muốn xóa Vĩnh Viễn khỏi hệ thống khuyến mãi này?',
                showCancelButton: true,
                confirmButtonColor: '#667eea',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Xóa',
                cancelButtonText: 'Hủy',
                reverseButtons: true
            });

            if (result.isConfirmed) {
                event.target.submit();
            }
            return false;
        }

        // Quick discount buttons
        function setDiscount(percent, formType) {
            const fieldId = formType === 'add' ? 'addDiscountPercent' : 'editDiscountPercent';
            document.getElementById(fieldId).value = percent;
            // Highlight effect
            const input = document.getElementById(fieldId);
            input.classList.add('border-success', 'border-2');
            setTimeout(() => {
                input.classList.remove('border-success', 'border-2');
            }, 800);
        }

        // Quick promotion duration buttons
        function setPromotionDuration(preset, formType) {
            const startId = formType === 'add' ? 'addStartDate' : 'editStartDate';
            const endId = formType === 'add' ? 'addEndDate' : 'editEndDate';
            const startInput = document.getElementById(startId);
            const endInput = document.getElementById(endId);
            let startDate = new Date();
            let endDate = new Date();

            switch(preset) {
                case 'today':
                    // Hôm nay: từ bây giờ đến 23:59
                    endDate.setHours(23, 59, 0, 0);
                    break;
                
                case 'weekend':
                    // Cuối tuần: Thứ 7 - Chủ nhật
                    const today = startDate.getDay();
                    const daysUntilSaturday = (6 - today + 7) % 7;
                    if (daysUntilSaturday === 0 && today !== 6) {
                        // If today is Sunday, start next Saturday
                        startDate.setDate(startDate.getDate() + 6);
                    } else if (today === 6) {
                        // If today is Saturday, start today
                    } else {
                        // Go to next Saturday
                        startDate.setDate(startDate.getDate() + daysUntilSaturday);
                    }
                    startDate.setHours(0, 0, 0, 0);
                    endDate = new Date(startDate);
                    endDate.setDate(endDate.getDate() + 1); // Sunday
                    endDate.setHours(23, 59, 0, 0);
                    break;
                
                case 'week':
                    // 1 tuần: 7 ngày từ bây giờ
                    endDate.setDate(endDate.getDate() + 7);
                    break;
                
                case 'month':
                    // 1 tháng: 30 ngày từ bây giờ
                    endDate.setDate(endDate.getDate() + 30);
                    break;
            }

            // Format to datetime-local format (YYYY-MM-DDTHH:mm)
            const formatDateTime = (date) => {
                const year = date.getFullYear();
                const month = String(date.getMonth() + 1).padStart(2, '0');
                const day = String(date.getDate()).padStart(2, '0');
                const hours = String(date.getHours()).padStart(2, '0');
                const minutes = String(date.getMinutes()).padStart(2, '0');
                return `${year}-${month}-${day}T${hours}:${minutes}`;
            };

            startInput.value = formatDateTime(startDate);
            endInput.value = formatDateTime(endDate);

            // Highlight effect
            startInput.classList.add('border-success', 'border-2');
            endInput.classList.add('border-success', 'border-2');
            setTimeout(() => {
                startInput.classList.remove('border-success', 'border-2');
                endInput.classList.remove('border-success', 'border-2');
            }, 1000);
        }
    </script>
}
