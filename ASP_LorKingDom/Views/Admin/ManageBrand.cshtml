@model IEnumerable<BLL.DTOs.BrandDto>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản Lí Thương Hiệu";
    var q = (string?)ViewBag.Query ?? "";
}
<link rel="stylesheet" href="~/css/MBrand.css" asp-append-version="true" />
<div class="container-fluid px-5">
    <h1 class="mt-4">Quản Lí Thương Hiệu</h1>

    <!-- Form thêm mới -->
    <form class="mt-4" asp-action="AddBrand" asp-controller="Brand" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="q" value="@q" />
        <label class="form-label">Tên Thương Hiệu</label>
        <input type="text" name="name" class="form-control d-inline-block w-auto" required />
        <button class="btn btn-primary ms-2" type="submit">Thêm Thương Hiệu</button>
    </form>


    <div class="card mb-4 mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div><i class="fa-solid fa-table me-1"></i> Danh Sách Thương Hiệu</div>
        </div>

        <div class="card-body">
            <!-- Tìm kiếm -->
            <form class="mb-4" method="get" asp-action="Manage" asp-controller="Brand">
                <div class="input-group search-box">
                    <input type="text" name="q" value="@q" class="form-control" placeholder="Tìm kiếm thương hiệu...">
                    <button class="btn btn-outline-secondary" type="submit">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                </div>
            </form>

            @if (TempData["Error"] is string e)
            {
                <div class="alert alert-danger">@e</div>
            }
            @if (TempData["Success"] is string s)
            {
                <div class="alert alert-success">@s</div>
            }

            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th style="white-space:nowrap">ID</th>
                            <th style="white-space:nowrap">Hành Động</th>
                            <th>Thương hiệu</th>
                            <th style="white-space:nowrap">Trạng Thái</th>
                            <th style="white-space:nowrap">Ngày Tạo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var x in Model)
                            {
                                <tr class="@(x.IsDeleted ? "deleted-row" : "")">
                                    <td>@x.Id</td>

                                    <td style="white-space:nowrap">
                                        <!-- Nút Edit mở modal -->
                                        <a class="btn btn-sm btn-warning ms-1" title="Cập nhật"
                                           asp-action="Edit" asp-controller="Brand"
                                           asp-route-id="@x.Id" asp-route-q="@q">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>
                                    </td>

                                    <td>@x.Name</td>

                                    <td>
                                        @if (x.IsDeleted)
                                        {
                                            <span class="badge bg-secondary">Không còn hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Hoạt Động</span>
                                        }
                                    </td>

                                    <td>@(x.CreatedAt?.ToString("dd/MM/yyyy HH:mm"))</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted">Không có dữ liệu.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Edit Brand -->
<div class="modal fade @(ViewBag.EditBrand != null ? "show d-block" : "")"
     id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="@(ViewBag.EditBrand == null)">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 id="editModalLabel" class="modal-title">Cập nhật Thương Hiệu</h5>
                <a href="@Url.Action("Manage", "Brand")" class="btn-close"></a>
            </div>

            <form method="post" asp-action="UpdateBrand" asp-controller="Brand">
                @Html.AntiForgeryToken()
                <input type="hidden" name="q" value="@q" />
                <div class="modal-body">
                    @{
                        var edit = ViewBag.EditBrand as BLL.DTOs.BrandDto;
                    }
                    <input type="hidden" name="id" value="@(edit?.Id ?? 0)" />

                    <div class="mb-3">
                        <label class="form-label">Tên Thương Hiệu</label>
                        <input type="text" class="form-control" name="name" value="@(edit?.Name ?? "")" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Trạng thái</label>
                        <select class="form-select" name="isDeleted" required>
                            <option value="false" selected="@(edit?.IsDeleted == false)">Hoạt động (0)</option>
                            <option value="true" selected="@(edit?.IsDeleted == true)">Không hoạt động (1)</option>
                        </select>
                    </div>

                    <div class="mb-2 text-muted small">
                        <i class="fa-regular fa-clock me-1"></i>
                        Ngày tạo: @(edit?.CreatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                    </div>
                </div>

                <div class="modal-footer">
                    <a href="@Url.Action("Manage", "Brand", new { q })" class="btn btn-outline-secondary">Hủy</a>
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                </div>
            </form>

        </div>
    </div>
</div>

@* modal báo lỗi *@
<div class="toast-container position-fixed p-3 toast-top-right" style="z-index:2080;">
    <div id="liveToast" class="toast align-items-center text-bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body fs-5 fw-semibold">
                <i class="fa-solid fa-circle-exclamation me-2"></i>
                @ViewBag.ErrorMessage
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Đóng"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Hiển thị toast 5s khi có lỗi
        document.addEventListener('DOMContentLoaded', function () {
            const hasError = '@(ViewBag.ShowErrorModal == true ? "true" : "false")';
            if (hasError === "true") {
                const toastEl = document.getElementById('liveToast');
                if (toastEl) {
                    const toast = new bootstrap.Toast(toastEl, { delay: 5000 }); // 5 giây
                    toast.show();
                }
            }
        });
    </script>

    @* Khóa nền khi có modal Edit hoặc khi muốn che nền *@
    @if (ViewBag.EditBrand != null || ViewBag.ShowErrorModal == true)
    {
        <script>
            document.body.classList.add('modal-open');
            document.body.style.overflow = 'hidden';
        </script>
    }
}

@section Styles {
    <!-- Font Awesome 6 -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          crossorigin="anonymous" referrerpolicy="no-referrer" />
}
