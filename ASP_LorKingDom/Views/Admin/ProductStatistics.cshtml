@model BLL.DTOs.ProductStatisticsDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Product Statistics";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="mb-0">📦 Product Statistics</h2>
            <p class="text-muted">Detailed analytics of your products</p>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted">Total Products</h6>
                    <h3 class="text-primary">@Model.TotalProducts</h3>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted">Active</h6>
                    <h3 class="text-success">@Model.ActiveProducts</h3>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted">Out of Stock</h6>
                    <h3 class="text-danger">@Model.OutOfStockProducts</h3>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted">Discontinued</h6>
                    <h3 class="text-secondary">@Model.DiscontinuedProducts</h3>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted">Low Stock</h6>
                    <h3 class="text-warning">@Model.LowStockProducts</h3>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted">Inventory Value</h6>
                    <h3 class="text-info">@((Model.TotalInventoryValue / 1000000).ToString("N1"))M đ</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <!-- Sales by Category -->
        <div class="col-xl-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">📊 Sales by Category</h5>
                </div>
                <div class="card-body">
                    <canvas id="categoryChart" height="150"></canvas>
                </div>
            </div>
        </div>

        <!-- Sales by Brand -->
        <div class="col-xl-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">🏷️ Sales by Brand</h5>
                </div>
                <div class="card-body">
                    <canvas id="brandChart" height="150"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <!-- Top Products -->
        <div class="col-xl-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">🏆 Top 10 Selling Products</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-sm table-hover">
                            <thead class="sticky-top bg-white">
                                <tr>
                                    <th>#</th>
                                    <th>Image</th>
                                    <th>Product</th>
                                    <th>Sold</th>
                                    <th>Revenue</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.TopProducts.Count; i++)
                                {
                                    var product = Model.TopProducts[i];
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td>
                                            <img src="@(product.MainImageUrl ?? "/Assets/placeholder.jpg")" 
                                                 style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px;">
                                        </td>
                                        <td>@product.ProductName</td>
                                        <td><span class="badge bg-success">@product.TotalSold</span></td>
                                        <td>@product.TotalRevenue.ToString("N0") đ</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Worst Products -->
        <div class="col-xl-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">📉 Worst 10 Selling Products</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-sm table-hover">
                            <thead class="sticky-top bg-white">
                                <tr>
                                    <th>#</th>
                                    <th>Image</th>
                                    <th>Product</th>
                                    <th>Sold</th>
                                    <th>Revenue</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.WorstProducts.Count; i++)
                                {
                                    var product = Model.WorstProducts[i];
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td>
                                            <img src="@(product.MainImageUrl ?? "/Assets/placeholder.jpg")" 
                                                 style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px;">
                                        </td>
                                        <td>@product.ProductName</td>
                                        <td><span class="badge bg-secondary">@product.TotalSold</span></td>
                                        <td>@product.TotalRevenue.ToString("N0") đ</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Low Stock Alerts -->
    <div class="row g-3">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">⚠️ Low Stock Alerts (≤10 items)</h5>
                </div>
                <div class="card-body">
                    @if (Model.LowStockAlerts.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Image</th>
                                        <th>SKU</th>
                                        <th>Product</th>
                                        <th>Category</th>
                                        <th>Brand</th>
                                        <th>Current Stock</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var alert in Model.LowStockAlerts)
                                    {
                                        <tr>
                                            <td>
                                                <img src="@(alert.MainImageUrl ?? "/Assets/placeholder.jpg")" 
                                                     style="width: 50px; height: 50px; object-fit: cover; border-radius: 4px;">
                                            </td>
                                            <td><code>@alert.Sku</code></td>
                                            <td>@alert.ProductName</td>
                                            <td>@(alert.CategoryName ?? "N/A")</td>
                                            <td>@(alert.BrandName ?? "N/A")</td>
                                            <td>
                                                <span class="badge @(alert.CurrentStock <= 5 ? "bg-danger" : "bg-warning")">
                                                    @alert.CurrentStock
                                                </span>
                                            </td>
                                            <td>
                                                @if (alert.CurrentStock <= 5)
                                                {
                                                    <span class="badge bg-danger">Critical</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning">Low</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success">
                            <i class="fas fa-check-circle"></i> All products have sufficient stock levels!
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        // Category Chart
        const categoryCtx = document.getElementById('categoryChart').getContext('2d');
        new Chart(categoryCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.SalesByCategory.Select(c => c.CategoryName))),
                datasets: [{
                    label: 'Revenue (đ)',
                    data: @Html.Raw(Json.Serialize(Model.SalesByCategory.Select(c => c.TotalRevenue))),
                    backgroundColor: 'rgba(54, 162, 235, 0.8)',
                    borderColor: 'rgb(54, 162, 235)',
                    borderWidth: 1
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return 'Revenue: ' + context.parsed.x.toLocaleString() + ' đ';
                            }
                        }
                    }
                },
                scales: {
                    x: { beginAtZero: true }
                }
            }
        });

        // Brand Chart
        const brandCtx = document.getElementById('brandChart').getContext('2d');
        new Chart(brandCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.SalesByBrand.Select(b => b.BrandName))),
                datasets: [{
                    label: 'Revenue (đ)',
                    data: @Html.Raw(Json.Serialize(Model.SalesByBrand.Select(b => b.TotalRevenue))),
                    backgroundColor: 'rgba(255, 159, 64, 0.8)',
                    borderColor: 'rgb(255, 159, 64)',
                    borderWidth: 1
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return 'Revenue: ' + context.parsed.x.toLocaleString() + ' đ';
                            }
                        }
                    }
                },
                scales: {
                    x: { beginAtZero: true }
                }
            }
        });
    </script>
}
