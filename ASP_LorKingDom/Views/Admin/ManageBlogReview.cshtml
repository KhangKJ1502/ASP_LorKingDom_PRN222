@model List<BLL.DTOs.ReviewBlogDto>
@{
    ViewData["Title"] = "Quản lý bình luận - ToyLand Admin";
    Layout = "_AdminLayout";
    var q = (string?)ViewBag.Query ?? "";
    var blockStatusFilter = (string?)ViewBag.BlockStatusFilter ?? "";
    var replyStatusFilter = (string?)ViewBag.ReplyStatusFilter ?? "";
    var currentPage = (int?)ViewBag.CurrentPage ?? 1;
    var totalPages = (int?)ViewBag.TotalPages ?? 1;
}

<style>
    .deleted-row {
        opacity: 0.6;
        background: #f8f9fa;
    }

    #reviewDetailModal .modal-content {
        border: none;
        border-radius: 16px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
    }

    #reviewDetailModal .modal-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 16px 16px 0 0;
        padding: 1.5rem;
        border: none;
    }

    #reviewDetailModal .modal-title {
        font-weight: 600;
        font-size: 1.25rem;
    }

    #reviewDetailModal .btn-close {
        filter: brightness(0) invert(1);
        opacity: 0.8;
    }

    #reviewDetailModal .modal-body {
        padding: 2rem;
        background-color: #f8f9fa;
    }

    .review-content {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        max-height: 3em;
        font-size: 0.95rem;
    }

    .author-badge {
        display: inline-block;
        background: #e7f3ff;
        color: #0066cc;
        padding: 0.35rem 0.75rem;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .reaction-stats {
        display: flex;
        gap: 1rem;
        font-size: 0.9rem;
        color: #6b7280;
    }

    .reaction-stats i {
        color: #667eea;
        margin-right: 0.3rem;
    }

    .date-text {
        font-size: 0.9rem;
        color: #6b7280;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.4rem 0.75rem;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .blog-title-ellipsis {
        max-width: 200px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        display: inline-block;
        color: #333;
    }
</style>

<div class="container-fluid px-5">
    <h1 class="mt-4">Quản Lý Bình Luận Bài Viết</h1>

    <div class="card mb-4 mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div><i class="fa-solid fa-comments me-2"></i>Danh Sách Bình Luận</div>
        </div>

        <div class="card-body">
            <!-- Tìm kiếm và Lọc -->
            <form class="mb-4" method="get" asp-action="ManageBlogReview" asp-controller="BlogReview">
                <div class="row g-2">
                    <div class="col-md-3">
                        <input type="text" name="q" value="@q" class="form-control"
                            placeholder="Tìm theo người bình luận hoặc nội dung...">
                    </div>
                    <div class="col-md-2">
                        <select name="blockStatus" class="form-control">
                            <option value="">Tất cả trạng thái</option>
                            <option value="unblocked" selected="@(blockStatusFilter == "unblocked")">Bình thường
                            </option>
                            <option value="blocked" selected="@(blockStatusFilter == "blocked")">Đã cấm</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select name="replyStatus" class="form-control">
                            <option value="">Tất cả phản hồi</option>
                            <option value="replied" selected="@(replyStatusFilter == "replied")">Đã hồi</option>
                            <option value="unreplied" selected="@(replyStatusFilter == "unreplied")">Chưa hồi</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-primary w-100" type="submit">
                            <i class="fa-solid fa-magnifying-glass"></i> Tìm kiếm
                        </button>
                    </div>
                </div>
            </form>

            <!-- Bảng Dữ Liệu -->
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 130px; text-align: center;">Hành động</th>
                            <th>Nội dung bình luận</th>
                            <th style="width: 150px;">Người bình luận</th>
                            <th style="width: 180px;">Bài viết</th>
                            <th style="width: 120px;">Tương tác</th>
                            <th style="width: 100px;">Phản hồi</th>
                            <th style="width: 80px;">Cấm</th>
                            <th style="width: 130px;">Ngày bình luận</th>                         
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.Any() == true)
                        {
                            @foreach (var review in Model)
                            {
                                <tr data-comment-id="@review.ReviewBlogId">
                                    <td style="text-align: center;">
                                        <button type="button" class="btn btn-sm btn-info"
                                                onclick="viewReviewDetail(@review.ReviewBlogId)" title="Xem">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm @(review.IsBlocked ? "btn-warning" : "btn-danger")"
                                                onclick="toggleBlockReview(@review.ReviewBlogId, @review.IsBlocked.ToString().ToLower())"
                                                title="@(review.IsBlocked ? "Gỡ cấm" : "Cấm")">
                                            <i class="fa-solid @(review.IsBlocked ? "fa-lock-open" : "fa-lock")"></i>
                                        </button>
                                        @* <button type="button" class="btn btn-sm btn-danger" *@
                                        @*         onclick="deleteReview(@review.ReviewBlogId)" title="Xóa"> *@
                                        @*     <i class="fas fa-trash"></i> *@
                                        @* </button> *@
                                    </td>
                                    <td>
                                        <p class="review-content mb-0">@review.Comment</p>
                                    </td>
                                    <td>
                                        <div class="user-cell">
                                            <span class="author-badge">@review.AuthorName</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="blog-title-ellipsis" title="@review.BlogTitle">@review.BlogTitle</span>
                                    </td>
                                    <td>
                                        <span class="me-2"><i class="fas fa-thumbs-up"></i> @review.LikeCount</span>
                                        <span><i class="fas fa-thumbs-down"></i> @review.DislikeCount</span>
                                    </td>
                                    <td>
                                        @if (review.Replies?.Any() == true)
                                        {
                                            <span class="badge bg-success"><i class="fas fa-check"></i> @review.Replies.Count</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark"><i class="fas fa-clock"></i> Chưa</span>
                                        }
                                    </td>
                                    <td>
                                        @if (review.IsBlocked)
                                        {
                                            <span class="badge bg-danger"><i class="fas fa-lock"></i> Đã cấm</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary"><i class="fas fa-lock-open"></i> Bình thường</span>
                                        }
                                    </td>
                                    <td>@review.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>                                 
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" style="text-align: center; color: #999;">Không có bình luận nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <nav class="mt-4" aria-label="Blog pagination">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                            href="@Url.Action("ManageBlogReview", "BlogReview", new { q, blockStatus = blockStatusFilter, replyStatus = replyStatusFilter, page = currentPage - 1 })">
                            <i class="fas fa-chevron-left me-1"></i>Trước
                        </a>
                    </li>

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link"
                                href="@Url.Action("ManageBlogReview", "BlogReview", new { q, blockStatus = blockStatusFilter, replyStatus = replyStatusFilter, page = i })">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link"
                            href="@Url.Action("ManageBlogReview", "BlogReview", new { q, blockStatus = blockStatusFilter, replyStatus = replyStatusFilter, page = currentPage + 1 })">
                            Sau <i class="fas fa-chevron-right ms-1"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>

    <!-- Modal Chi Tiết Bình Luận -->
    <div class="modal fade" id="commentDetailModal" tabindex="-1" aria-labelledby="reviewDetailLabel"
        aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content" id="reviewDetailModal">
                <div class="modal-header">
                    <h5 class="modal-title" id="reviewDetailLabel">
                        <i class="fa-solid fa-comment me-2"></i>Chi tiết bình luận
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="commentDetailContent">
                    <!-- Content sẽ được load bằng JS -->
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>

@section Scripts {
        <script>
            // Select All
            document.getElementById('selectAll')?.addEventListener('change', function () {
                document.querySelectorAll('.row-checkbox').forEach(cb => cb.checked = this.checked);
            });

            // Toggle Block Review
            function toggleBlockReview(reviewId, currentlyBlocked) {
                const action = currentlyBlocked ? 'gỡ cấm' : 'cấm';
                Swal.fire({
                    title: `Xác nhận ${action}`,
                    text: `Bạn có chắc chắn muốn ${action} bình luận này?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc2626',
                    cancelButtonColor: '#6b7280',
                    confirmButtonText: 'Có, xác nhận',
                    cancelButtonText: 'Hủy'
                }).then((result) => {
                    if (result.isConfirmed) {
                        const token = $('input[name="__RequestVerificationToken"]').val();

                        $.ajax({
                            url: `/BlogReview/ToggleBlock/${reviewId}`,
                            type: 'POST',
                            headers: {
                                'RequestVerificationToken': token
                            },
                            success: function (data) {
                                if (data.success) {
                                    Swal.fire({
                                        icon: 'success',
                                        title: 'Thành công',
                                        text: data.message,
                                        confirmButtonColor: '#10b981'
                                    }).then(() => {
                                        location.reload();
                                    });
                                } else {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Lỗi',
                                        text: data.message,
                                        confirmButtonColor: '#dc2626'
                                    });
                                }
                            },
                            error: function (xhr) {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Lỗi',
                                    text: 'Không thể cập nhật trạng thái',
                                    confirmButtonColor: '#dc2626'
                                });
                            }
                        });
                    }
                });
            }

            // Delete Review
            // function deleteReview(reviewId) {
            //     Swal.fire({
            //         title: 'Xác nhận xóa',
            //         text: 'Bạn có chắc chắn muốn xóa bình luận này?',
            //         icon: 'warning',
