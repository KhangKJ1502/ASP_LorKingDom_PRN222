@model List<BLL.DTOs.ReviewBlogDto>
@{
    ViewData["Title"] = "Quản lý bình luận - ToyLand Admin";
    Layout = "_AdminLayout";
    var q = (string?)ViewBag.Query ?? "";
    var blogFilter = (string?)ViewBag.BlogFilter ?? "";
    var userFilter = (string?)ViewBag.UserFilter ?? "";
    var currentPage = (int?)ViewBag.CurrentPage ?? 1;
    var totalPages = (int?)ViewBag.TotalPages ?? 1;
    var blogs = (List<BLL.DTOs.BlogPostDto>?)ViewBag.Blogs ?? new List<BLL.DTOs.BlogPostDto>();
}

<style>
    .search-box .form-control {
        border: 1px solid #000 !important;
        box-shadow: none !important;
    }

    .search-box .btn {
        border: 1px solid #000 !important;
        border-left: none !important;
    }

    .toast-top-right {
        top: 120px !important;
        right: 24px !important;
    }

    #liveToast.toast {
        min-width: 520px;
        padding: 1rem 1.25rem;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
    }

    #liveToast .toast-body {
        font-size: 1.1rem;
        font-weight: 600;
    }

    .deleted-row {
        opacity: 0.6;
        background: #f8f9fa;
    }

    #reviewDetailModal .modal-content {
        border: none;
        border-radius: 16px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
    }

    #reviewDetailModal .modal-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 16px 16px 0 0;
        padding: 1.5rem;
        border: none;
    }

    #reviewDetailModal .modal-title {
        font-weight: 600;
        font-size: 1.25rem;
    }

    #reviewDetailModal .btn-close {
        filter: brightness(0) invert(1);
        opacity: 0.8;
    }

    #reviewDetailModal .modal-body {
        padding: 2rem;
        background-color: #f8f9fa;
    }

    .review-content {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        max-height: 3em;
        font-size: 0.95rem;
    }

    .author-badge {
        display: inline-block;
        background: #e7f3ff;
        color: #0066cc;
        padding: 0.35rem 0.75rem;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .reaction-stats {
        display: flex;
        gap: 1rem;
        font-size: 0.9rem;
        color: #6b7280;
    }

    .reaction-stats i {
        color: #667eea;
        margin-right: 0.3rem;
    }

    .date-text {
        font-size: 0.9rem;
        color: #6b7280;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.4rem 0.75rem;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 600;
    }
</style>

<div class="container-fluid px-5">
    <h1 class="mt-4">Quản Lý Bình Luận Blog</h1>

    <div class="card mb-4 mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div><i class="fa-solid fa-comments me-2"></i>Danh Sách Bình Luận</div>
        </div>

        <div class="card-body">
            <!-- Tìm kiếm và Lọc -->
            <form class="mb-4" method="get" asp-action="ManageBlogReview" asp-controller="BlogReview">
                <div class="row g-2 mb-3">
                    <div class="col-md-4">
                        <input type="text" name="q" value="@q" class="form-control"
                            placeholder="Tìm kiếm nội dung bình luận...">
                    </div>
                    <div class="col-md-3">
                        <select name="blog" class="form-control">
                            <option value="">Tất cả bài viết</option>
                            @foreach (var blog in blogs)
                            {
                                <option value="@blog.BlogPostId" selected="@(blogFilter == blog.BlogPostId.ToString())">
                                    @blog.BlogTitle
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <input type="text" name="user" value="@userFilter" class="form-control"
                            placeholder="Tìm kiếm người bình luận...">
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-primary w-100" type="submit">
                            <i class="fa-solid fa-magnifying-glass"></i> Tìm kiếm
                        </button>
                    </div>
                </div>
            </form>

            @if (TempData["Error"] is string e)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @e
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Success"] is string s)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @s
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Bảng Dữ Liệu -->
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 40px;">
                                <input type="checkbox" id="selectAll" class="form-check-input">
                            </th>
                            <th>Nội dung bình luận</th>
                            <th style="width: 150px;">Người bình luận</th>
                            <th style="width: 180px;">Bài viết</th>
                            <th style="width: 120px;">Tương tác</th>
                            <th style="width: 100px;">Phản hồi</th>
                            <th style="width: 80px;">Cấm</th>
                            <th style="width: 130px;">Ngày bình luận</th>
                            <th style="width: 130px; text-align: center;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.Any() == true)
                        {
                            @foreach (var review in Model)
                            {
                                <tr data-comment-id="@review.ReviewBlogId">
                                    <td><input type="checkbox" class="form-check-input row-checkbox"></td>
                                    <td>
                                        <p class="review-content mb-0">@review.Comment</p>
                                    </td>
                                    <td>
                                        <div class="user-cell">
                                            <span class="author-badge">@review.AuthorName</span>
                                        </div>
                                    </td>
                                    <td>
                                        <a href="/Blog/Detail/@review.BlogPostId" class="blog-link" target="_blank">
                                            Xem bài viết <i class="fas fa-external-link-alt"></i>
                                        </a>
                                    </td>
                                    <td>
                                        <span class="me-2"><i class="fas fa-thumbs-up"></i> @review.LikeCount</span>
                                        <span><i class="fas fa-thumbs-down"></i> @review.DislikeCount</span>
                                    </td>
                                    <td>
                                        @if (review.Replies?.Any() == true)
                                        {
                                            <span class="badge bg-success"><i class="fas fa-check"></i> @review.Replies.Count</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark"><i class="fas fa-clock"></i> Chưa</span>
                                        }
                                    </td>
                                    <td>
                                        @if (review.IsBlocked)
                                        {
                                            <span class="badge bg-danger"><i class="fas fa-lock"></i> Đã cấm</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary"><i class="fas fa-lock-open"></i> Bình thường</span>
                                        }
                                    </td>
                                    <td>@review.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td style="text-align: center;">
                                        <button type="button" class="btn btn-sm btn-info"
                                            onclick="viewReviewDetail(@review.ReviewBlogId)" title="Xem">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button type="button"
                                            class="btn btn-sm @(review.IsBlocked ? "btn-warning" : "btn-danger")"
                                            onclick="toggleBlockReview(@review.ReviewBlogId, @review.IsBlocked.ToString().ToLower())"
                                            title="@(review.IsBlocked ? "Gỡ cấm" : "Cấm")">
                                            <i class="fa-solid @(review.IsBlocked ? "fa-lock-open" : "fa-lock")"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-danger"
                                            onclick="deleteReview(@review.ReviewBlogId)" title="Xóa">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" style="text-align: center; color: #999;">Không có bình luận nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <nav class="mt-4" aria-label="Blog pagination">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                            href="@Url.Action("ManageBlogReview", "BlogReview", new { q, blog = blogFilter, user = userFilter, page = currentPage - 1 })">
                            <i class="fas fa-chevron-left me-1"></i>Trước
                        </a>
                    </li>

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link"
                                href="@Url.Action("ManageBlogReview", "BlogReview", new { q, blog = blogFilter, user = userFilter, page = i })">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link"
                            href="@Url.Action("ManageBlogReview", "BlogReview", new { q, blog = blogFilter, user = userFilter, page = currentPage + 1 })">
                            Sau <i class="fas fa-chevron-right ms-1"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>

    <!-- Modal Chi Tiết Bình Luận -->
    <div class="modal fade" id="commentDetailModal" tabindex="-1" aria-labelledby="reviewDetailLabel"
        aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content" id="reviewDetailModal">
                <div class="modal-header">
                    <h5 class="modal-title" id="reviewDetailLabel">
                        <i class="fa-solid fa-comment me-2"></i>Chi tiết bình luận
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="commentDetailContent">
                    <!-- Content sẽ được load bằng JS -->
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>

@section Scripts {
        <script>
            // Select All
            document.getElementById('selectAll')?.addEventListener('change', function () {
                document.querySelectorAll('.row-checkbox').forEach(cb => cb.checked = this.checked);
            });

            // Toggle Block Review
            async function toggleBlockReview(reviewId, currentlyBlocked) {
                const action = currentlyBlocked ? 'gỡ cấm' : 'cấm';
                const result = await Swal.fire({
                    title: `Xác nhận ${action}`,
                    text: `Bạn có chắc chắn muốn ${action} bình luận này?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Có, xác nhận',
                    cancelButtonText: 'Hủy'
                });

                if (result.isConfirmed) {
                    try {
                        const formData = new FormData();
                        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                        if (token) {
                            formData.append('__RequestVerificationToken', token);
                        }

                        const response = await fetch(`/BlogReview/ToggleBlock/${reviewId}`, {
                            method: 'POST',
                            body: formData
                        });

                        if (response.ok) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công',
                                text: currentlyBlocked ? 'Đã gỡ cấm bình luận' : 'Đã cấm bình luận',
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => {
                                location.reload();
                            });
                        } else {
                            throw new Error('Lỗi server');
                        }
                    } catch (error) {
                        Swal.fire('Lỗi', 'Không thể cập nhật trạng thái', 'error');
                    }
                }
            }

            // Delete Review
            async function deleteReview(reviewId) {
                const result = await Swal.fire({
                    title: 'Xác nhận xóa',
                    text: 'Bạn có chắc chắn muốn xóa bình luận này? Hành động này không thể hoàn tác.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Có, xóa',
                    cancelButtonText: 'Hủy'
                });

                if (result.isConfirmed) {
                    try {
                        const formData = new FormData();
                        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                        if (token) {
                            formData.append('__RequestVerificationToken', token);
                        }

                        const response = await fetch(`/BlogReview/Delete/${reviewId}`, {
                            method: 'POST',
                            body: formData
                        });

                        if (response.ok) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công',
                                text: 'Bình luận đã được xóa',
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => {
                                location.reload();
                            });
                        } else {
                            throw new Error('Lỗi server');
                        }
                    } catch (error) {
                        Swal.fire('Lỗi', 'Không thể xóa bình luận', 'error');
                    }
                }
            }

            // View Review Detail
            async function viewReviewDetail(reviewId) {
                try {
                    const response = await fetch(`/BlogReview/Details/${reviewId}`);
                    if (!response.ok) throw new Error('Không thể tải chi tiết bình luận');

                    const review = await response.json();
                    let repliesHtml = '';

                    if (review.replies && review.replies.length > 0) {
                        repliesHtml = '<h6 class="mt-3 mb-2"><strong>Phản hồi:</strong></h6>';
                        review.replies.forEach(reply => {
                            repliesHtml += `
                                    <div style="background: white; padding: 0.75rem; margin-bottom: 0.5rem; border-left: 3px solid #667eea; border-radius: 4px;">
                                        <p class="mb-1"><strong>${reply.authorName}</strong></p>
                                        <p class="mb-1">${reply.content}</p>
                                        <small class="text-muted">${reply.createdAt}</small>
                                    </div>
                                `;
                        });
                    } else {
                        repliesHtml = '<div class="alert alert-info">Chưa có phản hồi nào</div>';
                    }

                    const content = `
                            <div class="row g-3">
                                <div class="col-md-12">
                                    <p><strong>Nội dung:</strong></p>
                                    <div style="background: white; padding: 0.75rem; border: 1px solid #e0e0e0; border-radius: 4px; margin-bottom: 1rem;">
                                        ${review.content}
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <p><strong>Người bình luận:</strong> ${review.authorName}</p>
                                </div>
                                <div class="col-md-6">
                                    <p><strong>Email:</strong> ${review.authorEmail || 'N/A'}</p>
                                </div>
                                <div class="col-md-6">
                                    <p><strong>Tương tác:</strong> 👍 ${review.likeCount} | 👎 ${review.dislikeCount}</p>
                                </div>
                                <div class="col-md-12">
                                    <p><strong>Ngày bình luận:</strong> ${review.createdAt}</p>
                                </div>
                                <div class="col-md-12">
                                    <h6><strong>Phản hồi:</strong></h6>
                                    ${repliesHtml}
                                    <form id="replyForm" style="margin-top: 1rem;">
                                        <textarea name="replyContent" class="form-control" rows="2" placeholder="Nhập phản hồi..."></textarea>
                                        <button type="button" class="btn btn-primary btn-sm mt-2" onclick="submitReply(${reviewId})">
                                            <i class="fas fa-paper-plane me-1"></i>Gửi phản hồi
                                        </button>
                                    </form>
                                </div>
                            </div>
                        `;

                    document.getElementById('commentDetailContent').innerHTML = content;
                    const modal = new bootstrap.Modal(document.getElementById('commentDetailModal'));
                    modal.show();
                } catch (error) {
                    Swal.fire('Lỗi', error.message, 'error');
                }
            }

            // Submit Reply
            async function submitReply(reviewId) {
                const replyContent = document.querySelector('textarea[name="replyContent"]')?.value.trim();
                if (!replyContent) {
                    Swal.fire('Thông báo', 'Vui lòng nhập phản hồi', 'warning');
                    return;
                }

                try {
                    const formData = new FormData();
                    formData.append('replyContent', replyContent);

                    // Thêm CSRF token
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    if (token) {
                        formData.append('__RequestVerificationToken', token);
                    }

                    const response = await fetch(`/BlogReview/Reply/${reviewId}`, {
                        method: 'POST',
                        body: formData
                    });

                    if (response.ok) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Thành công',
                            text: 'Phản hồi đã được gửi',
                            timer: 1500,
                            showConfirmButton: false
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        throw new Error('Lỗi server');
                    }
                } catch (error) {
                    Swal.fire('Lỗi', 'Không thể gửi phản hồi', 'error');
                }
            }
        </script>
}