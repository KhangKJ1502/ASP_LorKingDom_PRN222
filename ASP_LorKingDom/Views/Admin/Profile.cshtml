@{
    ViewData["Title"] = "Cập nhật tài khoản";
    Layout = "_AdminLayout";
}

<link href="~/css/admin-profile.css" rel="stylesheet" asp-append-version="true" />

<div class="profile-container">
    <!-- Header -->
    <div class="profile-header">
        <h1 class="text-light">
            </i>Cập nhật tài khoản
        </h1>
        <p>Quản lý thông tin và cài đặt tài khoản của bạn</p>
    </div>

    <!-- Main Card -->
    <div class="profile-card">
        <div class="profile-body">
            <!-- Avatar Section -->
            <div class="avatar-section">
                <img id="avatarPreview" src="" alt="Avatar" class="avatar-preview">
                <h5 id="accountNameDisplay" style="margin-bottom: 8px; color: #1f2937;">-</h5>
                <p style="color: #6b7280; font-size: 14px; margin-bottom: 0;" id="roleDisplay"
                    data-role="@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? " Staff"">
                    @(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Staff")
                </p>
                <div class="avatar-upload">
                    <button type="button" class="btn-upload-avatar"
                        onclick="document.getElementById('avatarInput').click()">
                        <i class="fas fa-camera me-2"></i>Đổi ảnh đại diện
                    </button>
                    <input type="file" id="avatarInput" accept="image/*">
                </div>
            </div>

            <!-- Form -->
            <form id="profileForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="changePasswordHidden" name="changePassword" value="false">

                <!-- Basic Information Section -->
                <div class="form-section">
                    <h5 class="form-section-title">
                        <i class="fas fa-user me-2"></i>Thông tin cơ bản
                    </h5>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="accountName">Tên tài khoản</label>
                            <input type="text" id="accountName" name="accountName" class="form-input"
                                placeholder="Nhập tên tài khoản" required>
                            <span class="info-text">Tên hiển thị trên hệ thống</span>
                        </div>
                        <div class="form-group">
                            <label for="email">Email</label>
                            <input type="email" id="email" name="email" class="form-input"
                                placeholder="user@example.com" disabled>
                            <span class="info-text">Email không thể thay đổi</span>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="phoneNumber">Số điện thoại</label>
                            <input type="tel" id="phoneNumber" name="phoneNumber" class="form-input"
                                placeholder="0123456789">
                            <span class="info-text">Để trống nếu chưa có</span>
                        </div>
                        <div class="form-group">
                            <label for="status">Trạng thái</label>
                            <select id="status" name="status" class="form-input" disabled>
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Security Section -->
                <div class="form-section">
                    <h5 class="form-section-title">
                        <i class="fas fa-lock me-2"></i>Bảo mật
                    </h5>

                    <div class="password-section">
                        <div class="password-toggle">
                            <input type="checkbox" id="changePasswordCheck">
                            <label for="changePasswordCheck">Thay đổi mật khẩu</label>
                        </div>

                        <div class="password-fields" id="passwordFields">
                            <div class="form-row full">
                                <div class="form-group">
                                    <label for="currentPassword">Mật khẩu hiện tại</label>
                                    <input type="password" id="currentPassword" name="currentPassword"
                                        class="form-input input-change-password" placeholder="Nhập mật khẩu hiện tại">
                                </div>
                            </div>

                            <div class="form-row full">
                                <div class="form-group">
                                    <label for="newPassword">Mật khẩu mới</label>
                                    <input type="password" id="newPassword" name="newPassword"
                                        class="form-input input-change-password" placeholder="Nhập mật khẩu mới">
                                    <span class="info-text">Tối thiểu 6 ký tự</span>
                                </div>
                            </div>

                            <div class="form-row full">
                                <div class="form-group">
                                    <label for="confirmPassword">Xác nhận mật khẩu</label>
                                    <input type="password" id="confirmPassword" name="confirmPassword"
                                        class="form-input input-change-password" placeholder="Nhập lại mật khẩu mới">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @{
                    string role = ViewBag.Role as string ?? "";
                    string redirectAction = "";
                    string redirectController = "";

                    switch (role)
                    {
                        case "Staff":
                            redirectAction = "Dashboard";
                            redirectController = "Statistics";
                            break;

                        case "WareHouse":
                            redirectAction = "ProductStatistics";
                            redirectController = "Statistics";
                            break;
                    }
                }

                <!-- Form Actions -->
                <div class="form-actions">
                    <a href="@Url.Action(redirectAction, redirectController)" class="btn btn-secondary">
                        <i class="fas fa-times me-2"></i>Hủy
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function loadProfile() {
            $.ajax({
                url: '@Url.Action("GetProfile", "AdminAuth")',
                type: 'GET',
                success: function (data) {
                    if (!data || data.success === false) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi',
                            text: data?.message || 'Không thể tải thông tin tài khoản',
                            confirmButtonColor: '#dc2626'
                        });
                        return;
                    }

                    // Update form fields
                    $('#accountName').val(data.accountName || '');
                    $('#email').val(data.email || '');
                    $('#phoneNumber').val(data.phoneNumber || '');
                    $('#status').val(data.status || 'Active');

                    // Update avatar
                    const avatarUrl = data.image || '/Assets/image/avatar/avatar-illustrated-02.png';
                    $('#avatarPreview').attr('src', avatarUrl);
                    $('#accountNameDisplay').text(data.accountName || '-');

                    // Update role
                    const roleElement = $('#roleDisplay');
                    if (!roleElement.attr('data-role')) {
                        roleElement.text(data.role || 'Staff');
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi',
                        text: 'Không thể tải thông tin tài khoản',
                        confirmButtonColor: '#dc2626'
                    });
                }
            });
        }


        // Toggle password fields
        $('#changePasswordCheck').on('change', function () {
            const isChecked = this.checked;
            const passwordFields = $('#passwordFields');
            const hiddenInput = $('#changePasswordHidden');

            passwordFields.toggleClass('show', isChecked);
            hiddenInput.val(isChecked ? 'true' : 'false');

            $('#currentPassword, #newPassword, #confirmPassword').prop('required', isChecked);
        });

        // Avatar upload preview
        $('#avatarInput').on('change', function (e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = (event) => $('#avatarPreview').attr('src', event.target.result);
                reader.readAsDataURL(file);
            }
        });

        // Form submit
        $('#profileForm').on('submit', function (e) {
            e.preventDefault();

            const changePassword = $('#changePasswordCheck').is(':checked');
            const newPassword = $('#newPassword').val();
            const confirmPassword = $('#confirmPassword').val();

            // Validate password
            if (changePassword && newPassword !== confirmPassword) {
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi',
                    text: 'Mật khẩu xác nhận không khớp',
                    confirmButtonColor: '#dc2626'
                });
                return;
            }

            if (changePassword && newPassword.length < 6) {
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi',
                    text: 'Mật khẩu phải tối thiểu 6 ký tự',
                    confirmButtonColor: '#dc2626'
                });
                return;
            }

            const btn = $(this).find('button[type="submit"]');
            btn.prop('disabled', true).html('<span class="loading-spinner"></span>Đang lưu...');

            Swal.fire({
                title: 'Đang cập nhật...',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();

                    const formData = new FormData($('#profileForm')[0]);
                    const token = $('input[name="__RequestVerificationToken"]').val();

                    $.ajax({
                        url: '@Url.Action("UpdateProfile", "Admin")',
                        type: 'POST',
                        data: formData,
                        processData: false,
                        contentType: false,
                        headers: {
                            'RequestVerificationToken': token
                        },
                        success: function (data) {
                            Swal.close();

                            if (data.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Thành công',
                                    text: data.message,
                                    confirmButtonColor: '#10b981'
                                }).then(() => {
                                    loadProfile();

                                    // Reset password fields
                                    $('#changePasswordCheck').prop('checked', false);
                                    $('#passwordFields').removeClass('show');
                                    $('#currentPassword, #newPassword, #confirmPassword').val('');
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Lỗi',
                                    text: data.message,
                                    confirmButtonColor: '#dc2626'
                                });
                            }
                        },
                        error: function () {
                            Swal.close();
                            Swal.fire({
                                icon: 'error',
                                title: 'Lỗi',
                                text: 'Đã xảy ra lỗi khi cập nhật thông tin',
                                confirmButtonColor: '#dc2626'
                            });
                        },
                        complete: function () {
                            btn.prop('disabled', false).html('<i class="fas fa-save me-2"></i>Lưu thay đổi');
                        }
                    });
                }
            });
        });

        // Load data on page load
        $(document).ready(loadProfile);
    </script>
}