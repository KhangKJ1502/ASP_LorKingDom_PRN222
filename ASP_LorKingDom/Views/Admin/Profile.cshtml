@{
    ViewData["Title"] = "Cập nhật tài khoản";
    Layout = "_AdminLayout";
}

<link href="~/css/admin-profile.css" rel="stylesheet" asp-append-version="true" />

<div class="profile-container">
    <!-- Header -->
    <div class="profile-header">
        <h1 class="text-light">
            </i>Cập nhật tài khoản
        </h1>
        <p>Quản lý thông tin và cài đặt tài khoản của bạn</p>
    </div>

    <!-- Main Card -->
    <div class="profile-card">
        <div class="profile-body">
            <!-- Avatar Section -->
            <div class="avatar-section">
                <img id="avatarPreview" src="" alt="Avatar" class="avatar-preview">
                <h5 id="accountNameDisplay" style="margin-bottom: 8px; color: #1f2937;">-</h5>
                <p style="color: #6b7280; font-size: 14px; margin-bottom: 0;" id="roleDisplay"
                    data-role="@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? " Staff"">
                    @(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Staff")
                </p>
                <div class="avatar-upload">
                    <button type="button" class="btn-upload-avatar"
                        onclick="document.getElementById('avatarInput').click()">
                        <i class="fas fa-camera me-2"></i>Đổi ảnh đại diện
                    </button>
                    <input type="file" id="avatarInput" accept="image/*">
                </div>
            </div>

            <!-- Info Box -->
            <div class="info-box">
                <i class="fas fa-info-circle"></i>
                <span>Thông tin cơ bản được tự động cập nhật từ hệ thống. Liên hệ Admin để thay đổi role hoặc
                    quyền.</span>
            </div>

            <!-- Form -->
            <form id="profileForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="changePasswordHidden" name="changePassword" value="false">

                <!-- Basic Information Section -->
                <div class="form-section">
                    <h5 class="form-section-title">
                        <i class="fas fa-user me-2"></i>Thông tin cơ bản
                    </h5>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="accountName">Tên tài khoản</label>
                            <input type="text" id="accountName" name="accountName" class="form-input"
                                placeholder="Nhập tên tài khoản" required>
                            <span class="info-text">Tên hiển thị trên hệ thống</span>
                        </div>
                        <div class="form-group">
                            <label for="email">Email</label>
                            <input type="email" id="email" name="email" class="form-input"
                                placeholder="user@example.com" disabled>
                            <span class="info-text">Email không thể thay đổi</span>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="phoneNumber">Số điện thoại</label>
                            <input type="tel" id="phoneNumber" name="phoneNumber" class="form-input"
                                placeholder="0123456789">
                            <span class="info-text">Để trống nếu chưa có</span>
                        </div>
                        <div class="form-group">
                            <label for="status">Trạng thái</label>
                            <select id="status" name="status" class="form-input" disabled>
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                            <span class="info-text">Được quản lý bởi Admin</span>
                        </div>
                    </div>
                </div>

                <!-- Security Section -->
                <div class="form-section">
                    <h5 class="form-section-title">
                        <i class="fas fa-lock me-2"></i>Bảo mật
                    </h5>

                    <div class="password-section">
                        <div class="password-toggle">
                            <input type="checkbox" id="changePasswordCheck">
                            <label for="changePasswordCheck">Thay đổi mật khẩu</label>
                        </div>

                        <div class="password-fields" id="passwordFields">
                            <div class="form-row full">
                                <div class="form-group">
                                    <label for="currentPassword">Mật khẩu hiện tại</label>
                                    <input type="password" id="currentPassword" name="currentPassword"
                                        class="form-input input-change-password" placeholder="Nhập mật khẩu hiện tại">
                                    <span class="info-text">Để xác minh đó là bạn</span>
                                </div>
                            </div>

                            <div class="form-row full">
                                <div class="form-group">
                                    <label for="newPassword">Mật khẩu mới</label>
                                    <input type="password" id="newPassword" name="newPassword"
                                        class="form-input input-change-password" placeholder="Nhập mật khẩu mới">
                                    <span class="info-text">Tối thiểu 8 ký tự, bao gồm chữ và số</span>
                                </div>
                            </div>

                            <div class="form-row full">
                                <div class="form-group">
                                    <label for="confirmPassword">Xác nhận mật khẩu</label>
                                    <input type="password" id="confirmPassword" name="confirmPassword"
                                        class="form-input input-change-password" placeholder="Nhập lại mật khẩu mới">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @{
                    string role = ViewBag.Role as string ?? "";
                    string redirectAction = "";
                    string redirectController = "";

                    switch (role)
                    {
                        case "Staff":
                            redirectAction = "Dashboard";
                            redirectController = "Statistics";
                            break;

                        case "WareHouse":
                            redirectAction = "ProductStatistics";
                            redirectController = "Statistics";
                            break;
                    }
                }

                <!-- Form Actions -->
                <div class="form-actions">
                    <a href="@Url.Action(redirectAction, redirectController)" class="btn btn-secondary">
                        <i class="fas fa-times me-2"></i>Hủy
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Load profile data
        async function loadProfile() {
            try {
                const response = await fetch('@Url.Action("GetProfile", "AdminAuth")');
                if (!response.ok) throw new Error('Không thể tải thông tin');

                const data = await response.json();

                // Update form fields
                document.getElementById('accountName').value = data.accountName || '';
                document.getElementById('email').value = data.email || '';
                document.getElementById('phoneNumber').value = data.phoneNumber || '';
                document.getElementById('status').value = data.status || 'Active';

                // Update avatar
                const avatarUrl = data.image || '/Assets/image/avatar/avatar-illustrated-02.png';
                document.getElementById('avatarPreview').src = avatarUrl;
                document.getElementById('accountNameDisplay').textContent = data.accountName || '-';

                // Get role from claims (server-side)
                const roleElement = document.getElementById('roleDisplay');
                if (roleElement && roleElement.getAttribute('data-role')) {
                    // Already set by server
                } else {
                    roleElement.textContent = data.role || 'Staff';
                }
            } catch (error) {
                Swal.fire('Lỗi', 'Không thể tải thông tin tài khoản', 'error');
            }
        }

        // Toggle password fields
        document.getElementById('changePasswordCheck').addEventListener('change', function () {
            const passwordFields = document.getElementById('passwordFields');
            const hiddenInput = document.getElementById('changePasswordHidden');

            if (this.checked) {
                passwordFields.classList.add('show');
                document.getElementById('currentPassword').required = true;
                document.getElementById('newPassword').required = true;
                document.getElementById('confirmPassword').required = true;
                hiddenInput.value = 'true';
            } else {
                passwordFields.classList.remove('show');
                document.getElementById('currentPassword').required = false;
                document.getElementById('newPassword').required = false;
                document.getElementById('confirmPassword').required = false;
                hiddenInput.value = 'false';
            }
        });

        // Avatar upload preview
        document.getElementById('avatarInput').addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (event) {
                    document.getElementById('avatarPreview').src = event.target.result;
                };
                reader.readAsDataURL(file);
            }
        });

        // Form submit
        document.getElementById('profileForm').addEventListener('submit', function (e) {
            e.preventDefault();

            const form = $(this);
            const changePassword = document.getElementById('changePasswordCheck').checked;
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;

            // Validate password
            if (changePassword && newPassword !== confirmPassword) {
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi',
                    text: 'Mật khẩu xác nhận không khớp',
                    confirmButtonColor: '#dc2626'
                });
                return;
            }

            if (changePassword && newPassword.length < 8) {
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi',
                    text: 'Mật khẩu phải tối thiểu 8 ký tự',
                    confirmButtonColor: '#dc2626'
                });
                return;
            }

            const btn = this.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.innerHTML = '<span class="loading-spinner"></span>Đang lưu...';

            Swal.fire({
                title: 'Đang cập nhật...',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();

                    const formData = new FormData(this);
                    const token = $('input[name="__RequestVerificationToken"]').val();

                    $.ajax({
                        url: '@Url.Action("UpdateProfile", "Admin")',
                        type: 'POST',
                        data: formData,
                        processData: false,
                        contentType: false,
                        headers: {
                            'RequestVerificationToken': token
                        },
                        success: function (data) {
                            if (data.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Thành công',
                                    text: data.message,
                                    confirmButtonColor: '#10b981'
                                }).then(() => {
                                    loadProfile();
                                    document.getElementById('changePasswordCheck').checked = false;
                                    document.getElementById('passwordFields').classList.remove('show');
                                    document.getElementById('currentPassword').value = '';
                                    document.getElementById('newPassword').value = '';
                                    document.getElementById('confirmPassword').value = '';
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Lỗi',
                                    text: data.message,
                                    confirmButtonColor: '#dc2626'
                                });
                            }
                        },
                        error: function (xhr) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Lỗi',
                                text: 'Đã xảy ra lỗi khi cập nhật thông tin',
                                confirmButtonColor: '#dc2626'
                            });
                        },
                        complete: function () {
                            btn.disabled = false;
                            btn.innerHTML = '<i class="fas fa-save me-2"></i>Lưu thay đổi';
                        }
                    });
                }
            });
        });

        // Load data on page load
        document.addEventListener('DOMContentLoaded', loadProfile);
    </script>
}