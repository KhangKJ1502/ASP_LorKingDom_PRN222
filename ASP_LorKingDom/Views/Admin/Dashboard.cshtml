
@model BLL.DTOs.DashboardStatisticsDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
}

<link rel="stylesheet" href="~/css/Dashboard-revenue.css" asp-append-version="true" />

<div class="dashboard-container">
    <div class="container-fluid">
        <!-- Header -->
        <div class="dashboard-header">
            <h1 class="dashboard-title">Bảng Điều Khiển</h1>
            <p class="text-muted mb-0" style="font-size: 1.1rem;">Tổng quan về hiệu suất cửa hàng của bạn</p>
        </div>

        <!-- Summary Cards -->
        <div class="row g-4 mb-4">
            <div class="col-xl-3 col-md-6">
                <div class="stat-card revenue">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="stat-icon">
                            <i class="fas fa-dollar-sign"></i>
                        </div>
                    </div>
                    <h6 class="stat-label">Tổng doanh thu</h6>
                    <h3 class="stat-value">@Model.TotalRevenue.ToString("N0") đ</h3>
                    <span class="stat-subtitle success">
                        Tháng này: @Model.RevenueThisMonth.ToString("N0") đ
                    </span>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="stat-card orders">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="stat-icon">
                            <i class="fas fa-shopping-cart"></i>
                        </div>
                    </div>
                    <h6 class="stat-label">Tổng số đơn hàng</h6>
                    <h3 class="stat-value">@Model.TotalOrders</h3>
                    <span class="stat-subtitle info">
                        Hôm nay: @Model.OrdersToday
                    </span>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="stat-card customers">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="stat-icon">
                            <i class="fas fa-users"></i>
                        </div>
                    </div>
                    <h6 class="stat-label">Tổng số khách hàng</h6>
                    <h3 class="stat-value">@Model.TotalCustomers</h3>
                    <span class="stat-subtitle primary">
                        Mới tháng này: @Model.NewCustomersThisMonth
                    </span>
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <div class="stat-card products">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="stat-icon">
                            <i class="fas fa-box"></i>
                        </div>
                    </div>
                    <h6 class="stat-label">Tổng số sản phẩm</h6>
                    <h3 class="stat-value">@Model.TotalProducts</h3>
                    <span class="stat-subtitle warning">
                        Sắp hết: @Model.LowStockProducts
                    </span>
                </div>
            </div>
        </div>

        <!-- Charts Row 1 -->
        <div class="row g-4 mb-4">
            <div class="col-xl-8">
                <div class="chart-card">
                    <div class="chart-header">
                        <h5 class="chart-title">Doanh Thu Hàng Ngày (7 ngày qua)</h5>
                    </div>
                    <div class="chart-body">
                        <canvas id="dailyRevenueChart" height="80"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-xl-4">
                <div class="chart-card">
                    <div class="chart-header">
                        <h5 class="chart-title">Đơn Hàng Theo Trạng Thái</h5>
                    </div>
                    <div class="chart-body">
                        <canvas id="orderStatusChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Monthly Revenue Chart -->
        <div class="row g-4 mb-4">
            <div class="col-12">
                <div class="chart-card">
                    <div class="chart-header">
                        <h5 class="chart-title">Doanh Thu Hàng Tháng (12 tháng qua)</h5>
                    </div>
                    <div class="chart-body">
                        <canvas id="monthlyRevenueChart" height="60"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Top Products Table -->
        <div class="row g-4">
            <div class="col-12">
                <div class="chart-card">
                    <div class="chart-header">
                        <h5 class="chart-title">Top 5 Sản Phẩm Bán Chạy Nhất</h5>
                    </div>
                    <div class="chart-body">
                        <div class="table-responsive">
                            <table class="table table-modern mb-0">
                                <thead>
                                    <tr>
                                        <th>Hình ảnh</th>
                                        <th>Tên sản phẩm</th>
                                        <th>Đã bán</th>
                                        <th>Doanh thu</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in Model.TopSellingProducts)
                                    {
                                        <tr>
                                            <td>
                                                <img src="@(product.MainImageUrl ?? "/Assets/placeholder.jpg")"
                                                     alt="@product.ProductName"
                                                     class="product-img">
                                            </td>
                                            <td>
                                                <strong style="color: #1f2937;">@product.ProductName</strong>
                                            </td>
                                            <td>
                                                <span class="badge bg-success badge-modern">
                                                    @product.TotalSold
                                                </span>
                                            </td>
                                            <td>
                                                <span class="revenue-badge">
                                                    @product.TotalRevenue.ToString("N0") đ
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        // Chart.js Global Configuration
        Chart.defaults.font.family = "'Inter', 'Segoe UI', sans-serif";

        // Daily Revenue Chart
        const dailyCtx = document.getElementById('dailyRevenueChart').getContext('2d');
        new Chart(dailyCtx, {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.DailyRevenues.Select(d => d.DateLabel))),
                datasets: [{
                    label: 'Doanh thu (đ)',
                    data: @Html.Raw(Json.Serialize(Model.DailyRevenues.Select(d => d.Revenue))),
                    borderColor: '#10b981',
                    backgroundColor: 'rgba(16, 185, 129, 0.1)',
                    borderWidth: 3,
                    tension: 0.4,
                    fill: true,
                    pointBackgroundColor: '#10b981',
                    pointBorderColor: '#fff',
                    pointBorderWidth: 2,
                    pointRadius: 5,
                    pointHoverRadius: 7
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        display: true,
                        labels: {
                            font: { size: 13, weight: '600' },
                            padding: 15
                        }
                    },
                    tooltip: {
                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                        padding: 12,
                        titleFont: { size: 14, weight: '600' },
                        bodyFont: { size: 13 },
                        callbacks: {
                            label: function(context) {
                                return 'Doanh thu: ' + context.parsed.y.toLocaleString() + ' đ';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: 'rgba(0, 0, 0, 0.05)' },
                        ticks: { font: { size: 12 } }
                    },
                    x: {
                        grid: { display: false },
                        ticks: { font: { size: 12 } }
                    }
                }
            }
        });

        // Order Status Chart
        const statusCtx = document.getElementById('orderStatusChart').getContext('2d');
        const statusData = @Html.Raw(Json.Serialize(Model.OrdersByStatus));
        new Chart(statusCtx, {
            type: 'doughnut',
            data: {
                labels: Object.keys(statusData),
                datasets: [{
                    data: Object.values(statusData),
                    backgroundColor: [
                        '#ef4444',
                        '#3b82f6',
                        '#fbbf24',
                        '#10b981',
                        '#8b5cf6',
                        '#f97316'
                    ],
                    borderWidth: 3,
                    borderColor: '#fff'
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 15,
                            font: { size: 12, weight: '600' }
                        }
                    },
                    tooltip: {
                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                        padding: 12
                    }
                }
            }
        });

        // Monthly Revenue Chart
        const monthlyCtx = document.getElementById('monthlyRevenueChart').getContext('2d');
        new Chart(monthlyCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.MonthlyRevenues.Select(m => m.MonthName))),
                datasets: [{
                    label: 'Doanh thu (đ)',
                    data: @Html.Raw(Json.Serialize(Model.MonthlyRevenues.Select(m => m.Revenue))),
                    backgroundColor: 'rgba(59, 130, 246, 0.8)',
                    borderColor: '#3b82f6',
                    borderWidth: 2,
                    borderRadius: 8,
                    borderSkipped: false
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        display: true,
                        labels: {
                            font: { size: 13, weight: '600' },
                            padding: 15
                        }
                    },
                    tooltip: {
                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                        padding: 12,
                        callbacks: {
                            label: function(context) {
                                return 'Doanh thu: ' + context.parsed.y.toLocaleString() + ' đ';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: 'rgba(0, 0, 0, 0.05)' },
                        ticks: { font: { size: 12 } }
                    },
                    x: {
                        grid: { display: false },
                        ticks: { font: { size: 12 } }
                    }
                }
            }
        });
    </script>
}