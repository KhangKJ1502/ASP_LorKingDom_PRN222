@model List<BLL.DTOs.WishlistItemDto>

@functions {
	string FormatPrice(decimal v) => v.ToString("C0");
	string BadgeClass(string status) =>
		status == "OutOfStock" ? "out-stock" :
		status == "Discontinued" ? "discontinued" : "in-stock";
	string BadgeText(string status) =>
		status == "OutOfStock" ? "Hết hàng" :
		status == "Discontinued" ? "Ngừng bán" : "Còn hàng";
}

@if (!Model.Any())
{
	<div class="text-muted mx-3">Danh sách yêu thích của bạn đang trống.</div>
}
else
{
	foreach (var x in Model)
	{
		<div class="wl-card" data-id="@x.ProductId">
			<div class="wl-row">
				<img class="wl-thumb"
					 src="@(string.IsNullOrWhiteSpace(x.MainImageUrl)
                        ? Url.Content("~/images/placeholder.png")
                        : x.MainImageUrl)"
					 alt="@x.ProductName" />
				<div class="wl-info">
					<h6 class="wl-name" title="@x.ProductName">@x.ProductName</h6>
					<div class="d-flex align-items-center gap-2 mb-2">
						<span class="wl-price">@FormatPrice(x.Price)</span>
					</div>
					<span class="wl-badge @BadgeClass(x.ProductStatus ?? "") mb-2 d-inline-block">
						@BadgeText(x.ProductStatus ?? "")
					</span>
					<div class="wl-actions">
						<button type="button" class="wl-add btn-cart" data-id="@x.ProductId">
							<i class="fa-solid fa-cart-shopping me-2"></i> Thêm vào giỏ
						</button>
						<button type="button" class="wl-trash btn-remove" data-id="@x.ProductId" title="Xóa">
							<i class="fa-solid fa-trash"></i>
						</button>
					</div>
				</div>
			</div>
		</div>
	}
}
