							style="width: 100px; height: 100px; border-radius: 50%; object-fit: cover; border: 3px solid #667eea;">
					</div>
					<div class="profile-info">
						<div class="mb-3">
							<label class="fw-bold text-muted small">Tên tài khoản</label>
							<p id="profileName" class="mb-0">-</p>
						</div>
						<div class="mb-3">
							<label class="fw-bold text-muted small">Email</label>
							<p id="profileEmail" class="mb-0">-</p>
						</div>
						<div class="mb-3">
							<label class="fw-bold text-muted small">Số điện thoại</label>
							<p id="profilePhone" class="mb-0">-</p>
						</div>
						<div class="mb-3">
							<label class="fw-bold text-muted small">Trạng thái</label>
							<p id="profileStatus" class="mb-0">-</p>
						</div>
						<div class="mb-3">
							<label class="fw-bold text-muted small">Ngày tạo</label>
							<p id="profileCreatedAt" class="mb-0">-</p>
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
					<a href="@Url.Action("Profile", "Admin")" class="btn btn-primary">Chỉnh sửa</a>
				</div>
			</div>
		</div>
	</div>

	<!-- Logout Form (hidden) -->
	<form id="logoutForm" method="post" action="@Url.Action("Logout", "AdminAuth")" style="display: none;">
		@Html.AntiForgeryToken()
	</form>

	@Html.AntiForgeryToken()

	<script>
		// Show Profile Modal
		async function showProfileModal() {
			try {
				const response = await fetch('@Url.Action("GetProfile", "AdminAuth")');
				if (!response.ok) throw new Error('Không thể tải thông tin');

				const data = await response.json();

				document.getElementById('profileAvatar').src = data.image || '/Assets/image/avatar/avatar-illustrated-02.png';
				document.getElementById('profileName').textContent = data.accountName || '-';
				document.getElementById('profileEmail').textContent = data.email || '-';
				document.getElementById('profilePhone').textContent = data.phoneNumber || 'Chưa cập nhật';
				document.getElementById('profileStatus').textContent = data.status || '-';
				document.getElementById('profileCreatedAt').textContent = data.createdAt || '-';

				const modal = new bootstrap.Modal(document.getElementById('profileModal'));
				modal.show();
			} catch (error) {
				Swal.fire('Lỗi', 'Không thể tải thông tin tài khoản', 'error');
			}
		}

		// Confirm Logout
		function confirmLogout() {
			Swal.fire({
				title: 'Xác nhận đăng xuất?',
				text: 'Bạn có chắc chắn muốn đăng xuất khỏi hệ thống?',
				icon: 'question',
				showCancelButton: true,
				confirmButtonColor: '#dc3545',
				cancelButtonColor: '#6c757d',
				confirmButtonText: 'Đăng xuất',
				cancelButtonText: 'Hủy'
			}).then((result) => {
				if (result.isConfirmed) {
					document.getElementById('logoutForm').submit();
				}
			});
		}
	</script>

	<!-- Admin Notification Script -->
	<script>
		(function() {
			async function loadAdminNotifications() {
				try {
					const badge = document.getElementById('adminNotificationBadge');
					const icon = document.getElementById('adminNotificationIcon');
					const dropdown = document.getElementById('adminNotificationDropdown');
					if (badge) {
						badge.style.display = 'none';
					}
					if (icon) {
						icon.classList.remove('active');
					}

					if (dropdown) {
						dropdown.innerHTML = `
							<li class="text-center py-4">
								<div style="padding: 20px;">
									<i data-feather="bell" style="width:48px;height:48px;color:#6c757d;margin-bottom:12px;" aria-hidden="true"></i>
									<h6 class="mb-2" style="color:#495057;">Thông Báo</h6>
									<p class="text-muted mb-0" style="font-size:0.9em;">
										Tính năng đang được phát triển
									</p>
									<span class="badge bg-warning text-dark mt-2">Coming Soon</span>
								</div>
							</li>
						`;
						if (typeof feather !== 'undefined') {
							feather.replace();
						}
					}

				} catch (error) {
					console.error('Load admin notifications error:', error);

					// Fallback UI on error
					const dropdown = document.getElementById('adminNotificationDropdown');
					if (dropdown) {
						dropdown.innerHTML = `
							<li class="text-center py-3 text-muted">
								<i data-feather="alert-circle" style="color:#dc3545;" aria-hidden="true"></i>
								<p class="mb-0 mt-2">Không thể tải thông báo</p>
							</li>
						`;
						if (typeof feather !== 'undefined') {
							feather.replace();
						}
					}
				}
			}

			function escapeHtml(text) {
				const div = document.createElement('div');
				div.textContent = text || '';
				return div.innerHTML;
			}
			loadAdminNotifications();
		})();
	</script>

	@await RenderSectionAsync("Scripts", required: false)
</body>

</html>