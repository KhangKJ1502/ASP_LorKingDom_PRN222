	<script>
		document.addEventListener('DOMContentLoaded', function () {
			if (window.lucide) lucide.createIcons();

			// === TẠO VÀ CẬP NHẬT BADGE GIỎ HÀNG ===
			let badge = document.querySelector('#cart-badge');
			const cartLink = document.getElementById('cart-link');
			if (cartLink && !badge) {
				badge = document.createElement('span');
				badge.id = 'cart-badge';
				badge.className = 'action-badge action-badge-primary';
				badge.style.cssText = 'position: absolute; top: -8px; right: -8px; font-size: 12px; min-width: 18px; height: 18px; display: flex; align-items: center; justify-content: center; border-radius: 50%;';
				cartLink.style.position = 'relative';
				cartLink.appendChild(badge);
			}

			// Cập nhật badge ngay khi load
			if (typeof updateCartBadge === 'function') {
				updateCartBadge();
			}
		});
	</script>
	@await RenderSectionAsync("Scripts", required: false)
	<script>
		// Lấy số thông báo chưa đọc
		async function updateNotificationBadge() {
			try {
				const response = await fetch('/MyNotifications/GetUnreadCount');
				const data = await response.json();

				const badge = document.getElementById('unreadBadge');
				if (data.success && data.count > 0) {
					badge.textContent = data.count > 99 ? '99+' : data.count;
					badge.style.display = 'block';
				} else {
					badge.style.display = 'none';
				}
			} catch (error) {
				console.error('Error:', error);
			}
		}

		// Cập nhật lúc load trang
		updateNotificationBadge();

		// Cập nhật mỗi 30 giây
		setInterval(updateNotificationBadge, 30000);

		// Khi click nút thông báo -> đi đến trang xem thông báo
		document.getElementById('notificationBtn').addEventListener('click', function () {
			window.location.href = '/MyNotifications/Index';
		});
	</script>
