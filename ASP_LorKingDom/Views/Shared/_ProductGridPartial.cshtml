@model BLL.DTOs.PagedResult<BLL.DTOs.ProductDto>
@using System.Linq

@{
	// Lấy q/page/pageSize hiện tại từ query để build URL Index đúng
	var q = Context.Request.Query["q"].ToString();
	int page = int.TryParse(Context.Request.Query["page"], out var _p) ? _p : (Model?.Page ?? 1);
	int pageSize = int.TryParse(Context.Request.Query["pageSize"], out var _ps) ? _ps : (Model?.PageSize ?? 16);

	var indexUrl = Url.Action("Index", "Home", new { q, page, pageSize });
}
<link href="~/css/promotion-pricing.css" rel="stylesheet" asp-append-version="true" />
<style>
	.pagination-orange {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 10px;
		margin-top: 32px;
	}

		.pagination-orange .page-item {
			list-style: none;
		}

		.pagination-orange .page-link {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 56px;
			height: 56px;
			font-size: 20px;
			font-weight: 700;
			color: #F97316;
			background: #fff;
			border: 2px solid #F97316;
			text-decoration: none;
			transition: all 0.25s ease;
			box-shadow: 0 3px 10px rgba(249, 115, 22, 0.08);
		}

			.pagination-orange .page-link:hover {
				background: #F97316;
				color: #fff;
			}

		.pagination-orange .page-item.active .page-link {
			background: #F97316;
			color: #fff;
			border-color: #F97316;
			box-shadow: 0 6px 16px rgba(249, 115, 22, 0.28);
			cursor: default;
		}

		.pagination-orange .page-item.disabled .page-link {
			opacity: 0.4;
			pointer-events: none;
		}


		.pagination-orange .page-link {
			border-radius: 16px;
		}

		.pagination-orange .page-item:first-child .page-link {
			border-top-left-radius: 24px;
			border-bottom-left-radius: 24px;
			border-top-right-radius: 8px;
			border-bottom-right-radius: 8px;
		}

		.pagination-orange .page-item:last-child .page-link {
			border-top-right-radius: 24px;
			border-bottom-right-radius: 24px;
			border-top-left-radius: 8px;
			border-bottom-left-radius: 8px;
		}
</style>



@if (Model?.Items != null && Model.Items.Any())
{
	var rnd = new Random(12345);

	foreach (var row in Model.Items.Chunk(4))
	{
		<div class="product-row d-grid" style="grid-template-columns: repeat(4, minmax(0,1fr)); gap:24px; margin-bottom:24px;">
			@foreach (var p in row)
			{
				var url = Url.Action("ProductDetails", "Home", new { id = p.Id });
				int stars = rnd.Next(4, 6);
				int reviews = rnd.Next(50, 500);
				var hasPromotion = p.PromotionId != null && p.PromotionDiscountPercent.HasValue && p.PromotionDiscountPercent.Value > 0;

				<article class="product-card @(hasPromotion ? "on-sale" : "") js-card" role="link" tabindex="0" data-url="@url">
					<div class="product-image">
						<img src="@(string.IsNullOrWhiteSpace(p.MainImageUrl) ? Url.Content("~/images/placeholder.png") : p.MainImageUrl)" alt="@p.ProductName" />

						<!-- Form trái tim: POST đồng bộ, returnUrl luôn về Index -->
						<form asp-controller="Wishlist" asp-action="Toggle" method="post" class="wishlist-form" onclick="event.stopPropagation();">
							@Html.AntiForgeryToken()
							<input type="hidden" name="productId" value="@p.Id" />
							<input type="hidden" name="returnUrl" value="@indexUrl" />
							<button type="submit" class="product-wishlist @(p.IsLiked ? "active" : "")" title="Yêu thích">
								<svg width="20" height="20" viewBox="0 0 24 24"
									 fill="@(p.IsLiked ? "red" : "none")"
									 stroke="currentColor" stroke-width="2">
									<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06
                                             a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78
                                             1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
								</svg>
							</button>
						</form>
					</div>

					<div class="product-info">
						<h3 class="product-name">
							<a href="@url">@p.ProductName</a>
						</h3>
						<div class="product-rating">
							<div class="stars">
								@for (int i = 0; i < stars; i++)
								{
									<span>★</span>
								}
								@for (int i = stars; i < 5; i++)
								{
									<span>☆</span>
								}
							</div>
							<span>(@reviews)</span>
						</div>
						<div class="product-price">
							@{
								// If product has a promotion, show original price struck-through and discounted price
								if (p.PromotionId != null && p.PromotionDiscountPercent.HasValue && p.PromotionDiscountPercent.Value > 0)
								{
									var discount = p.PromotionDiscountPercent.Value;
									var discounted = p.Price * (1 - discount / 100m);
									<text>
										<span class="price-discounted">@discounted.ToString("C0")</span>
										<span class="price-original"><del>@p.Price.ToString("C0")</del></span>
									</text>
								}
								else
								{
									<text><span class="price-current">@p.Price.ToString("C0")</span></text>
								}
							}
						</div>
						<button onclick="addToCart(@p.Id, 1)" class="btn btn-primary btn-block">
							Thêm vào giỏ hàng
						</button>
					</div>
				</article>
			}
		</div>
	}
}
else
{
	<div class="alert alert-info">No products available.</div>
}

@if (Model != null && Model.Total > Model.PageSize)
{
	var totalPages = (int)Math.Ceiling(Model.Total / (double)Model.PageSize);
	<nav aria-label="pagination" class="mt-4">
		<ul class="pagination-orange">
			<li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
				<a class="page-link js-page"
				   data-page="@(Model.Page - 1)"
				   href="@Url.Action("Index","Home", new { q = Context.Request.Query["q"], page = Model.Page - 1, pageSize = Model.PageSize })">
					«
				</a>
			</li>

			@for (int i = 1; i <= totalPages; i++)
			{
				<li class="page-item @(i == Model.Page ? "active" : "")">
					<a class="page-link js-page"
					   data-page="@i"
					   href="@Url.Action("Index", "Home", new { q, page = i, pageSize = Model.PageSize })">@i</a>
				</li>
			}

			<li class="page-item @(Model.Page >= totalPages ? "disabled" : "")">
				<a class="page-link js-page"
				   data-page="@(Model.Page + 1)"
				   href="@Url.Action("Index","Home", new { q = Context.Request.Query["q"], page = Model.Page + 1, pageSize = Model.PageSize })">
					»
				</a>
			</li>
		</ul>
	</nav>
}

