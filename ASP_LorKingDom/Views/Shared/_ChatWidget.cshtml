@{
    // ==================== CẶP CHẾ ĐỘ A: AUTHENTICATION (Đăng nhập) ====================
    
    // ✅ A1: GUEST MODE (Đang dùng) - Cho phép chat không cần đăng nhập
    var userId = User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? ("guest_" + Guid.NewGuid().ToString("N").Substring(0, 8));
    var name = User?.Identity?.Name ?? "Khách hàng";
    var isAuthenticated = false; // Guest luôn = false
    
    // 🔐 A2: CUSTOMER MODE - Yêu cầu đăng nhập (Comment A1, bỏ comment A2)
    // var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
    // var userId = isAuthenticated ? (User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "") : "";
    // var name = isAuthenticated ? (User?.Identity?.Name ?? "Khách hàng") : "";
    
    // ==================== KẾT THÚC CẶP A ====================
}

<div id="chatWidget">
    <!-- Floating Button -->
    <button class="chat-widget-button" id="chatToggleBtn" type="button">
        <svg class="chat-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
        <svg class="close-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
        <span class="notification-dot" id="notificationDot"></span>
    </button>

    <!-- Chat Box -->
    <div class="chat-widget-box" id="chatBox">
        <!-- Header -->
        <div class="chat-widget-header">
            <div class="header-content">
                <div class="agent-avatar">
                    <span>🎧</span>
                </div>
                <div class="agent-info">
                    <h4>Hỗ trợ khách hàng</h4>
                    <p class="agent-status" id="agentStatus">
                        <span class="status-dot"></span>
                        <span class="status-text">Đang kiểm tra...</span>
                    </p>
                </div>
            </div>
            <button class="minimize-btn" id="minimizeBtn" type="button">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
            </button>
        </div>

        <!-- Messages -->
        <div class="chat-widget-messages" id="chatMessages">
            <div class="welcome-message">
                <div class="welcome-icon">👋</div>
                <h3>Xin chào!</h3>
                <p>Chúng tôi có thể giúp gì cho bạn?</p>
            </div>
        </div>

        <!-- Typing Indicator -->
        <div class="typing-indicator" id="typingIndicator">
            <div class="typing-dots">
                <span></span>
                <span></span>
                <span></span>
            </div>
            <span class="typing-text">Nhân viên đang nhập...</span>
        </div>

        <!-- Input -->
        <div class="chat-widget-input">
            <input type="text" id="messageInput" placeholder="Nhập tin nhắn..." autocomplete="off" />
            <button class="send-button" id="sendButton" type="button">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="22" y1="2" x2="11" y2="13"></line>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
            </button>
        </div>

        <!-- Footer -->
        <div class="chat-widget-footer">
            <span>Powered by ToyLand Support</span>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
    (function () {
        // ===== Razor -> JS =====
        const USER_ID = "@userId";
        const DISPLAY_NAME = "@name";
        const IS_AUTHENTICATED = @Json.Serialize(isAuthenticated);
        const HUB = `/chatHub?userId=${encodeURIComponent(USER_ID)}&isStaff=false&name=${encodeURIComponent(DISPLAY_NAME)}`;

        // state
        let conn = null;
        let convId = null;
        let typingTimer = null;
        let isBoxOpen = false;

        // dom
        const toggleBtn = document.getElementById('chatToggleBtn');
        const chatBox = document.getElementById('chatBox');
        const minimizeBtn = document.getElementById('minimizeBtn');
        const messageInput = document.getElementById('messageInput');
        const sendButton = document.getElementById('sendButton');
        const chatMessages = document.getElementById('chatMessages');
        const typingIndicator = document.getElementById('typingIndicator');
        const agentStatus = document.getElementById('agentStatus');
        const notificationDot = document.getElementById('notificationDot');

        // ===== Cookie helpers =====
        function getCookie(name) {
            const m = document.cookie.match(new RegExp('(?:^|; )' + name.replace(/([$?*|{}\]\\^])/g, '\\$1') + '=([^;]*)'));
            return m ? decodeURIComponent(m[1]) : null;
        }

        function getAssignedStaff() {
            const staffId = getCookie("staffId");
            const staffName = getCookie("staffName") || "Nhân viên hỗ trợ";
            return { staffId, staffName };
        }

        // ===== UI helpers =====
        function toggleChatBox() {
            isBoxOpen = !isBoxOpen;
            chatBox.classList.toggle('show', isBoxOpen);
            toggleBtn.classList.toggle('active', isBoxOpen);

            if (isBoxOpen) {
                messageInput.focus();
                notificationDot.classList.remove('show');
            }
        }
        // toggleBtn click handler sẽ được gắn sau (ở dưới, sau khi định nghĩa init)
        minimizeBtn.addEventListener('click', toggleChatBox);

        function formatTime(date) {
            return new Date(date || Date.now()).toLocaleTimeString('vi-VN', {
                hour: '2-digit',
                minute: '2-digit'
            });
        }

        function addMessage(senderId, text, when) {
            // bỏ welcome lúc nhận tin đầu tiên
            const welcome = chatMessages.querySelector('.welcome-message');
            if (welcome) welcome.remove();

            const wrap = document.createElement('div');
            wrap.className = `chat-message ${senderId === USER_ID ? 'sent' : 'received'}`;

            const bubble = document.createElement('div');
            bubble.className = 'chat-bubble';
            bubble.textContent = text ?? '';

            const time = document.createElement('span');
            time.className = 'message-time';
            time.textContent = formatTime(when);

            bubble.appendChild(time);
            wrap.appendChild(bubble);
            chatMessages.appendChild(wrap);

            chatMessages.scrollTop = chatMessages.scrollHeight;

            if (!isBoxOpen && senderId !== USER_ID) {
                notificationDot.classList.add('show');
            }
        }

        function setAgentStatus(online, text) {
            if (online) {
                agentStatus.classList.add('online');
                agentStatus.querySelector('.status-text').textContent = text || 'Đang online';
            } else {
                agentStatus.classList.remove('online');
                agentStatus.querySelector('.status-text').textContent = text || 'Offline';
            }
        }

        function showTyping(isTyping) {
            typingIndicator.classList.toggle('show', isTyping);
            if (isTyping) {
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }
        }

        // ===== chat actions =====
        // ==================== CẶP CHẾ ĐỘ A: AUTHENTICATION ====================
        
        // ✅ A1: GUEST MODE (Đang dùng) - Gửi tin nhắn không cần đăng nhập
        async function sendMessage() {
            const text = messageInput.value.trim();
            if (!text) return;

            // Chỉ tạo conversation khi GỬI TIN NHẮN ĐẦU TIÊN
            if (!convId) {
                try {
                    console.log("🔌 Tạo conversation khi gửi tin nhắn đầu tiên...");
                    await startConversation();
                    if (!convId) {
                        console.error("❌ Không thể tạo conversation");
                        return;
                    }
                } catch (err) {
                    console.error("❌ Lỗi khi tạo conversation:", err);
                    return;
                }
            }

            messageInput.value = '';
            try {
                await conn.invoke("SendMessage", convId, USER_ID, text);
            } catch (err) {
                console.error("SendMessage error:", err);
            }
        }

        // 🔐 A2: CUSTOMER MODE - Yêu cầu đăng nhập khi gửi tin nhắn (Comment A1, bỏ comment A2)
        // async function sendMessage() {
        //     // Kiểm tra đăng nhập
        //     if (!IS_AUTHENTICATED) {
        //         Swal.fire({
        //             icon: 'warning',
        //             title: 'Vui lòng đăng nhập',
        //             text: 'Bạn cần đăng nhập để gửi tin nhắn.',
        //             confirmButtonColor: '#667eea'
        //         });
        //         return;
        //     }
        //
        //     const text = messageInput.value.trim();
        //     if (!text) return;
        //
        //     // Chỉ tạo conversation khi GỬI TIN NHẮN ĐẦU TIÊN
        //     if (!convId) {
        //         try {
        //             console.log("🔌 Tạo conversation khi gửi tin nhắn đầu tiên...");
        //             await startConversation();
        //             if (!convId) {
        //                 console.error("❌ Không thể tạo conversation");
        //                 return;
        //             }
        //         } catch (err) {
        //             console.error("❌ Lỗi khi tạo conversation:", err);
        //             return;
        //         }
        //     }
        //
        //     messageInput.value = '';
        //     try {
        //         await conn.invoke("SendMessage", convId, USER_ID, text);
        //     } catch (err) {
        //         console.error("SendMessage error:", err);
        //     }
        // }
        
        // ==================== KẾT THÚC CẶP A ====================

        function handleTyping() {
            if (!convId) return;

            conn.invoke("Typing", convId, USER_ID, true).catch(() => {});
            clearTimeout(typingTimer);
            typingTimer = setTimeout(() => {
                conn.invoke("Typing", convId, USER_ID, false).catch(() => {});
            }, 1000);
        }

        sendButton.addEventListener('click', sendMessage);
        messageInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            } else {
                handleTyping();
            }
        });

        // ===== SignalR =====
        async function initSignalR() {
            conn = new signalR.HubConnectionBuilder()
                .withUrl(HUB)
                .withAutomaticReconnect()
                .build();

            // Khi có tin nhắn mới
            conn.on("receive", (m) => {
                if (m.conversationId === convId) {
                    addMessage(m.senderId, m.text, m.sentAt);
                }
            });

            // Khi staff đang gõ
            conn.on("typing", (from, isTyping) => {
                if (from !== USER_ID) {
                    showTyping(isTyping);
                }
            });

            // Khi presence thay đổi
            conn.on("presenceChanged", (uid, online) => {
                // chỉ update nếu uid == staff đang assigned cho mình
                const { staffId } = getAssignedStaff();
                if (uid && staffId && uid === staffId) {
                    setAgentStatus(online);
                }
            });

            // Khi server báo cập nhật hội thoại (ví dụ đổi staff)
            conn.on("conversationUpdated", (conv) => {
                // nếu server có đổi conv.StaffUserId thì bạn có thể sync lại cookie bên dưới
                console.log("conversationUpdated", conv);
            });

            await conn.start();
            console.log("SignalR connected");
        }

        // Gọi RPC server để lấy / tạo conversation đúng staff
        async function startConversation() {
            const { staffId } = getAssignedStaff();

            try {
                if (staffId) {
                    // Ưu tiên staffId từ cookie
                    convId = await conn.invoke("StartChatWithStaff", USER_ID, staffId);
                    console.log("StartChatWithStaff ->", convId);

                    // bật tạm trạng thái online = true tới khi presenceChanged sync lại
                    setAgentStatus(true);
                } else {
                    // fallback: auto-assign staff
                    convId = await conn.invoke("StartChatAsCustomer", USER_ID);
                    console.log("StartChatAsCustomer ->", convId);
                }
            } catch (err) {
                console.error("startConversation failed:", err);
                agentStatus.querySelector('.status-text').textContent = 'Lỗi kết nối';
            }
        }

        // ==================== LAZY LOADING IMPLEMENTATION ====================
        // Biến để track xem đã kết nối chưa (tránh connect nhiều lần)
        let isConnected = false;
        let isConnecting = false;

        async function init() {
            if (isConnected || isConnecting) return; // ✅ Đã connect rồi, không connect lại
            isConnecting = true;

            // Hiển thị trạng thái đang kết nối
            setAgentStatus(false, 'Đang kết nối...');

            try {
                await initSignalR();
                // ✅ Chỉ tạo conversation khi user GỬI TIN NHẮN ĐẦU TIÊN (xem hàm sendMessage)
                isConnected = true;
                setAgentStatus(false, 'Sẵn sàng');
                console.log("SignalR đã kết nối thành công!");
            } catch (err) {
                console.error("Failed to initialize chat:", err);
                setAgentStatus(false, 'Lỗi kết nối');
                isConnecting = false;
            }
        }

        chatToggleBtn.addEventListener('click', async () => {
            // Nếu chưa kết nối, kết nối trước rồi mới mở chat box
            if (!isConnected && !isConnecting) {
                console.log("🔌 Đang kết nối SignalR...");
                await init();
            }
            // Sau khi kết nối (hoặc đã kết nối rồi), toggle chat box
            toggleChatBox();
        });
 

        // 🔐 A2+B2: CUSTOMER + AUTO-CONNECT - Tự động kết nối, yêu cầu đăng nhập KHI CLICK
        // (Comment B2, bỏ comment block dưới)
        //
        // window.addEventListener('DOMContentLoaded', () => {
        //     console.log("🔌 Auto-connecting SignalR...");
        //     init(); // Tự động connect khi page load
        // });
        //
        // chatToggleBtn.addEventListener('click', () => {
        //     // Kiểm tra đăng nhập khi click
        //     if (!IS_AUTHENTICATED) {
        //         Swal.fire({
        //             icon: 'warning',
        //             title: 'Vui lòng đăng nhập',
        //             html: 'Bạn cần <strong>đăng nhập</strong> để sử dụng tính năng chat.<br><br>Đăng nhập ngay để được hỗ trợ!',
        //             showCancelButton: true,
        //             confirmButtonText: '🔐 Đăng nhập',
        //             cancelButtonText: 'Đóng',
        //             confirmButtonColor: '#667eea',
        //             cancelButtonColor: '#6c757d'
        //         }).then((result) => {
        //             if (result.isConfirmed) {
        //                 window.location.href = '/Auth/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
        //             }
        //         });
        //         return;
        //     }
        //     toggleChatBox(); // Chỉ mở/đóng chat box
        // });
        
        // ==================== KẾT THÚC CẶP A×B ====================
    })();
</script>