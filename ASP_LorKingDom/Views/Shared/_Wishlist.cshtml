@using System.Security.Claims
@inject BLL.Interfaces.IWishlistService WishlistSvc

@{
	var req = Context.Request;
	var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(req.QueryString.Value ?? "");
	var wq = (string?)req.Query["wq"];
	var wl = (string?)req.Query["wl"];

	int accountId = 0;
	bool isAuth = User?.Identity?.IsAuthenticated == true &&
		int.TryParse(User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out accountId);

	var items = isAuth
		? await WishlistSvc.ListAsync(accountId, string.IsNullOrWhiteSpace(wq) ? null : wq)
		: new List<BLL.DTOs.WishlistItemDto>();
}

<link rel="stylesheet"
	  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
	  crossorigin="anonymous" referrerpolicy="no-referrer">
<link rel="stylesheet" href="~/css/wishlist.css" asp-append-version="true" />

<div class="offcanvas offcanvas-end wishlist-canvas" tabindex="-1" style="width:800px"
	 id="wishlistOffcanvas" aria-labelledby="wishlistTitle">

	<div class="offcanvas-header align-items-center">
		<h5 id="wishlistTitle" class="m-0 d-flex align-items-center gap-2">
			<i class="fa-solid fa-heart text-danger"></i>
			<span>Danh sách yêu thích (<span id="wl-count">@items.Count</span> sản phẩm)</span>
		</h5>
		<button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
	</div>

	<div class="wishlist-search px-3 pb-2">
		<form id="wl-search-form" method="get">
			<div class="input-group">
				<span class="input-group-text bg-white border-end-0">
					<i class="fa-solid fa-magnifying-glass text-secondary"></i>
				</span>
				<input type="text" name="wq" id="wl-search" class="form-control border-start-0"
					   value="@(wq ?? "")" placeholder="Tìm sản phẩm trong danh sách yêu thích...">
				<button class="btn btn-outline-secondary" type="submit">Tìm</button>
			</div>
		</form>
	</div>

	<div class="offcanvas-body d-flex flex-column pt-2">
		<div id="wl-list" class="flex-grow-1 overflow-auto">
			@if (!isAuth)
			{
				<div class="alert alert-info mx-3">
					Vui lòng <a href="/Account/Login">đăng nhập</a> để sử dụng Wishlist.
				</div>
			}
			else
			{
				@await Html.PartialAsync("_WishlistListPartial", items)
			}
		</div>

		<div class="wl-footer mt-3 px-3">
			<button id="wl-clear-all" class="btn btn-outline-danger w-100"
			@(items.Count == 0 ? "disabled" : null)>
				<i class="fa-solid fa-trash-can me-2"></i> Xóa tất cả
			</button>
		</div>
	</div>
</div>

@* ========== SCRIPT (KHÔNG DÙNG @section TRONG PARTIAL) ========== *@
<script>
	document.addEventListener('DOMContentLoaded', function () {

		// 1️⃣ Tự mở wishlist khi có wl=1
		const url = new URL(window.location.href);
		if (url.searchParams.get('wl') === '1') {
			const el = document.getElementById('wishlistOffcanvas');
			if (el && window.bootstrap) new bootstrap.Offcanvas(el).show();
		}

		// 2️⃣ Search AJAX
		const searchForm = document.getElementById('wl-search-form');
		const wlList = document.getElementById('wl-list');
		const wlCount = document.getElementById('wl-count');

		if (searchForm) {
			searchForm.addEventListener('submit', async (e) => {
				e.preventDefault();
				const params = new URLSearchParams(new FormData(searchForm));
				try {
					const resp = await fetch(`/Wishlist/ListPartial?${params}`);
					if (!resp.ok) throw new Error();
					const html = await resp.text();
					wlList.innerHTML = html;
					wlCount.textContent = wlList.querySelectorAll('.wl-card').length;
					attachWishlistEvents(); // re-bind events
				} catch {
					alert('Không thể tải danh sách yêu thích.');
				}
			});
		}

		// 3️⃣ Gắn sự kiện xóa từng sản phẩm (AJAX)
		function attachWishlistEvents() {
			document.querySelectorAll('.btn-remove').forEach(btn => {
				btn.addEventListener('click', async () => {
					const id = btn.dataset.id;
					if (!id) return;
					const fd = new FormData();
					fd.append('productId', id);
					const resp = await fetch('/Wishlist/Remove', { method: 'POST', body: fd });
					if (resp.ok) {
						btn.closest('.wl-card').remove();
						wlCount.textContent = wlList.querySelectorAll('.wl-card').length;
					} else {
						alert('Không thể xóa sản phẩm.');
					}
				});
			});
		}

		// 4️⃣ Xóa tất cả (AJAX)
		const clearAll = document.getElementById('wl-clear-all');
		if (clearAll) {
			clearAll.addEventListener('click', async () => {
				const resp = await fetch('/Wishlist/Clear', { method: 'POST' });
				if (resp.ok) {
					wlList.innerHTML = '<div class="text-muted mx-3">Danh sách yêu thích của bạn đang trống.</div>';
					wlCount.textContent = 0;
				} else {
					alert('Không thể xóa danh sách.');
				}
			});
		}

		// 5️⃣ Kích hoạt sự kiện ban đầu
		attachWishlistEvents();
	});
</script>
