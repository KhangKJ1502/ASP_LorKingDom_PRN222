@model BLL.DTOs.TransactionHistoryDto

<div class="transaction-history-container">
    <!-- Header -->
    <div class="transaction-header">
        <button type="button" data-action="back-to-wallet" class="back-btn">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            <span>Quay lại</span>
        </button>
        <h2 class="transaction-title">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
            Lịch sử giao dịch
        </h2>
    </div>

    @if (Model.Transactions.Any())
    {
        <!-- Transaction List -->
        <div class="transaction-list">
            @foreach (var txn in Model.Transactions)
            {
                <div class="transaction-item @(txn.Direction == "CR" ? "transaction-credit" : "transaction-debit")">
                    <div class="transaction-icon">
                        @if (txn.Direction == "CR")
                        {
                            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                            </svg>
                        }
                        else
                        {
                            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" />
                            </svg>
                        }
                    </div>

                    <div class="transaction-details">
                        <div class="transaction-main">
                            <h3 class="transaction-type">
                                @(txn.TxnType == "TopUp" ? "Nạp tiền" :
                                    txn.TxnType == "Payment" ? "Thanh toán" :
                                    txn.TxnType == "Refund" ? "Hoàn tiền" : txn.TxnType)
                            </h3>
                            <p class="transaction-amount @(txn.Direction == "CR" ? "amount-credit" : "amount-debit")">
                                @(txn.Direction == "CR" ? "+" : "-")@txn.Amount.ToString("N0")đ
                            </p>
                        </div>

                        @if (!string.IsNullOrEmpty(txn.Reason))
                        {
                            <p class="transaction-reason">@txn.Reason</p>
                        }

                        <div class="transaction-meta">
                            <span class="transaction-date">
                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                @txn.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </span>

                            @if (!string.IsNullOrEmpty(txn.Method))
                            {
                                <span class="transaction-method">
                                    @(txn.Method == "Bank" ? "🏦 Ngân hàng" :
                                        txn.Method == "EWallet" ? "💳 Ví điện tử" :
                                        txn.Method == "Cash" ? "💵 Tiền mặt" :
                                        txn.Method == "Wallet" ? "👛 Ví" : txn.Method)
                                </span>
                            }

                            <span class="transaction-status status-@txn.Status.ToLower()">
                                @(txn.Status == "Completed" ? "✓ Thành công" :
                                    txn.Status == "Pending" ? "⏳ Đang xử lý" :
                                    txn.Status == "Failed" ? "✗ Thất bại" :
                                    txn.Status == "Cancelled" ? "⊘ Đã hủy" : txn.Status)
                            </span>
                        </div>

                        <div class="transaction-balance">
                            <span>Số dư: @txn.BalanceBefore.ToString("N0")đ → @txn.BalanceAfter.ToString("N0")đ</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="transaction-pagination">
                <button type="button"
                        data-action="load-page"
                        data-page="@(Model.CurrentPage - 1)"
                        class="pagination-btn"
                        disabled="@(Model.CurrentPage <= 1)">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                    Trước
                </button>

                <span class="pagination-info">
                    Trang @Model.CurrentPage / @Model.TotalPages
                    <span class="pagination-total">(@Model.TotalCount giao dịch)</span>
                </span>

                <button type="button"
                        data-action="load-page"
                        data-page="@(Model.CurrentPage + 1)"
                        class="pagination-btn"
                        disabled="@(Model.CurrentPage >= Model.TotalPages)">
                    Sau
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
            </div>
        }
    }
    else
    {
        <!-- Empty State -->
        <div class="transaction-empty">
            <div class="empty-icon">📋</div>
            <h3>Chưa có giao dịch nào</h3>
            <p>Lịch sử giao dịch của bạn sẽ hiển thị ở đây</p>
            <button type="button" data-action="back-to-wallet" class="empty-back-btn">
                Quay lại ví
            </button>
        </div>
    }
</div>

<style>
    .transaction-history-container {
        padding: 1.5rem;
    }

    .transaction-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #fed7aa;
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        background: white;
        color: #f97316;
        border: 2px solid #fed7aa;
        border-radius: 0.5rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

        .back-btn:hover {
            background: #fff5ec;
            border-color: #f97316;
        }

    .transaction-title {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 1.5rem;
        font-weight: 700;
        color: #1f2937;
        margin: 0;
    }

    .transaction-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .transaction-item {
        display: flex;
        gap: 1rem;
        padding: 1.25rem;
        background: white;
        border: 2px solid #fed7aa;
        border-radius: 1rem;
        transition: all 0.3s ease;
    }

        .transaction-item:hover {
            border-color: #f97316;
            box-shadow: 0 4px 12px rgba(249, 115, 22, 0.15);
            transform: translateY(-2px);
        }

    .transaction-credit {
        border-left: 4px solid #10b981;
    }

    .transaction-debit {
        border-left: 4px solid #ef4444;
    }

    .transaction-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 3rem;
        height: 3rem;
        border-radius: 0.75rem;
        flex-shrink: 0;
    }

    .transaction-credit .transaction-icon {
        background: linear-gradient(135deg, #d1fae5, #a7f3d0);
        color: #059669;
    }

    .transaction-debit .transaction-icon {
        background: linear-gradient(135deg, #fee2e2, #fecaca);
        color: #dc2626;
    }

    .transaction-details {
        flex: 1;
    }

    .transaction-main {
        display: flex;
        justify-content: space-between;
        align-items: start;
        margin-bottom: 0.5rem;
    }

    .transaction-type {
        font-size: 1.125rem;
        font-weight: 600;
        color: #1f2937;
        margin: 0;
    }

    .transaction-amount {
        font-size: 1.25rem;
        font-weight: 700;
    }

    .amount-credit {
        color: #059669;
    }

    .amount-debit {
        color: #dc2626;
    }

    .transaction-reason {
        font-size: 0.875rem;
        color: #6b7280;
        margin: 0.25rem 0 0.75rem;
    }

    .transaction-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        font-size: 0.8125rem;
        color: #6b7280;
        margin-bottom: 0.5rem;
    }

        .transaction-meta span {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
        }

    .transaction-status {
        padding: 0.25rem 0.625rem;
        border-radius: 0.375rem;
        font-weight: 600;
    }

    .status-completed {
        background: #d1fae5;
        color: #065f46;
    }

    .status-pending {
        background: #fef3c7;
        color: #92400e;
    }

    .status-failed {
        background: #fee2e2;
        color: #991b1b;
    }

    .status-cancelled {
        background: #f3f4f6;
        color: #6b7280;
    }

    .transaction-balance {
        font-size: 0.8125rem;
        color: #9ca3af;
        padding-top: 0.5rem;
        border-top: 1px solid #f3f4f6;
    }

    .transaction-pagination {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 2rem;
        padding: 1rem;
        background: white;
        border: 2px solid #fed7aa;
        border-radius: 0.75rem;
    }

    .pagination-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.625rem 1rem;
        background: linear-gradient(135deg, #f97316, #ea580c);
        color: white;
        border: none;
        border-radius: 0.5rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

        .pagination-btn:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(249, 115, 22, 0.3);
        }

        .pagination-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

    .pagination-info {
        font-weight: 600;
        color: #1f2937;
    }

    .pagination-total {
        font-weight: 400;
        color: #6b7280;
        font-size: 0.875rem;
    }

    .transaction-empty {
        text-align: center;
        padding: 4rem 2rem;
        background: white;
        border: 2px solid #fed7aa;
        border-radius: 1rem;
    }

    .empty-icon {
        font-size: 4rem;
        margin-bottom: 1rem;
        opacity: 0.5;
    }

    .transaction-empty h3 {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 0.5rem;
    }

    .transaction-empty p {
        color: #6b7280;
        margin-bottom: 1.5rem;
    }

    .empty-back-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        background: linear-gradient(135deg, #f97316, #ea580c);
        color: white;
        border: none;
        border-radius: 0.75rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

        .empty-back-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(249, 115, 22, 0.3);
        }

    /* Responsive */
    @@media (max-width: 640px) {
        .transaction-item

    {
        flex-direction: column;
    }

    .transaction-icon {
        width: 2.5rem;
        height: 2.5rem;
    }

    .transaction-meta {
        flex-direction: column;
        gap: 0.5rem;
    }

    .pagination-info {
        font-size: 0.875rem;
    }

    .pagination-total {
        display: block;
        margin-top: 0.25rem;
    }

    }
</style>

<script>
    console.log('🔵 Transaction History loaded');

    // Handle back button
    document.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-action="back-to-wallet"]');
        if (!btn) return;

        e.preventDefault();
        console.log('🔵 Back to wallet clicked');

        // Reload wallet tab
        if (typeof window.loadTab === 'function') {
            window.loadTab('wallets');
        }
    });

    // Handle pagination
    document.addEventListener('click', async (e) => {
        const btn = e.target.closest('[data-action="load-page"]');
        if (!btn || btn.disabled) return;

        e.preventDefault();
        const page = parseInt(btn.dataset.page);
        console.log('🔵 Loading page:', page);

        const content = document.getElementById('profile-content');
        if (!content) return;

        try {
            const res = await fetch(`/Wallet/TransactionHistory?page=${page}`);
            if (!res.ok) throw new Error('Failed to load');

            const html = await res.text();
            content.innerHTML = html;

            // Re-run embedded scripts
            const tmp = document.createElement('div');
            tmp.innerHTML = html;
            const scripts = tmp.querySelectorAll('script');
            scripts.forEach(oldScript => {
                const s = document.createElement('script');
                for (const attr of oldScript.attributes) {
                    s.setAttribute(attr.name, attr.value);
                }
                s.textContent = oldScript.textContent;
                document.body.appendChild(s);
            });

            // Scroll to top
            content.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } catch (err) {
            console.error('Error loading page:', err);
        }
    });
</script>