</style>

<script>
		(function initializeWalletModule() {
			console.log('🔵 Initializing Wallet Module...');

			if (window.__walletModuleInitialized) {
				console.log('⚠️ Wallet module already initialized, skipping...');
				return;
			}
			window.__walletModuleInitialized = true;

			function showToast(type, title, message, timeout = 2800) {
				const wrap = document.getElementById('toast-wrap');
				if (!wrap) return;
				const el = document.createElement('div');
				el.className = `toast ${type}`;
				el.innerHTML = `
					<span class="badge"></span>
					<div class="content">
						<div class="title">${title || (type === 'success' ? 'Thành công' : type === 'error' ? 'Lỗi' : 'Thông báo')}</div>
						${message ? `<div class="msg">${message}</div>` : ''}
					</div>
					<button class="close" aria-label="Close">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
					</button>
				`;
				wrap.appendChild(el);
				requestAnimationFrame(() => el.classList.add('show'));
				const remove = () => { el.classList.remove('show'); setTimeout(() => el.remove(), 180); };
				const t = setTimeout(remove, timeout);
				el.querySelector('.close').addEventListener('click', () => { clearTimeout(t); remove(); });
			}

			function setBtnLoading(btn, isLoading, iconId = 'iconCreateWallet') {
				if (!btn) return;
				btn.disabled = !!isLoading;
				const icon = btn.querySelector(`#${iconId}`);
				if (isLoading) {
					btn.classList.add('cursor-wait', 'opacity-90');
					if (icon) {
						icon.setAttribute('viewBox', '0 0 24 24');
						icon.innerHTML = '<circle cx="12" cy="12" r="10" stroke-width="2" stroke="currentColor" fill="none"></circle>';
						icon.style.animation = 'spin 0.8s linear infinite';
					}
				} else {
					btn.classList.remove('cursor-wait', 'opacity-90');
					if (icon) {
						icon.style.animation = '';
						if (iconId === 'iconTopUp') {
							icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />';
						} else {
							icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />';
						}
					}
				}
			}

			console.log('🔵 Setting up wallet event delegation...');

			document.body.addEventListener("click", handleWalletClick, true);
			document.body.addEventListener("submit", handleWalletSubmit, true);

			function handleWalletClick(e) {
		// === QUICK AMOUNT ===
		if (e.target.closest('.quick-amount-btn')) {
			const btn = e.target.closest('.quick-amount-btn');
			e.preventDefault();
			e.stopPropagation();
			const amount = btn.dataset.amount;
			const input = document.getElementById("topupAmount");
			if (input) input.value = amount;
			return;
		}

		const btn = e.target.closest("[data-action]");
		if (!btn) return;

		const action = btn.dataset.action;

		// === DANH SÁCH ACTION CỦA WALLET ===
		const walletActions = [
			'show-create-wallet',
			'hide-create-wallet',
			'show-topup-modal',
			'close-topup-modal',
			'view-transactions'
		];

		// === DANH SÁCH ACTION CỦA TRANSACTION HISTORY (BỎ QUA HOÀN TOÀN) ===
		const transactionActions = ['load-page', 'back-to-wallet'];

		// === XỬ LÝ: Nếu là action của Transaction History → BỎ QUA, KHÔNG CHẠM VÀO ===
		if (transactionActions.includes(action)) {
			console.log('Transaction action bypassed:', action);
			// KHÔNG preventDefault, KHÔNG stopPropagation → để script kia xử lý
			return;
		}

		// === Nếu là action của Wallet → xử lý bình thường ===
		if (!walletActions.includes(action)) return;

		e.preventDefault();
		e.stopPropagation();
		console.log('Wallet action:', action);

		// === XỬ LÝ CÁC ACTION ===
		 if (action === "show-create-wallet") {
			const formWrap = document.getElementById("create-wallet-form");
			const firstBlock = document.querySelector("#wallet-content > div");
			if (formWrap) formWrap.classList.add("show");     // hiển thị form (display:block theo CSS)
			if (firstBlock) firstBlock.classList.add("hidden"); // ẩn khối đầu (no-wallet/wallet card)
		}

		if (action === "hide-create-wallet") {
			const formWrap = document.getElementById("create-wallet-form");
			const firstBlock = document.querySelector("#wallet-content > div");
			if (formWrap) formWrap.classList.remove("show");  // ẩn form (display:none mặc định)
			if (firstBlock) firstBlock.classList.remove("hidden");
		}


		if (action === "show-topup-modal") {
			const modal = document.getElementById("topup-modal");
			if (modal) {
				modal.classList.add("show");
				document.body.style.overflow = 'hidden';
				setTimeout(() => document.getElementById("topupAmount")?.focus(), 100);
			}
		}

		if (action === "close-topup-modal") {
			const modal = document.getElementById("topup-modal");
			if (modal) {
				modal.classList.remove("show");
				document.body.style.overflow = '';
				document.getElementById("topupForm")?.reset();
			}
		}

		if (action === "view-transactions") {
			const content = document.getElementById("profile-content");
			if (!content) return;

			window.__transactionHistoryInitialized = false;
			content.innerHTML = `
				<div style="text-align:center;padding:3rem">
					<div style="display:inline-block;width:3rem;height:3rem;border:4px solid #fed7aa;border-top-color:#f97316;border-radius:50%;animation:spin 1s linear infinite"></div>
					<p style="margin-top:1rem;color:#6b7280">Đang tải lịch sử giao dịch...</p>
				</div>
			`;

			fetch('/Wallet/TransactionHistory')
				.then(r => r.ok ? r.text() : Promise.reject(r.status))
				.then(html => content.innerHTML = html)
				.catch(() => {
					content.innerHTML = `<div style="text-align:center;padding:3rem"><p style="color:#dc2626">Không thể tải</p></div>`;
				});
		}
	}






			async function handleWalletSubmit(e) {
				const form = e.target;

				if (!form || (form.id !== "walletForm" && form.id !== "topupForm")) {
					return;
				}

				console.log('🔵 Wallet form submitted:', form.id);
				e.preventDefault();
				e.stopPropagation();

				if (form.id === "walletForm") {
					const btn = document.getElementById('btnCreateWallet');
					setBtnLoading(btn, true, 'iconCreateWallet');

					const formData = new FormData(form);
					const data = { WalletName: formData.get("WalletName") || null };

					const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value ||
						document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";

					try {
						const res = await fetch("/Wallet/Create", {
							method: "POST",
							headers: {
								"Content-Type": "application/json",
								"RequestVerificationToken": token
							},
							credentials: "same-origin",
							body: JSON.stringify(data)
						});

						if (res.status === 401) {
							window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(location.pathname + location.search);
							return;
						}

						const result = await res.json().catch(() => null);
						if (!result) {
							showToast('error', 'Lỗi dữ liệu', 'Máy chủ không trả về JSON hợp lệ.');
							return;
						}

						if (result.success) {
							const host = document.getElementById("profile-content");
							host.innerHTML = result.html;

							window.__walletModuleInitialized = false;
							const tmp = document.createElement("div");
							tmp.innerHTML = result.html;
							const scripts = tmp.querySelectorAll("script");
							scripts.forEach(oldScript => {
								const s = document.createElement("script");
								for (const attr of oldScript.attributes) s.setAttribute(attr.name, attr.value);
								s.textContent = oldScript.textContent;
								document.body.appendChild(s);
							});

							showToast('success', 'Tạo ví thành công', 'Ví của bạn đã sẵn sàng!');
						} else {
							showToast('error', 'Không thể tạo ví', result.message || 'Vui lòng thử lại.');
						}
					} catch (err) {
						console.error(err);
						showToast('error', 'Lỗi hệ thống', 'Có lỗi xảy ra, vui lòng thử lại.');
					} finally {
						setBtnLoading(btn, false, 'iconCreateWallet');
					}
				}

				if (form.id === "topupForm") {
					console.log('🔵 Processing top-up form...');

					const btn = document.getElementById('btnTopUp');
					setBtnLoading(btn, true, 'iconTopUp');

					const formData = new FormData(form);
					const amount = parseFloat(formData.get("Amount"));

					console.log('💰 Amount to top up:', amount);

					if (!amount || amount < 10000) {
						showToast('error', 'Số tiền không hợp lệ', 'Số tiền nạp tối thiểu là 10,000đ');
						setBtnLoading(btn, false, 'iconTopUp');
						return;
					}

					if (amount > 100000000) {
						showToast('error', 'Số tiền không hợp lệ', 'Số tiền nạp tối đa là 100,000,000đ');
						setBtnLoading(btn, false, 'iconTopUp');
						return;
					}

					const data = {
						Amount: amount,
						Reason: formData.get("Reason") || null,
						Method: null
					};

					const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value ||
						document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";

					console.log('🔑 Token found:', !!token);
					console.log('📦 Data to send:', data);

					try {
						console.log('📡 Sending request to /Wallet/TopUp...');

						const res = await fetch("/Wallet/TopUp", {
							method: "POST",
							headers: {
								"Content-Type": "application/json",
								"RequestVerificationToken": token
							},
							credentials: "same-origin",
							body: JSON.stringify(data)
						});

						console.log('📥 Response status:', res.status);

						if (res.status === 401) {
							window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(location.pathname + location.search);
							return;
						}

						const result = await res.json().catch(() => null);
						console.log('📋 Result:', result);

						if (!result) {
							showToast('error', 'Lỗi dữ liệu', 'Máy chủ không trả về JSON hợp lệ.');
							return;
						}

						if (result.success) {
							console.log('✅ Top-up successful!');

							const host = document.getElementById("profile-content");
							if (host && result.html) {
								host.innerHTML = result.html;

								window.__walletModuleInitialized = false;
								const tmp = document.createElement("div");
								tmp.innerHTML = result.html;
								const scripts = tmp.querySelectorAll("script");
								scripts.forEach(oldScript => {
									const s = document.createElement("script");
									for (const attr of oldScript.attributes) s.setAttribute(attr.name, attr.value);
									s.textContent = oldScript.textContent;
									document.body.appendChild(s);
								});
							}

							const modal = document.getElementById("topup-modal");
							if (modal) {
								modal.classList.remove("show");
								document.body.style.overflow = '';
							}
							form.reset();

							showToast('success', 'Nạp tiền thành công',
								`Đã nạp ${amount.toLocaleString('vi-VN')}đ vào ví. Số dư mới: ${result.newBalance?.toLocaleString('vi-VN')}đ`);
						} else {
							console.error('❌ Top-up failed:', result.message);
							showToast('error', 'Nạp tiền thất bại', result.message || 'Vui lòng thử lại.');
						}
					} catch (err) {
						console.error('❌ Top-up error:', err);
						showToast('error', 'Lỗi hệ thống', 'Có lỗi xảy ra, vui lòng thử lại.');
					} finally {
						setBtnLoading(btn, false, 'iconTopUp');
					}
				}
			}

			const topupModal = document.getElementById("topup-modal");
			if (topupModal) {
				topupModal.addEventListener("click", function (e) {
					if (e.target.id === "topup-modal") {
						this.classList.remove("show");
						document.body.style.overflow = '';
						const form = document.getElementById("topupForm");
						if (form) form.reset();
					}
				});
			}

			document.addEventListener("keydown", function (e) {
				if (e.key === "Escape") {
					const modal = document.getElementById("topup-modal");
					if (modal && modal.classList.contains("show")) {
						modal.classList.remove("show");
						document.body.style.overflow = '';
						const form = document.getElementById("topupForm");
						if (form) form.reset();
					}
				}
			});

			console.log('✅ Wallet module initialized successfully');
		})();
</script>