@model BLL.DTOs.PagedResult<BLL.DTOs.UserNotificationDto>
@{
    ViewData["Title"] = "Thông Báo Của Tôi";
    Layout = "_Layout";

    // Lấy thông tin tab active
    bool? currentFilter = ViewBag.CurrentFilter as bool?;

    // Lấy số badge global từ ViewBag
    var totalAll = ViewBag.TotalAll is int ? (int)ViewBag.TotalAll : 0;
    var totalUnread = ViewBag.TotalUnread is int ? (int)ViewBag.TotalUnread : 0;
    var totalRead = ViewBag.TotalRead is int ? (int)ViewBag.TotalRead : 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/notifications.css" asp-append-version="true" />
}

<div class="notification-page">
    <div class="notification-container">

        <!-- Filter / actions -->
        <div class="filter-section">
            <div class="filter-tabs">

                <div class="filter-left">
                    <a href="@Url.Action("Index", new { page = 1, pageSize = Model.PageSize })"
                       class="filter-tab @(currentFilter == null ? "active" : "")">
                        <i class="fa-solid fa-list"></i>
                        <span>Tất cả</span>
                        <span class="tab-count">@totalAll</span>
                    </a>

                    <a href="@Url.Action("Index", new { isRead = false, page = 1, pageSize = Model.PageSize })"
                       class="filter-tab @(currentFilter == false ? "active" : "")">
                        <i class="fa-solid fa-envelope"></i>
                        <span>Chưa đọc</span>
                        <span class="tab-count">@totalUnread</span>
                    </a>

                    <a href="@Url.Action("Index", new { isRead = true, page = 1, pageSize = Model.PageSize })"
                       class="filter-tab @(currentFilter == true ? "active" : "")">
                        <i class="fa-solid fa-envelope-open"></i>
                        <span>Đã đọc</span>
                        <span class="tab-count">@totalRead</span>
                    </a>
                </div>

                <div class="filter-right">
                    <form method="post"
                          asp-action="MarkAllRead"
                          asp-controller="MyNotifications"
                          style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                class="mark-all-btn"
                                title="Đánh dấu tất cả là đã đọc"
                                @(totalUnread == 0 ? "disabled" : null)>
                            <i class="fa-solid fa-check-double"></i>
                            Đánh dấu tất cả đã đọc
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Notifications list -->
        <div class="notifications-wrapper">
            @if (Model.Items != null && Model.Items.Any())
            {
                <div class="notification-list">
                    @foreach (var notification in Model.Items)
                    {
                        var lower = (notification.Title ?? "").ToLowerInvariant();
                        var iconType =
                        lower.Contains("thành công") || lower.Contains("success") ? "success" :
                        lower.Contains("cảnh báo") || lower.Contains("warning") ? "warning" :
                        lower.Contains("lỗi") || lower.Contains("error") ? "error" :
                        lower.Contains("khuyến mãi") || lower.Contains("promo") ? "promo" :
                        "info";

                        var iconClass = iconType switch
                        {
                            "success" => "fa-circle-check",
                            "warning" => "fa-triangle-exclamation",
                            "error" => "fa-circle-xmark",
                            "promo" => "fa-gift",
                            _ => "fa-bell"
                        };

                        <div class="notification-card @(notification.IsRead ? "read" : "unread")">
                            <div class="notification-content">
                                <div class="notification-icon @iconType">
                                    <i class="fa-solid @iconClass"></i>
                                </div>

                                <div class="notification-body">
                                    <div class="notification-header">
                                        <h3 class="notification-title">@notification.Title</h3>
                                        @if (!notification.IsRead)
                                        {
                                            <span class="new-badge">Mới</span>
                                        }
                                    </div>

                                    <p class="notification-message">@notification.Message</p>

                                    <div class="notification-meta">
                                        <span class="meta-item">
                                            <i class="fa-regular fa-clock"></i>
                                            @GetTimeAgo(notification.ScheduledAt)
                                        </span>

                                        @if (notification.DeliveredAt.HasValue)
                                        {
                                            <span class="meta-item">
                                                <i class="fa-solid fa-paper-plane"></i>
                                                @notification.DeliveredAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                            </span>
                                        }

                                        @if (notification.ReadAt.HasValue)
                                        {
                                            <span class="meta-item">
                                                <i class="fa-solid fa-eye"></i>
                                                Đã đọc
                                            </span>
                                        }
                                    </div>
                                </div>

                                @if (!notification.IsRead)
                                {
                                    <div class="notification-actions">
                                        <form method="post"
                                              asp-action="MarkRead"
                                              asp-controller="MyNotifications">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@notification.UserNotificationId" />
                                            <input type="hidden" name="returnFilter" value="@(currentFilter?.ToString().ToLower() ?? "")" />
                                            <button type="submit"
                                                    class="action-btn mark-read-btn"
                                                    title="Đánh dấu đã đọc">
                                                <i class="fa-solid fa-check"></i>
                                                Đã đọc
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.Total > Model.PageSize)
                {
                    var totalPages = (int)Math.Ceiling((double)Model.Total / Model.PageSize);
                    var currentPage = Model.Page;
                    var isReadParam = currentFilter?.ToString().ToLower();

                    <div class="pagination-wrapper">
                        <ul class="pagination">
                            @if (currentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       href="@Url.Action("Index", new { isRead = isReadParam, page = currentPage - 1, pageSize = Model.PageSize })">
                                        <i class="fa-solid fa-chevron-left"></i>
                                    </a>
                                </li>
                            }

                            @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link"
                                       href="@Url.Action("Index", new { isRead = isReadParam, page = i, pageSize = Model.PageSize })">@i</a>
                                </li>
                            }

                            @if (currentPage < totalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       href="@Url.Action("Index", new { isRead = isReadParam, page = currentPage + 1, pageSize = Model.PageSize })">
                                        <i class="fa-solid fa-chevron-right"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="fa-regular fa-bell-slash"></i>
                    </div>
                    <h3 class="empty-title">Không có thông báo</h3>
                    <p class="empty-text">Bạn chưa có thông báo nào. Hãy quay lại sau nhé!</p>
                </div>
            }
        </div>
    </div>
</div>

@functions {
    string GetTimeAgo(DateTime dateTime)
    {
        var localTime = dateTime.ToLocalTime();
        var timeSpan = DateTime.Now - localTime;

        if (timeSpan.TotalMinutes < 1) return "Vừa xong";
        if (timeSpan.TotalMinutes < 60) return $"{(int)timeSpan.TotalMinutes} phút trước";
        if (timeSpan.TotalHours < 24) return $"{(int)timeSpan.TotalHours} giờ trước";
        if (timeSpan.TotalDays < 7) return $"{(int)timeSpan.TotalDays} ngày trước";
        if (timeSpan.TotalDays < 30) return $"{(int)(timeSpan.TotalDays / 7)} tuần trước";
        if (timeSpan.TotalDays < 365) return $"{(int)(timeSpan.TotalDays / 30)} tháng trước";

        return localTime.ToString("dd/MM/yyyy");
    }
}

@section Scripts {
    <script>
        // Animation on load
        document.addEventListener('DOMContentLoaded', function () {
            const cards = document.querySelectorAll('.notification-card');
            cards.forEach((card, index) => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(20px)';

                setTimeout(() => {
                    card.style.transition = 'all 0.5s ease';
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                }, index * 100);
            });

            // Handle mark read buttons with better UX
            const markReadForms = document.querySelectorAll('form[asp-action="MarkRead"]');
            markReadForms.forEach(form => {
                form.addEventListener('submit', function(e) {
                    const button = this.querySelector('.mark-read-btn');
                    if (button) {
                        button.disabled = true;
                        button.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang xử lý...';
                    }
                });
            });

            // Handle mark all read with better UX
            const markAllForm = document.querySelector('form[asp-action="MarkAllRead"]');
            if (markAllForm) {
                markAllForm.addEventListener('submit', function(e) {
                    const button = this.querySelector('.mark-all-btn');
                    if (button && !button.disabled) {
                        button.disabled = true;
                        button.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang xử lý...';
                    }
                });
            }
        });

        // Auto refresh mỗi 60s cho tab "Tất cả" hoặc "Chưa đọc" (tăng từ 30s lên 60s để giảm load)
        const isReadParam = new URLSearchParams(window.location.search).get('isRead');
        if (isReadParam !== 'true') {
            let refreshInterval = setInterval(() => {
                if (!document.hidden) {
                    // Soft reload - check if there are new notifications first
                    fetch('/MyNotifications/CheckNewNotifications?lastCheck=' + new Date().toISOString())
                        .then(res => res.json())
                        .then(data => {
                            if (data.success && data.hasNew) {
                                // Show notification and reload
                                const currentPage = new URLSearchParams(window.location.search).get('page') || '1';
                                if (currentPage === '1') {
                                    location.reload();
                                }
                            }
                        })
                        .catch(err => console.error('Check new notifications error:', err));
                }
            }, 60000);

            document.addEventListener('visibilitychange', function () {
                if (document.hidden) {
                    clearInterval(refreshInterval);
                } else {
                    // Refresh when tab becomes visible again
                    refreshInterval = setInterval(() => {
                        if (!document.hidden) {
                            fetch('/MyNotifications/CheckNewNotifications?lastCheck=' + new Date().toISOString())
                                .then(res => res.json())
                                .then(data => {
                                    if (data.success && data.hasNew) {
                                        const currentPage = new URLSearchParams(window.location.search).get('page') || '1';
                                        if (currentPage === '1') {
                                            location.reload();
                                        }
                                    }
                                })
                                .catch(err => console.error('Check new notifications error:', err));
                        }
                    }, 60000);
                }
            });
        }
    </script>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          crossorigin="anonymous"
          referrerpolicy="no-referrer" />
}
