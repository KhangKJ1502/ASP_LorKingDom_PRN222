@{
    ViewData["Title"] = "Xác thực OTP - Quên mật khẩu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <style>
        :root {
            --primary-color: #667eea;
            --bg-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: var(--bg-gradient);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .verify-container {
            background: white;
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            max-width: 500px;
            width: 100%;
            padding: 48px 40px;
        }

        .verify-header {
            text-align: center;
            margin-bottom: 35px;
        }

        .verify-icon {
            width: 80px;
            height: 80px;
            background: var(--bg-gradient);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            box-shadow: 0 8px 20px rgba(103, 126, 234, 0.3);
        }

        .verify-icon i {
            font-size: 36px;
            color: white;
        }

        .verify-title {
            font-size: 28px;
            font-weight: 700;
            color: #1f2937;
            margin-bottom: 8px;
        }

        .verify-subtitle {
            font-size: 14px;
            color: #6b7280;
            margin-bottom: 0;
        }

        .otp-group {
            display: flex;
            justify-content: space-between;
            gap: 8px;
            margin-bottom: 24px;
        }

        .otp-input {
            width: 60px !important;
            height: 60px;
            font-size: 24px !important;
            font-weight: 600 !important;
            text-align: center;
            border: 2px solid #e5e7eb !important;
            border-radius: 12px;
            transition: all 0.3s ease;
        }

        .otp-input:focus {
            border-color: var(--primary-color) !important;
            box-shadow: 0 0 0 3px rgba(103, 126, 234, 0.1) !important;
        }

        .btn-verify {
            width: 100%;
            padding: 14px;
            background: var(--bg-gradient);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 12px rgba(103, 126, 234, 0.4);
            margin-bottom: 16px;
        }

        .btn-verify:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(103, 126, 234, 0.5);
        }

        .btn-resend {
            background: none;
            color: var(--primary-color);
            border: none;
            padding: 0;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            text-decoration: none;
            transition: color 0.3s ease;
            display: block;
            width: 100%;
            text-align: center;
        }

        .btn-resend:hover:not(:disabled) {
            color: #764ba2;
        }

        .btn-resend:disabled {
            color: #9ca3af;
            cursor: not-allowed;
        }

        .back-link {
            text-align: center;
            margin-top: 24px;
        }

        .back-link a {
            color: #6b7280;
            text-decoration: none;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: color 0.3s ease;
        }

        .back-link a:hover {
            color: var(--primary-color);
        }
    </style>
</head>

<body>
    <div class="verify-container">
        <div class="verify-header">
            <div class="verify-icon">
                <i class="fas fa-envelope-open"></i>
            </div>
            <h1 class="verify-title">Xác minh Email</h1>
            <p class="verify-subtitle">
                Chúng tôi đã gửi mã OTP đến <strong>@ViewBag.Email</strong>.<br />
                Vui lòng nhập mã bên dưới để tiếp tục.
            </p>
        </div>

        <!-- Form VERIFY -->
        <form id="verifyForgotPasswordOtpForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="email" value="@ViewBag.Email" />
            <input type="hidden" name="otpCode" id="otpCode" />

            <div class="otp-group">
                <input type="text" maxlength="1" class="otp-input form-control" autocomplete="one-time-code" required />
                <input type="text" maxlength="1" class="otp-input form-control" required />
                <input type="text" maxlength="1" class="otp-input form-control" required />
                <input type="text" maxlength="1" class="otp-input form-control" required />
                <input type="text" maxlength="1" class="otp-input form-control" required />
                <input type="text" maxlength="1" class="otp-input form-control" required />
            </div>

            <button type="submit" class="btn-verify">
                <span class="spinner-border spinner-border-sm me-2 d-none" id="verifySpinner" role="status"
                    aria-hidden="true"></span>
                <span id="verifyBtnText">Xác nhận</span>
            </button>
        </form>

        <!-- Form RESEND -->
        <form id="resendForgotPasswordOtpForm" class="text-center">
            @Html.AntiForgeryToken()
            <input type="hidden" name="email" value="@ViewBag.Email" />
            <button type="button" class="btn-resend" id="resendBtn" disabled>
                Gửi lại mã sau <span id="countdown">30</span>s
            </button>
        </form>

        <div class="back-link">
            <a href="@Url.Action("Login", "AdminAuth")">
                <i class="fas fa-arrow-left"></i>
                <span>Quay lại đăng nhập</span>
            </a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // OTP Input Navigation
        const otpInputs = document.querySelectorAll('.otp-input');
        const otpCodeInput = document.getElementById('otpCode');

        const updateOtpCode = () => {
            otpCodeInput.value = Array.from(otpInputs).map(i => i.value).join('');
        };

        otpInputs.forEach((input, index) => {
            input.addEventListener('input', (e) => {
                if (e.target.value.length === 1 && index < otpInputs.length - 1) {
                    otpInputs[index + 1].focus();
                }
                updateOtpCode();
            });

            input.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && !input.value && index > 0) {
                    otpInputs[index - 1].focus();
                }
            });
        });

        // Countdown Timer
        const email = '@ViewBag.Email';
        const key = `otp_resend_admin_forgot_until:${email}`;
        let until = parseInt(localStorage.getItem(key) || "0", 10);
        const now = Date.now();
        if (!until || now >= until) {
            until = now + 30_000;
            localStorage.setItem(key, String(until));
        }

        const resendBtn = document.getElementById('resendBtn');
        const countdownEl = document.getElementById('countdown');

        function tick() {
            const remain = Math.max(0, until - Date.now());
            const s = Math.ceil(remain / 1000);
            countdownEl.textContent = s;
            if (remain <= 0) {
                resendBtn.removeAttribute("disabled");
                resendBtn.textContent = "Gửi lại mã OTP";
                return;
            }
            requestAnimationFrame(tick);
        }
        tick();

        // Verify OTP Form
        $('#verifyForgotPasswordOtpForm').on('submit', function (e) {
            e.preventDefault();

            const form = $(this);
            const spinner = $('#verifySpinner');
            const btnText = $('#verifyBtnText');

            spinner.removeClass('d-none');
            btnText.text('Đang xác minh...');

            $.ajax({
                url: '@Url.Action("VerifyForgotPasswordOtpConfirm", "AdminAuth")',
                type: 'POST',
                data: form.serialize(),
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (data) {
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Thành công',
                            text: data.message,
                            confirmButtonColor: '#667eea',
                            allowOutsideClick: false
                        }).then(() => {
                            window.location.href = data.redirectUrl;
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Xác minh thất bại',
                            text: data.message,
                            confirmButtonColor: '#dc2626'
                        });
                    }
                },
                error: function (xhr) {
                    console.error(xhr);
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi',
                        text: 'Đã xảy ra lỗi khi xác minh OTP',
                        confirmButtonColor: '#dc2626'
                    });
                },
                complete: function () {
                    spinner.addClass('d-none');
                    btnText.text('Xác nhận');
                }
            });
        });


        // Resend OTP Form
        $('#resendForgotPasswordOtpForm').on('submit', function (e) {
            e.preventDefault();

            const form = $(this);
            const resendBtn = $('#resendBtn');
            resendBtn.prop('disabled', true);

            $.ajax({
                url: '@Url.Action("ResendForgotPasswordOtp", "AdminAuth")',
                type: 'POST',
                data: form.serialize(),
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (data) {
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Thành công',
                            text: data.message,
                            confirmButtonColor: '#667eea',
                            timer: 1500,
                            showConfirmButton: false
                        });

                        // ✅ Reset countdown timer
                        until = Date.now() + 30_000;
                        localStorage.setItem(key, String(until));
                        resendBtn.html('Gửi lại mã sau <span id="countdown">30</span>s');
                        resendBtn.attr('disabled', true);
                        tick();
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi',
                            text: data.message,
                            confirmButtonColor: '#dc2626'
                        });
                        resendBtn.prop('disabled', false);
                    }
                },
                error: function (xhr) {
                    console.error(xhr);
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi',
                        text: 'Đã xảy ra lỗi khi gửi lại OTP',
                        confirmButtonColor: '#dc2626'
                    });
                    resendBtn.prop('disabled', false);
                }
            });
        });

    </script>
</body>

</html>