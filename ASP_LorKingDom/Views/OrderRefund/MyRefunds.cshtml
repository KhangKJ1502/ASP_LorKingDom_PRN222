@model List<BLL.DTOs.CustomerRefundStatusDto>
@{
    ViewData["Title"] = "Lịch sử hoàn tiền";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    .refund-container {
        max-width: 1200px;
        margin: 2rem auto;
        padding: 0 1rem;
    }

    .refund-header {
        background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
        color: white;
        padding: 2rem;
        border-radius: 1rem;
        margin-bottom: 2rem;
        box-shadow: 0 10px 30px rgba(249, 115, 22, 0.3);
    }

    .refund-card {
        background: white;
        border: 2px solid #fed7aa;
        border-radius: 1rem;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        transition: all 0.3s ease;
    }

    .refund-card:hover {
        border-color: #f97316;
        box-shadow: 0 8px 20px rgba(249, 115, 22, 0.15);
        transform: translateY(-2px);
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        border-radius: 9999px;
        font-size: 0.875rem;
        font-weight: 600;
    }

    .refund-requested { background: #fef3c7; color: #92400e; }
    .refund-approved { background: #dbeafe; color: #1e40af; }
    .refund-refunded { background: #d1fae5; color: #065f46; }
    .refund-rejected { background: #fee2e2; color: #991b1b; }
    .refund-processing { background: #e0e7ff; color: #3730a3; }
    .refund-cancelled { background: #f3f4f6; color: #6b7280; }

    .timeline {
        position: relative;
        padding-left: 2rem;
        margin-top: 1rem;
    }

    .timeline::before {
        content: '';
        position: absolute;
        left: 0.5rem;
        top: 0;
        bottom: 0;
        width: 2px;
        background: #e5e7eb;
    }

    .timeline-item {
        position: relative;
        padding-bottom: 1.5rem;
    }

    .timeline-item::before {
        content: '';
        position: absolute;
        left: -1.65rem;
        top: 0.25rem;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #10b981;
        border: 2px solid white;
        box-shadow: 0 0 0 2px #10b981;
    }

    .timeline-item:last-child {
        padding-bottom: 0;
    }

    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        background: white;
        border: 2px dashed #fed7aa;
        border-radius: 1rem;
    }

    .btn-detail {
        background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
        color: white;
        padding: 0.5rem 1.5rem;
        border-radius: 0.5rem;
        border: none;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
    }

    .btn-detail:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(249, 115, 22, 0.3);
        color: white;
    }
</style>

<div class="refund-container">
    <div class="refund-header">
        <h1 class="mb-0">
            <i class="fas fa-history me-2"></i>
            Lịch sử hoàn tiền
        </h1>
        <p class="mb-0 mt-2 opacity-90">Theo dõi trạng thái yêu cầu hoàn tiền của bạn</p>
    </div>

    @if (Model.Any())
    {
        @foreach (var refund in Model)
        {
            <div class="refund-card">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h5 class="mb-1">
                            <i class="fas fa-receipt me-2 text-orange-500"></i>
                            @refund.OrderCode
                        </h5>
                        <p class="text-muted mb-0">
                            <small>
                                Mã hoàn tiền: #@refund.RefundId.ToString().PadLeft(6, '0')
                            </small>
                        </p>
                    </div>
                    <span class="status-badge @refund.StatusBadgeClass">
                        @refund.RefundStatusDisplay
                    </span>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <p class="mb-1"><strong>Số tiền hoàn:</strong></p>
                        <p class="text-danger fw-bold mb-0" style="font-size: 1.25rem;">
                            @refund.RefundAmount.ToString("N0")đ
                        </p>
                    </div>
                    <div class="col-md-4">
                        <p class="mb-1"><strong>Phương thức:</strong></p>
                        <p class="mb-0">@refund.RefundMode</p>
                    </div>
                    <div class="col-md-4">
                        <p class="mb-1"><strong>Ngày gửi:</strong></p>
                        <p class="mb-0">@refund.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(refund.Reason))
                {
                    <div class="alert alert-light mb-3">
                        <strong>Lý do:</strong> @refund.Reason
                    </div>
                }

                <div class="timeline">
                    @foreach (var step in refund.Timeline)
                    {
                        <div class="timeline-item">
                            <strong>@step.Label</strong>
                            <p class="text-muted small mb-0">@step.At.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                    }
                </div>

                <div class="text-end mt-3">
                    <a href="@Url.Action("RefundDetail", new { id = refund.RefundId })" class="btn-detail">
                        <i class="fas fa-eye me-2"></i>Xem chi tiết
                    </a>
                </div>
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <div style="font-size: 4rem; opacity: 0.5;">📋</div>
            <h3 class="mt-3">Chưa có yêu cầu hoàn tiền nào</h3>
            <p class="text-muted">Các yêu cầu hoàn tiền của bạn sẽ hiển thị ở đây</p>
            <a href="@Url.Action("OrderHistory", "Order")" class="btn-detail mt-3">
                <i class="fas fa-arrow-left me-2"></i>Quay lại đơn hàng
            </a>
        </div>
    }
</div>