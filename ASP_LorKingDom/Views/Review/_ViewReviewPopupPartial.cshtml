@model BLL.DTOs.ReviewProductDto

<div class="p-4">
    <!-- Header: Product + Rating -->
    <div class="d-flex gap-3 mb-4 align-items-start">
        <img src="@(Model.ImageUrls?.FirstOrDefault() ?? "/images/placeholder.png")"
             alt="@Model.ProductName"
             class="rounded shadow-sm"
             style="width: 90px; height: 90px; object-fit: cover; border: 2px solid #fed7aa;" />

        <div class="flex-grow-1">
            <h5 class="fw-bold mb-1">@Model.ProductName</h5>
            <div class="d-flex align-items-center gap-1 text-warning mb-2">
                @for (int i = 1; i <= 5; i++)
                {
                    <i class="@(i <= Model.Rating ? "fas" : "far") fa-star"></i>
                }
            </div>
            <small class="text-muted">
                <i class="far fa-calendar-alt me-1"></i>
                @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
            </small>
            @if (Model.IsVerifiedPurchase)
            {
                <span class="badge bg-success ms-2" style="font-size: 0.7rem;">
                    <i class="fas fa-check-circle"></i> Đã mua hàng
                </span>
            }
        </div>
    </div>

    <!-- Comment -->
    <div class="bg-light p-3 rounded mb-3" style="line-height: 1.7; border-left: 4px solid #f97316;">
        @Model.Comment
    </div>

    <!-- Images -->
    @if (Model.ImageUrls?.Any() == true)
    {
        <div class="d-flex gap-2 flex-wrap mb-3">
            @foreach (var img in Model.ImageUrls)
            {
                <a href="@img" target="_blank">
                    <img src="@img"
                         class="rounded shadow-sm"
                         style="width: 80px; height: 80px; object-fit: cover; cursor: zoom-in; border: 2px solid #fed7aa;"
                         alt="Review image" />
                </a>
            }
        </div>
    }

    <!-- Shop Reply -->
    @if (Model.Replies?.Any() == true)
    {
        <div class="bg-orange-50 p-3 rounded border-start border-orange border-3">
            <p class="fw-bold text-orange mb-2">
                <i class="fas fa-reply me-1"></i> Phản hồi từ cửa hàng
            </p>
            @foreach (var reply in Model.Replies)
            {
                <div class="small">
                    <p class="mb-1">@reply.Content</p>
                    <span class="text-muted">@reply.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            }
        </div>
    }
</div>