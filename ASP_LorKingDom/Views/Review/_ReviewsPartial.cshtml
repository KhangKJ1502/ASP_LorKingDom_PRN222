@model BLL.DTOs.ReviewsViewModel

<style>
    .reviews-container {
        padding: 2rem;
    }

    .reviews-tabs {
        display: flex;
        gap: 0.5rem;
        background: white;
        border: 2px solid #fed7aa;
        border-radius: 1rem;
        padding: 0.5rem;
        margin-bottom: 1.5rem;
    }

    .review-tab {
        padding: 0.625rem 1.25rem;
        border-radius: 0.75rem;
        border: none;
        background: transparent;
        color: #6b7280;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 0.875rem;
        flex: 1;
    }

    .review-tab:hover {
        background: #fff5ec;
        color: #f97316;
    }

    .review-tab.active {
        background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
        color: white;
        box-shadow: 0 4px 10px rgba(249, 115, 22, 0.3);
    }

    .review-content {
        display: none;
    }

    .review-content.active {
        display: block;
    }

    .pending-review-card {
        background: white;
        border: 2px solid #fed7aa;
        border-radius: 1rem;
        padding: 1.5rem;
        margin-bottom: 1rem;
        transition: all 0.3s ease;
        display: flex;
        gap: 1.5rem;
        align-items: center;
    }

    .pending-review-card:hover {
        border-color: #f97316;
        box-shadow: 0 10px 25px rgba(249, 115, 22, 0.1);
        transform: translateY(-2px);
    }

    .pending-review-image {
        width: 100px;
        height: 100px;
        border-radius: 0.75rem;
        object-fit: cover;
        border: 2px solid #fed7aa;
        flex-shrink: 0;
    }

    .pending-review-info {
        flex: 1;
    }

    .pending-review-name {
        font-weight: 600;
        font-size: 1.125rem;
        color: #1f2937;
        margin-bottom: 0.5rem;
    }

    .pending-review-meta {
        display: flex;
        gap: 1.5rem;
        font-size: 0.875rem;
        color: #6b7280;
        margin-bottom: 0.5rem;
    }

    .pending-review-price {
        color: #f97316;
        font-weight: 600;
        font-size: 1rem;
    }

    .btn-write-review {
        background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 0.75rem;
        border: none;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        white-space: nowrap;
    }

    .btn-write-review:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(249, 115, 22, 0.3);
    }

    .my-review-card {
        background: white;
        border: 2px solid #fed7aa;
        border-radius: 1rem;
        padding: 1.5rem;
        margin-bottom: 1rem;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .my-review-card:hover {
        border-color: #f97316;
        box-shadow: 0 10px 25px rgba(249, 115, 22, 0.1);
    }

    .my-review-header {
        display: flex;
        gap: 1rem;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #fff5ec;
    }

    .my-review-product-image {
        width: 80px;
        height: 80px;
        border-radius: 0.5rem;
        object-fit: cover;
        border: 2px solid #fed7aa;
    }

    .my-review-product-info {
        flex: 1;
    }

    .my-review-product-name {
        font-weight: 600;
        font-size: 1rem;
        color: #1f2937;
        margin-bottom: 0.5rem;
    }

    .my-review-rating {
        display: flex;
        gap: 0.25rem;
        color: #fbbf24;
        font-size: 1.25rem;
        margin-bottom: 0.5rem;
    }

    .my-review-date {
        font-size: 0.875rem;
        color: #6b7280;
    }

    .my-review-content {
        color: #374151;
        line-height: 1.6;
        margin-bottom: 1rem;
    }

    .my-review-images {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
    }

    .my-review-image {
        width: 80px;
        height: 80px;
        border-radius: 0.5rem;
        object-fit: cover;
        border: 2px solid #fed7aa;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .my-review-image:hover {
        transform: scale(1.05);
        border-color: #f97316;
    }

    .my-review-actions {
        display: flex;
        gap: 0.75rem;
        justify-content: flex-end;
    }

    .btn-view-review {
        background: white;
        color: #f97316;
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        border: 2px solid #f97316;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-view-review:hover {
        background: #f97316;
        color: white;
    }

    .btn-delete-review {
        background: white;
        color: #dc2626;
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        border: 2px solid #dc2626;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-delete-review:hover {
        background: #dc2626;
        color: white;
    }

    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        background: white;
        border: 2px solid #fed7aa;
        border-radius: 1rem;
    }

    .empty-icon {
        font-size: 4rem;
        margin-bottom: 1rem;
        opacity: 0.5;
    }

    .verified-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        background: #d1fae5;
        color: #065f46;
        padding: 0.25rem 0.5rem;
        border-radius: 0.25rem;
        font-size: 0.75rem;
        font-weight: 600;
    }
</style>

<div class="reviews-container">
    <div class="reviews-tabs">
        <button class="review-tab active" data-tab="pending">
            <i class="fas fa-clock me-1"></i> Chưa đánh giá (@Model.PendingReviews.Count)
        </button>
        <button class="review-tab" data-tab="reviewed">
            <i class="fas fa-star me-1"></i> Đã đánh giá (@Model.MyReviews.Count)
        </button>
    </div>

    <!-- Pending Reviews -->
    <div id="pending-reviews" class="review-content active">
        @if (Model.PendingReviews.Any())
        {
            foreach (var item in Model.PendingReviews)
            {
                <div class="pending-review-card" data-product-id="@item.ProductId">
                    <img src="@(item.MainImageUrl ?? "https://via.placeholder.com/100")"
                         alt="@item.ProductName"
                         class="pending-review-image" />

                    <div class="pending-review-info">
                        <div class="pending-review-name">@item.ProductName</div>
                        <div class="pending-review-meta">
                            <span><i class="far fa-calendar-alt me-1"></i>Mua ngày: @item.PurchaseDate.ToString("dd/MM/yyyy")</span>
                            <span><i class="fas fa-box me-1"></i>Đơn hàng: #@item.OrderId</span>
                        </div>
                        <div class="pending-review-price">@item.Price.ToString("N0")đ</div>
                    </div>

                    <button class="btn-write-review" onclick="openReviewModal(@item.ProductId, '@item.ProductName', '@item.MainImageUrl')">
                        <i class="fas fa-star me-1"></i> Đánh giá ngay
                    </button>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">📦</div>
                <h3 style="color: #1f2937; margin-bottom: 0.5rem;">Không có sản phẩm chưa đánh giá</h3>
                <p style="color: #6b7280;">Bạn đã đánh giá tất cả các sản phẩm đã mua.</p>
            </div>
        }
    </div>

    <!-- My Reviews -->
    <div id="reviewed-reviews" class="review-content">
        @if (Model.MyReviews.Any())
        {
            foreach (var review in Model.MyReviews)
            {
                <div class="my-review-card" data-product-id="@review.ProductId">
                    <div class="my-review-header">
                        <img src="@(review.ProductImageUrl ?? "https://via.placeholder.com/80")"
                             alt="@review.ProductName"
                             class="my-review-product-image" />

                        <div class="my-review-product-info">
                            <div class="my-review-product-name">
                                @review.ProductName
                                @if (review.IsVerifiedPurchase)
                                {
                                    <span class="verified-badge">
                                        <i class="fas fa-check-circle"></i> Đã mua hàng
                                    </span>
                                }
                            </div>
                            <div class="my-review-rating">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= review.Rating)
                                    {
                                        <i class="fas fa-star"></i>
                                    }
                                    else
                                    {
                                        <i class="far fa-star"></i>
                                    }
                                }
                            </div>
                            <div class="my-review-date">
                                <i class="far fa-calendar me-1"></i>@review.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>
                    </div>

                    <div class="my-review-content">
                        @review.Comment
                    </div>

                    @if (review.ImageUrls?.Any() == true)
                    {
                        <div class="my-review-images">
                            @foreach (var imageUrl in review.ImageUrls)
                            {
                                <img src="@imageUrl"
                                     alt="Review image"
                                     class="my-review-image"
                                     onclick="window.open(this.src, '_blank')" />
                            }
                        </div>
                    }

                    @if (review.Replies?.Any() == true)
                    {
                        <div style="background: #fff5ec; padding: 1rem; border-radius: 0.5rem; border-left: 3px solid #f97316; margin-bottom: 1rem;">
                            <strong style="color: #f97316;"><i class="fas fa-reply me-1"></i>Phản hồi từ cửa hàng:</strong>
                            @foreach (var reply in review.Replies)
                            {
                                <div style="margin-top: 0.5rem;">
                                    <p style="margin: 0; color: #374151;">@reply.Content</p>
                                    <small style="color: #6b7280;">@reply.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                            }
                        </div>
                    }

                    <div class="my-review-actions">
                        <button class="btn-delete-review" onclick="event.stopPropagation(); deleteMyReview(@review.ReviewProductId)">
                            <i class="fas fa-trash me-1"></i>Xóa
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">⭐</div>
                <h3 style="color: #1f2937; margin-bottom: 0.5rem;">Chưa có đánh giá nào</h3>
                <p style="color: #6b7280;">Bạn chưa đánh giá sản phẩm nào.</p>
            </div>
        }
    </div>
</div>

<script>
    // ===== Tab switching =====
    document.querySelectorAll('.review-tab').forEach(tab => {
        tab.addEventListener('click', function () {
            console.log('📑 Review tab clicked:', this.getAttribute('data-tab'));

            // Remove active class from all tabs and contents
            document.querySelectorAll('.review-tab').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.review-content').forEach(c => c.classList.remove('active'));

            // Add active class to clicked tab
            this.classList.add('active');

            // Show corresponding content
            const tabName = this.getAttribute('data-tab');
            const content = document.getElementById(tabName + '-reviews');
            if (content) {
                content.classList.add('active');
                console.log('Switched to:', tabName);
            } else {
                console.error('Content not found for tab:', tabName);
            }
        });
    });

    // ===== Make review cards clickable to view product =====
    document.querySelectorAll('.my-review-card').forEach(card => {
        card.addEventListener('click', function (e) {
            // Don't navigate if clicking on action buttons
            if (e.target.closest('.btn-delete-review')) {
                return;
            }

            const productId = this.getAttribute('data-product-id');
            if (productId) {
                console.log('Navigating to product:', productId);
                window.location.href = `/Product/Details?id=${productId}`;
            }
        });
    });

    // Delete review function
    async function deleteMyReview(reviewId) {

        const result = await Swal.fire({
            title: 'Xác nhận xóa',
            text: 'Bạn có chắc chắn muốn xóa đánh giá này?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc2626',
            cancelButtonColor: '#6b7280',
            confirmButtonText: 'Xóa',
            cancelButtonText: 'Hủy'
        });

        if (result.isConfirmed) {
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                const response = await fetch(`/Review/Delete?reviewId=${reviewId}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    }
                });

                const data = await response.json();

                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công!',
                        text: data.message,
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => {
                        // Reload reviews tab
                        if (typeof window.navigateToReviewsTab === 'function') {
                            window.navigateToReviewsTab('reviewed');
                        } else {
                            window.location.reload();
                        }
                    });
                } else {
                    throw new Error(data.error || 'Có lỗi xảy ra');
                }
            } catch (error) {
                console.error('Error deleting review:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi',
                    text: error.message
                });
            }
        }
    }

    window.deleteMyReview = deleteMyReview;
</script>